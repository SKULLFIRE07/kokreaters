---
/**
 * Filters (DESIGN-SPEC 5.7 item 3): two rows of aria-pressed text toggles, no chips.
 * Rendered `hidden`; scripts/pages/insights.ts un-hides them, so without JS the full list shows.
 */
import PillarDot from '@/components/ui/PillarDot.astro';
import { pillars } from '@/data/pillars';
import { microcopy, formatLabels } from '@/data/microcopy';
import { fill } from '@/lib/format';
interface Props { total: number; }
const { total } = Astro.props;
const formats = Object.entries(formatLabels) as [keyof typeof formatLabels, string][];
---
<div class="filters" role="group" aria-label={microcopy.filterGroup} hidden data-filters>
  <div class="filters__row">
    <span class="filters__label t-dateline" id="filter-pillar-label">{microcopy.filterPillar}</span>
    <ul class="filters__opts" role="list" aria-labelledby="filter-pillar-label">
      <li><button type="button" class="filters__btn" aria-pressed="true" data-filter="pillar" data-value="">{microcopy.filterAll}</button></li>
      {pillars.map((p) => (
        <li><button type="button" class="filters__btn" aria-pressed="false" data-filter="pillar" data-value={p.key}><PillarDot pillar={p.key} size={8} />{p.shortLabel}</button></li>
      ))}
    </ul>
  </div>
  <div class="filters__row">
    <span class="filters__label t-dateline" id="filter-format-label">{microcopy.filterFormat}</span>
    <ul class="filters__opts" role="list" aria-labelledby="filter-format-label">
      <li><button type="button" class="filters__btn" aria-pressed="true" data-filter="format" data-value="">{microcopy.filterAll}</button></li>
      {formats.map(([k, label]) => (
        <li><button type="button" class="filters__btn" aria-pressed="false" data-filter="format" data-value={k}>{label}</button></li>
      ))}
    </ul>
  </div>
  <p class="filters__status t-meta tnum" aria-live="polite" data-filter-status data-template={microcopy.insightsCount}>{fill(microcopy.insightsCount, { n: total })}</p>
</div>
<style>
  .filters { display: flex; flex-direction: column; gap: var(--s-1); padding-block: var(--s-4) var(--s-5); }
  .filters__row { display: grid; grid-template-columns: 72px minmax(0, 1fr); align-items: center; gap: var(--s-3); }
  .filters__label { margin: 0; }
  .filters__opts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--s-5); }
  .filters__btn {
    position: relative;
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer;
    font-family: var(--font-sans); font-size: var(--fs-nav); font-weight: 500; line-height: 1.2;
    color: var(--c-meta);
    transition: color var(--d-colour) var(--ease-out);
  }
  .filters__btn::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 8px; height: 2px;
    background: var(--c-action); transform: scaleX(0); transform-origin: 0 50%;
    transition: transform var(--d-ui-in) var(--ease-out);
  }
  .filters__btn:hover { color: var(--c-link); }
  .filters__btn[aria-pressed="true"] { color: var(--c-text); font-weight: 600; }
  .filters__btn[aria-pressed="true"]::after { transform: scaleX(1); }
  .filters__status { margin: var(--s-2) 0 0; color: var(--c-meta); }
  @media (max-width: 767px) {
    .filters__row { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .filters__row + .filters__row { margin-top: var(--s-3); }
    .filters__opts { gap: 0 var(--s-4); }
  }
  @media (prefers-reduced-motion: reduce) { .filters__btn, .filters__btn::after { transition: none; } }
</style>
