---
/**
 * A founder-career case (DESIGN-SPEC v2 10.6 F3): a full-bleed chapter on its own ground (india Sapphire, indonesia
 * Sky, ukraine Imperial, tfa Orchid, each with grain). Grid 7/5. Left: a giant outlined chapter number (decorative),
 * the context as a mono dateline, the outcome h2, the figure in .t-stat (count-up where numeric; Ukraine's −25 °C sits
 * behind FoggyWord frost and adds the secondary 15% at 0.5×) and its source. Right: the honest label (white, 1°)
 * titled "From our founder’s career" with The challenge / What was done / The result (null → CONFIRM C-9 in staging,
 * row omitted in production), then the pillar and sector tags.
 */
import SpecLabel from '@/components/notes/SpecLabel.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import FoggyWord from '@/components/bencho/FoggyWord.astro';
import Confirm from '@/components/ui/Confirm.astro';
import PillarTag from '@/components/ui/PillarTag.astro';
import type { FounderResult, GroundKey } from '@/data/types';
import { impactPage, secondaryFigures } from '@/data/impact';
import { storyNotes } from '@/data/notes/story';
import { abbreviations, minus25 } from '@/lib/typography';
import { pillarHref } from '@/lib/pillars';
import { isStaging } from '@/lib/mode';

interface Props { result: FounderResult; index: number; total: number }
const { result, index, total } = Astro.props;
const { labels } = impactPage;
const grounds: Record<string, GroundKey> = { india: 'sapphire', indonesia: 'sky', ukraine: 'imperial', tfa: 'orchid' };
const ground = grounds[result.id] ?? 'sapphire';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
let itfa = false;
const withAbbr = (t: string) => { let h = esc(t); if (!itfa && h.includes('iTFA')) { h = h.replace('iTFA', `<abbr title="${abbreviations.iTFA.title}">iTFA</abbr>`); itfa = true; } return h; };
const raw = [
  { k: labels.challenge, v: result.challenge },
  { k: labels.done, v: result.done },
  { k: labels.result, v: result.result },
].filter((r) => r.v !== null || isStaging);
const rows = raw.map((r) => ({ k: r.k, v: r.v === null ? '—' : withAbbr(r.v), html: true, strong: r.k === labels.result }));
const missing = raw.some((r) => r.v === null);
// the figure: the data's own, else the DERIVED "1st" (india) or the emphasis word (tfa: "WHO")
const figure = result.figure?.value ?? (result.id === 'india' ? storyNotes.impact.indiaFigure : result.emphasis[0]);
const secondary = secondaryFigures[result.id];
const num = (v?: string) => { const m = v && /^([−-]?)(\d+)(?!\w)/.exec(v); return m && m[2] !== '1' ? `${m[1] ? '-' : ''}${m[2]}` : null; };
const split = (v: string) => { const m = /^([−-]?\d+)(.*)$/.exec(v); return m && m[2].trim() ? { n: m[1], u: m[2] } : null; };
const parts = figure ? split(figure) : null;
const frost = figure === minus25;
const titleId = `case-${result.id}-title`;
const n = String(index + 1).padStart(2, '0');
---
<article id={result.id} class:list={['case', `g-${ground}`, 'grain', 'has-notes']} aria-labelledby={titleId}>
  <div class="container case__grid">
    <div class="case__left">
      <span class="case__n" aria-hidden="true">{n}</span>
      <p class="case__context t-dateline"><span class="case__count tnum" aria-hidden="true">{n} / {String(total).padStart(2, '0')}</span>{result.context.replaceAll(' · ', ' · ')}</p>
      <h2 id={titleId} class="case__outcome">{result.outcome}</h2>
      {figure && (
        <div class="case__figure">
          <p class="case__figs">
            <span class="t-stat case__stat">
              {frost ? (
                <FoggyWord><span aria-hidden="true">{parts ? <>{parts.n}<span class="unit">{parts.u}</span></> : figure}</span></FoggyWord>
              ) : (
                <span aria-hidden="true" data-count={num(figure) ?? undefined}>{parts ? <>{parts.n}<span class="unit">{parts.u}</span></> : figure}</span>
              )}
              <span class="visually-hidden">{figure}</span>
            </span>
            {secondary && <span class="t-stat case__stat case__stat--half"><span aria-hidden="true" data-count={num(secondary) ?? undefined}>{secondary}</span><span class="visually-hidden">{secondary}</span></span>}
          </p>
          {frost && <>
            <MarginNote text={storyNotes.cold.wipe} show="pointer" rotate={-5} arrow="arrow-curve" arrowAt="start" flip arrowAngle={-35} anchor="abs" place="left:clamp(220px, 30%, 300px);top:-58px;" />
            <MarginNote text={storyNotes.cold.yes} show="touch" rotate={-4} arrow={null} anchor="block" class="case__yes" />
          </>}
          {result.figure?.source && <p class="case__source t-mono">{result.figure.source}</p>}
        </div>
      )}
    </div>
    <div class="case__right">
      <SpecLabel title={impactPage.partOne} headingLevel="none" rotate={1} rows={rows} foot={itfa ? abbreviations.iTFA.note : undefined} ground="white" class="case__label" />
      {isStaging && missing && <p class="case__confirm"><Confirm id="C-9" note="case detail" /></p>}
      {(result.pillars.length > 0 || result.sectors.length > 0) && (
        <ul class="case__tags" role="list">
          {result.pillars.map((k) => <li><PillarTag pillar={k} href={pillarHref(k)} /></li>)}
          {result.sectors.map((s) => <li class="case__sector t-label">{s}</li>)}
        </ul>
      )}
    </div>
  </div>
</article>
<style>
  .case { position: relative; padding-block: clamp(72px, 9vw, 150px); overflow: clip; scroll-margin-top: var(--scroll-offset); }
  .case__grid { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-8); align-items: center; }
  .case__left { position: relative; }
  .case__n { position: absolute; right: -2%; top: -12%; z-index: -1; font-family: var(--font-display); font-weight: 800; font-stretch: 75%; line-height: .8;
    font-size: clamp(10rem, 4rem + 22vw, 26rem); color: transparent; -webkit-text-stroke: 2px var(--fg); opacity: .22; letter-spacing: -.04em; pointer-events: none; }
  .case__context { margin: 0 0 var(--s-5); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; max-width: 54ch; }
  .case__count { padding: 5px 10px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1.5px var(--fg); }
  .case__outcome { margin: 0; font-family: var(--font-display); font-weight: 800; font-stretch: 75%; letter-spacing: -.025em; line-height: .92;
    font-size: clamp(2.5rem, 1rem + 4.4vw, 5.5rem); color: var(--head); text-wrap: balance; max-width: 14ch; }
  .case__figure { position: relative; margin-top: var(--s-7); }
  .case__figs { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 .35em; color: var(--head); }
  .case__stat { white-space: nowrap; }
  .case__stat--half { font-size: calc(var(--fs-stat) * .5); color: var(--note); }
  .case :global(.unit) { font-size: .42em; vertical-align: .9em; margin-left: .04em; }
  .case :global(.case__yes) { margin-top: var(--s-2); }
  .case__source { margin: var(--s-3) 0 0; color: var(--fg-2); }
  .case__right { position: relative; }
  .case :global(.case__label) { box-shadow: 10px 10px 0 var(--kk-ink); }
  .case__confirm { margin: var(--s-3) 0 0; }
  .case__tags { list-style: none; margin: var(--s-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .case__tags :global(.pillar-tag) { box-shadow: 0 0 0 2px var(--kk-white); }
  .case__sector { padding: 7px 12px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1.5px var(--fg); color: var(--fg); }
  @media (max-width: 1023px) {
    .case__grid { grid-template-columns: 1fr; gap: var(--s-7); }
    .case__n { top: -6%; }
  }
</style>
