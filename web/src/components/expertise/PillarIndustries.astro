---
/**
 * Related industries for one service (v4 Delft): the industries whose `pillars` include it (mapping C-10). Featured
 * industries show as photo tiles (IndustryTile `photo`: navy gradient, Bodoni name), the rest as a short "Also" line of
 * links. Every link goes to /industries#<slug>. Full-width section: Head on top, tiles 3 across from 900px.
 * The page omits the section when the list is empty. Staging only: a Confirm (C-10) under the list.
 */
import Section from '@/components/ui/Section.astro';
import Confirm from '@/components/ui/Confirm.astro';
import IndustryTile from '@/components/cards/IndustryTile.astro';
import Head from './Head.astro';
import { showConfirm } from '@/lib/mode';
import { pillarPage } from '@/data/pillars';
import { industryPhoto, industriesPage } from '@/data/industries';
import { photos } from '@/data/photos';
import type { Industry } from '@/data/types';

interface Props {
  items: Industry[];
  ground?: 'white' | 'grey';
  rule?: boolean;
}
const { items, ground = 'white', rule = false } = Astro.props;
const withPhoto = items.filter((i) => industryPhoto[i.slug]);
const rest = items.filter((i) => !industryPhoto[i.slug]);
---
<Section ground={ground} rule={rule} pad={rule ? 'tight' : 'default'} labelledby="industries-title">
  <Head id="industries-title" title={pillarPage.relatedIndustries} link={{ label: 'All industries', href: '/industries' }} />
  {withPhoto.length > 0 && (
    <ul class:list={['photo-tiles', 'inds__tiles', `inds__tiles--${withPhoto.length}`]} role="list">
      {withPhoto.map((i) => {
        const ph = photos[industryPhoto[i.slug]];
        return <li><IndustryTile variant="photo" href={`/industries#${i.slug}`} name={i.name} image={ph.src} imageAlt={ph.alt} imagePosition={ph.position} /></li>;
      })}
    </ul>
  )}
  {rest.length > 0 && (
    <p class="inds__also">
      <span class="inds__alsolabel">{industriesPage.otherLabel}:</span>
      {rest.map((i, n) => <>{n > 0 && <span aria-hidden="true"> · </span>}<a href={`/industries#${i.slug}`}>{i.name}</a></>)}
    </p>
  )}
  {showConfirm && <p class="inds__confirm"><Confirm id="C-10" note="industry ↔ expertise mapping is composed" /></p>}
</Section>
<style>
  @media (min-width: 900px) {
    .inds__tiles--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .inds__tiles--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .inds__tiles--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .inds__tiles--4 :global(.ptile__name) { left: 20px; right: 20px; bottom: 18px; }
  }
  .inds__also { margin-top: var(--s-5); font-size: var(--fs-small); line-height: 1.7; color: var(--fg-2); }
  .inds__alsolabel { font-weight: 700; color: var(--head); margin-right: 6px; }
  .inds__also a { color: var(--link); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--rule); }
  .inds__also a:hover { text-decoration-color: currentColor; }
  .inds__confirm { margin-top: var(--s-4); }
</style>
