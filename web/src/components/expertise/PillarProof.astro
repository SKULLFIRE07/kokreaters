---
/**
 * Proof from the founder's career (v4 Delft), on Delft Navy, after the homepage impact band: saffron-ruled label
 * "Impact", h2 "From our founder’s career" and "See the impact →" on one row; under a thin rule, the dateline
 * (caps, #DCE4F2), the result figure in Bodoni Moda 84px white (data-gsap="count") and the result line in Manrope 17px.
 * Without a result (strategy, deals: C-8) staging shows the band with a <Confirm>; preview and production omit it.
 * Mobile: head, figure 64px, line, link.
 */
import Section from '@/components/ui/Section.astro';
import Confirm from '@/components/ui/Confirm.astro';
import Head from './Head.astro';
import { pillarPage } from '@/data/pillars';
import { impactPage, figureFallback } from '@/data/impact';
import { microcopy } from '@/data/microcopy';
import type { FounderResult } from '@/data/types';

interface Props { result?: FounderResult }
const { result: r } = Astro.props;
const figure = r ? (r.figure?.value ?? figureFallback[r.id]) : undefined;
---
<Section ground="navy" labelledby="record-title">
  <Head id="record-title" label={impactPage.overline} title={pillarPage.fromTheRecord} dark link={r ? { label: microcopy.impactLink, href: `/impact#${r.id}` } : undefined} />
  {r ? (
    <div class="plate">
      <div class="plate__fig">
        <p class="plate__eyebrow">{r.dateline}</p>
        {figure && <p class="plate__figure" data-gsap="count">{figure}</p>}
      </div>
      <div class="plate__text">
        <p class="plate__line">{r.homeLine}</p>
        <p class="plate__src">{impactPage.partOne} at {r.dateline.split(' · ').pop()}.</p>
      </div>
    </div>
  ) : (
    <p><Confirm id="C-8" note="no founder result is mapped to this area of expertise yet" /></p>
  )}
</Section>
<style>
  .plate { border-top: 1px solid var(--rule); padding-top: var(--s-5); display: grid; gap: var(--s-5); }
  .plate__eyebrow { font-size: var(--fs-label); font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #DCE4F2; }
  .plate__figure {
    margin-top: var(--s-5);
    font-family: var(--font-serif); font-size: clamp(4rem, 3.4rem + 2vw, 5.25rem); line-height: 1; font-weight: 400;
    letter-spacing: -0.01em; color: var(--white); font-variant-numeric: lining-nums tabular-nums; white-space: nowrap;
  }
  .plate__line { margin-top: var(--s-5); font-size: 1.0625rem; line-height: 1.6; color: #E4EAF5; max-width: 46ch; text-wrap: pretty; }
  .plate__src { margin-top: var(--s-5); font-size: var(--fs-meta); color: var(--fg-2); }
  @media (min-width: 900px) {
    .plate { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: end; padding-top: var(--s-6); }
    .plate__fig { grid-column: 1 / 6; }
    .plate__text { grid-column: 7 / -1; padding-bottom: 6px; }
    .plate__line { margin-top: 0; font-size: 1.1875rem; }
  }
</style>
