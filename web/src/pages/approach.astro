---
/**
 * /approach (REDESIGN-V3 §4 Approach, §8.3, §8.8, §9 "elegant full-screen"). Grounds: navy photo hero → white (promise)
 * → photo interlude → grey (how we work, sticky storytelling) → white (principles) → grey (ways to work with us)
 * → white (FAQ) → grey CtaBand (BaseLayout) → navy footer.
 *  1. PageHero md, full-bleed background `people-02` (a working session; BLEED_SAFE: the faces sit in the middle band
 *     of the frame, so the wide crop keeps every head; people-01 lost them): crumbs, eyebrow "Approach",
 *     H1 "We create with you, not for you.", the intro in full (two sentences).
 *  2. Positioning: headline, promise, range (moved from Home, §8.3).
 *  3. PhotoInterlude `plant-01` (the plant floor), captioned with the brand line from data/home.ts `method.headline`
 *     (caption only: plant-01 is a light photo; large italic type on the scrim keeps AA where a 12px eyebrow might not).
 *  4. Steps: Connect / Collaborate / Create as sticky storytelling (heading + ringed-node index left, steps right).
 *  5. Principles: five, as a numbered editorial list.
 *  6. EngagementTable: the five models, table ≥ 700px, stacked hairline cards below.
 *  7. Faq: Accordion, answers from data only (C-22 in staging where approval is needed).
 * Mobile: the hero photo becomes a band above the text; the interlude is about square; every section is one column.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import PhotoInterlude from '@/components/ui/PhotoInterlude.astro';
import Positioning from '@/components/approach/Positioning.astro';
import Steps from '@/components/approach/Steps.astro';
import Principles from '@/components/approach/Principles.astro';
import EngagementTable from '@/components/approach/EngagementTable.astro';
import Faq from '@/components/approach/Faq.astro';
import { approach } from '@/data/approach';
import { method } from '@/data/home';
import { photos } from '@/data/photos';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: approach.overline, href: '/approach' }];
const photo = photos['people-02'];
// Line-break discipline (§8 rule 9): "with you" is the phrase the headline turns on, so it never splits
// ("We create with you, / not for you." rather than "We create with / you, not for you."); "25 years" never breaks
// between number and unit.
const title = approach.headline.replace(approach.swooshPhrase, approach.swooshPhrase.replace(' ', ' '));
const lead = approach.intro.replace(/(\d+) (years?)\b/g, '$1 $2');
---
<BaseLayout page="approach" seo={pageSeo('approach')} breadcrumbs={crumbs}>
  <PageHero
    ground="navy"
    eyebrow={approach.overline}
    title={title}
    lead={lead}
    crumbs={crumbs}
    image={photo.src}
    imageAlt={photo.alt}
    imagePosition="62% 46%"
    titleId="ap-title"
  />
  <Positioning />
  <PhotoInterlude slug="plant-01" caption={method.headline} />
  <Steps />
  <Principles />
  <EngagementTable />
  <Faq />
</BaseLayout>
