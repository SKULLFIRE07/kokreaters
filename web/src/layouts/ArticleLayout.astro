---
/**
 * Article page (DESIGN-SPEC 5.8). Grid at ≥ 1280px: cols 1–3 sidenotes, 4–10 body (≤ 64ch),
 * 11–12 the route rail. Single column below, with notes inline in reading order.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ProgressRule from '@/components/article/ProgressRule.astro';
import ArticleHeader from '@/components/article/ArticleHeader.astro';
import RouteRail from '@/components/article/RouteRail.astro';
import AuthorBox from '@/components/article/AuthorBox.astro';
import InsightRow from '@/components/shared/InsightRow.astro';
import Section from '@/components/ui/Section.astro';
import { article as articleNode } from '@/components/seo/schema';
import { articleSeo } from '@/lib/seo';
import { getPillar } from '@/lib/pillars';
import { microcopy, formatLabels } from '@/data/microcopy';
import { fill } from '@/lib/format';
import type { SeoProps } from '@/components/seo/schema';

interface Props {
  entry: CollectionEntry<'insights'>;
  headings: MarkdownHeading[];
  minutes: number;
  related: CollectionEntry<'insights'>[];
}
const { entry, headings, minutes, related } = Astro.props;
const d = entry.data;
const pillar = getPillar(d.pillar);
const base = articleSeo({ id: entry.id, title: d.title, description: d.description });
const published = d.date;
const modified = d.updated ?? d.date;
const seo: SeoProps = {
  ...base,
  article: { published: published?.toISOString(), modified: modified?.toISOString(), section: pillar.name },
  jsonLd: [articleNode({ title: d.title, standfirst: d.standfirst || d.description, path: base.path, published, modified, section: pillar.name, ogImage: base.ogImage })],
};
const crumbs = [{ label: 'Insights', href: '/insights' }, { label: d.title, href: base.path }];
const showRail = headings.filter((h) => h.depth === 2).length >= 3;
const minLabel = minutes > 0 ? fill(microcopy.readingTime, { n: minutes }) : '';
---
<BaseLayout page="article" seo={seo} breadcrumbs={crumbs} pillar={d.pillar}>
  <ProgressRule />
  <article class="article" data-article data-minutes={minutes}>
    <div class="container">
      <div class="article__running t-meta">
        <span>{microcopy.insightsRunningHead} · {formatLabels[d.format]}</span>
        {minLabel && <span class="tnum nowrap" data-running-time data-label-left={microcopy.minutesLeft}>{minLabel}</span>}
      </div>
      <div class="article__grid">
        <div class="article__head"><ArticleHeader entry={entry} minutes={minutes} /></div>
        <div class="article__body prose" data-article-body><slot /></div>
        {showRail && <aside class="article__rail"><RouteRail headings={headings} /></aside>}
        <div class="article__author"><AuthorBox /></div>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <Section labelledby="related-h" class="article__related">
      <h2 id="related-h" class="t-h2" data-reveal="lines">{microcopy.relatedInsights}</h2>
      <ol class="related__list">
        {related.map((r) => <InsightRow entry={r} />)}
      </ol>
    </Section>
  )}
</BaseLayout>
<style>
  .article { padding-bottom: var(--section); }
  .article__running {
    display: flex; justify-content: space-between; gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-rule);
    color: var(--c-meta);
    margin-bottom: var(--s-8);
  }
  .article__grid { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-7); }
  .article__head, .article__body, .article__author { width: 100%; max-width: var(--measure-article); margin-inline: auto; }
  .article__head { max-width: calc(var(--measure-article) + 4rem); }
  .article__rail { display: none; }
  .article__author { margin-top: var(--s-5); }
  .related__list { list-style: none; margin: var(--s-6) 0 0; padding: 0; border-bottom: 1px solid var(--c-rule); }

  @media (min-width: 1280px) {
    .article__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .article__head { grid-column: 4 / 12; max-width: none; margin: 0; }
    .article__body { grid-column: 4 / 11; margin: 0; }
    .article__author { grid-column: 4 / 11; margin: var(--s-5) 0 0; max-width: var(--measure-article); }
    .article__rail { display: block; grid-column: 11 / 13; grid-row: 2; }
    .article__body { grid-row: 2; }
  }
</style>
