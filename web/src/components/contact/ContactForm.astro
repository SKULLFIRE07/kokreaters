---
/**
 * Contact form, right column (REDESIGN-V3 §4 Contact). Pack 3: required fields only Name, Email, Company and Message
 * (Country, Area of interest and the rest optional, src/data/contact.ts); no consent tick box: a short privacy line
 * with the policy link sits above Send.
 * Works with no JS: a text/plain mailto to office@ (or a native POST when PUBLIC_FORM_ENDPOINT is an absolute URL);
 * with JS, scripts/pages/contact.ts POSTs to site.formEndpoint (default: the same-origin function /api/contact);
 * the browser's own required/email checks guard that submit. scripts/pages/contact.ts (loaded by the page) sets
 * form.noValidate and layers on: inline errors (aria-invalid + aria-describedby, focus on the first invalid field), the
 * honeypot and 3 s time trap, Turnstile lazy-load on first focus, fetch or mailto, and the thank-you panel that replaces
 * the form on success ([data-form-done]).
 * Hooks the script reads: form[data-form] + its data-* messages, [data-form-status], [data-submit], [data-started-at],
 * input[name="company_website"], .cf__label[data-label], .cf__field controls, #<name>-error [data-error-text],
 * [data-form-wrap] / [data-form-body] / [data-form-done] and the [data-done-*] parts inside it.
 * `id="form"` (the /contact#form anchor used by every "Book a 30-minute call" fallback) sits on the wrapper so the
 * heading is in view when the anchor lands.
 * v4 "Delft": the form sits on a Delft Ice panel (square, no shadow). Inputs are white, square, 52px (56px from 900px),
 * 1px #7F8DAB border (3:1 on white), clear Manrope 700 labels above, 16px text; the focused field's border turns Deep
 * Delft. Heading in Bodoni 28 over a thin rule, generous row gaps, a large Deep Delft "Send" button.
 * Layout: one column; two columns of short fields once the form itself is ≥ 400px wide (container query), so it
 * adapts to the page column rather than the viewport. Mobile: one column, full-width Send button.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { fields, consentLink, contact, contactPage } from '@/data/contact';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';

// No-JS submit: an absolute third-party endpoint takes a native POST; the same-origin /api/contact function answers
// JSON for the script, so without JS the form falls back to a text/plain mailto to office@ (the script always uses fetch).
const nativeEndpoint = /^https?:\/\//.test(site.formEndpoint) ? site.formEndpoint : '';
const action = nativeEndpoint || `mailto:${site.email}`;
const enctype = nativeEndpoint ? 'multipart/form-data' : 'text/plain';
const [noteBefore, noteAfter] = (() => {
  const i = contactPage.privacyNote.indexOf(consentLink.text);
  return i < 0 ? [contactPage.privacyNote, ''] : [contactPage.privacyNote.slice(0, i), contactPage.privacyNote.slice(i + consentLink.text.length)];
})();
const inputs = fields.filter((f) => f.type !== 'checkbox');
const id = (n: string) => `f-${n}`;
const wide = (n: string, t: string) => t === 'textarea' || t === 'select' || n === 'source';
const d = contactPage.done;
interface Props { /** "Or send a message" when the booking block sits above (pack 3). */ heading?: string; }
const { heading } = Astro.props;
---
<div class="cf-wrap" id="form" data-form-wrap>
  <div class="cf-body" data-form-body>
    <div class="cf-head">
      <h2 id="contact-form-h" class="cf-head__title">{heading ?? contactPage.formHeading}</h2>
      <p class="cf-head__note" aria-hidden="true">{contactPage.requiredNote}</p>
    </div>

    <form
      class="cf"
      method="post"
      action={action}
      enctype={enctype}
      data-form
      data-endpoint={site.formEndpoint || undefined}
      data-mailto={site.email}
      data-msg-required={microcopy.required}
      data-msg-consent={contactPage.consentRequired}
      data-msg-email={microcopy.invalidEmail}
      data-msg-success={microcopy.formSuccess}
      data-msg-error={microcopy.formError}
      data-msg-mailto={microcopy.mailtoSent}
      data-turnstile={site.turnstileSiteKey || undefined}
      aria-labelledby="contact-form-h"
    >
      <div class="cf__grid">
        {inputs.map((f) => (
          <div class:list={['cf__field', `cf__field--${f.name}`, { 'cf__field--wide': wide(f.name, f.type) }]} data-field={f.name}>
            <label class="cf__label" for={id(f.name)} data-label={f.label}>
              {f.label}
              {f.required && <><span class="cf__req" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></>}
            </label>
            {f.type === 'textarea' ? (
              <textarea id={id(f.name)} name={f.name} rows={f.rows ?? 6} required={f.required} maxlength={f.maxLength} autocomplete={f.autocomplete} class="cf__input cf__input--area"></textarea>
            ) : f.type === 'select' ? (
              <span class="cf__select">
                <select id={id(f.name)} name={f.name} required={f.required} autocomplete={f.autocomplete} class="cf__input">
                  <option value="" selected disabled>{contactPage.selectPlaceholder}</option>
                  {f.options?.map((o) => <option value={o}>{o}</option>)}
                </select>
                <Icon name="chevron-down" size={20} class="cf__chev" />
              </span>
            ) : (
              <input
                id={id(f.name)} name={f.name} type={f.type} required={f.required} maxlength={f.maxLength} autocomplete={f.autocomplete} class="cf__input"
                {...(f.type === 'email' ? { inputmode: 'email', spellcheck: 'false', autocapitalize: 'off' } : {})}
                {...(f.type === 'tel' ? { inputmode: 'tel' } : {})}
              />
            )}
            <p id={`${f.name}-error`} class="cf__error" hidden><Icon name="error" size={18} /><span data-error-text></span></p>
          </div>
        ))}

      </div>

      <div class="hp" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="started_at" value="" data-started-at />
      {site.turnstileSiteKey && <div class="cf-turnstile cf__turnstile" data-sitekey={site.turnstileSiteKey}></div>}

      <p class="cf__privacy">{noteBefore}<a href={consentLink.href} target="_blank" rel="noopener">{consentLink.text}<span class="visually-hidden"> ({consentLink.newTab})</span></a>{noteAfter}</p>
      <div class="cf__actions">
        <Button type="submit" variant="primary" size="lg" icon="arrow" class="cf__submit" data-submit>{contact.submit}</Button>
      </div>
      <div class="cf__status" role="status" aria-live="polite" data-form-status></div>
      <template data-icon="success"><Icon name="success" size={20} /></template>
      <template data-icon="error"><Icon name="error" size={20} /></template>
    </form>
  </div>

  <div class="cf-done" hidden data-form-done data-sent-heading={d.sentHeading} data-mailto-heading={d.mailtoHeading}>
    <div class="cf-done__head">
      <Icon name="success" size={28} stroke={1.5} class="cf-done__icon" />
      <h2 class="cf-done__title" id="cf-done-h" tabindex="-1" aria-describedby="cf-done-text" data-done-heading>{d.sentHeading}</h2>
    </div>
    <p class="cf-done__text" id="cf-done-text" data-done-text>{microcopy.formSuccess}</p>
    <div class="cf-done__actions">
      <Button type="button" variant="secondary" data-done-again>{d.again}</Button>
      <Button type="button" variant="secondary" data-done-back hidden>{d.back}</Button>
      <Button href={`mailto:${site.email}`} variant="tertiary" icon="external" data-done-reopen hidden>{d.reopen}</Button>
    </div>
  </div>
</div>

<style>
  .cf-wrap {
    container-type: inline-size;
    --field-border: #7F8DAB; --field-bg: var(--white); --rule: #CBD5E6; --surface-hover: var(--white);
    background: var(--ice); padding: var(--s-6) var(--s-5);
  }
  /* phones: the panel runs edge to edge so the fields keep their width */
  @media (max-width: 599px) { .cf-wrap { margin-inline: calc(-1 * var(--gutter-x)); padding: var(--s-6) var(--gutter-x); } }
  @media (min-width: 600px) { .cf-wrap { padding: var(--s-7); } }
  @media (min-width: 1200px) { .cf-wrap { padding: var(--s-8) var(--s-8) var(--s-7); } }
  .cf-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-2) var(--s-5); margin-bottom: var(--s-7); padding-bottom: var(--s-5); border-bottom: 1px solid var(--rule); }
  .cf-head__title { margin: 0; font: 500 1.75rem/1.2 var(--font-serif); letter-spacing: 0; color: var(--head); }
  .cf-head__note { margin: 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }

  .cf { margin: 0; }
  .cf__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6) var(--s-5); }
  @media (min-width: 900px) { .cf__grid { gap: var(--s-7) var(--s-6); } }
  @container (min-width: 400px) {
    .cf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cf__field--wide { grid-column: 1 / -1; }
  }
  .cf__field { position: relative; display: grid; gap: var(--s-2); align-content: start; min-width: 0; }
  .cf__label { font: 700 var(--fs-small)/1.35 var(--font-sans); color: var(--head); }
  .cf__req { margin-left: 3px; color: var(--fg-2); font-weight: 500; }

  .cf__input {
    display: block; width: 100%; min-width: 0; height: 52px; margin: 0; padding: 0 var(--s-4);
    border: 1px solid var(--field-border); border-radius: var(--r-sm);
    background: var(--field-bg); color: var(--fg);
    font: 400 var(--fs-body)/1.4 var(--font-sans);
    transition: border-color var(--d-1) var(--ease-out), box-shadow var(--d-1) var(--ease-out);
  }
  @media (min-width: 900px) { .cf__input { height: 56px; } }
  .cf__input:hover { border-color: var(--head); }
  .cf__input:focus { border-color: var(--link); box-shadow: inset 0 0 0 1px var(--link); outline: none; }
  .cf__input:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-color: var(--link); }
  .cf__input--area { height: auto; min-height: 200px; padding: var(--s-3) var(--s-4); line-height: 1.55; resize: vertical; }
  .cf__input[aria-invalid="true"] { border-color: var(--danger); box-shadow: inset 0 0 0 1px var(--danger); }

  .cf__select { position: relative; display: block; }
  .cf__select select { appearance: none; -webkit-appearance: none; padding-right: 48px; cursor: pointer; text-overflow: ellipsis; }
  .cf__select select:invalid { color: var(--fg-2); }
  .cf__select option { color: var(--ink); }
  .cf__select :global(.cf__chev) { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--head); }

  .cf__error { display: flex; align-items: flex-start; gap: var(--s-2); margin: 0; font: 500 var(--fs-meta)/var(--lh-meta) var(--font-sans); color: var(--danger); }
  .cf__error :global(.icon) { flex: none; margin-top: 1px; }

  /* pack 3: the privacy line above Send (no tick box on this page) */
  .cf__privacy { margin: var(--s-6) 0 0; padding-top: var(--s-5); border-top: 1px solid var(--rule); max-width: 60ch; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); text-wrap: pretty; }
  .cf__privacy a { color: var(--link); text-underline-offset: .2em; }

  .hp { position: absolute !important; left: -10000px !important; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .cf__turnstile { margin-top: var(--s-5); }
  .cf__actions { margin-top: var(--s-6); }
  .cf__actions :global(.cf__submit) { min-width: 200px; }
  @container (max-width: 399px) { .cf__actions :global(.cf__submit) { width: 100%; } }

  .cf__status { margin-top: var(--s-4); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg); max-width: 40em; }
  .cf__status:empty { display: none; }
  .cf__status[data-tone] { display: flex; align-items: flex-start; gap: var(--s-3); padding: var(--s-4) var(--s-5); border-left: 2px solid var(--danger); background: var(--surface-hover); }
  .cf__status[data-tone="info"] { display: none; }
  .cf__status[data-tone="success"] { border-left-color: var(--success); }
  .cf__status :global(.icon) { flex: none; margin-top: 2px; }
  .cf__status[data-tone="error"] :global(.icon) { color: var(--danger); }
  .cf__status[data-tone="success"] :global(.icon) { color: var(--success); }

  /* Thank-you state: replaces the heading + form once the message is sent or handed to the mail app. It keeps the
     form's own structure (serif heading over a 2px rule, then body and actions), so its heading and rule sit exactly
     where "Send a message" and its rule were, level with "Contact details" in the left column. */
  .cf-done {
    /* scrollIntoView lands it below the sticky header (it has no id, so the global [id] rule does not cover it) */
    scroll-margin-top: var(--scroll-offset);
  }
  .cf-done__head { display: flex; align-items: center; gap: var(--s-3); padding-bottom: var(--s-5); border-bottom: 1px solid var(--rule); }
  .cf-done__head :global(.cf-done__icon) { flex: none; color: var(--success); }
  .cf-done__title { margin: 0; font: 500 1.75rem/1.2 var(--font-serif); letter-spacing: 0; color: var(--head); }
  .cf-done__title:focus { outline: none; }
  .cf-done__title:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .cf-done__text { margin: var(--s-5) 0 0; max-width: 46ch; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg); text-wrap: pretty; }
  .cf-done__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); margin-top: var(--s-6); }
  @container (max-width: 399px) {
    .cf-done__actions :global(.btn--secondary) { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .cf__input { transition: none; } }
</style>
