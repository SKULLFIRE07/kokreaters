---
/**
 * /approach (v4 Delft). Grounds: navy photo hero → white (promise) → Delft Ice (lab → plant → market photo cards)
 * → white (how we work) → Porcelain (principles) → white (ways to work with us) → Porcelain (FAQ) → CtaBand → footer.
 *  1 PillarHero: a working session under the navy gradient; label "Approach", H1, the intro.
 *  2 Positioning: label, h2, the promise as a Bodoni statement, the range paragraph.
 *  3 ApproachLanes: Develop / Scale / Access (client design wording), each linking to its service.
 *  4 Steps: Connect / Collaborate / Create as sticky storytelling.
 *  5 Principles · 6 EngagementTable · 7 Faq.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHero from '@/components/expertise/PillarHero.astro';
import Positioning from '@/components/approach/Positioning.astro';
import ApproachLanes from '@/components/approach/ApproachLanes.astro';
import Steps from '@/components/approach/Steps.astro';
import Principles from '@/components/approach/Principles.astro';
import EngagementTable from '@/components/approach/EngagementTable.astro';
import Faq from '@/components/approach/Faq.astro';
import { approach } from '@/data/approach';
import { photos } from '@/data/photos';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: approach.overline, href: '/approach' }];
const photo = photos['people-02'];
// "with you" never splits; "25 years" never breaks between number and unit.
const title = approach.headline.replace(approach.swooshPhrase, approach.swooshPhrase.replace(' ', ' '));
const lead = approach.intro.replace(/(\d+) (years?)\b/g, '$1 $2');
---
<BaseLayout page="approach" seo={pageSeo('approach')} breadcrumbs={crumbs}>
  <PillarHero
    eyebrow={approach.overline} title={title} lead={lead} crumbs={crumbs}
    image={photo.src} imageAlt={photo.alt} imagePosition="62% 46%" titleId="ap-title"
  />
  <Positioning />
  <ApproachLanes />
  <Steps />
  <Principles />
  <EngagementTable />
  <Faq />
</BaseLayout>
