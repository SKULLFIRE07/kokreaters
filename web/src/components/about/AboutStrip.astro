---
/**
 * About · the figures band (pack 3, "Make 25 years felt" point 3): directly under the hero, so the page opens with
 * achievements. Porcelain band. `aboutFigures` from src/data/career.ts: 25 years, 8 sites, 5 languages, then the six
 * scale figures. The six are drafts: they render in staging and preview (staging marks each with a <Confirm>), never
 * in production until `status: 'confirmed'` (career.ts `visible`).
 * Each figure: Bodoni lining figures at one size (72–80px desktop) with the unit in Manrope beside it, on a 1px rule
 * (the first a 3px saffron rule), the label under it in Manrope. No counting animation (lead decision 1).
 * Under the grid, the one footnote of the page (careerFootnote, verbatim).
 * ≥ 900px three columns (3 × 3 with all nine); 600–899px two; phones two narrow columns with a smaller figure (the unit
 * drops under the number when the column is too narrow for both).
 */
import Confirm from '@/components/ui/Confirm.astro';
import { aboutFigures, careerFootnote, visible } from '@/data/career';
import { aboutStrip } from '@/data/about';
import { showConfirm } from '@/lib/mode';

const items = visible(aboutFigures);
---
{items.length > 0 && (
  <section class="band band--grey afig" aria-labelledby="afig-h">
    <div class="container">
      <h2 id="afig-h" class="afig__label t-label">{aboutStrip.label}</h2>
      <ul class="afig__list" role="list">
        {items.map((f, i) => (
          <li class:list={['afig__item', i === 0 && 'afig__item--lead']}>
            <span class="afig__rule" aria-hidden="true" data-gsap="rule"></span>
            <p class="afig__fig"><span class="afig__n">{f.value}</span>{f.unit && <span class="afig__u">{f.unit}</span>}</p>
            <p class="afig__text">{f.label}{showConfirm && f.status === 'draft' && <> <Confirm id="P-2" note="draft figure" /></>}</p>
          </li>
        ))}
      </ul>
      <p class="afig__note">{careerFootnote}</p>
    </div>
  </section>
)}
<style>
  .afig { --_pad: clamp(4rem, 3rem + 3vw, 6.5rem); }
  .afig__label { margin: 0 0 var(--s-7); }
  .afig__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--s-5);
  }
  .afig__item { position: relative; padding-top: var(--s-5); min-width: 0; }
  .afig__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--rule); transform-origin: left center; }
  .afig__item--lead .afig__rule { height: 3px; background: var(--saffron); }
  .afig__fig { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 .4rem; margin: 0; color: var(--head); }
  .afig__n {
    font-family: var(--font-serif); font-weight: 400; font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem); line-height: 1;
    letter-spacing: -0.01em; font-variant-numeric: lining-nums tabular-nums; white-space: nowrap;
  }
  .afig__u { font: 700 var(--fs-small)/1.2 var(--font-sans); letter-spacing: .01em; color: var(--head); white-space: nowrap; }
  .afig__text { margin: var(--s-3) 0 0; max-width: 32ch; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); text-wrap: pretty; }
  .afig__note {
    margin: var(--s-8) 0 0; padding-top: var(--s-4); border-top: 1px solid var(--rule); max-width: 70ch;
    font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2);
  }
  @media (min-width: 600px) { .afig__list { gap: var(--s-8) var(--grid-gap); } .afig__u { font-size: var(--fs-body); } }
  @media (min-width: 900px) {
    .afig__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .afig__text { font-size: var(--fs-body); line-height: var(--lh-body); }
  }
</style>
