---
/**
 * /approach §5 — five principles as a numbered editorial list (REDESIGN-V3 §4 Approach, §9.3). White band.
 * The h2 (SectionHeader), then five rows, each on a hairline: a light serif numeral, the serif h3 name, the copy.
 * Desktop (≥ 900): the rows run on the 12-column grid — numeral in columns 1–2, name in 3–7, copy in 8–12, top-aligned
 *  (the copy's first line sits level with the name's first line). 40 → 56px of air per row.
 * Mobile (< 900): numeral and name side by side, the copy below at body size; rows 32px apart.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { principles, principlesHeading } from '@/data/approach';
import { pad2 } from '@/lib/format';
---
<Section ground="white" labelledby="principles-h" class="principles">
  <SectionHeader id="principles-h" title={principlesHeading} />
  <ol class="pr" role="list">
    {principles.map((p, i) => (
      <li class="pr__row" data-reveal style={`--i:${i % 3}`}>
        <span class="pr__n" aria-hidden="true">{pad2(i + 1)}</span>
        <h3 class="pr__name">{p.name}</h3>
        <p class="pr__copy">{p.copy}</p>
      </li>
    ))}
  </ol>
</Section>
<style>
  .pr { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }
  .pr__row {
    display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: var(--s-4); align-items: baseline;
    padding-block: var(--s-6) var(--s-7); border-top: 1px solid var(--rule);
  }
  .pr__n {
    font-family: var(--font-serif); font-optical-sizing: auto; font-weight: 300;
    font-size: 1.75rem; line-height: 1; letter-spacing: -0.02em; color: var(--fg-2); font-variant-numeric: lining-nums tabular-nums;
  }
  .pr__name {
    font-family: var(--font-serif); font-optical-sizing: auto; font-weight: 400;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.25rem); line-height: 1.15; letter-spacing: -0.012em; color: var(--head); text-wrap: balance;
  }
  .pr__copy {
    grid-column: 2; margin-top: var(--s-3);
    font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2); text-wrap: pretty; max-width: 44ch;
  }
  @media (min-width: 900px) {
    .pr__row {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: start;
      padding-block: var(--s-7) var(--s-8);
    }
    .pr__n { grid-column: 1 / 3; font-size: clamp(2rem, 1.4rem + 1.2vw, 3rem); }
    .pr__name { grid-column: 3 / 8; max-width: 20ch; }
    .pr__copy { grid-column: 8 / -1; margin-top: .35em; font-size: var(--fs-lead); line-height: var(--lh-lead); }
  }
</style>
