---
/**
 * Site header (v4 developer guide: white, logo 52px tall, visible navigation, Deep Delft "Start a conversation").
 * Sticky solid white bar with a 1px #E3E8F1 hairline; 88px on desktop, compacting to 72px on scroll (site.ts adds
 * .is-scrolled; the logo scales 52 → 44px). The outer <header> keeps --header-h in flow and lets clicks through; only
 * the inner bar resizes, so compacting never shifts the page.
 * Desktop ≥ 1120px: the business-card logo (with "Connect · Collaborate · Create") · Expertise ▾ (MegaMenu) ·
 * Industries ▾ (IndustriesMenu) · Approach · Insights · About · "Start a conversation" ([data-header-cta];
 * aria-current="page" on /contact). One 2px Deep Delft bar on the header's bottom edge glides between hovered items and
 * rests under the current section (no-JS: a static bar under aria-current).
 * Mobile < 1120px: 64px bar, logo 40px + a "Menu" button (hamburger, mobile only; turns into a cross) that opens
 * MobileMenu below the bar. No-JS: the Menu link jumps to the footer sitemap.
 */
import Logo from '@/components/brand/Logo.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Container from '@/components/ui/Container.astro';
import MegaMenu from './MegaMenu.astro';
import IndustriesMenu from './IndustriesMenu.astro';
import MobileMenu from './MobileMenu.astro';
import { main, header as labels } from '@/data/nav';
import { microcopy } from '@/data/microcopy';

interface Props { page?: string }
const { page = '' } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const current = (href: string) =>
  isCurrent(href) || (href === '/expertise' && (page === 'expertise' || page === 'pillar')) || (href === '/insights' && page === 'article');
const kind = (p: true | 'mega' | 'list' | undefined) => (p === 'list' ? 'list' : p ? 'mega' : null);
---
<header class="site-header" data-header>
  <div class="site-header__bar">
    <Container class="site-header__inner">
      <Logo variant="full" href="/" label={labels.homeLabel} height={52} loading="eager" class="site-header__logo" />

      <nav class="site-nav" aria-label={labels.navLabel}>
        <ul class="site-nav__list" role="list" data-glide-list>
          {main.map((item) => {
            const k = kind(item.panel);
            const on = current(item.href);
            const id = k === 'mega' ? 'mega-expertise' : 'menu-industries';
            return k ? (
              <li class:list={['site-nav__item', k === 'list' && 'site-nav__item--anchor']} data-nav-scope>
                <button type="button" class:list={['site-nav__link', 'js-only', on && 'is-current']}
                  aria-expanded="false" aria-controls={id} data-nav-toggle data-glide-item>
                  <span>{item.label}</span><span class="site-nav__chev"><Icon name="chevron-down" size={16} /></span>
                </button>
                <a class:list={['site-nav__link', 'nojs-only', on && 'is-current']} href={item.href}
                  aria-current={on ? 'page' : undefined}>{item.label}</a>
                {k === 'mega' ? <MegaMenu id={id} /> : <IndustriesMenu id={id} />}
              </li>
            ) : (
              <li class="site-nav__item">
                <a class:list={['site-nav__link', on && 'is-current']} href={item.href}
                  aria-current={on ? 'page' : undefined} data-glide-item>{item.label}</a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="site-header__actions">
        <Button href="/contact" class="site-header__cta" data-header-cta aria-current={page === 'contact' ? 'page' : undefined}>{microcopy.primaryCta}</Button>
        <button type="button" class="menu-btn js-only" aria-expanded="false" aria-controls="mobile-menu"
          data-menu-toggle data-label-open={microcopy.menu} data-label-close={microcopy.close}>
          <span class="menu-btn__label" data-menu-label>{microcopy.menu}</span>
          <span class="menu-btn__icon" aria-hidden="true"><span></span><span></span></span>
        </button>
        <a class="menu-btn nojs-only" href="#site-footer">
          <span class="menu-btn__label">{microcopy.menu}</span>
          <span class="menu-btn__icon" aria-hidden="true"><span></span><span></span></span>
        </a>
      </div>
    </Container>
    <span class="site-nav__glide" data-glide aria-hidden="true"></span>
  </div>
  <div class="site-scrim" aria-hidden="true"></div>
  <MobileMenu />
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-h);
    pointer-events: none;                       /* the strip under the compact bar never blocks the page */
  }
  .site-header__bar {
    position: relative; z-index: 2;
    height: var(--header-h);
    pointer-events: auto;
    color: var(--ink);
    background: var(--white);
    box-shadow: inset 0 -1px 0 #E3E8F1;
    view-transition-name: site-header;
    transition: height var(--d-2) var(--ease-out), box-shadow var(--d-2) var(--ease-out), background-color var(--d-2) var(--ease-out);
  }
  .site-header.is-scrolled .site-header__bar { height: var(--header-h-compact); box-shadow: inset 0 -1px 0 #E3E8F1, 0 1px 0 rgba(14, 31, 77, .03); }
  .site-header.has-panel .site-header__bar,
  :global(html.menu-open) .site-header__bar { background: var(--white); }
  :global(html.menu-open) .site-header__bar { box-shadow: inset 0 -1px 0 var(--grey-200); }
  /* While the mobile menu is open the body is position:fixed, so the header is pinned where it was. */
  :global(html.menu-open) .site-header { position: fixed; top: var(--menu-hdr-top, 0px); left: 0; right: 0; }

  .site-header :global(.site-header__inner) { height: 100%; display: flex; align-items: center; gap: var(--s-6); }
  .site-header :global(.site-header__logo) { --logo-h: 40px !important; flex: none; box-sizing: content-box; padding-block: 2px; margin-block: -2px; transition: height var(--d-2) var(--ease-out); }
  @media (min-width: 1120px) {
    .site-header :global(.site-header__logo) { --logo-h: 52px !important; }
    .site-header.is-scrolled :global(.site-header__logo) { --logo-h: 44px !important; }
  }

  /* ── Desktop nav ── */
  .site-nav { display: none; height: 100%; margin-left: auto; }
  @media (min-width: 1120px) { .site-nav { display: block; } }
  .site-nav__list { display: flex; height: 100%; gap: 32px; margin: 0; padding: 0; list-style: none; }
  .site-nav__item { display: flex; align-items: center; height: 100%; }
  .site-nav__item--anchor { position: relative; }
  .site-nav__link {
    position: relative;
    display: inline-flex; align-items: center; gap: 6px; height: 44px;
    margin: 0; padding: 0; border: 0; border-radius: var(--r-sm); background: none; cursor: pointer;
    font: 600 var(--fs-nav)/1 var(--font-sans); letter-spacing: 0;
    color: var(--navy-900); text-decoration: none; white-space: nowrap;
    transition: color var(--d-1) var(--ease-out);
  }
  .site-nav__link:hover, .site-nav__link[aria-expanded="true"], .site-nav__link.is-current { color: var(--blue-700); }
  .site-nav__link:focus-visible { outline-offset: 4px; }
  .site-nav__chev { display: inline-flex; color: var(--ink-2); transition: transform var(--d-2) var(--ease-out); }
  .site-nav__link[aria-expanded="true"] .site-nav__chev { transform: rotate(180deg); }
  /* no-JS / pre-JS: a static bar under the current section */
  .site-nav__link.is-current::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: calc(22px - var(--header-h) / 2); height: 2px; background: var(--accent);
  }
  .site-nav__list.has-glide .site-nav__link::after { display: none; }

  /* the sliding highlight (positioned against the bar by site.ts) */
  .site-nav__glide {
    position: absolute; left: 0; bottom: 0; z-index: 3;
    width: 0; height: 2px; background: var(--accent);
    opacity: 0; pointer-events: none;
    transition: transform var(--d-2) var(--ease-out), width var(--d-2) var(--ease-out), opacity var(--d-1) var(--ease-out);
  }
  .site-nav__glide.is-still { transition: opacity var(--d-1) var(--ease-out); }
  @media (max-width: 1119px) { .site-nav__glide { display: none; } }

  /* ── Actions ── */
  .site-header__actions { display: flex; align-items: center; gap: var(--s-4); margin-left: auto; flex: none; }
  @media (min-width: 1120px) { .site-header__actions { margin-left: clamp(8px, 1.6vw, 40px); } }
  .site-header :global(.site-header__cta) { display: none; }
  @media (min-width: 1120px) {
    .site-header :global(.site-header__cta) { display: inline-flex; height: 46px; min-height: 46px; padding: 0 22px; }
  }

  .menu-btn {
    display: inline-flex; align-items: center; gap: 10px;
    height: 44px; min-width: 44px; margin-right: -10px; padding: 0 10px;
    border: 0; border-radius: var(--r-sm); background: none; cursor: pointer;
    font: 600 var(--fs-nav)/1 var(--font-sans); color: var(--navy-900); text-decoration: none;
  }
  @media (min-width: 1120px) { .menu-btn { display: none !important; } }
  .menu-btn__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 400px) { .menu-btn__label { position: static; width: auto; height: auto; overflow: visible; clip-path: none; } }
  .menu-btn__icon { position: relative; width: 20px; height: 12px; flex: none; }
  .menu-btn__icon span {
    position: absolute; left: 0; width: 100%; height: 1.5px; border-radius: 1px; background: currentColor;
    transition: transform var(--d-2) var(--ease-out), top var(--d-2) var(--ease-out);
  }
  .menu-btn__icon span:first-child { top: 0; }
  .menu-btn__icon span:last-child { top: calc(100% - 1.5px); }
  .menu-btn[aria-expanded="true"] .menu-btn__icon span { top: calc(50% - .75px); }
  .menu-btn[aria-expanded="true"] .menu-btn__icon span:first-child { transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .menu-btn__icon span:last-child { transform: rotate(-45deg); }

  /* ── Scrim behind the mega-menu ── */
  .site-scrim {
    position: fixed; inset: 0; z-index: 1;
    background: rgb(14 31 77 / .22);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity var(--d-3) var(--ease-out), visibility 0s linear var(--d-3);
  }
  .site-header.has-scrim .site-scrim { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity var(--d-3) var(--ease-out), visibility 0s; }
</style>
