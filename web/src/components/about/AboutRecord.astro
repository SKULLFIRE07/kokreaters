---
/**
 * About · track record, v4 "Delft" (the homepage's Porcelain track-record band, carried onto About). The four figures
 * from src/data/home.ts `proof` (developer guide content fixes): 25 years in industry, 14 years in oils, fats and food
 * ingredients, 5 countries, WHO recognition. No "regions of teams led" count: that is an open question for Ganeaysh.
 * Each figure is Bodoni 64 over its rule: the lead figure takes the 3px saffron top rule, the others a 1px line
 * (data-gsap="rule" draws them in; data-gsap="count" counts the numbers up once, WHO is left alone).
 * Header row: "Track record" label left, the source line right.
 * ≥ 900px four columns; 600–899 two; phones two columns with smaller figures.
 */
import { proof, proofStripSource, homeLabels } from '@/data/home';

const label = homeLabels.proof;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Keep "hands-on" and "trans-fat" whole in the narrow phone columns. */
const keep = (s: string) => esc(s).replace(/(\S+-\S+)/g, '<span class="nowrap">$1</span>');
const strongFirst = (p: (typeof proof)[number]) => {
  if (!p.strong || !p.label.startsWith(p.strong)) return { strong: '', rest: p.label };
  return { strong: p.strong, rest: p.label.slice(p.strong.length) };
};
---
<section class="band band--grey arec" aria-labelledby="arec-h">
  <div class="container">
    <div class="arec__head">
      <h2 id="arec-h" class="arec__label t-label">{label}</h2>
      <p class="arec__source">{proofStripSource}</p>
    </div>
    <ul class="arec__list" role="list">
      {proof.map((p, i) => {
        const l = strongFirst(p);
        return (
          <li class:list={['arec__item', i === 0 && 'arec__item--lead']}>
            <span class="arec__rule" aria-hidden="true" data-gsap="rule"></span>
            <p class="arec__figure" data-gsap={p.count ? 'count' : undefined}>{p.value}</p>
            <p class="arec__text">{l.strong && <strong>{l.strong}</strong>}<Fragment set:html={keep(l.rest)} /></p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  .arec { --_pad: clamp(4rem, 3rem + 3vw, 6.5rem); }
  .arec__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-2) var(--s-6); margin-bottom: var(--s-7); }
  .arec__label { margin: 0; }
  .arec__source { margin: 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .arec__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--grid-gap); }
  .arec__item { position: relative; padding-top: var(--s-5); min-width: 0; }
  .arec__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--rule); transform-origin: left center; }
  .arec__item--lead .arec__rule { height: 3px; background: var(--saffron); }
  .arec__figure {
    margin: 0; font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4rem); line-height: 1; letter-spacing: -0.01em; color: var(--head);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .arec__text { margin: var(--s-4) 0 0; max-width: 26ch; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2); text-wrap: pretty; }
  .arec__text strong { color: var(--head); font-weight: 700; }
  @media (min-width: 900px) { .arec__list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
