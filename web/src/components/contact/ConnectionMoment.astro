---
/**
 * The connection path (DESIGN-SPEC v2 00.2 "CONTACT — the form as a 3-step node path (who → what → send) that draws
 * as fields complete", 10.10 ConnectionMoment). Decorative (aria-hidden; the form itself carries every label, state
 * and error). The visitor's node ("You", or the first name they type) → Who → What → Send → Ganeaysh's avatar.
 * scripts/pages/contact.ts sets --f (0 → 1) on each segment as the required fields of that step become valid, lights
 * each stop when its step is complete, and draws the last segment (to Ganeaysh) only on a successful submit.
 */
import FounderPhoto from '@/components/brand/FounderPhoto.astro';
import { contact } from '@/data/contact';
import { journalNotes } from '@/data/notes/journal';
const stops = [
  { k: 'who', label: journalNotes.form.who },
  { k: 'what', label: journalNotes.form.what },
  { k: 'send', label: contact.submit },
];
---
<div class="cm" aria-hidden="true" data-steps>
  <div class="cm__path">
    <span class="cm__stop cm__stop--you">
      <span class="cm__node"><span class="cm__dot"></span></span>
      <span class="cm__label" data-visitor-label data-fallback={contact.visitorFallback}>{contact.visitorFallback}</span>
    </span>
    {stops.map((s, i) => (<>
      <span class="cm__seg"><span class="cm__fill" data-seg={i}></span></span>
      <span class="cm__stop" data-stop={s.k}>
        <span class="cm__node tnum">{i + 1}</span>
        <span class="cm__label">{s.label}</span>
      </span>
    </>))}
    <span class="cm__seg cm__seg--last"><span class="cm__fill" data-seg="3" data-connection-line></span></span>
    <span class="cm__stop cm__stop--gk">
      <FounderPhoto variant="avatar" size={52} alt="" />
    </span>
  </div>
</div>
<style>
  .cm { position: relative; z-index: 5; margin-bottom: var(--s-7); }
  .cm__path { display: flex; align-items: center; gap: 6px; padding: 14px 18px 30px; background: var(--kk-white); border: 2px solid var(--kk-ink); border-radius: 22px; box-shadow: var(--shadow-hard); }
  .cm__stop { position: relative; flex: none; display: grid; place-items: center; }
  .cm__node { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--kk-white); box-shadow: inset 0 0 0 2.5px var(--kk-ink);
    font-family: var(--font-mono); font-size: 12px; font-weight: 500; color: var(--kk-ink); transition: background 300ms var(--ease-expo), scale 400ms var(--ease-expo), rotate 400ms var(--ease-expo); }
  .cm__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--kk-sapphire); }
  .cm__stop.is-done .cm__node { background: var(--kk-saffron); scale: 1.15; rotate: -8deg; }
  .cm__label { position: absolute; top: calc(100% + 4px); left: 50%; translate: -50% 0; white-space: nowrap; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--kk-graphite); max-width: 12ch; overflow: hidden; text-overflow: ellipsis; }
  .cm__stop.is-done .cm__label { color: var(--kk-ink); }
  .cm__seg { position: relative; flex: 1 1 0; min-width: 12px; height: 4px; border-radius: 2px; background: repeating-linear-gradient(90deg, var(--kk-field-border) 0 5px, transparent 5px 10px); }
  .cm__fill { position: absolute; inset: 0; border-radius: 2px; background: var(--kk-sapphire); transform: scaleX(var(--f, 0)); transform-origin: 0 50%; transition: transform 500ms var(--ease-expo); }
  .cm__seg--last .cm__fill { background: var(--kk-orchid); }
  .cm__stop--gk :global(.founder-avatar) { box-shadow: 0 0 0 3px var(--kk-ink); }
  .cm.is-connected .cm__stop--gk :global(.founder-avatar) { box-shadow: 0 0 0 3px var(--kk-ink), 0 0 0 7px var(--kk-saffron); }
  @media (prefers-reduced-motion: reduce) { .cm__fill, .cm__node { transition: none; } }
</style>
