---
/**
 * MarginNote (DESIGN-SPEC v2 6.2/6.3): Ganeaysh's handwritten margin note, Caveat, with an optional hand-drawn arrow.
 * Decorative by default (aria-hidden, never the only carrier of information). Words come from src/data/notes/*.
 * Ships fully drawn; motion (scripts/motion/notes.ts) hides it only while html.motion is set, then draws the arrow
 * and settles the note in. `anchor="abs"` places it absolutely inside the nearest `.has-notes` (no layout, no CLS).
 */
import { pick, vbSize, toneColor, type DoodleKind, type Tone, type Show } from './paths';
interface Props {
  text: string;
  tone?: Tone;
  size?: 'md' | 'lg';
  rotate?: number;
  arrow?: DoodleKind | null;
  arrowAt?: 'start' | 'end' | 'above' | 'below';
  arrowAngle?: number;
  flip?: boolean;
  place?: string;
  anchor?: 'abs' | 'inline' | 'block';
  show?: Show;
  delay?: number;
  trigger?: string;
  order?: number;
  seed?: number;
  decorative?: boolean;
  class?: string;
}
const {
  text, tone = 'auto', size = 'md', arrow = 'arrow-curve', arrowAt = 'end', arrowAngle = 0, flip = false,
  place = '', anchor = 'abs', show = 'md', delay = 0, trigger, order = 0, seed, decorative = true, class: cls,
} = Astro.props;
const rot = Math.max(-12, Math.min(12, Astro.props.rotate ?? -4));
const def = arrow ? pick(arrow, seed ?? text) : null;
const scale = size === 'lg' ? 1.3 : 1;
const [vw, vh] = def ? vbSize(def.vb) : [0, 0];
const sw = (3 / scale).toFixed(2);
const Tag = decorative ? 'span' : 'p';
const style = `--rot:${rot}deg;--note-c:${toneColor(tone)};--arrow-rot:${arrowAngle}deg;${place}`;
---
<Tag
  class:list={['note', `note--${size}`, `note--show-${show}`, `note--${anchor}`, `note--at-${arrowAt}`, { 'note--flip': flip }, cls]}
  data-note
  data-note-delay={delay || undefined}
  data-note-order={order || undefined}
  data-note-trigger={trigger}
  aria-hidden={decorative ? 'true' : undefined}
  style={style}
>
  <span class:list={['note__text', 't-note', { 't-note--lg': size === 'lg' }]}>{text}</span>
  {def && (
    <svg class="note__arrow" width={Math.round(vw * scale)} height={Math.round(vh * scale)} viewBox={def.vb} fill="none" aria-hidden="true" focusable="false" stroke-width={sw}>
      {def.d?.map((d) => <path data-note-draw pathLength="1" d={d} />)}
      {def.head?.map((d) => <path data-note-draw data-note-head pathLength="1" d={d} />)}
    </svg>
  )}
</Tag>
