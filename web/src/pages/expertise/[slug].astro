---
/**
 * /expertise/[slug] (v4 Delft): one template, six pages; slugs kept from v3 (see research/v4/requests-pages-a.md).
 * Grounds (no two identical neighbours without a hairline):
 *  1 PillarHero (photo + navy gradient): crumbs, "Expertise · 0n", H1 = the service name, lead = its headline.
 *  2 The challenge we solve (white rail): the intro, a Bodoni opening (≥ 24px) then Manrope.
 *  3 What we help with (Porcelain): numbered list on thin rules beside the detail photo.
 *  4 Exhibit (Delft Ice), process and strategy only.
 *  5 Typical deliverables (white rail; hairline when it follows white).
 *  6 From our founder’s career (navy): the matching result in an 84px Bodoni figure (C-8: staging only when none).
 *  7 Related insights (white rail) and related industries (photo tiles), each omitted when empty.
 *  8 Previous / next service, then BaseLayout's CtaBand.
 * Acronyms: first use per page gets <abbr title>; FSQR / 3-MCPD expansions print as a small note.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHero from '@/components/expertise/PillarHero.astro';
import Confirm from '@/components/ui/Confirm.astro';
import RailSection from '@/components/expertise/RailSection.astro';
import PillarHelp from '@/components/expertise/PillarHelp.astro';
import PillarExhibit from '@/components/expertise/PillarExhibit.astro';
import PillarProof from '@/components/expertise/PillarProof.astro';
import PillarInsights from '@/components/expertise/PillarInsights.astro';
import PillarIndustries from '@/components/expertise/PillarIndustries.astro';
import PillarPager from '@/components/expertise/PillarPager.astro';
import { createAbbreviator } from '@/components/expertise/abbr';
import { expertiseOverview, pillarHelpConfirm, pillarPage, pillarPhoto, pillars } from '@/data/pillars';
import { photos } from '@/data/photos';
import { founderResults } from '@/data/impact';
import { industries } from '@/data/industries';
import { byPillar, comingSoonByPillar } from '@/lib/insights';
import { pillarHref, pillarNumber } from '@/lib/pillars';
import { pageSeo } from '@/lib/seo';
import { showConfirm } from '@/lib/mode';
import type { Pillar, PillarKey } from '@/data/types';

export const getStaticPaths = (() => pillars.map((p) => ({ params: { slug: p.slug }, props: { pillar: p } }))) satisfies GetStaticPaths;

interface Props { pillar: Pillar }
const { pillar } = Astro.props;

const crumbs = [
  { label: expertiseOverview.overline, href: '/expertise' },
  { label: pillar.name, href: pillarHref(pillar.key) },
];
const hero = pillarPhoto[pillar.key];
const photo = photos[hero.slug];

/* 2 · the intro as two paragraphs: the first sentence (Bodoni opening), then the rest. */
const sentences = pillar.intro.split(/(?<=[.?!])\s+(?=[A-Z0-9“‘])/);
const paras = sentences.length > 1 ? [sentences[0], sentences.slice(1).join(' ')] : sentences;
const expand = createAbbreviator();
const introParts = paras.map((t) => expand(t));
const introNotes = introParts.flatMap((x) => x.notes);
const helpNotes = pillar.helpWith.flatMap((t) => expand(t).notes);
const helpConfirm = showConfirm ? pillarHelpConfirm[pillar.key] : undefined;

/*
 * 4 · exhibits only where the chain is a true sequence AND adds something the page does not already say:
 *  process  — the refining chain (contract §4), nowhere else on the page;
 *  strategy — the Go/No-Go gate (idea → three questions → decision).
 * Skipped: quality (layers, not a sequence), deals (a contrast, not a chain), innovation (its title repeats the H1 and
 * its steps repeat the deliverables), capability (three verbs already in the intro).
 */
const EXHIBIT: PillarKey[] = ['process', 'strategy'];
const hasExhibit = EXHIBIT.includes(pillar.key);

/* 5 · deliverables are stored as a sentence continuation ("Innovation roadmaps, technical briefs, …"): capitalise. */
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

/* 6–7 */
const result = pillar.impactId ? founderResults.find((r) => r.id === pillar.impactId) : undefined;
const hasProof = !!result || showConfirm;   // no result: staging shows the band with a Confirm (C-8); elsewhere omitted
const related = await byPillar(pillar.key);
const coming = await comingSoonByPillar(pillar.key);
const hasInsights = related.length > 0 || coming.length > 0;
const relatedIndustries = industries.filter((i) => i.pillars.includes(pillar.key));

/* grounds: white · Porcelain · (Ice) · white · (navy) · white …; a hairline where two whites touch. */
const beforeInsights = hasProof ? 'navy' : 'white';
const insightsRule = beforeInsights === 'white';
const industriesRule = hasInsights || beforeInsights === 'white';
const pagerFlush = hasInsights || relatedIndustries.length > 0 || beforeInsights === 'white';
---
<BaseLayout page="pillar" pillar={pillar.key} seo={pageSeo(pillar.slug)} breadcrumbs={crumbs}>
  <PillarHero
    image={photo.src} imageAlt={photo.alt} imagePosition={hero.position ?? photo.position}
    crumbs={crumbs} crumbsCurrentShort={pillar.shortLabel} eyebrow={`${expertiseOverview.overline} · ${pillarNumber(pillar)}`}
    title={pillar.name} lead={pillar.headline} titleId="pillar-title"
  />

  <RailSection id="challenge-title" title={pillarPage.challenge}>
    <div class="challenge">
      {introParts.map((x, i) => <p class:list={['challenge__p', i === 0 && 'challenge__p--lede']} set:html={x.html} />)}
      {introNotes.length > 0 && <p class="note">{introNotes.join(' · ')}</p>}
    </div>
  </RailSection>

  <PillarHelp id="help-title" title={pillarPage.helpWith} items={pillar.helpWith} photo={hero.detail} position={hero.detailPosition}>
    {(helpNotes.length > 0 || helpConfirm) && (
      <p class="note">{helpNotes.join(' · ')}{helpConfirm && <Confirm id={helpConfirm.id} note={helpConfirm.note} />}</p>
    )}
  </PillarHelp>

  {hasExhibit && <PillarExhibit pillar={pillar.key} />}

  <RailSection id="deliverables-title" title={pillarPage.deliverables}>
    <ul class="deliv" role="list">
      {pillar.deliverables.map((d) => <li>{cap(d)}</li>)}
    </ul>
  </RailSection>

  {hasProof && <PillarProof result={result} />}

  {hasInsights && <PillarInsights visible={related} coming={coming} rule={insightsRule} />}

  {relatedIndustries.length > 0 && <PillarIndustries items={relatedIndustries} rule={industriesRule} />}

  <PillarPager pillar={pillar.key} flush={pagerFlush} />
</BaseLayout>
<style>
  /* 2 · first paragraph as a Bodoni opening (24 → 36px), the rest in Manrope lead type */
  .challenge { max-width: 60rem; }
  .challenge__p { font-size: 1.0625rem; line-height: 1.65; color: var(--fg-2); text-wrap: pretty; max-width: 60ch; }
  .challenge__p + .challenge__p { margin-top: var(--s-5); }
  .challenge__p--lede {
    font-family: var(--font-serif); font-size: clamp(1.5rem, 1.25rem + .9vw, 2.25rem);
    line-height: 1.3; font-weight: 400; color: var(--head); max-width: 34ch; text-wrap: pretty;
  }
  .challenge :global(abbr[title]) { text-decoration: underline dotted; text-underline-offset: 3px; cursor: help; }

  .note { margin-top: var(--s-5); font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }

  /* 5 · deliverables: Bodoni 24px items on thin rules, numbered; two columns from 600px */
  .deliv { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--s-7); counter-reset: d; }
  .deliv li {
    counter-increment: d; display: grid; gap: 6px; padding-block: 20px 24px; border-top: 1px solid var(--rule);
    font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.25; font-weight: 400; color: var(--head); text-wrap: pretty;
  }
  .deliv li::before {
    content: counter(d, decimal-leading-zero); font-family: var(--font-sans); font-size: .875rem; line-height: 1; font-weight: 700;
    color: var(--label); font-variant-numeric: tabular-nums;
  }
  @media (min-width: 600px) { .deliv { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .challenge { padding-top: 6px; } }
</style>
