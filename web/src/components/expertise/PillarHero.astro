---
/**
 * Pillar hero (v3.1, REDESIGN-V3 §9.1–9.2), page-local variant of PageHero for /expertise/[slug]. Holds the page's H1.
 * Why a variant: PageHero `md` background crops a photo to the viewport's aspect (≈ 2.6:1 at 1920 × 1080) and lays the
 * headline over its lower-left — oils-01, chocolate-01 or plant-01 lose their subject there. Here the photo fills the
 * right ≈ 2/3 of the band at full height (box ≈ 1.2–1.5:1 from 1024 to 1920, so a 3:2 photo keeps ≥ 80 % of its width
 * and all of its height at 1440–1920) and fades into navy under the text, which sits bottom-left on the 12-column grid:
 * the same anchor, gradient and type scale as the other inner heroes.
 *  Crumbs top-left · eyebrow "Expertise · 0n" · H1 (--fs-h1, word-split rise on load: data-reveal="lines") · muted lead.
 *  min-height clamp(600px, 80svh, 960px). The photo is the LCP image (priority).
 * Mobile (< 900px): the photo is a full-width 3:2 band at the top (nothing cut at phone widths) fading into navy, the
 * crumbs sit on navy above it, and the text follows on solid navy.
 */
import type { ImageMetadata } from 'astro';
import type { Crumb } from '@/components/seo/schema';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Photo from '@/components/ui/Photo.astro';
import SplitText from '@/components/ui/SplitText.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs: Crumb[];
  crumbsCurrentShort?: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  titleId?: string;
}
const { title, eyebrow, lead, crumbs, crumbsCurrentShort, image, imageAlt, imagePosition, titleId = 'page-title' } = Astro.props;
---
<section class="ph band band--navy" aria-labelledby={titleId}>
  <div class="ph__media">
    <Photo src={image} alt={imageAlt} fill priority position={imagePosition}
      sizes="(min-width: 1200px) 66vw, (min-width: 900px) 70vw, 100vw" />
    <div class="ph__scrim" aria-hidden="true"></div>
  </div>
  <div class="container ph__crumbs"><Breadcrumbs items={crumbs} currentShort={crumbsCurrentShort} /></div>
  <div class="container ph__inner">
    <div class="ph__text">
      {eyebrow && <Eyebrow class="ph__eyebrow">{eyebrow}</Eyebrow>}
      <h1 id={titleId} class="ph__title t-h1" data-reveal="lines"><SplitText text={title} /></h1>
      {lead && <p class="ph__lead t-lead" data-hero-after>{lead}</p>}
    </div>
  </div>
</section>
<style>
  .ph { position: relative; isolation: isolate; overflow: clip; padding-block: 0; display: flex; flex-direction: column; }

  /* mobile: a 3:2 photo band at the top, fading into navy; the crumbs ride over its top edge */
  .ph__media { position: relative; order: -1; aspect-ratio: 3 / 2; max-height: 62svh; width: 100%; }
  .ph__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(11, 27, 51, 0) 0%, rgba(11, 27, 51, 0) 62%, var(--navy-900) 100%);
  }
  /* crumbs sit on solid navy above the photo band (as in PageHero), never over a busy light photo */
  .ph__crumbs { position: relative; z-index: 2; order: -2; padding-block: var(--s-4); }
  .ph__inner { position: relative; z-index: 1; padding-block: var(--s-5) clamp(4rem, 2.6rem + 5.7vw, 7.5rem); }
  .ph__eyebrow { margin-bottom: var(--s-5); }
  .ph__title { color: var(--head); max-width: 16ch; }
  .ph__lead { margin-top: var(--s-6); color: var(--fg-2); max-width: var(--measure-lead); }

  @media (min-width: 900px) {
    .ph { min-height: clamp(600px, 80svh, 960px); }
    .ph__media { position: absolute; order: 0; inset: 0 0 0 30%; aspect-ratio: auto; max-height: none; width: auto; z-index: 0; }
    /* the photo dissolves into the navy under the text (left), with a soft floor so the band's edge stays quiet */
    .ph__scrim {
      background:
        linear-gradient(90deg, var(--navy-900) 0%, rgba(11, 27, 51, .82) 16%, rgba(11, 27, 51, .35) 38%, rgba(11, 27, 51, 0) 60%),
        linear-gradient(0deg, rgba(11, 27, 51, .55) 0%, rgba(11, 27, 51, 0) 34%),
        linear-gradient(180deg, rgba(11, 27, 51, .35) 0%, rgba(11, 27, 51, 0) 22%);
    }
    .ph__crumbs { order: 0; padding-block: var(--s-4) 0; }
    .ph__inner { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-block: var(--s-8) clamp(4rem, 2.6rem + 4vw, 7.5rem); }
    .ph__text { max-width: min(46rem, 52%); }
  }
  @media (min-width: 1200px) {
    .ph__media { left: 34%; }
    .ph__text { max-width: min(52rem, 46%); }
  }
</style>
