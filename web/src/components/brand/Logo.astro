---
/**
 * KoKreaters logo, vector (pack 2, brief items 5 and 11). The SVGs are Ganeaysh's 20 Nov 2026 brand files
 * (research/pack2/brand → src/assets/brand/svg/ via scripts/prepare-brand.mjs): the "K" mark with one saffron node and
 * the Bodoni Moda wordmark, text converted to outlines. The artwork is never recoloured, stretched or re-set: only the
 * whole logo is scaled uniformly. Every variant loads as a cached <img> (crisp at any DPR); `inline` renders inline SVG.
 *
 * Variants
 *  - navy: mark + wordmark, no tagline (kokreaters-logo-navy-no-tagline.svg). Website header on a light ground.
 *  - navy-tagline: with "Connect · Collaborate · Create" (kokreaters-logo-navy.svg). Documents, about page.
 *  - white: white mark + wordmark + tagline (kokreaters-logo-white.svg). Footer and any navy ground.
 *  - mark: the K mark alone (kokreaters-mark.svg; `size`, default 64).
 *  Old v3 names are kept as aliases so every caller compiles and shows the new logo:
 *  horizontal / wordmark → navy, full → navy-tagline, full-white / full-reversed / horizontal-white / wordmark-white →
 *  white, cluster → mark.
 * Size: `height` (px, sets --logo-h; the CSS can override --logo-h per breakpoint) or `width` (any CSS length).
 * Accessible name (brief item 5): the image always has alt="KoKreaters" (or `alt`); inside a link (`href`) the link
 * also carries aria-label=`label` (default "KoKreaters home").
 * Mobile: scales with `height` / `width`; never wider than its container.
 */
import navyRaw from '@/assets/brand/svg/kokreaters-logo-navy-no-tagline.svg?raw';
import navyUrl from '@/assets/brand/svg/kokreaters-logo-navy-no-tagline.svg?url';
import navyTagRaw from '@/assets/brand/svg/kokreaters-logo-navy.svg?raw';
import navyTagUrl from '@/assets/brand/svg/kokreaters-logo-navy.svg?url';
import whiteRaw from '@/assets/brand/svg/kokreaters-logo-white.svg?raw';
import whiteUrl from '@/assets/brand/svg/kokreaters-logo-white.svg?url';
import markRaw from '@/assets/brand/svg/kokreaters-mark.svg?raw';
import markUrl from '@/assets/brand/svg/kokreaters-mark.svg?url';

type Base = 'navy' | 'navy-tagline' | 'white' | 'mark';
export type LogoVariant = Base
  | 'horizontal' | 'horizontal-white' | 'full' | 'full-white' | 'full-reversed' | 'wordmark' | 'wordmark-white' | 'cluster';
interface Props {
  variant?: LogoVariant;
  href?: string | null;
  label?: string;
  alt?: string;
  height?: number;
  width?: number | string;
  size?: number;
  inline?: boolean;
  loading?: 'lazy' | 'eager';
  class?: string;
  id?: string;
}
const ALIAS: Record<LogoVariant, Base> = {
  navy: 'navy', 'navy-tagline': 'navy-tagline', white: 'white', mark: 'mark',
  horizontal: 'navy', wordmark: 'navy', full: 'navy-tagline',
  'full-white': 'white', 'full-reversed': 'white', 'horizontal-white': 'white', 'wordmark-white': 'white', cluster: 'mark',
};
const { label = 'KoKreaters home', class: cls, id, inline = false } = Astro.props;
const variant = ALIAS[Astro.props.variant ?? 'navy'];
const href = Astro.props.href ?? null;
const Tag = href ? 'a' : 'span';
const loading = Astro.props.loading ?? 'lazy';

const files: Record<Base, readonly [string, string]> = {
  navy: [navyRaw, navyUrl], 'navy-tagline': [navyTagRaw, navyTagUrl], white: [whiteRaw, whiteUrl], mark: [markRaw, markUrl],
};
const [raw, url] = files[variant];

/** Inner markup of an SVG file (no comment, title, ids or outer <svg>). */
const inner = (s: string) => s.replace(/<!--[\s\S]*?-->/g, '').replace(/<title>[\s\S]*?<\/title>/g, '').replace(/\s+id="[^"]*"/g, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
const viewBox = (raw.match(/viewBox="([^"]+)"/) ?? [])[1] ?? '0 0 100 100';
const [, , vbW, vbH] = viewBox.split(/\s+/).map(Number);
const ratio = vbW / vbH;

const byHeight = Astro.props.width === undefined && (Astro.props.height !== undefined || variant !== 'mark');
const height = Astro.props.height ?? (variant === 'mark' ? (Astro.props.size ?? 64) : 44);
const w = Astro.props.width ?? (variant === 'mark' ? (Astro.props.size ?? 64) : '100%');
const cssW = typeof w === 'number' ? `${w}px` : w;
const pxW = typeof w === 'number' ? w : 600;
const imgW = byHeight ? Math.round(height * ratio) : pxW;
const imgH = byHeight ? height : Math.round(pxW / ratio);

const name = Astro.props.alt ?? 'KoKreaters';
---
<Tag
  href={href ?? undefined} id={id}
  class:list={['logo', `logo--${variant}`, byHeight ? 'logo--h' : 'logo--w', cls]}
  aria-label={href ? label : undefined}
  style={byHeight ? `--logo-h:${height}px;--logo-ratio:${ratio}` : `--logo-w:${cssW};--logo-ratio:${ratio}`}
>
  {inline ? (
    <svg class="logo__img" viewBox={viewBox} focusable="false" role="img" aria-label={name} set:html={inner(raw)} />
  ) : (
    <img class="logo__img" src={url} alt={name} width={imgW} height={imgH} loading={loading} decoding="async" />
  )}
</Tag>
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; color: inherit; line-height: 0; flex: none; }
  .logo__img { display: block; overflow: visible; max-width: none; }
  .logo--h { height: var(--logo-h); }
  .logo--h .logo__img { height: 100%; width: auto; aspect-ratio: var(--logo-ratio); }
  .logo--w { width: var(--logo-w); max-width: 100%; }
  .logo--w .logo__img { width: 100%; height: auto; aspect-ratio: var(--logo-ratio); }
</style>
