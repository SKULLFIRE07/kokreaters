---
/** Announcement bar (DESIGN-SPEC v2 7.1): first element in <body> after the SkipLink, not sticky. Thin Ink band,
 * mono 13px: the newsletter words + a link to the insights; right (≥ 768) the base line and the Pause motion control. */
import MotionToggle from './MotionToggle.astro';
import { chromeNotes } from '@/data/notes/chrome';
import { hero } from '@/data/home';
---
<div class="ann g-ink" role="region" aria-label="Announcement">
  <div class="ann__inner container">
    <p class="ann__lead">
      <span class="ann__dot" aria-hidden="true"></span>
      <span class="ann__text">{chromeNotes.ann.lead}</span>
      <a class="ann__link" href="/insights">{chromeNotes.ann.link}</a>
    </p>
    <div class="ann__right">
      <span class="ann__base">{hero.footLeft}</span>
      <MotionToggle />
    </div>
  </div>
</div>
<style>
  .ann { position: relative; z-index: 51; min-height: var(--ann-h); font: 400 13px/1.35 var(--font-mono); letter-spacing: .01em; }
  .ann__inner { min-height: var(--ann-h); display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: 4px; }
  .ann__lead { margin: 0; display: flex; align-items: center; flex-wrap: wrap; gap: 2px 10px; color: var(--fg); }
  .ann__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--kk-saffron); box-shadow: 0 0 0 2px var(--kk-ink), 0 0 0 3px var(--kk-saffron); flex: none; }
  .ann__link { color: var(--kk-saffron); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: .22em; display: inline-flex; align-items: center; min-height: 24px; }
  .ann__link:hover { color: var(--kk-white); }
  .ann__right { display: flex; align-items: center; gap: var(--s-5); flex: none; color: var(--fg-2); }
  .ann__base { display: none; }
  @media (min-width: 1024px) { .ann__base { display: inline; } }
  @media (max-width: 767px) {
    .ann { font-size: 12px; }
    .ann__lead { display: block; }
    .ann__link { margin-left: 6px; }
    .ann__dot { display: none; }
    .ann__link { display: inline; }
  }
</style>
