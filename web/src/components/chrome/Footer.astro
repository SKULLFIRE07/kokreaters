---
/**
 * Footer (v4 developer guide, home section 13). Near-black Footer ink (#0A0F1C) band: the only place near-black appears.
 *  Top (≥ 1120px, four columns): the full KoKreaters logo on a white plate + one-line statement · Expertise (the six
 *  services) · Company · Contact (email, WhatsApp, "Based in the Netherlands", LinkedIn).
 *  Optional newsletter form (`newsletter`, default off in v4: the design has none) under the columns.
 *  Bottom: hairline, "© 2026 KoKreaters. All rights reserved." (+ KvK when site.legal.registration exists; Confirm 11
 *  in staging only) · Privacy · Cookies · Terms (+ Cookie settings when analytics is on).
 * Mobile: logo and statement first; below 600px Expertise and Company fold into hairline accordion rows (plus → minus;
 * site.ts [data-ft-group]); Contact and the legal row stay open. Without JS every group renders open (the footer is the
 * no-JS menu). `id="site-footer" tabindex="-1"` is the no-JS target of the header's Menu link.
 */
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import Container from '@/components/ui/Container.astro';
import Confirm from '@/components/ui/Confirm.astro';
import NewsletterForm from '@/components/ui/NewsletterForm.astro';
import { footer, legal } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';

interface Props { newsletter?: boolean }
const { newsletter = false } = Astro.props;
const c = footer.contact;
const groups = [
  { key: 'expertise', id: 'ft-expertise', heading: footer.expertise.heading, links: footer.expertise.links },
  { key: 'company', id: 'ft-company', heading: footer.company.heading, links: footer.company.links },
] as const;
---
<footer id="site-footer" class="site-footer band--navy" tabindex="-1">
  <Container>
    <div class="ft-cols">
      <div class="ft-brand">
        <span class="ft-plate"><Logo variant="full" href="/" label={footer.homeLabel} height={40} class="ft-logo" /></span>
        <p class="ft-statement">{footer.statement}</p>
      </div>
      {groups.map((g) => (
        <nav class="ft-col ft-col--group" aria-labelledby={g.id} data-ft-col>
          <div class="ft-headrow">
            <h2 id={g.id} class="ft-head">{g.heading}</h2>
            <button type="button" class="ft-head__btn" aria-expanded="false" aria-controls={`${g.id}-panel`} aria-labelledby={g.id} data-ft-group>
              <svg class="ft-head__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M2 8h12" /><path class="ft-head__v" d="M8 2v12" />
              </svg>
            </button>
          </div>
          <div id={`${g.id}-panel`} class="ft-panel"><div class="ft-panel__in">
            <ul class="ft-list" role="list">
              {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div></div>
        </nav>
      ))}
      <div class="ft-col ft-col--contact">
        <h2 class="ft-head">{c.heading}</h2>
        <ul class="ft-list" role="list">
          <li><a href={c.email.href}>{c.email.label}</a></li>
          <li><a href={c.whatsapp.href} rel="noopener">{c.whatsapp.label}</a></li>
          <li class="ft-base">{c.base}</li>
          <li>
            <a class="ft-social" href={c.linkedin.href} rel="me noopener">
              <Icon name="linkedin" size={18} /><span>{c.linkedin.label}</span><span class="visually-hidden"> ({microcopy.opensLinkedIn})</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {newsletter && (
      <div class="ft-news">
        <NewsletterForm id="nl-footer" tone="dark" heading={footer.newsletter.heading} />
      </div>
    )}

    <div class="ft-bottom">
      <p class="ft-copy">
        <span>{footer.copyright}</span>
        {site.legal.registration
          ? <span class="ft-reg">{site.legal.registration}</span>
          : <Confirm id={11} note={footer.registrationNote} />}
      </p>
      <p class="ft-legal">
        {legal.map((l) => <a href={l.href}>{l.label}</a>)}
        {site.analytics && (
          <button type="button" class="ft-settings" data-cookie-settings aria-haspopup="dialog" aria-controls="cookie-settings">{microcopy.cookieSettings}</button>
        )}
      </p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    --bg: var(--footer-ink); --fg: #FFFFFF; --fg-2: #B9C3D8; --rule: #222B3F; --link: #FFFFFF;
    position: relative;
    padding-block: clamp(3.5rem, 3rem + 2vw, 4.5rem) var(--s-6);
    background: var(--bg); color: var(--fg-2);
    view-transition-name: site-footer;
  }
  .site-footer:focus { outline: none; }

  .ft-cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7) var(--s-7); padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  @media (min-width: 600px) { .ft-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ft-brand { grid-column: 1 / -1; } }
  @media (min-width: 1120px) {
    .ft-cols { grid-template-columns: 1.15fr 1fr 1fr 1fr; column-gap: 40px; }
    .ft-brand { grid-column: auto; }
  }

  .ft-brand { display: grid; gap: 18px; justify-items: start; align-content: start; }
  .ft-plate { display: inline-flex; padding: 10px 14px; background: var(--white); }
  .ft-plate :global(.ft-logo) { box-sizing: content-box; padding-block: 2px; margin-block: -2px; }
  .ft-statement { margin: 0; max-width: 32ch; font: 400 .875rem/1.6 var(--font-sans); color: var(--fg-2); }

  .ft-head { margin: 0 0 14px; font: 700 .875rem/1.3 var(--font-sans); letter-spacing: 0; color: var(--white); }
  .ft-list { margin: 0; padding: 0; list-style: none; display: grid; }
  .ft-list a, .ft-base, .ft-settings {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 44px; padding-block: var(--s-2);
    font: 400 .875rem/1.4 var(--font-sans);
    color: var(--fg-2); text-decoration: none;
  }
  .ft-list a { transition: color var(--d-1) var(--ease-out); }
  .ft-list a:hover, .ft-legal a:hover { color: var(--white); text-decoration: underline; text-decoration-color: currentColor; text-underline-offset: .25em; }
  @media (min-width: 1120px) { .ft-list a, .ft-base { min-height: 32px; padding-block: 5px; } }

  /* phone accordion (< 600px, once site.ts has booted) */
  .ft-headrow { position: relative; }
  .ft-head__btn { display: none; }
  @media (max-width: 599px) {
    :global(html.chrome-ready) .ft-cols { row-gap: 0; }
    :global(html.chrome-ready) .ft-brand { padding-bottom: var(--s-6); }
    :global(html.chrome-ready) .ft-col--group { border-top: 1px solid var(--rule); }
    :global(html.chrome-ready) .ft-col--group + .ft-col--contact { border-top: 1px solid var(--rule); padding-top: var(--s-6); }
    :global(html.chrome-ready) .ft-headrow { display: flex; align-items: center; min-height: 56px; padding-right: 40px; }
    :global(html.chrome-ready) .ft-col--group .ft-head { margin: 0; }
    :global(html.chrome-ready) .ft-head__btn {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end;
      margin: 0; padding: 0; border: 0; background: none; cursor: pointer; color: inherit;
    }
    :global(html.chrome-ready) .ft-head__btn:focus-visible { outline-offset: -2px; }
    .ft-head__icon { flex: none; fill: none; stroke: var(--saffron); stroke-width: 1.5; stroke-linecap: round; }
    .ft-head__v { transform-origin: 8px 8px; transition: transform var(--d-2) var(--ease-out); }
    .ft-head__btn[aria-expanded="true"] .ft-head__v { transform: rotate(90deg); }
    :global(html.chrome-ready) .ft-panel {
      display: grid; grid-template-rows: 0fr; visibility: hidden;
      transition: grid-template-rows var(--d-3) var(--ease-out), visibility 0s linear var(--d-3);
    }
    :global(html.chrome-ready) .ft-col--group.is-open .ft-panel {
      grid-template-rows: 1fr; visibility: visible;
      transition: grid-template-rows var(--d-3) var(--ease-out), visibility 0s;
    }
    :global(html.chrome-ready) .ft-panel__in { min-height: 0; overflow: hidden; }
    :global(html.chrome-ready) .ft-panel .ft-list { padding-bottom: var(--s-4); }
  }

  .ft-news { padding-block: var(--s-6); border-top: 1px solid var(--rule); max-width: 640px; }

  .ft-bottom {
    display: flex; flex-direction: column; gap: var(--s-2);
    padding-top: var(--s-5); border-top: 1px solid var(--rule);
    font: 400 .8125rem/1.45 var(--font-sans); color: #8591AB;
  }
  @media (min-width: 900px) { .ft-bottom { flex-direction: row; justify-content: space-between; align-items: center; } }
  .ft-legal, .ft-copy { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-5); min-height: 44px; }
  .ft-legal a, .ft-settings {
    display: inline-flex; align-items: center; min-height: 44px;
    color: #8591AB; text-decoration: none; font: inherit;
    background: none; border: 0; padding: 0; cursor: pointer;
  }
  .ft-settings:hover { color: var(--white); }
  .ft-reg::before { content: "·"; content: "·" / ""; margin-right: var(--s-3); }
</style>
