---
/** The six pillars as index rows (5.0.8). Not a card grid. */
import { pillars } from '@/data/pillars';
import PillarDot from '../ui/PillarDot.astro';
import Arrow from '../ui/Arrow.astro';
import { pad2 } from '@/lib/format';
interface Props { size?: 'home' | 'overview'; showHelp?: boolean; class?: string; }
const { size = 'home', showHelp = false, class: cls } = Astro.props;
---
<ol class:list={['x-index', `x-index--${size}`, cls]} data-reveal-group>
  {pillars.map((p) => (
    <li class="x-item" style={`--pc:var(--pillar-${p.key})`} data-pillar={p.key} data-ink={p.inkText ? '' : undefined}>
      <span class="x-rule" data-rule aria-hidden="true"></span>
      <a class="x-row" href={`/expertise/${p.slug}`}>
        <span class="x-num t-meta tnum">{pad2(p.n)}</span>
        <span class="x-dot"><PillarDot pillar={p.key} size={10} /></span>
        <span class="x-text">
          <span class="x-num-sm t-dateline tnum" aria-hidden="true">{pad2(p.n)}</span>
          <span class:list={['x-name', size === 'overview' ? 't-h1' : 't-index']}>{p.name}</span>
          <span class="x-promise t-lead">{p.promise}</span>
          {showHelp && <span class="x-help t-meta">{p.helpWith.slice(0, 2).join(' · ')}</span>}
        </span>
        <span class="x-arrow"><Arrow size={24} /></span>
      </a>
    </li>
  ))}
  <li class="x-end" aria-hidden="true"><span class="x-rule" data-rule></span></li>
</ol>
<style>
  .x-index { list-style: none; margin: 0; padding: 0; }
  .x-item { position: relative; }
  .x-rule { display: block; height: 1px; background: var(--c-rule); }
  .x-item::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; z-index: 1;
    background: var(--pc); transform: scaleX(0); transform-origin: 0 50%;
    transition: transform 240ms var(--ease-out);
  }
  .x-item:has(.x-row:is(:hover, :focus-visible))::before { transform: scaleX(1); }
  .x-row {
    display: grid; grid-template-columns: 56px 24px minmax(0, 1fr) 48px; align-items: start; column-gap: var(--s-3);
    min-height: 96px; padding-block: 28px; color: inherit; text-decoration: none;
  }
  .x-index--overview .x-row { padding-block: 40px; }
  .x-num { padding-top: 0.6em; }
  .x-dot { padding-top: 0.95em; line-height: 0; }
  .x-index--overview .x-dot { padding-top: 1.35em; }
  .x-text { display: flex; flex-direction: column; gap: var(--s-2); }
  .x-num-sm { display: none; }
  .x-name { transition: color var(--d-colour) var(--ease-out); }
  .x-promise { color: var(--c-meta); }
  .x-help { color: var(--c-meta); max-width: 60ch; }
  .x-arrow { color: var(--c-link); justify-self: end; padding-top: 0.5em; }
  .x-arrow :global(svg) { transition: transform 240ms var(--ease-out); }
  .x-row:is(:hover, :focus-visible) .x-arrow :global(svg) { transform: translateX(8px); }
  .x-row:is(:hover, :focus-visible) .x-name { color: var(--c-link); }
  .x-item[data-ink] .x-row:is(:hover, :focus-visible) .x-name { color: var(--c-heading); }
  .x-row:is(:hover, :focus-visible) :global(.pillar-dot) { box-shadow: 0 0 0 2px var(--kk-white), 0 0 0 3px var(--pc); }
  .x-item[data-ink] .x-row:is(:hover, :focus-visible) :global(.pillar-dot) { box-shadow: 0 0 0 2px var(--kk-white), 0 0 0 3px var(--kk-ink), 0 0 0 4px var(--pc); }
  .x-end { list-style: none; }
  @media (max-width: 767px) {
    .x-row { grid-template-columns: 24px minmax(0, 1fr) 32px; }
    .x-num { display: none; }
    .x-num-sm { display: block; }
    .x-dot { padding-top: 2.1em; }
    .x-index--overview .x-dot { padding-top: 2.4em; }
    .x-arrow { padding-top: 1.9em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .x-item::before, .x-arrow :global(svg), .x-name { transition: none; }
  }
</style>
