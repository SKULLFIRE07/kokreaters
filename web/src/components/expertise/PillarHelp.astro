---
/**
 * "What we help with" (v4 Delft), on Porcelain. Label + Bodoni h2, then the help items as a numbered list on thin
 * #D9E0EC rules (number 14px 700 Deep Delft, text Manrope 17–18px navy: Bodoni only from 24px), beside the service's
 * detail photo, square, in its natural orientation (portrait 4:5, landscape 3:2), with data-gsap="parallax".
 * ≥ 900px: list in columns 1–6, photo in 8–12 (portrait) or 7–12 (landscape). Slot: notes under the list.
 * Mobile: heading, list, then the photo.
 */
import Section from '@/components/ui/Section.astro';
import Photo from '@/components/ui/Photo.astro';
import Head from './Head.astro';
import { photos, type PhotoSlug } from '@/data/photos';
import { pad2 } from '@/lib/format';

interface Props {
  id: string;
  title: string;
  label?: string;
  items: string[];
  photo: PhotoSlug;
  position?: string;
  ground?: 'white' | 'grey';
  rule?: boolean;
}
const { id, title, label, items, photo, position, ground = 'grey', rule = false } = Astro.props;
const rec = photos[photo];
const portrait = rec.orientation === 'portrait';
---
<Section ground={ground} rule={rule} labelledby={id}>
  <div class:list={['help', portrait ? 'help--portrait' : 'help--landscape']}>
    <div class="help__main">
      <Head id={id} title={title} label={label} class="help__head" />
      <ol class="help__list" role="list">
        {items.map((t, i) => (
          <li class="help__item">
            <span class="help__n" aria-hidden="true">{pad2(i + 1)}</span>
            <span class="help__text">{t}</span>
          </li>
        ))}
      </ol>
      <slot />
    </div>
    <figure class="help__media">
      <Photo
        slug={photo} position={position} ratio={portrait ? '4/5' : '3/2'} data-gsap="parallax"
        sizes={portrait ? '(min-width: 1320px) 440px, (min-width: 900px) 34vw, min(440px, calc(100vw - 40px))' : '(min-width: 1320px) 560px, (min-width: 900px) 42vw, calc(100vw - 40px)'}
      />
    </figure>
  </div>
</Section>
<style>
  .help { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-8); }
  .help__list { list-style: none; margin: 0; padding: 0; }
  .help__item {
    display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: var(--s-4); align-items: baseline;
    padding-block: 20px; border-top: 1px solid var(--rule);
  }
  .help__item:last-child { border-bottom: 1px solid var(--rule); }
  .help__n { font-size: .875rem; font-weight: 700; color: var(--label); font-variant-numeric: lining-nums tabular-nums; }
  .help__text { font-size: 1.0625rem; line-height: 1.55; font-weight: 500; color: var(--head); text-wrap: pretty; max-width: 52ch; }
  .help__media { margin: 0; }
  .help--portrait .help__media { max-width: 440px; }

  @media (min-width: 900px) {
    .help { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: start; }
    .help__main { grid-column: 1 / 7; grid-row: 1; }
    .help__media { grid-row: 1; }
    .help__item { grid-template-columns: 56px minmax(0, 1fr); padding-block: 24px; }
    .help__text { font-size: 1.125rem; }
    .help--portrait .help__media {
      grid-column: 8 / -1; justify-self: end; max-width: none;
      width: min(100%, calc((100svh - var(--header-h) - 6rem) * .8));
    }
    .help--landscape .help__media { grid-column: 7 / -1; align-self: end; margin-left: var(--grid-gap); }
  }
</style>
