---
/**
 * Approach F5, ways to work with us (DESIGN-SPEC v2 10.5 F5): Ice ground; five FaqAccordion rows. Summary = the model
 * + its "Typical shape" in mono; body = a <dl> "Typical shape" / "Good for" (labels `modelColumns`). CONFIRM 10.
 */
import FaqAccordion from '@/components/bencho/FaqAccordion.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { isStaging } from '@/lib/mode';
import { models, modelsHeading, modelColumns } from '@/data/approach';
import { storyNotes } from '@/data/notes/story';
const items = models.map((m) => ({ title: m.model, preview: m.shape, rows: [{ k: modelColumns.shape, v: m.shape }, { k: modelColumns.goodFor, v: m.goodFor }] }));
---
<section class="ways g-ice has-notes" aria-labelledby="ways-title">
  <div class="container ways__grid">
    <div class="ways__head">
      <h2 id="ways-title" class="ways__h2" data-rise="lines">{modelsHeading}</h2>
      <MarginNote text={storyNotes.models.shape} tone="sapphire" rotate={-6} arrow="arrow-curve" arrowAt="below" arrowAngle={70} anchor="block" show="md" class="ways__note" />
      {isStaging && <p class="ways__confirm"><Confirm id={10} /></p>}
    </div>
    <FaqAccordion items={items} class="ways__faq" />
  </div>
</section>
<style>
  .ways { padding-block: var(--section); }
  .ways__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--s-8); align-items: start; }
  .ways__head { position: sticky; top: calc(var(--header-h) + 24px); }
  .ways__h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-stretch: 75%; letter-spacing: -.03em; line-height: .9;
    font-size: clamp(3rem, 1rem + 5.6vw, 7rem); text-wrap: balance; }
  .ways :global(.ways__note) { margin-top: var(--s-5); }
  .ways__confirm { margin: var(--s-5) 0 0; }
  @media (max-width: 1023px) {
    .ways__grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .ways__head { position: static; }
  }
</style>
