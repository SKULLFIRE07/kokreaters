---
/**
 * Floating WhatsApp button (pack 3, brief "Give visitors a reason to click": "keep the WhatsApp link, and add a
 * floating WhatsApp button only on mobile"). Phones and small tablets (< 768px) only; 56px square, bottom-right, above
 * the safe area. It appears once the visitor has scrolled past the first screen and steps aside while the closing CTA
 * band or the footer is in view (site.ts: html.wa-show / html.wa-zone), so it never covers the hero buttons, the CTA
 * button or the footer links. Not rendered on /contact (WhatsApp is listed there) or when the chat widget is on.
 */
import { site } from '@/config/site';
const label = `WhatsApp ${site.whatsapp.display}`;
---
<a class="wa-float" href={site.whatsapp.href} rel="noopener" target="_blank" aria-label={label} data-wa-float>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719" />
    <path transform="translate(6.6 6.6) scale(.45)" stroke-width="3.6" d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
  </svg>
</a>
<style>
  .wa-float {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 60;
    display: none; align-items: center; justify-content: center;
    width: 56px; height: 56px;
    background: #167A42; color: #FFFFFF;          /* WhatsApp green, darkened: 5.4:1 with the white glyph */
    box-shadow: 0 10px 24px -10px rgba(14, 31, 77, .55);
    text-decoration: none;
    opacity: 0; translate: 0 12px; pointer-events: none;
    transition: opacity var(--d-2) var(--ease-out), translate var(--d-2) var(--ease-out);
  }
  .wa-float:focus-visible { outline: 2px solid var(--navy-900); outline-offset: 3px; }
  @media (max-width: 767px) { .wa-float { display: inline-flex; } }
  :global(html.no-js) .wa-float,
  :global(html.wa-show:not(.wa-zone):not(.menu-open)) .wa-float { opacity: 1; translate: 0 0; pointer-events: auto; }
</style>
