---
/**
 * /approach §3 — Connect / Collaborate / Create (REDESIGN-V3 §4 Approach). Grey band.
 * A static ringed-node diagram (the logo's node: accent disc, white ring, accent outline; §0 signature) joined by a
 * 1px connector, with the three steps as an ordered list. Each step: node, "Step n", serif h3, the brief's copy, then
 * What we do / What you get / Typical duration. All nine values are drafted in data/approach.ts (10 Nov 2026, for
 * approval) and render in every mode. Should a value ever be null again, staging renders that row with a Confirm
 * (CONFIRM 10) and preview/production drop it (never "—"). Ids connect / collaborate / create are kept on the steps.
 * Desktop (≥ 900): three equal columns; the connector runs node to node along the top. The list is a 7-row grid
 * (node · Step n · name · copy · three rows) and each step, its body and its <dl> are row subgrids, so What we do /
 * What you get / Typical duration start on one line across the three columns whatever the length of each text.
 * Mobile (< 900): vertical — nodes on a left spine (connector runs down to the next node), text to the right,
 * 40px between steps; body copy 18px.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { steps, stepLabels, stepsHeading } from '@/data/approach';
import { showConfirm } from '@/lib/mode';

const FIELDS = ['whatWeDo', 'whatYouGet', 'duration'] as const;
/** Keep number ranges whole ("2–5 days" never breaks after the dash), as in the models table and the FAQ. */
const bind = (v: string | null) => (v === null ? null : v.replace(/(\d)–(\d)/g, '$1–\u2060$2'));
const rowsFor = (s: (typeof steps)[number]) =>
  FIELDS.filter((f) => s[f] !== null || showConfirm).map((f) => ({ label: stepLabels[f], value: bind(s[f]) }));
---
<Section ground="grey" labelledby="steps-h" class="steps">
  <SectionHeader id="steps-h" title={stepsHeading} />
  <ol class="steps__list" role="list">
    {steps.map((s, i) => {
      const slug = s.name.toLowerCase();
      const rows = rowsFor(s);
      return (
        <li id={slug} class="step" data-reveal style={`--i:${i}`}>
          <span class="step__node" aria-hidden="true"></span>
          <div class="step__body">
            <p class="step__n">{stepLabels.step} {s.n}</p>
            <h3 id={`${slug}-h`} class="t-h3 step__name">{s.name}</h3>
            <p class="step__copy">{s.copy}</p>
            {rows.length > 0 && (
              <dl class="step__rows">
                {rows.map((r) => (
                  <div class="step__row">
                    <dt>{r.label}</dt>
                    <dd>{r.value ?? <Confirm id={10} />}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</Section>
<style>
  .steps__list {
    --node: 20px; --ring: var(--white); --gap: var(--s-7);
    list-style: none; margin: 0; padding: 0; display: grid; row-gap: var(--gap);
  }
  .step { position: relative; display: grid; grid-template-columns: var(--node) minmax(0, 1fr); column-gap: var(--s-5); }
  /* ringed node: accent disc · white ring · accent outline (the logo's node, flattened; same as ProcessFlow) */
  .step__node {
    position: relative; z-index: 1; width: 14px; height: 14px; margin: 3px;
    border-radius: 50%; background: var(--accent); border: 2px solid var(--ring); box-shadow: 0 0 0 3px var(--accent);
  }
  /* connector, mobile: node centre → next node centre, down the left spine */
  .step:not(:last-child)::before {
    content: ""; position: absolute; left: calc(var(--node) / 2 - .5px); top: calc(var(--node) / 2);
    bottom: calc((var(--gap) + var(--node) / 2) * -1); width: 1px; background: var(--label);
  }
  .step__n {
    font-size: var(--fs-label); line-height: var(--node); font-weight: 600; letter-spacing: var(--tr-label);
    text-transform: uppercase; color: var(--label);
  }
  /* one step above the card h3 (the three words are the brand tagline) but clearly under the section h2:
     24 → ~29px against the h2's 30 → 42px (was 28 → 38px, which read as a second h2) */
  .step__name { margin-top: var(--s-3); font-size: clamp(1.5rem, 1.3rem + .6vw, 1.875rem); line-height: 1.2; letter-spacing: -0.01em; font-weight: 450; }
  .step__copy { margin-top: var(--s-3); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg); text-wrap: pretty; max-width: 40ch; }
  .step__rows { margin-top: var(--s-5); border-top: 1px solid var(--rule); }
  .step__row { padding-block: var(--s-3); border-bottom: 1px solid var(--rule); }
  .step__row dt { font-size: var(--fs-meta); line-height: var(--lh-meta); font-weight: 600; color: var(--fg-2); }
  .step__row dd { margin: 2px 0 0; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg); text-wrap: pretty; }

  @media (min-width: 900px) {
    .steps__list { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(7, auto); column-gap: var(--grid-gap); row-gap: 0; }
    /* row subgrids: node (1) · Step n (2) · name (3) · copy (4) · the three definition rows (5–7) */
    .step { grid-row: span 7; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .step__body { grid-row: span 6; display: grid; grid-template-rows: subgrid; row-gap: 0; padding-right: var(--s-6); }
    .step__n { margin-top: var(--s-5); }
    .step__rows { grid-row: span 3; display: grid; grid-template-rows: subgrid; row-gap: 0; }
    /* connector, desktop: node centre → next column's node centre, along the top */
    .step:not(:last-child)::before {
      left: calc(var(--node) / 2); right: calc((var(--grid-gap) + var(--node) / 2) * -1);
      top: calc(var(--node) / 2 - .5px); bottom: auto; width: auto; height: 1px;
    }
    .step__name { margin-top: var(--s-2); }
    .step__copy { margin-top: var(--s-4); }
  }
</style>
