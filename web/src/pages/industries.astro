---
/**
 * /industries (REDESIGN-V3 §4 Industries, §8.8–8.9). Grounds: grey hero → white (nine cards) → grey CtaBand
 * (BaseLayout) → navy footer.
 *  1. PageHero grey: crumbs, eyebrow "Industries", H1 "Where we work", and the one-paragraph intro
 *     (`industriesPage.lead`, drafted 10 Nov 2026 for approval; C-15 closed) in every mode.
 *  2. IndustriesGrid: nine IndustryTile cards with id={slug} anchors and "Relevant expertise" links.
 * Mobile: one column; the intro at lead size; the grid is one column (IndustriesGrid).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import IndustriesGrid from '@/components/industries/IndustriesGrid.astro';
import { industriesPage } from '@/data/industries';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: industriesPage.overline, href: '/industries' }];
---
<BaseLayout page="industries" seo={pageSeo('industries')} breadcrumbs={crumbs}>
  <PageHero ground="grey" eyebrow={industriesPage.overline} title={industriesPage.headline} lead={industriesPage.lead} crumbs={crumbs} titleId="industries-title" />
  <IndustriesGrid />
</BaseLayout>
