---
/**
 * Icon for "Who he has worked alongside" (earlier item 24, pack 3): a Lucide glyph (lucide-static, ISC) inlined at
 * build time in the site's stroke style (24-unit box, stroke currentColor 1.5, round caps). Decorative: the
 * organisation type is always written beside it. Only the five glyphs used are imported, so nothing else ships.
 */
import globe from 'lucide-static/icons/globe.svg?raw';
import award from 'lucide-static/icons/award.svg?raw';
import factory from 'lucide-static/icons/factory.svg?raw';
import rocket from 'lucide-static/icons/rocket.svg?raw';
import landmark from 'lucide-static/icons/landmark.svg?raw';

interface Props { name: string; size?: number; class?: string; }
const { name, size = 32, class: cls } = Astro.props;
const raw: Record<string, string> = { globe, award, factory, rocket, landmark };
const inner = (s: string) => s.replace(/<!--[\s\S]*?-->/g, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/\s+/g, ' ').trim();
const body = inner(raw[name] ?? raw.globe);
---
<svg class:list={['sector-icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={body} />
