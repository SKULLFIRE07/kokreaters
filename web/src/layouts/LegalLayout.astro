---
/**
 * Legal pages (REDESIGN-V3 §4 Legal, §8.5). The MDX `layout:` of privacy.mdx, cookies.mdx and terms.mdx.
 * Frontmatter: title, description?, updated?, reviewed?, seoKey?. Non-MDX use passes the same as props.
 *  1 PageHero, grey, size sm (compact): crumbs (Home / <title>), eyebrow "Legal", H1 = title, lead = description,
 *    "Last updated" under a hairline.
 *  2 White band, wide grid: the MDX body as measured prose (.prose.prose--legal, 68ch), each h2 opening on a hairline
 *    with generous space above, and, when the page has more than two h2s, a numbered "On this page" contents list.
 *    The lawyer-review note and every <Confirm> render in staging only (§8.5).
 * The whole page is one <article> named by its H1. BaseLayout page="legal": no CtaBand, BreadcrumbList JSON-LD.
 * Mobile (< 600px): one column; the contents list sits above the text as full-width 44px rows with hairlines.
 * 600–1023px: the same list in two columns (read down, then across), so it takes half the height above the text.
 * ≥ 1024px: a 12-column editorial split: the contents list in columns 1–3 (aligned with the H1, sticky under the
 * header), the text from column 5 at a 68ch measure.
 */
import BaseLayout from './BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { microcopy } from '@/data/microcopy';
import type { MarkdownHeading } from 'astro';
import { pageSeo } from '@/lib/seo';
import { fill, formatDate, isoDate } from '@/lib/format';
import { showConfirm } from '@/lib/mode';
import type { SeoKey } from '@/data/seo';

interface Frontmatter { title: string; description?: string; updated?: string | Date; reviewed?: boolean; seoKey?: SeoKey }
interface Props { headings?: MarkdownHeading[]; frontmatter?: Frontmatter; title?: string; description?: string; updated?: string | Date; reviewed?: boolean }

const fm: Frontmatter = Astro.props.frontmatter ?? {
  title: Astro.props.title ?? '',
  description: Astro.props.description,
  updated: Astro.props.updated,
  reviewed: Astro.props.reviewed,
};
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const key = (fm.seoKey ?? path.slice(1)) as SeoKey;
let seo;
try { seo = pageSeo(key); } catch { seo = undefined; }
const seoProps = seo ?? { title: `${fm.title} | KoKreaters`, description: fm.description ?? '', path };
const crumbs = [{ label: fm.title, href: path }];
const h2s = (Astro.props.headings ?? []).filter((h) => h.depth === 2);
const updated = fm.updated ? (typeof fm.updated === 'string' ? new Date(fm.updated) : fm.updated) : undefined;
const updatedLabel = fill(microcopy.lastUpdated, { date: '' }).trim();
const hasToc = h2s.length > 2;
---
<BaseLayout page="legal" seo={seoProps} breadcrumbs={crumbs}>
  <article class="legal" aria-labelledby="page-title">
    <PageHero ground="grey" size="sm" crumbs={crumbs} eyebrow={microcopy.legalDateline} title={fm.title} lead={fm.description}>
      {updated && (
        <p class="legal__updated">{updatedLabel} <time datetime={isoDate(updated)}>{formatDate(updated)}</time></p>
      )}
    </PageHero>

    <div class="band band--white legal__band">
      <div class="container">
        <div class:list={['legal__grid', hasToc && 'legal__grid--toc']}>
          {hasToc && (
            <nav class="legal__toc" aria-labelledby="legal-toc-t">
              <p class="legal__toc-title t-label" id="legal-toc-t">{microcopy.onThisPage}</p>
              <ol class="legal__toc-list" role="list">
                {h2s.map((h, i) => <li><a href={`#${h.slug}`}><span class="legal__toc-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{h.text}</span></a></li>)}
              </ol>
            </nav>
          )}
          <div class="legal__main">
            {showConfirm && !fm.reviewed && <p class="legal__review" role="note">{microcopy.legalBanner}</p>}
            <div class="prose prose--legal legal__body">
              <slot />
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal__updated {
    margin: 0; padding-top: var(--s-4); border-top: 1px solid var(--rule); max-width: 46ch;
    font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .legal__updated time { color: var(--fg); font-weight: 500; }

  .legal__band { padding-block: var(--section-tight) var(--section); }
  .legal__grid { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-8); align-items: start; }

  .legal__toc-title { margin: 0 0 var(--s-3); color: var(--label); }
  .legal__toc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .legal__toc-list li { border-bottom: 1px solid var(--rule); }
  .legal__toc-list a {
    display: flex; align-items: baseline; gap: var(--s-4); min-height: 48px; padding-block: var(--s-3);
    font-size: var(--fs-small); line-height: 1.4; color: var(--fg); text-decoration: none;
    transition: color var(--d-1) var(--ease-out);
  }
  .legal__toc-n { flex: none; min-width: 2ch; font-size: var(--fs-meta); font-variant-numeric: lining-nums tabular-nums; color: var(--fg-2); }
  .legal__toc-list a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .legal__toc-list a:hover { color: var(--link); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .2em; }

  .legal__review {
    margin: 0 0 var(--s-6); padding: var(--s-3) var(--s-4);
    border: 1px dashed var(--fg-2); border-radius: var(--r-sm);
    font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2);
  }
  .legal__body { max-width: var(--measure); }
  /* the first heading sits at the top of the column, not 2.5em below it */
  .legal__body > :global(:first-child) { margin-top: 0; }
  /* each section opens on a hairline: the long page reads as calm, separate clauses */
  .legal__body :global(h2:not([class])) {
    margin-top: clamp(3rem, 2.4rem + 2.4vw, 5rem); padding-top: var(--s-6); border-top: 1px solid var(--rule);
    scroll-margin-top: calc(var(--scroll-offset) + var(--s-4));
  }
  .legal__body > :global(h2:first-child) { margin-top: 0; border-top: 0; padding-top: 0; }

  @media (min-width: 600px) and (max-width: 1023px) {
    .legal__toc-list { columns: 2; column-gap: var(--grid-gap); }
    .legal__toc-list li { break-inside: avoid; }
  }
  @media (min-width: 1024px) {
    .legal__grid--toc { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .legal__grid--toc .legal__toc { grid-column: 1 / 4; grid-row: 1; position: sticky; top: calc(var(--header-h-compact) + var(--s-7)); }
    .legal__grid--toc .legal__main { grid-column: 5 / -1; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .legal__toc-list a { transition: none; } }
</style>
