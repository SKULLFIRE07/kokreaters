---
/**
 * PillarMap as a constellation (DESIGN-SPEC v2 10.3 F1): the current pillar as a 120px die-cut sticker at the centre,
 * the other five as ringed nodes on hand-drawn strings, their mono labels are the real links in
 * <nav aria-label="Other expertise"> (v1 structure kept). SVG = decoration. Below 768 the nav becomes PillarTags.
 * Motion (pages/expertise.ts): the strings draw out from the sticker, the nodes pop, then they bob gently (pausable);
 * hovering a link tightens its string.
 */
import { pillars } from '@/data/pillars';
import { pillarGround, pillarNumber } from '@/lib/pillars';
import PillarDot from '../ui/PillarDot.astro';
import MarginNote from '../notes/MarginNote.astro';
import { expertiseNotes } from '@/data/notes/expertise';
import type { PillarKey } from '@/data/types';

interface Props { current: PillarKey; class?: string }
const { current, class: cls } = Astro.props;
const W = 560, H = 520, CX = 270, CY = 262, R = 196;
const here = pillars.find((p) => p.key === current)!;
const others = pillars.filter((p) => p.key !== current).map((p, i) => {
  const a = (-150 + i * 75) * Math.PI / 180;     // a fan round the sticker, from upper left to lower left
  const r = R * (i % 2 ? .92 : 1.04);
  const x = CX + r * Math.cos(a), y = CY + r * Math.sin(a);
  const mx = (CX + x) / 2, my = (CY + y) / 2, sag = 26 + (i % 3) * 8;
  const d = `M${CX} ${CY} Q ${(mx + (i % 2 ? sag : -sag) * .4).toFixed(1)} ${(my + sag).toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
  return { p, x, y, d, up: y < CY - 30, left: x < CX - 40, right: false };
});
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---
<div class:list={['pmap', 'has-notes', cls]} data-pmap>
  <svg class="pmap__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <circle class="pmap__orbit" cx={CX} cy={CY} r={R} />
    <g data-pmap-lines>
      {others.map((n) => <path class="pmap__line" data-line={n.p.key} d={n.d} pathLength="1" />)}
    </g>
    {others.map((n) => (
      <g class="pmap__node" data-node={n.p.key}>
        <circle cx={n.x} cy={n.y} r="17" class="pmap__ring" />
        <circle cx={n.x} cy={n.y} r="12" style={`fill:var(--pillar-${n.p.key})`} class="pmap__dot" />
      </g>
    ))}
  </svg>
  <div class="pmap__here" data-pmap-here style={`left:${pct(CX, W)};top:${pct(CY, H)}`} aria-hidden="true">
    <span class={`pmap__sticker g-${pillarGround(here.key)}`}>
      <span class="pmap__here-n tnum">{pillarNumber(here)}</span>
      <span class="pmap__here-l">{here.shortLabel}</span>
    </span>
  </div>
  <MarginNote text={expertiseNotes.pillar.here} arrow="arrow-straight" arrowAt="end" rotate={-6} arrowAngle={6} place={`right: calc(100% - ${pct(CX, W)} + 74px); top: calc(${pct(CY, H)} - 22px);`} show="md" />
  <nav class="pmap__nav" aria-label="Other expertise">
    <p class="pmap__navlabel t-label">{expertiseNotes.pillar.others}</p>
    <ul class="pmap__list" role="list">
      {others.map((n) => (
        <li class:list={['pmap__item', { 'pmap__item--up': n.up, 'pmap__item--left': n.left, 'pmap__item--right': n.right }]} data-to={n.p.key} style={`--x:${pct(n.x, W)};--y:${pct(n.y, H)}`}>
          <a class:list={['pmap__label', `g-${pillarGround(n.p.key)}`]} href={`/expertise/${n.p.slug}`}>
            <PillarDot pillar={n.p.key} size={8} class="pmap__chipdot" /><span>{n.p.shortLabel}</span><span class="visually-hidden">, {n.p.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>
<style>
  .pmap { position: relative; width: 100%; max-width: 560px; margin-inline: auto; }
  .pmap__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .pmap__orbit { fill: none; stroke: var(--fg); stroke-width: 1.5; stroke-dasharray: 2 10; opacity: .5; }
  .pmap__line { fill: none; stroke: var(--fg); stroke-width: 2.5; stroke-linecap: round; transition: stroke-width var(--d-ui) var(--ease-expo); }
  .pmap__ring { fill: var(--kk-white); }
  .pmap__dot { stroke: var(--kk-ink); stroke-width: 1.5; }
  .pmap__here { position: absolute; translate: -50% -50%; z-index: 1; }
  .pmap__sticker {
    display: grid; place-content: center; justify-items: center; gap: 2px; width: 132px; height: 132px; border-radius: 50%;
    box-shadow: 0 0 0 7px var(--kk-white), var(--shadow-lift); rotate: -6deg; text-align: center;
  }
  .pmap__here-n { font: 800 44px/0.9 var(--font-display); font-stretch: 75%; color: var(--fg); }
  .pmap__here-l { font: 500 12px/1.1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--fg); max-width: 9ch; }
  .pmap :global(.note) { z-index: 2; }
  .pmap__navlabel { display: none; }
  .pmap__list { list-style: none; margin: 0; padding: 0; }
  @media (min-width: 768px) {
    .pmap__nav { position: absolute; inset: 0; pointer-events: none; }
    .pmap__item { position: absolute; left: var(--x); top: var(--y); translate: -50% 18px; pointer-events: auto; }
    .pmap__item--up { translate: -50% calc(-100% - 18px); }
    .pmap__item--left { translate: calc(-100% - 20px) -50%; }
    .pmap__item--right { translate: 20px -50%; }
    .pmap__label {
      display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px 0 12px; border-radius: var(--r-pill);
      font: 500 13px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; color: var(--fg); white-space: nowrap;
      box-shadow: 0 0 0 3px var(--kk-white), var(--shadow-sticker);
      transition: rotate var(--d-ui) var(--ease-expo), translate var(--d-ui) var(--ease-expo);
    }
    .pmap__label:hover, .pmap__label:focus-visible { color: var(--fg); rotate: -3deg; translate: 0 -3px; }
    .pmap__label:focus-visible { outline: 3px solid var(--kk-ink); outline-offset: 4px; }
    .pmap:has(.pmap__item a:is(:hover, :focus-visible)) .pmap__line { stroke-width: 1.5; }
  }
  @media (max-width: 767px) {
    .pmap { max-width: none; }
    .pmap__svg, .pmap__here { display: none; }
    .pmap__navlabel { display: block; margin: 0 0 var(--s-3); color: var(--fg-2); }
    .pmap__list { display: flex; flex-wrap: wrap; gap: 10px 8px; }
    .pmap__label {
      position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px 0 10px; border-radius: var(--r-pill);
      font: 500 12px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; text-decoration: none; color: var(--fg);
      box-shadow: 0 0 0 2px var(--kk-white);
    }
    .pmap__label::after { content: ""; position: absolute; inset: -4px 0; }
  }
  @media (prefers-reduced-motion: reduce) { .pmap__label:hover, .pmap__label:focus-visible { rotate: 0deg; translate: 0 0; } }
</style>
