---
/**
 * F1 · Hero (DESIGN-SPEC v2 10.1). White. The H1 is the LCP element: three explicit lines at ≥ 1024, never hidden or
 * moved at load. An Orchid swoosh under "shared ambition" (manual: hero.ts draws it after the bloom). The
 * elastic HeroNetwork sits in the empty space right of line 1. MagneticLetters (bencho) re-splits the H1 after idle on
 * desktop + fine pointer only. Foot row: perforated rule, base + places.
 */
import { hero } from '@/data/home';
import { homeNotes } from '@/data/notes/home';
import Scribble from '@/components/notes/Scribble.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import Button from '@/components/ui/Button.astro';
import MagneticLetters from '@/components/bencho/MagneticLetters.astro';
import HeroNetwork from './HeroNetwork.astro';

const overline = hero.overline.split(' · ');
---
<section class="hero g-white has-notes" aria-labelledby="hero-heading" data-hero-root>
  <div class="hero__inner container">
    <p class="t-dateline hero__overline">{overline.map((part, i) => <><span class="hero__ov-part">{part}</span>{i < overline.length - 1 && <span class="hero__ov-dot" aria-hidden="true"> ✶ </span>}{i < overline.length - 1 && <span class="visually-hidden"> · </span>}</>)}</p>

    <div class="hero__stage">
      <MagneticLetters>
        <h1 id="hero-heading" class="t-mega hero__h1" data-magnetic-letters><span class="l">Where deep</span> <span class="l">expertise meets</span> <span class="l hero__l3"><Scribble kind="swoosh" tone="orchid" manual thickness={5}>shared ambition</Scribble>.</span></h1>
      </MagneticLetters>
      <MarginNote text={homeNotes.hero.shared} tone="orchid" size="lg" rotate={-6} arrow="arrow-curve" arrowAt="start" arrowAngle={-150} show="md" order={0} delay={0.6} class="hero__note-shared" place="" />
      <div class="hero__art">
        <HeroNetwork />
        <MarginNote text={homeNotes.hero.pull} tone="orchid" rotate={3} arrow="arrow-loop" arrowAt="start" arrowAngle={200} show="pointer" order={1} class="hero__note-pull" />
      </div>
    </div>

    <div class="hero__row">
      <p class="t-lead hero__sub">{hero.sub}</p>
      <div class="hero__actions">
        <Button href={hero.primary.href} variant="primary" arrow>{hero.primary.label}</Button>
        <Button href={hero.secondary.href} variant="hand" data-hero-explore>{hero.secondary.label}</Button>
      </div>
    </div>

    <div class="hero__foot t-label">
      <p>{hero.footLeft}</p>
      <p class="hero__places">{hero.footRight.map((p, i) => <><span>{p}</span>{i < hero.footRight.length - 1 && <span aria-hidden="true" class="hero__pdot">·</span>}</>)}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: clip;
    min-height: min(calc(100svh - var(--ann-h) - var(--header-h)), 960px);
    display: flex;
  }
  .hero__inner { position: relative; display: flex; flex-direction: column; width: 100%; padding-top: clamp(24px, 4vh, 56px); padding-bottom: var(--s-5); }
  .hero__overline { margin: 0 0 clamp(20px, 3vh, 40px); color: var(--fg-2); }
  .hero__ov-dot { color: var(--kk-orchid); }
  @media (min-width: 768px) { .hero__ov-part { white-space: nowrap; } }

  .hero__stage { position: relative; flex: 1 0 auto; }
  .hero__h1 { position: relative; z-index: 2; margin: 0; color: var(--kk-ink); max-width: 100%; font-size: clamp(3.1rem, 9.4vw, 9.25rem); }
  .hero__h1 :global(.scribble__svg) { color: var(--kk-orchid); }
  .hero__l3 { white-space: nowrap; }

  /* the note sits under line 3, right of "ambition", arrow up-left at "shared" */
  .hero :global(.hero__note-shared) { left: clamp(420px, 40vw, 600px); top: calc(clamp(3.1rem, 9.4vw, 9.25rem) * 2.95); z-index: 3; }

  .hero__art {
    position: absolute; z-index: 1; right: calc(-1 * min(24px, var(--side))); top: calc(-1 * clamp(56px, 8vh, 96px));
    width: min(37vw, 560px);
  }
  .hero :global(.hero__note-pull) { right: 0; top: 101%; }
  .hero :global(.hero__note-shared .note__text), .hero :global(.hero__note-pull .note__text) { white-space: nowrap; }

  .hero__row {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-5);
    align-items: end; margin-top: clamp(28px, 5vh, 64px);
  }
  .hero__sub { grid-column: 1 / 7; margin: 0; color: var(--fg-2); max-width: 46ch; }
  .hero__actions { grid-column: 7 / 13; display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: var(--s-3) var(--s-4); }

  .hero__foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-5);
    margin-top: clamp(28px, 5vh, 56px); padding-top: var(--s-4); color: var(--fg-2);
    background: linear-gradient(90deg, var(--kk-ink) 50%, transparent 0) top left / 14px 1.5px repeat-x;
  }
  .hero__foot p { margin: 0; }
  .hero__places { display: flex; flex-wrap: wrap; gap: 0 10px; }
  .hero__pdot { color: var(--kk-orchid); }

  @media (max-width: 1023px) {
    .hero__art { position: relative; right: auto; top: auto; width: min(100%, 560px); margin: var(--s-5) auto 0; }
    .hero :global(.hero__note-shared), .hero :global(.hero__note-pull) { display: none; }
    .hero__sub { grid-column: 1 / -1; }
    .hero__actions { grid-column: 1 / -1; justify-content: flex-start; }
    .hero__stage { display: contents; }
    .hero__overline { order: 0; } .hero__h1 { order: 1; } .hero__row { order: 2; } .hero__art { order: 3; } .hero__foot { order: 4; }
  }
  @media (max-width: 767px) {
    .hero__row { grid-template-columns: minmax(0, 1fr); }
    .hero__art { height: 300px; width: 100%; margin-top: var(--s-4); }
    .hero__art :global(.hero-network) { height: 300px; width: 100%; }
    .hero__inner { padding-top: 20px; }
  }
</style>
