---
/**
 * Home 4 · Track record (v4 developer guide). Porcelain band: "Our track record" label left, the source line right
 * ("Figures from our founder’s career at Wilmar and Cargill."), then four figures in Bodoni 64px: 25 years in industry ·
 * 14 years in oils, fats and food ingredients · 5 countries · WHO. The lead figure carries a 3px saffron top rule, the
 * others a 1px line (StatStrip). Motion: rules draw in, numbers count up once (motion.ts); "WHO" stays as it is.
 * Mobile: 2 × 2 grid; the source line moves under the label.
 */
import StatStrip from '@/components/ui/StatStrip.astro';
import { proof, proofStripSource, homeLabels } from '@/data/home';
---
<section class="hp band band--grey" aria-labelledby="proof-heading">
  <div class="container">
    <div class="hp__head">
      <h2 id="proof-heading" class="t-label hp__label">{homeLabels.proof}</h2>
      <p class="hp__source">{proofStripSource}</p>
    </div>
    <StatStrip items={proof} cols={4} class="hp__stats" />
  </div>
</section>

<style>
  .hp { --_pad: clamp(4rem, 3.4rem + 2.2vw, 5rem); }
  .hp__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; margin-bottom: 40px; }
  .hp__label { margin: 0; }
  .hp__source { margin: 0; font-size: .875rem; line-height: 1.5; color: var(--fg-2); }
  .hp :global(.stats__value) { font-size: clamp(3rem, 2.5rem + 2vw, 4rem); }
  .hp :global(.stats__label) { color: #2C3A5E; }
  .hp :global(.stats__key) { font-weight: 700; color: var(--navy-900); }
  @media (min-width: 900px) {
    .hp :global(.stats__list) { column-gap: 32px; }
    .hp :global(.stats__item) { padding-top: 26px; gap: 14px; }
  }
</style>
