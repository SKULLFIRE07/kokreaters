---
/**
 * About hero (DESIGN-SPEC v2 10.7 F1): a split band. Left (White): breadcrumbs, dateline, the H1 with "25 years"
 * hand-underlined, the intro. Right: a Lavender block that bleeds to the right viewport edge and the band's bottom;
 * the cut-out sits flush on its bottom and side edges (the block is exactly the photo's aspect, so the cut shoulders
 * land on the block edges). Behind him: a Saffron disc at the head, the node-cluster engraving and two node doodles;
 * EdgeLight on the block. The note "hello from the Netherlands" loops to the face. The H1 and the photo never animate.
 * Mobile: the block follows the text at full width. The photo is lazy (below the fold on phones; spec 10.7).
 */
import FounderPhoto from '@/components/brand/FounderPhoto.astro';
import Engraving from '@/components/brand/Engraving.astro';
import Breadcrumbs from '@/components/chrome/Breadcrumbs.astro';
import Scribble from '@/components/notes/Scribble.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import Doodle from '@/components/notes/Doodle.astro';
import type { Crumb } from '@/components/seo/schema';
import { about, portraitAlt } from '@/data/founder';
import { storyNotes } from '@/data/notes/story';
interface Props { crumbs?: Crumb[]; }
const { crumbs = [] } = Astro.props;
const phrase = '25 years';
const [h1a, h1b = ''] = about.headline.split(phrase);
---
<section class="ab-hero g-white" aria-labelledby="about-title">
  <div class="ab-hero__text">
    {crumbs.length > 0 && <div class="ab-hero__crumbs"><Breadcrumbs items={crumbs} /></div>}
    <p class="t-dateline ab-hero__dateline">{about.overline}</p>
    <h1 id="about-title" class="t-display ab-hero__h1">{h1a}<Scribble kind="underline" tone="orchid" thickness={5}>{phrase}</Scribble>{h1b}</h1>
    <p class="t-lead ab-hero__intro">{about.intro}</p>
  </div>
  <div class="ab-hero__block g-lavender grain has-notes" data-edge-light>
    <span class="ab-hero__disc" aria-hidden="true" data-parallax="0.08"></span>
    <Engraving variant="cluster" class="ab-hero__eng" />
    <Doodle kind="node" tone="imperial" size={44} place="position:absolute;left:10%;top:56%;" />
    <Doodle kind="spark" tone="berry" size={52} place="position:absolute;right:9%;top:9%;" seed={1} />
    <FounderPhoto variant="cutout" alt={portraitAlt.about} loading="lazy" sizes="(min-width: 1024px) 46vw, 100vw" class="ab-hero__img" />
    <MarginNote text={storyNotes.about.hello} tone="berry" size="lg" rotate={-7} arrow="arrow-loop" arrowAt="end" arrowAngle={10}
      place="left:-11.5rem;top:9%;" show="lg" delay={0.6} class="ab-hero__note" />
  </div>
</section>
<style>
  .ab-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: stretch; overflow: clip; }
  .ab-hero__text { padding: var(--s-5) var(--s-8) clamp(64px, 8vw, 128px) max(var(--side), calc((100vw - var(--content-max)) / 2));
    display: flex; flex-direction: column; }
  .ab-hero__crumbs { margin-bottom: auto; padding-bottom: var(--s-8); }
  .ab-hero__dateline { margin: 0 0 var(--s-5); }
  .ab-hero__h1 { margin: 0; max-width: 10ch; font-size: clamp(3.25rem, 1rem + 6.6vw, 8.25rem); line-height: .9; }
  .ab-hero__intro { margin: var(--s-7) 0 0; max-width: 44ch; }
  .ab-hero__block { position: relative; height: min(82svh, 820px); aspect-ratio: 1665 / 2048; align-self: end; margin-top: var(--s-8);
    overflow: visible; border-radius: var(--r-block) 0 0 0; }
  .ab-hero__block.grain::after { border-radius: inherit; z-index: 0; }
  .ab-hero__disc { position: absolute; left: 45.6%; top: 30%; width: 64%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: var(--kk-saffron); z-index: 0; }
  .ab-hero__block :global(.ab-hero__eng) { position: absolute; left: 4%; top: 4%; width: 38% !important; opacity: .35; z-index: 0; }
  .ab-hero__block :global(.doodle) { z-index: 1; }
  .ab-hero__block :global(picture) { position: absolute; inset: 0; z-index: 1; display: block; overflow: clip; border-radius: inherit; }
  .ab-hero__block :global(.ab-hero__img), .ab-hero__block :global(.ab-hero__img img) { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  .ab-hero__block :global(.ab-hero__note) { z-index: 4; }
  @media (max-width: 1023px) {
    .ab-hero { grid-template-columns: 1fr; }
    .ab-hero__text { padding: var(--s-5) var(--side) var(--s-8); }
    .ab-hero__crumbs { margin-bottom: 0; }
    .ab-hero__block { width: min(100%, 560px); height: auto; justify-self: end; margin-top: 0; border-radius: var(--r-block) 0 0 0; }
  }
</style>
