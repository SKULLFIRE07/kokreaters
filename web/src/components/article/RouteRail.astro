---
/**
 * RouteRail (DESIGN-SPEC 5.8 item 13, graft 6): sticky "On this page" nav at ≥ 1280px, h2 links as
 * station nodes on a vertical Hairline line with a Sapphire progress segment. scripts/pages/article.ts
 * sets the active node (aria-current="true") and scrubs the segment.
 */
import type { MarkdownHeading } from 'astro';
import { microcopy } from '@/data/microcopy';
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---
<nav class="rail" aria-label={microcopy.onThisPage} data-rail>
  <p class="rail__label t-dateline">{microcopy.onThisPage}</p>
  <div class="rail__track">
    <span class="rail__line" aria-hidden="true"><span class="rail__progress" data-rail-progress></span></span>
    <ol class="rail__list">
      {h2s.map((h) => (
        <li class="rail__item"><a class="rail__link" href={`#${h.slug}`} data-rail-link={h.slug}><span class="rail__node" aria-hidden="true"></span><span class="rail__text">{h.text}</span></a></li>
      ))}
    </ol>
  </div>
</nav>
<style>
  .rail { position: sticky; top: calc(var(--header-h) + 32px); font-family: var(--font-sans); }
  .rail__label { margin: 0 0 var(--s-4); }
  .rail__track { position: relative; }
  .rail__line { position: absolute; left: 5px; top: 10px; bottom: 10px; width: 1px; background: var(--c-rule); }
  .rail__progress { position: absolute; inset: 0; background: var(--c-line); transform: scaleY(0); transform-origin: 50% 0; }
  .rail__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .rail__link {
    position: relative; display: flex; gap: var(--s-3); align-items: flex-start;
    padding: 6px 0; min-height: 32px;
    font-size: 13px; line-height: 18px; font-weight: 500;
    color: var(--c-meta); text-decoration: none; text-wrap: pretty;
    transition: color var(--d-colour) var(--ease-out);
  }
  .rail__link:hover, .rail__link:focus-visible { color: var(--c-link); }
  .rail__link[aria-current="true"] { color: var(--c-heading); font-weight: 600; }
  .rail__node {
    flex: none; position: relative; z-index: 1; margin-top: 3px;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--kk-white); border: var(--line-work) solid var(--kk-field-border);
    box-shadow: 0 0 0 2px var(--kk-white);
    transition: background var(--d-colour) var(--ease-out), border-color var(--d-colour) var(--ease-out);
  }
  .rail__link[aria-current="true"] .rail__node, .rail__link:hover .rail__node { border-color: var(--c-line); }
  .rail__link[aria-current="true"] .rail__node { background: var(--c-line); }
  @media (prefers-reduced-motion: reduce) { .rail__link, .rail__node { transition: none; } }
</style>
