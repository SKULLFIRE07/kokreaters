---
/**
 * 404, v4 "Delft". One full-screen hero (PageHero size lg): the client's wheat-against-blue-sky photo (spare-wheat,
 * v4 set; replaces the v3 steel roof truss) full-bleed behind the navy gradient,
 * eyebrow "404", H1 "This page could not be found." at display size, the brief's line "Let’s connect you back.", four
 * serif links (Home, Expertise, Insights, Contact) and the NodeMark as the quiet signature in the right column.
 * No scroll cue (there is nothing to scroll to). noindex and no CtaBand (BaseLayout page="notfound"); no breadcrumbs.
 * The hero runs straight into the navy footer, so a container-width hairline separates the two.
 * Mobile (< 900px): PageHero turns the photo into a band at the top that fades into navy; the text sits below on solid
 * navy; the links stack as full-width 56px rows with hairlines; the NodeMark leaves the flow and sits small (40px)
 * top right, level with the "404" eyebrow, as a folio mark. 900–1199px: links in a 2 × 2 grid; ≥ 1200px one row of
 * four, each a 72px row on a hairline whose accent line draws across on hover. NodeMark large (≈ 220px) from 900px.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import NodeMark from '@/components/brand/NodeMark.astro';
import { notFoundPage } from '@/data/notfound';
import { photos } from '@/data/photos';
import { pageSeo } from '@/lib/seo';

const bg = photos['spare-wheat'];
---
<BaseLayout page="notfound" seo={pageSeo('notfound')}>
  <PageHero
    ground="navy"
    size="lg"
    eyebrow={notFoundPage.code}
    title={notFoundPage.headline}
    lead={notFoundPage.line}
    titleId="nf-title"
    class="nf-hero"
    image={bg.src}
    imageAlt={bg.alt}
    scrollCue={false}
    asideMobile="corner"
  >
    <ul class="nf-links" role="list">
      {notFoundPage.links.map((l) => (
        <li>
          <a class="nf-link u-hover" href={l.href}>
            <span class="nf-link__label">{l.label}</span>
            <Icon name="arrow-right" size={22} stroke={1.75} class="nf-link__arrow u-nudge" />
          </a>
        </li>
      ))}
    </ul>
    <div slot="aside" class="nf-mark"><NodeMark size={220} tone="blue" /></div>
  </PageHero>
  <div class="band band--navy band--pad-none" aria-hidden="true"><div class="container"><div class="hairline"></div></div></div>
</BaseLayout>

<style>
  .nf-links {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--rule);
  }
  .nf-link {
    position: relative;
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    min-height: 56px; padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
    font: 700 1.125rem/1.35 var(--font-sans);
    color: var(--head); text-decoration: none;
  }
  .nf-link :global(.nf-link__arrow) { flex: none; color: var(--saffron); }
  .nf-link:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  .nf-mark { display: flex; }
  .nf-mark :global(.nodemark) { width: 220px; height: 220px; opacity: .9; }

  @media (max-width: 899px) {
    .nf-mark :global(.nodemark) { width: 40px; height: 40px; }
  }

  @media (min-width: 900px) {
    .nf-links { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--grid-gap); border-top: 0; }
    .nf-link { border-bottom: 0; border-top: 1px solid var(--rule); min-height: 72px; padding-block: var(--s-4); font: 400 1.75rem/1.2 var(--font-serif); }
    /* the accent line draws across the hairline on hover (the light-card language) */
    .nf-link::before {
      content: ""; position: absolute; left: 0; top: -1px; width: 100%; height: 2px; background: var(--saffron);
      transform: scaleX(0); transform-origin: left; transition: transform var(--d-3) var(--ease-out);
    }
    .nf-link:hover::before, .nf-link:focus-visible::before { transform: scaleX(1); }
    .nf-mark { justify-content: flex-end; }
  }
  @media (min-width: 1200px) {
    .nf-links { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .nf-link::before { transition: none; } }
</style>
