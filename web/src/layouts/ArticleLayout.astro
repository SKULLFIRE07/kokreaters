---
/**
 * Article page (DESIGN-SPEC 5.8). Grid at ≥ 1280px: cols 1–3 sidenotes, 4–10 body (≤ 64ch),
 * 11–12 the route rail. Single column below, with notes inline in reading order.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ProgressRule from '@/components/article/ProgressRule.astro';
import ArticleHeader from '@/components/article/ArticleHeader.astro';
import RouteRail from '@/components/article/RouteRail.astro';
import AuthorBox from '@/components/article/AuthorBox.astro';
import CoverStory from '@/components/shared/CoverStory.astro';
import { article as articleNode } from '@/components/seo/schema';
import { articleSeo } from '@/lib/seo';
import { getPillar } from '@/lib/pillars';
import { microcopy } from '@/data/microcopy';
import type { SeoProps } from '@/components/seo/schema';

interface Props {
  entry: CollectionEntry<'insights'>;
  headings: MarkdownHeading[];
  minutes: number;
  related: CollectionEntry<'insights'>[];
}
const { entry, headings, minutes, related } = Astro.props;
const d = entry.data;
const pillar = getPillar(d.pillar);
const base = articleSeo({ id: entry.id, title: d.title, description: d.description });
const published = d.date;
const modified = d.updated ?? d.date;
const seo: SeoProps = {
  ...base,
  article: { published: published?.toISOString(), modified: modified?.toISOString(), section: pillar.name },
  jsonLd: [articleNode({ title: d.title, standfirst: d.standfirst || d.description, path: base.path, published, modified, section: pillar.name, ogImage: base.ogImage })],
};
const crumbs = [{ label: 'Insights', href: '/insights' }, { label: d.title, href: base.path }];
const showRail = headings.filter((h) => h.depth === 2).length >= 3;
---
<BaseLayout page="article" seo={seo} breadcrumbs={crumbs} pillar={d.pillar} showCrumbs={false}>
  <ProgressRule />
  <article class="article" data-article data-minutes={minutes}>
    <ArticleHeader entry={entry} minutes={minutes} />
    <div class="container">
      <div class="article__grid">
        <div class="article__body prose" data-article-body><slot /></div>
        {showRail && <aside class="article__rail"><RouteRail headings={headings} /></aside>}
        <div class="article__author"><AuthorBox /></div>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="article__related g-cloud paper-grid" aria-labelledby="related-h">
      <div class="container">
        <h2 id="related-h" class="t-h2 related__h" data-rise>{microcopy.relatedInsights}</h2>
        <ul class="related__list" role="list">
          {related.map((r) => <li><CoverStory entry={r} variant="card" headingLevel="h3" /></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .article { padding-bottom: var(--section); }
  .article__grid { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-8); padding-top: clamp(3rem, 2rem + 3vw, 5rem); }
  .article__body, .article__author { width: 100%; max-width: var(--measure-article); margin-inline: auto; }
  .article__rail { display: none; }
  .article__author { margin-top: var(--s-6); }
  .article__related { padding-block: clamp(4rem, 2rem + 5vw, 7rem); border-top: 2px solid var(--kk-ink); }
  .related__h { margin: 0 0 var(--s-7); }
  .related__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
  .related__list :global(.cover--card) { width: 100%; min-height: 380px; box-shadow: var(--shadow-hard); border: 2px solid var(--kk-ink); }
  @media (min-width: 768px) { .related__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .related__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  @media (min-width: 1280px) {
    .article__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .article__body { grid-column: 4 / 11; grid-row: 1; margin: 0; }
    .article__author { grid-column: 4 / 11; margin: var(--s-6) 0 0; max-width: var(--measure-article); }
    .article__rail { display: block; grid-column: 11 / 13; grid-row: 1; }
  }
</style>
