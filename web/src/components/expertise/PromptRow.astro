---
/** "Not sure where you fit? Start a conversation" (DESIGN-SPEC v2 10.2 F4, 10.3 F6): a full-bleed Butter band, the
 * question in big Bricolage, the primary pill, and the "start anywhere" note pointing at it. */
import Button from '../ui/Button.astro';
import MarginNote from '../notes/MarginNote.astro';
import Doodle from '../notes/Doodle.astro';
import { expertiseOverview } from '@/data/pillars';
import { expertiseNotes } from '@/data/notes/expertise';
import type { GroundKey } from '@/data/types';
interface Props { ground?: GroundKey }
const { ground = 'butter' } = Astro.props;
const { prompt } = expertiseOverview;
---
<section class:list={['band', 'fold', `g-${ground}`, 'prompt', 'has-notes']} aria-labelledby="prompt-title">
  <div class="container prompt__in">
    <h2 id="prompt-title" class="t-display prompt__text" data-rise>{prompt.text}</h2>
    <div class="prompt__cta has-notes">
      <MarginNote text={expertiseNotes.prompt.anywhere} tone="berry" arrow="arrow-straight" arrowAt="end" rotate={-6} arrowAngle={18} place="right: calc(100% + 12px); top: -34px;" show="md" />
      <Button href={prompt.link.href}>{prompt.link.label}</Button>
    </div>
    <Doodle kind="star" tone="berry" size={56} rotate={12} place="right: 6%; top: 18%;" show="lg" />
  </div>
</section>
<style>
  .prompt { padding-block: clamp(4rem, 2rem + 8vw, 8rem); }
  .prompt__in { position: relative; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s-6) var(--s-8); }
  .prompt__text { margin: 0; max-width: 11ch; color: var(--head); }
  .prompt__cta { position: relative; flex: none; }
  .prompt :global(.doodle) { position: absolute; }
  @media (max-width: 767px) { .prompt__in { align-items: flex-start; flex-direction: column; } }
</style>
