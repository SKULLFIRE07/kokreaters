---
/**
 * Photo (REDESIGN-V3 §2, §3, §9.2): astro:assets <Picture> → AVIF + WebP (+ original as <img> fallback), responsive
 * widths, explicit `sizes`, cover crop inside a ratio box (no layout shift).
 * Focal point (§9.2 "no image cut"): `position` = object-position. When it is omitted and `src` is one of the stock
 * photos in src/data/photos.ts, that record's tuned `position` is applied automatically (photoBySrc). `slug` is a
 * shortcut: <Photo slug="lab-01" sizes="…" /> takes src, alt and position from the record (explicit props still win).
 * `ratio` 'auto' (or omitted, without `fill`) keeps the photo's natural proportions: nothing is cropped at all.
 * `priority` (the LCP image only): loading eager + fetchpriority high + decoding sync. Everything else lazy + async.
 * `fill`: the box fills its positioned parent instead of keeping a ratio (hero backgrounds, interludes, half-bleed media).
 * `settle`: the image scales 1.06 → 1 as it scrolls into view (CSS scroll-driven, motion.css; same as data-settle).
 * `parallax` (v4): data-gsap="parallax" — the image overscans 1.12 and drifts with the scroll (motion.ts).
 * `kenburns` (v4, hero only): data-gsap="kenburns" — settles 1.08 → 1 on load, then drifts gently as the hero leaves.
 * Widths larger than the source are dropped (never upscale). The default ladder has an 800 step so a full-width phone
 * image at DPR 1.75–2 gets 800w, not 960w. Radius 2px unless `fill`.
 * Mobile: the ratio box spans its container; pass `sizes` that match the mobile column (usually 100vw minus gutters).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos, photoBySrc, type PhotoSlug } from '@/data/photos';
type Ratio = '21/9' | '16/9' | '3/2' | '4/3' | '1/1' | '4/5' | '3/4' | 'auto';
interface Props {
  src?: ImageMetadata;
  alt?: string;
  slug?: PhotoSlug;
  ratio?: Ratio;
  sizes: string;
  priority?: boolean;
  widths?: number[];
  position?: string;
  fill?: boolean;
  settle?: boolean;
  parallax?: boolean;
  kenburns?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  src: srcProp, alt: altProp, slug, ratio, sizes, priority = false, widths = [400, 640, 800, 960, 1280, 1600, 2000, 2560],
  position: posProp, fill = false, settle = false, parallax = false, kenburns = false, class: cls, ...rest
} = Astro.props;
const record = slug ? photos[slug] : photoBySrc(srcProp);
const src = srcProp ?? record?.src;
if (!src) throw new Error('Photo: pass `src` or a known `slug`.');
const alt = altProp ?? record?.alt ?? '';
const position = posProp ?? record?.position;
const usable = widths.filter((w) => w <= src.width);
const list = usable.length ? usable : [src.width];
const loadAttrs = priority
  ? { loading: 'eager' as const, fetchpriority: 'high' as const, decoding: 'sync' as const }
  : { loading: 'lazy' as const, decoding: 'async' as const };
const boxed = !fill && ratio && ratio !== 'auto';
---
<div
  class:list={['photo', fill ? 'photo--fill' : boxed && 'photo--ratio', cls]}
  style={boxed ? `--ratio:${ratio}` : undefined}
  data-settle={settle && !parallax && !kenburns ? '' : undefined}
  data-gsap={kenburns ? 'kenburns' : parallax ? 'parallax' : undefined}
  {...rest}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={list}
    sizes={sizes}
    class="photo__img"
    style={position ? `object-position:${position}` : undefined}
    {...loadAttrs}
  />
</div>
<style>
  .photo { position: relative; overflow: hidden; border-radius: 0; background: var(--grey-100); }
  .photo--ratio { aspect-ratio: var(--ratio); }
  .photo--fill { position: absolute; inset: 0; border-radius: 0; background: var(--navy-900); }
  .photo :global(picture) { display: contents; }
  .photo :global(.photo__img) { display: block; width: 100%; height: auto; }
  .photo:is(.photo--ratio, .photo--fill) :global(.photo__img) { position: absolute; inset: 0; height: 100%; object-fit: cover; }
</style>
