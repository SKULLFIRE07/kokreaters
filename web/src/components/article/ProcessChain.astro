---
/**
 * ProcessChain (REDESIGN-V3 §4 article: "ProcessChain as the ProcessFlow style"). MDX:
 * <ProcessChain steps={[{ name, note, highlight? }]} />, usually inside an Exhibit.
 * The site's ringed-node signature: a 14px accent node with a white ring, joined by a 1px connector in --label,
 * "01" numerals, the step name in serif and its note in sans. A `highlight` step gets a larger node with a soft halo
 * and sits on a grey panel (its note says why). Static: no animation. An <ol>, so order is announced.
 * Horizontal when the chain itself is ≥ 800px wide (container query; names never break mid-word), one column per step, connector running through
 * the node centres. Mobile (narrower): vertical spine on the left, name + note to the right, 24px between steps.
 */
import { pad2 } from '@/lib/format';
interface Step { name: string; note: string; highlight?: boolean; }
interface Props { steps: Step[]; }
const { steps } = Astro.props;
---
<div class="pc" style={`--n:${steps.length}`}>
  <ol class="pc__list" role="list">
    {steps.map((s, i) => (
      <li class:list={['pc__step', { 'pc__step--hl': s.highlight }]}>
        <span class="pc__node" aria-hidden="true"></span>
        <span class="pc__n" aria-hidden="true">{pad2(i + 1)}</span>
        <span class="pc__name">{s.name}</span>
        <span class="pc__note">{s.note}</span>
      </li>
    ))}
  </ol>
</div>
<style>
  .pc { container-type: inline-size; --node: 20px; --ring: var(--bg, var(--white)); overflow-wrap: normal; hyphens: manual; }
  .pc__list { list-style: none; margin: 0; padding: 0; display: grid; }

  /* vertical (narrow) */
  .pc__step {
    position: relative; display: grid; grid-template-columns: var(--node) minmax(0, 1fr); column-gap: var(--s-4); row-gap: 2px;
    margin: 0; padding: 0 0 var(--s-5);
  }
  .pc__step:last-child { padding-bottom: 0; }
  .pc__node {
    grid-row: 1 / span 3; position: relative; z-index: 1;
    width: 14px; height: 14px; margin: 3px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--ring); box-shadow: 0 0 0 3px var(--accent);
  }
  .pc__step:not(:last-child)::before {
    content: ""; position: absolute; z-index: 0;
    left: calc(var(--node) / 2 - .5px); top: calc(var(--node) / 2); bottom: calc(var(--node) / -2);
    width: 1px; background: var(--label);
  }
  .pc__n { font-size: var(--fs-meta); line-height: var(--node); color: var(--fg-2); font-variant-numeric: lining-nums tabular-nums; }
  .pc__name {
    font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-h4); line-height: var(--lh-h4);
    font-weight: 500; color: var(--head); text-wrap: balance;
  }
  .pc__note { margin-top: 2px; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); text-wrap: pretty; }

  /* highlight: halo node on a grey panel */
  .pc__step--hl { --ring: var(--surface-hover); }
  .pc__step--hl::after {
    content: ""; position: absolute; z-index: -1; inset: calc(var(--s-3) * -1) calc(var(--s-3) * -1) calc(var(--s-5) - var(--s-3)) calc(var(--s-3) * -1);
    background: var(--surface-hover); border-radius: var(--r-sm);
  }
  .pc__step--hl:last-child::after { bottom: calc(var(--s-3) * -1); }
  .pc__step--hl .pc__node { box-shadow: 0 0 0 3px var(--accent), 0 0 0 8px color-mix(in srgb, var(--accent) 22%, transparent); }
  .pc__step--hl .pc__note { color: var(--fg); }
  .pc__list { isolation: isolate; }

  /* horizontal: one column per step, the connector runs through the node centres */
  @container (min-width: 800px) {
    .pc__list { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); column-gap: var(--s-4); }
    .pc__step { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-2); padding: 0; align-content: start; }
    .pc__node { grid-row: auto; }
    .pc__step:not(:last-child)::before {
      left: calc(var(--node) / 2); right: calc((var(--s-4) + var(--node) / 2) * -1); top: calc(var(--node) / 2 - .5px); bottom: auto;
      width: auto; height: 1px;
    }
    .pc__n { line-height: 1.2; margin-top: var(--s-2); }
    .pc__name { padding-right: var(--s-2); font-size: 1.125rem; line-height: 1.3; }
    .pc__step--hl::after, .pc__step--hl:last-child::after { inset: calc(var(--s-4) * -1) calc(var(--s-2) * -1) calc(var(--s-4) * -1) calc(var(--s-3) * -1); }
  }
</style>
