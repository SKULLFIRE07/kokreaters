---
/**
 * Pack 3 (brief, Process development: "the refining step strip (Crude → Degumming → … → Spec) is excellent; add
 * enzymatic processing and oilseed crushing to it, and one capacity figure"). On Delft Ice.
 * Desktop (≥ 900px): the steps in one horizontal row (8 equal columns) on a 2px navy line, each a ringed node
 * (the logo's node), "01" and the label; Degumming and Interesterification carry a dashed "or enzymatic" tag.
 * The first and last nodes are filled. Long terms carry soft hyphens so they break at a syllable, never mid-letter.
 * Under a hairline: the capacity figure (career.ts, draft → staging/preview only; Bodoni number, Manrope unit) and the
 * enzymatic note. Phones (< 900px): the same <ol> as a vertical spine, labels to the right.
 * Replaces the shared ProcessFlow here (ProcessFlow turns vertical below ~1300px with eight steps).
 */
import Section from '@/components/ui/Section.astro';
import Confirm from '@/components/ui/Confirm.astro';
import Head from './Head.astro';
import { pillarExhibits, processStrip } from '@/data/pillars';
import { figure as careerFigure, isVisible } from '@/data/career';
import { microcopy } from '@/data/microcopy';
import { pad2 } from '@/lib/format';

const ex = pillarExhibits.process;
const steps = [ex.from, ...ex.steps, ...(ex.to ?? [])].filter((s): s is string => !!s);
const SHY: Record<string, string> = {
  Degumming: 'Degum­ming', Deodorisation: 'Deodor­isation', Fractionation: 'Fraction­ation',
  Interesterification: 'Inter­ester­ification', crushing: 'crush­ing',
};
const shy = (s: string) => s.replace(/[A-Za-z]{8,}/g, (w) => SHY[w] ?? w);
const enz = new Set<string>(processStrip.enzymatic.steps);
const cap = careerFigure(processStrip.figureId);
const showCap = isVisible(cap);
---
<Section ground="white" class="band--ice" labelledby="exhibit-title">
  <Head id="exhibit-title" label={microcopy.exhibit} title={ex.title} />
  <figure class="rs" aria-labelledby="exhibit-title">
    <ol class="rs__list" role="list" style={`--n: ${steps.length}`}>
      {steps.map((s, i) => (
        <li class:list={['rs__step', (i === 0 || i === steps.length - 1) && 'rs__step--end']}>
          <span class="rs__node" aria-hidden="true"></span>
          <span class="rs__n" aria-hidden="true">{pad2(i + 1)}</span>
          <span class="rs__label">{shy(s)}</span>
          {enz.has(s) && <span class="rs__enz">or enzymatic</span>}
        </li>
      ))}
    </ol>
    <div class="rs__foot">
      {showCap && (
        <p class="rs__cap">
          <span class="rs__fig"><span>{cap.value}</span>{cap.unit && <span class="rs__unit">{cap.unit}</span>}</span>
          <span class="rs__caplabel">{cap.label}{cap.status === 'draft' && <Confirm id="P-figures" note="draft career figure" />}</span>
        </p>
      )}
      <figcaption class="rs__note">{processStrip.enzymatic.note}</figcaption>
    </div>
  </figure>
</Section>
<style>
  .rs { margin: 0; padding-top: var(--s-7); border-top: 1px solid var(--rule); }
  .rs__list { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: var(--s-5); }
  .rs__list::before { content: ""; position: absolute; left: 11px; top: 12px; bottom: 12px; width: 2px; background: var(--head); }
  .rs__step { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: 12px; row-gap: 6px; padding-left: 44px; }
  .rs__node { position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--white); border: 2px solid var(--head); box-shadow: 0 0 0 4px var(--ice); }
  .rs__node::after { content: ""; position: absolute; inset: 5px; border-radius: 50%; background: var(--label); }
  .rs__step--end .rs__node { background: var(--label); border-color: var(--label); }
  .rs__step--end .rs__node::after { background: var(--white); inset: 7px; }
  .rs__n { font: 700 .875rem/1 var(--font-sans); color: var(--label); font-variant-numeric: lining-nums tabular-nums; padding-top: 4px; }
  .rs__label { font: 700 1.0625rem/1.3 var(--font-sans); color: var(--head); hyphens: manual; }
  .rs__enz { grid-column: 2; justify-self: start; padding: 3px 8px; border: 1px dashed var(--label); font: 700 .8125rem/1.2 var(--font-sans); color: var(--label); white-space: nowrap; }

  .rs__foot { margin-top: var(--s-7); padding-top: var(--s-6); border-top: 1px solid var(--rule); display: grid; gap: var(--s-6); align-items: end; }
  .rs__cap { display: grid; gap: var(--s-2); }
  .rs__fig { display: flex; align-items: baseline; gap: .3rem; font-family: var(--font-serif); font-size: clamp(3.5rem, 2.8rem + 2vw, 5rem); line-height: 1; color: var(--head); font-variant-numeric: lining-nums; white-space: nowrap; }
  .rs__unit { font: 700 clamp(1.125rem, 1rem + .4vw, 1.5rem)/1 var(--font-sans); }
  .rs__caplabel { font-size: 1rem; line-height: 1.5; color: var(--fg-2); max-width: 34ch; }
  .rs__note { padding-left: var(--s-4); border-left: 2px dashed var(--label); font-size: 1.0625rem; line-height: 1.5; font-weight: 600; color: var(--head); max-width: 40ch; }

  @media (min-width: 900px) {
    .rs { padding-top: var(--s-8); }
    .rs__list { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0 12px; }
    .rs__list::before { left: 12px; right: calc((100% - (var(--n) - 1) * 12px) / var(--n) - 12px); top: 11px; bottom: auto; width: auto; height: 2px; }
    .rs__step { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 44px 0 0; }
    .rs__label { font-size: 1rem; }
    .rs__foot { grid-template-columns: auto minmax(0, 1fr); column-gap: var(--s-9); }
    .rs__note { justify-self: end; }
  }
</style>
