---
/**
 * /expertise (v4 Delft). Grounds: navy photo hero → white (the six services) → ice (the approach lanes) → CtaBand.
 *  1 PillarHero: wheat against a blue sky under the navy gradient; label "Expertise", H1, the overview intro.
 *  2 The six services (white): Head (label "What we do", h2, lead) and PillarIndex (six editorial photo rows).
 *  3 ApproachLanes (ice): Develop / Scale / Access photo cards, each linking to its service.
 *  4 "Not sure where you fit?": BaseLayout's CtaBand.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHero from '@/components/expertise/PillarHero.astro';
import Head from '@/components/expertise/Head.astro';
import Section from '@/components/ui/Section.astro';
import PillarIndex from '@/components/expertise/PillarIndex.astro';
import ApproachLanes from '@/components/approach/ApproachLanes.astro';
import { expertiseHubPhoto, expertiseOverview, pillars } from '@/data/pillars';
import { whatWeDo } from '@/data/home';
import { photos } from '@/data/photos';
import { microcopy } from '@/data/microcopy';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: expertiseOverview.overline, href: '/expertise' }];
const prompt = expertiseOverview.prompt;
const hero = photos[expertiseHubPhoto.slug];
---
<BaseLayout
  page="expertise" seo={pageSeo('expertise')} breadcrumbs={crumbs}
  cta={{ title: prompt.text, primary: { label: prompt.link.label, href: prompt.link.href } }}
>
  <PillarHero
    crumbs={crumbs} eyebrow={expertiseOverview.overline} title={expertiseOverview.headline} titleId="expertise-title"
    lead={expertiseOverview.intro}
    image={hero.src} imageAlt={hero.alt} imagePosition={expertiseHubPhoto.position ?? hero.position}
  />

  <Section ground="white" labelledby="areas-title">
    <Head id="areas-title" label={whatWeDo.overline} title={microcopy.expertiseAreas} lead={whatWeDo.intro} />
    <PillarIndex items={pillars} />
  </Section>

  <ApproachLanes />
</BaseLayout>
