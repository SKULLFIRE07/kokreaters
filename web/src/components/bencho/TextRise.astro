/** TextRise: optional wrapper that renders a heading (or any tag) with the R1 hook. Script: scripts/bencho/text-rise.ts
 * (booted by motion/index.ts). <TextRise as="h2" class="t-h2" mode="lines">Six ways…</TextRise>. Never an h1. */
interface Props { as?: 'h2' | 'h3' | 'h4' | 'p' | 'div' | 'span'; mode?: 'lines' | 'words'; class?: string; id?: string }
const { as: Tag = 'h2', mode = 'lines', class: cls, id } = Astro.props;
---
<Tag id={id} class={cls} data-rise={mode}><slot /></Tag>
