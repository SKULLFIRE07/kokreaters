---
/** Staging only (v2 7.7): a hazard-tape band, mono caps, Ink on Butter between Saffron/Ink stripes. */
import { isStaging } from '@/lib/mode';
import { microcopy } from '@/data/microcopy';
interface Props { size?: 'sm' | 'md'; class?: string; }
const { size = 'md', class: cls } = Astro.props;
---
{isStaging && <p class:list={['draft-ribbon', `draft-ribbon--${size}`, cls]} data-draft><span>{microcopy.draftRibbon}</span></p>}
<style>
  .draft-ribbon {
    margin: 0; display: block; padding: 5px 0;
    background: repeating-linear-gradient(45deg, var(--kk-saffron) 0 8px, var(--kk-ink) 8px 16px);
  }
  .draft-ribbon span {
    display: block; padding: 4px var(--s-4); background: var(--kk-butter); color: var(--kk-ink);
    font-family: var(--font-mono); font-size: 12px; font-weight: 500; line-height: 16px; letter-spacing: .1em; text-transform: uppercase;
  }
  .draft-ribbon--sm { display: inline-block; padding: 3px; border-radius: 4px; }
  .draft-ribbon--sm span { display: inline-block; padding: 1px 8px; border-radius: 2px; font-size: 11px; letter-spacing: .08em; }
</style>
