---
/**
 * About · career (brief item 22). Grey band, aria-labelledby="journey-title".
 * SectionHeader (h2 "From CFTRI Mysore to KoKreaters", lead "Eight places, five countries, three continents of teams."),
 * then an <ol> of the seven rows exactly as the brief's table, on a vertical spine with the ringed-node signature (the
 * logo's node on a 1px hairline). Each stop: the years as a Deep Delft label ("1996–1999" … "Today"), the organisation
 * as a Bodoni h3 and its one line. The last row, "Today · KoKreaters", takes the saffron node.
 * Under the timeline, the places line: "Mundra · Medan · Odessa · Kakinada · Gurugram · Balikesir · Pune · Amsterdam"
 * (a list, separators decorative), small caps on a hairline.
 * ≥ 1200px: the header sits in columns 1–5 and stays pinned (sticky, under the header) while the stops scroll past in
 *   columns 7–12. 900–1199px: header above, the stops in columns 3–12. Mobile: header above; stops stacked on the left
 *   spine, years over organisation over line; the places wrap.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { timeline, timelineSection } from '@/data/about';
---
<Section ground="grey" labelledby="journey-title" class="career">
  <div class="career__grid">
    <div class="career__head">
      <SectionHeader id="journey-title" title={timelineSection.heading} lead={timelineSection.subtitle} layout="stack" />
    </div>
    <ol class="tl" role="list">
      {timeline.map((t) => (
        <li class:list={['tl__stop', t.now && 'tl__stop--now']}>
          <span class="tl__node" aria-hidden="true"></span>
          <p class="tl__years tnum">{t.years}</p>
          <div class="tl__text">
            <h3 class="tl__org">{t.org}</h3>
            <p class="tl__role">{t.line}</p>
          </div>
        </li>
      ))}
    </ol>
    <ul class="career__places" role="list" aria-label={timelineSection.placesLabel}>
      {timelineSection.places.map((p, i) => (
        <li>{p}{i < timelineSection.places.length - 1 && <span class="career__sep" aria-hidden="true">·</span>}</li>
      ))}
    </ul>
  </div>
</Section>
<style>
  .career__grid { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-8); }
  .career__head :global(.sh) { margin-bottom: 0; }

  .tl { --node: 18px; list-style: none; margin: 0; padding: 0; position: relative; }
  .tl__stop {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-2);
    padding: 0 0 var(--s-7) calc(var(--node) + var(--s-5));
  }
  .tl__stop:last-child { padding-bottom: 0; }
  .tl__stop:not(:last-child)::before {
    content: ""; position: absolute; left: calc(var(--node) / 2 - .5px); top: calc(var(--node) / 2 + 2px); bottom: calc(var(--node) / -2 - 2px);
    width: 1px; background: var(--rule);
  }
  .tl__node {
    position: absolute; left: 0; top: 2px; z-index: 1;
    width: var(--node); height: var(--node); border-radius: 50%;
    background: var(--bg); border: 2px solid var(--link); box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 10px var(--link);
  }
  .tl__stop--now .tl__node { border-color: var(--saffron); box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 10px var(--saffron); }

  .tl__years {
    margin: 0; font: 700 var(--fs-label)/1.6 var(--font-sans); letter-spacing: var(--tr-label); text-transform: uppercase;
    color: var(--label); font-variant-numeric: lining-nums tabular-nums;
  }
  .tl__text { min-width: 0; }
  .tl__org { margin: 0; font-family: var(--font-serif); font-size: 1.75rem; line-height: 1.2; font-weight: 400; }
  .tl__role { margin: var(--s-2) 0 0; max-width: 48ch; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2); text-wrap: pretty; }

  .career__places {
    list-style: none; margin: 0; padding: var(--s-5) 0 0; border-top: 1px solid var(--rule);
    display: flex; flex-wrap: wrap; gap: var(--s-2) 0;
    font: 700 var(--fs-label)/1.6 var(--font-sans); letter-spacing: var(--tr-label); text-transform: uppercase; color: var(--head);
  }
  .career__places li { white-space: nowrap; }
  .career__sep { display: inline-block; padding-inline: .7em; color: var(--saffron); }

  @media (min-width: 900px) {
    .career__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .career__head { grid-column: 1 / -1; }
    .tl { grid-column: 3 / -1; }
    .tl__stop { padding-bottom: var(--s-8); }
    .career__places { grid-column: 1 / -1; }
  }

  /* ≥ 1200: the header pinned in columns 1–5 while the stops scroll past in 7–12 */
  @media (min-width: 1200px) {
    .career__head { grid-column: 1 / 6; grid-row: 1 / span 2; position: sticky; top: calc(var(--header-h) + var(--s-8)); align-self: start; }
    .tl { grid-column: 7 / -1; }
    .career__places { grid-column: 7 / -1; }
  }
</style>
