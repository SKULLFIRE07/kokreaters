---
/**
 * Home 7 · Founder (REDESIGN-V3 §4 Home 7, §8.4). Grey band, tight padding (a single pull-quote, not a content
 * band). ≥ 900px: the studio portrait (src/assets/photos/ganeaysh-portrait.jpg, 4:5) in columns 1–4 (1–3 from 1200px),
 * one column of air, then the rest: the band label "Founder" (the section's h2), the founder quote in serif italic with
 * a hanging open quote, the byline (founder.ts name + role) and "Meet Ganeaysh" → /about, vertically centred on the
 * portrait. Portrait and padding are sized so Home stays inside §8.2's 5,500–6,500px at 1440 (§4's 5-column portrait
 * was ~590px tall, taller than the quote it frames). The quote wording is CONFIRM 4 (staging-only tag).
 * Mobile (< 900px): designed as a quote with a photo byline, not a collapsed desktop: label → quote → a row with the
 *  portrait at 4:5 (112px wide, 144px from 600px) beside the name, role and link. No full-width face on a phone.
 * The attribution sits outside the blockquote (WHATWG), in the byline that follows it.
 */
import Section from '@/components/ui/Section.astro';
import Photo from '@/components/ui/Photo.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { founderQuote } from '@/data/home';
import { founderName, founderRole, portraitAlt } from '@/data/founder';
import { site } from '@/config/site';
import portrait from '@/assets/photos/ganeaysh-portrait.jpg';
---
<Section ground="grey" pad="tight" labelledby="founder-heading" class="hf">
  <div class="hf__grid">
    <h2 id="founder-heading" class="hf__label t-label" data-reveal>{founderQuote.folio}</h2>
    <div class="hf__media" data-reveal>
      <Photo
        src={portrait} alt={portraitAlt.founder} ratio="4/5" position="50% 18%"
        sizes="(min-width: 1200px) 276px, (min-width: 900px) 31vw, (min-width: 600px) 144px, 112px"
        widths={[112, 144, 224, 288, 380, 560, 760, 1140]}
        data-settle
      />
    </div>
    <blockquote class="hf__quote t-quote" data-reveal style="--i:1">
      <p>“{founderQuote.quote}”</p>
    </blockquote>
    <div class="hf__by" data-reveal style="--i:2">
      <p class="hf__who">
        <span class="hf__name">{founderName}</span>
        <span class="hf__role">{founderRole}, {site.name}</span>
        <Confirm id={4} note="founder quote wording" />
      </p>
      <ArrowLink href={founderQuote.link.href} class="hf__link">{founderQuote.link.label}</ArrowLink>
    </div>
  </div>
</Section>

<style>
  .hf__grid {
    display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: var(--s-5);
    grid-template-areas: "label label" "quote quote" "media by";
  }
  .hf__label { grid-area: label; margin: 0 0 var(--s-5); color: var(--label); }
  .hf__quote { grid-area: quote; margin: 0 0 var(--s-6); color: var(--head); max-width: 26ch; text-wrap: pretty; }
  .hf__media { grid-area: media; }
  .hf__by { grid-area: by; align-self: center; }
  .hf__who { display: flex; flex-direction: column; gap: 2px; font-size: var(--fs-small); line-height: var(--lh-small); }
  .hf__name { font-weight: 600; color: var(--fg); }
  .hf__role { color: var(--fg-2); }
  .hf__who :global(.confirm) { align-self: flex-start; margin: var(--s-1) 0 0; }
  .hf__link { margin-top: var(--s-1); }

  @media (min-width: 600px) {
    .hf__grid { grid-template-columns: 144px minmax(0, 1fr); column-gap: var(--s-6); }
    .hf__quote { max-width: 32ch; }   /* three lines across the tablet width, not a narrow column with an empty half */
    .hf__quote p { text-indent: -.42em; }
  }
  @media (min-width: 900px) {
    .hf__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap);
      grid-template-rows: 1fr auto auto auto 1fr;
      grid-template-areas: none;
    }
    .hf__media { grid-column: 1 / span 4; grid-row: 1 / -1; align-self: center; }
    .hf__label { grid-column: 6 / -1; grid-row: 2; margin-bottom: var(--s-6); }
    .hf__quote { grid-column: 6 / -1; grid-row: 3; margin-bottom: 0; max-width: 30ch; }   /* 4 lines; fills the 7 columns */
    .hf__by { grid-column: 6 / -1; grid-row: 4; align-self: start; margin-top: var(--s-6); }
    .hf__who { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 2px var(--s-3); }
    .hf__link { margin-top: var(--s-3); }
  }
  @media (min-width: 1200px) {
    .hf__media { grid-column: 1 / span 3; }
    .hf__label, .hf__quote, .hf__by { grid-column: 5 / -1; padding-left: var(--s-5); }
  }
</style>
