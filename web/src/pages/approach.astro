---
/**
 * /approach (REDESIGN-V3 §4 Approach, §8.3, §8.8). Grounds: navy photo hero → white (promise) → grey (how we work)
 * → white (principles) → grey (ways to work with us) → white (FAQ) → grey CtaBand (BaseLayout) → navy footer.
 *  1. PageHero navy, background photo `people-01` (a working session; photos.md): crumbs, eyebrow "Approach",
 *     H1 "We create with you, not for you.", the intro in full (two sentences).
 *  2. Positioning: headline, promise, range (moved from Home, §8.3).
 *  3. Steps: Connect / Collaborate / Create on a ringed-node connector (ids connect / collaborate / create).
 *  4. Principles: five, numbered grid.
 *  5. EngagementTable: the five models, table ≥ 700px, stacked cards below.
 *  6. Faq: Accordion, answers from data only (C-22 in staging where approval is needed).
 * The crumpled report, the stamp, scribbles and margin notes are gone (copy-edits.md B5, C2–C5).
 * Mobile: the hero photo becomes a band above the text; every section is one column (see each component).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Positioning from '@/components/approach/Positioning.astro';
import Steps from '@/components/approach/Steps.astro';
import Principles from '@/components/approach/Principles.astro';
import EngagementTable from '@/components/approach/EngagementTable.astro';
import Faq from '@/components/approach/Faq.astro';
import { approach } from '@/data/approach';
import { photos } from '@/data/photos';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: approach.overline, href: '/approach' }];
const photo = photos['people-01'];
// Line-break discipline (§8 rule 9): "with you" is the phrase the headline turns on, so it never splits
// ("We create with you, / not for you." rather than "We create with / you, not for you."); "25 years" never breaks
// between number and unit (it did at 1024).
const title = approach.headline.replace(approach.swooshPhrase, approach.swooshPhrase.replace(' ', '\u00A0'));
const lead = approach.intro.replace(/(\d+) (years?)\b/g, '$1\u00A0$2');
---
<BaseLayout page="approach" seo={pageSeo('approach')} breadcrumbs={crumbs}>
  <PageHero
    ground="navy"
    eyebrow={approach.overline}
    title={title}
    lead={lead}
    crumbs={crumbs}
    image={photo.src}
    imageAlt={photo.alt}
    imagePosition={photo.position}
    titleId="ap-title"
  />
  <Positioning />
  <Steps />
  <Principles />
  <EngagementTable />
  <Faq />
</BaseLayout>
