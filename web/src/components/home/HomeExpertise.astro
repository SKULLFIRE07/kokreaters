---
/**
 * Home 3 · What we do (REDESIGN-V3 §4 Home 3, §9.3–9.4 "asymmetric editorial compositions", "sticky storytelling").
 * Grey band. ≥ 1200px: a 5/7 split. Columns 1–5 hold the header (eyebrow "What we do", the brief's "Six ways we create
 *  value, together.", the intro, "All expertise →"); it stays sticky under the header while the six light
 *  ExpertiseCards scroll past in a 2 × 3 grid in columns 7–12 (one column of air between them).
 * 600–1199: header stacked on top (title, intro, link), then the cards 2 × 3 across the full width.
 * Mobile (< 600px): one column of full-width cards under the header; the link sits under the intro.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import ExpertiseCard from '@/components/cards/ExpertiseCard.astro';
import { whatWeDo } from '@/data/home';
import { pillars } from '@/data/pillars';
import { megaMenu } from '@/data/nav';
import { keepCompounds } from './typo';

// Promise lines are short display strings: keep "Go/No-Go" whole on a 360px phone.
const cards = pillars.map((p) => ({ ...p, promise: keepCompounds(p.promise) }));
---
<Section ground="grey" labelledby="whatwedo-heading" class="hx">
  <div class="hx__grid">
    <div class="hx__aside">
      <div class="hx__sticky">
        <SectionHeader
          id="whatwedo-heading"
          eyebrow={whatWeDo.overline}
          title={whatWeDo.headline}
          lead={whatWeDo.intro}
          layout="stack"
          class="hx__head"
        />
        <p class="hx__link" data-reveal style="--i:2"><ArrowLink href={megaMenu.all.href}>{megaMenu.all.label}</ArrowLink></p>
      </div>
    </div>
    <ul class="card-grid hx__cards" style="--cols:2" role="list">
      {cards.map((p, i) => (
        <li data-reveal style={`--i:${i % 2}`}><ExpertiseCard pillar={p} /></li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .hx__grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hx__grid :global(.hx__head) { margin-bottom: var(--s-5); }
  .hx__link { margin: 0 0 clamp(3rem, 2.2rem + 3.3vw, 5rem); }

  @media (min-width: 1200px) {
    .hx__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: start; }
    .hx__aside { grid-column: 1 / span 5; align-self: stretch; }
    .hx__sticky { position: sticky; top: calc(var(--header-h) + var(--s-8)); }
    .hx__grid :global(.hx__head) { margin-bottom: var(--s-6); }
    .hx__link { margin: 0; }
    .hx__cards { grid-column: 7 / -1; }
  }
</style>
