---
/**
 * About · education and credentials (pack 3: "put education in a separate small block"; credentials strip and
 * languages). A compact white band, aria-labelledby="cred-title": a small h2, then text-only columns (no third-party
 * logos): Education · Executive education · Recognition · Languages, from src/data/career.ts `credentials` and
 * `languages`. Draft groups (Memberships, Talks and publications: no confirmed items yet) render only in staging, as
 * their heading and <Confirm id="P-11">; elsewhere they are left out and the grid closes up.
 * Column headings are Manrope labels (Bodoni only at 28px and up); each row is the qualification (bold) over the
 * institution (meta). ≥ 1200px one row of all visible columns; 600–1199px two; phones one, compact.
 */
import Section from '@/components/ui/Section.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { credentials, languages } from '@/data/career';
import { credentialsSection } from '@/data/about';
import { showConfirm } from '@/lib/mode';

type Col = { heading: string; rows: { main: string; meta?: string }[]; confirm?: string };
const groups: Col[] = credentials
  .filter((g) => g.items.length > 0 || showConfirm)
  .map((g) => ({ heading: g.heading, rows: g.items, confirm: g.items.length === 0 ? g.confirm : undefined }));
const cols: Col[] = [
  ...groups.filter((g) => g.rows.length > 0),
  { heading: credentialsSection.languagesHeading, rows: [{ main: languages.join(', ') }] },
  ...groups.filter((g) => g.rows.length === 0),
];
---
<Section ground="white" labelledby="cred-title" class="cred">
  <h2 id="cred-title" class="cred__title">{credentialsSection.heading}</h2>
  <div class="cred__cols" style={`--n:${Math.min(cols.length, 4)}`}>
    {cols.map((c, i) => (
      <div class:list={['cred__col', i === 0 && 'cred__col--lead']}>
        <h3 class="cred__h">{c.heading}</h3>
        {c.rows.length > 0 ? (
          <ul class="cred__list" role="list">
            {c.rows.map((r) => (
              <li class="cred__item"><span class="cred__main">{r.main}</span>{r.meta && <span class="cred__meta">{r.meta}</span>}</li>
            ))}
          </ul>
        ) : <p class="cred__pending"><Confirm id="P-11" note={c.confirm} /></p>}
      </div>
    ))}
  </div>
</Section>
<style>
  .cred__title { margin: 0 0 var(--s-7); font-family: var(--font-serif); font-weight: 400; font-size: 1.75rem; line-height: 1.2; color: var(--head); }
  .cred__cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6) var(--grid-gap); }
  .cred__col { padding-top: var(--s-4); border-top: 1px solid var(--rule); min-width: 0; }
  .cred__col--lead { border-top: 3px solid var(--saffron); padding-top: calc(var(--s-4) - 2px); }
  .cred__h {
    margin: 0 0 var(--s-3); font: 700 var(--fs-label)/1.6 var(--font-sans); letter-spacing: var(--tr-label);
    text-transform: uppercase; color: var(--label);
  }
  .cred__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .cred__item { display: grid; gap: 2px; }
  .cred__main { font-size: var(--fs-body); line-height: 1.4; font-weight: 600; color: var(--head); }
  .cred__meta { font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .cred__pending { margin: 0; }
  @media (min-width: 600px) { .cred__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-7); } }
  @media (min-width: 1200px) { .cred__cols { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); } }
</style>
