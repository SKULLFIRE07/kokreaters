/** GravityTags (DESIGN-SPEC v2 9, P-home): a white box (2px Ink border, radius 28) holding a real <ul> of links as pills.
 * Static / no JS / reduced motion: a flex-wrap pill list. scripts/bencho/gravity-tags.ts (lazy, near the viewport)
 * drops them from above once, piles them, and lets you drag and throw (double-click = follow the link). The links stay in
 * DOM order and keyboard focusable; focusing one wakes it to the front. */
import type { GroundKey } from '@/data/types';
interface Props { items: { label: string; href: string }[]; label: string; class?: string }
const { items, label, class: cls } = Astro.props;
const G: GroundKey[] = ['sapphire', 'saffron', 'violet', 'sky', 'orchid', 'mauve', 'ice', 'butter', 'lavender'];
---
<div class:list={['gtags', cls]} data-gravity-tags data-toy data-cursor="throw">
  <ul class="gtags__list" role="list" aria-label={label}>
    {items.map((it, i) => (
      <li class="gtags__item"><a href={it.href} class:list={['gtags__tag', `g-${G[i % G.length]}`]} draggable="false">{it.label}</a></li>
    ))}
  </ul>
</div>
<style>
  .gtags {
    position: relative; min-height: 480px; border-radius: 28px; background: #fff; box-shadow: inset 0 0 0 2px var(--kk-ink);
    overflow: hidden; touch-action: pan-y;
  }
  .gtags__list { list-style: none; margin: 0; padding: 28px; display: flex; flex-wrap: wrap; gap: 12px; align-content: flex-end; min-height: 480px; box-sizing: border-box; }
  .gtags__item { display: contents; }
  .gtags__tag {
    display: inline-flex; align-items: center; height: 56px; padding: 0 22px; border-radius: 999px; white-space: nowrap;
    font: 700 20px/1 var(--font-display); font-stretch: 85%; letter-spacing: -0.005em; text-decoration: none; color: var(--fg);
    box-shadow: inset 0 0 0 2px var(--kk-ink); user-select: none; -webkit-user-select: none;
  }
  .gtags__tag:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .gtags__tag:focus-visible { outline: 3px solid var(--kk-cobalt); outline-offset: 3px; }
  /* physics mode: the pills are absolutely placed and moved by transform */
  .gtags.is-live .gtags__tag { position: absolute; left: 0; top: 0; cursor: grab; will-change: transform; touch-action: none; }
  .gtags.is-live .gtags__tag:active { cursor: grabbing; }
  @media (max-width: 767px) {
    .gtags, .gtags__list { min-height: 420px; }
    .gtags__tag { height: 48px; padding: 0 18px; font-size: 18px; }
  }
</style>
