---
/**
 * IntroMore (DESIGN-SPEC v2 00.1): a lead whose first sentence stays visible and whose rest folds into a native
 * <details> ("Read the full note +"). Everything stays in the DOM (SEO, no cloaking); the toggle is the native summary.
 * `html` is trusted markup from src/data (abbr expansions).
 */
import { expertiseNotes } from '@/data/notes/expertise';
interface Props { html: string; class?: string }
const { html, class: cls } = Astro.props;
// split after the first sentence (". " outside any tag); short intros stay whole
const at = html.search(/\.\s(?=[A-Z])/);
const first = at > 0 ? html.slice(0, at + 1) : html;
const rest = at > 0 ? html.slice(at + 2) : '';
---
<div class:list={['imore', cls]}>
  <p class="t-lead imore__first" set:html={first} />
  {rest && (
    <details class="imore__more">
      <summary class="imore__sum"><span class="t-hand">{expertiseNotes.overview.more}</span><span class="imore__plus" aria-hidden="true"></span></summary>
      <p class="t-lead imore__rest" set:html={rest} />
    </details>
  )}
</div>
<style>
  .imore__first { margin: 0; color: var(--fg); }
  .imore__more { margin-top: var(--s-4); }
  .imore__sum {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px 2px 18px; cursor: pointer;
    border-radius: var(--r-pill); box-shadow: inset 0 0 0 2px var(--fg); color: var(--fg); list-style: none;
    transition: background-color var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo), rotate var(--d-ui) var(--ease-expo);
  }
  .imore__sum::-webkit-details-marker { display: none; }
  .imore__sum:hover { box-shadow: inset 0 0 0 2px var(--fg), var(--shadow-hard); rotate: -1deg; }
  .imore__sum:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .imore__plus { position: relative; width: 14px; height: 14px; }
  .imore__plus::before, .imore__plus::after { content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 2px; border-radius: 2px; background: currentColor; transition: rotate var(--d-ui) var(--ease-expo); }
  .imore__plus::after { rotate: 90deg; }
  .imore__more[open] .imore__plus::after { rotate: 0deg; }
  .imore__rest { margin: var(--s-4) 0 0; color: var(--fg); }
  .imore :global(abbr) { text-decoration: underline dotted 1px; text-underline-offset: .18em; cursor: help; }
  @media (prefers-reduced-motion: reduce) { .imore__sum:hover { rotate: 0deg; } }
</style>
