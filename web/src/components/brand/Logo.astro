---
/**
 * KoKreaters logo, vector (REDESIGN-V3 §2–3). The SVGs live in src/assets/brand/svg/. The mark is never recoloured,
 * stretched or re-set: only the whole mark is scaled uniformly. Every variant loads as a cached <img> (crisp at any DPR,
 * not repeated inline in each page); `inline` renders a single-file variant as inline SVG instead.
 * v3: the v2 home "dock" (header cluster hidden on home, flown in by dock.ts) is gone; the header shows the whole
 * horizontal lockup from the first paint.
 *
 * Variants
 *  - horizontal / horizontal-white: cluster + wordmark on one line (`height`, default 44; chrome sets 36 desktop /
 *    30 mobile). White header → horizontal; navy footer / menu bar → horizontal-white.
 *  - full / full-white: cluster + wordmark + tagline (`width`, default 320 / 260; or `height`, which sizes it by height
 *    through --logo-h like the horizontal lockup). v4: the header uses `full` at 52px (the business-card logo with
 *    "Connect · Collaborate · Create"); the footer uses `full` on a white plate.
 *  - wordmark / wordmark-white: the wordmark alone (`width` any CSS length, default 100%).
 *  - cluster: the node cluster alone (`size`, default 64). For a monochrome cluster use brand/NodeMark.
 * Accessible name: inside a link (`href`) the image is alt="" and the link carries `label`; standalone `full` /
 * `full-white` get `alt` (default "KoKreaters: Connect · Collaborate · Create"); other standalone variants are
 * decorative unless `alt` is passed.
 * Mobile: scales with `height` / `width`; never wider than its container.
 */
import horizontalUrl from '@/assets/brand/svg/kokreaters-logo-horizontal.svg?url';
import horizontalWhiteUrl from '@/assets/brand/svg/kokreaters-logo-horizontal-white.svg?url';
import fullRaw from '@/assets/brand/svg/kokreaters-logo-full.svg?raw';
import fullUrl from '@/assets/brand/svg/kokreaters-logo-full.svg?url';
import fullWhiteRaw from '@/assets/brand/svg/kokreaters-logo-full-white.svg?raw';
import fullWhiteUrl from '@/assets/brand/svg/kokreaters-logo-full-white.svg?url';
import wordmarkRaw from '@/assets/brand/svg/kokreaters-wordmark.svg?raw';
import wordmarkUrl from '@/assets/brand/svg/kokreaters-wordmark.svg?url';
import wordmarkWhiteRaw from '@/assets/brand/svg/kokreaters-wordmark-white.svg?raw';
import wordmarkWhiteUrl from '@/assets/brand/svg/kokreaters-wordmark-white.svg?url';
import nodeRaw from '@/assets/brand/svg/kokreaters-node-cluster.svg?raw';
import nodeUrl from '@/assets/brand/svg/kokreaters-node-cluster.svg?url';

export type LogoVariant = 'horizontal' | 'horizontal-white' | 'full' | 'full-white' | 'wordmark' | 'wordmark-white' | 'cluster'
  | 'full-reversed'; // v1 name, kept as an alias of full-white
interface Props {
  variant?: LogoVariant;
  href?: string | null;
  label?: string;
  alt?: string;
  height?: number;
  width?: number | string;
  size?: number;
  inline?: boolean;
  loading?: 'lazy' | 'eager';
  class?: string;
  id?: string;
}
const { label = 'KoKreaters home', class: cls, id, inline = false } = Astro.props;
const variant: Exclude<LogoVariant, 'full-reversed'> = Astro.props.variant === 'full-reversed' ? 'full-white' : (Astro.props.variant ?? 'horizontal');
const href = Astro.props.href ?? null;
const Tag = href ? 'a' : 'span';
const loading = Astro.props.loading ?? (variant.startsWith('horizontal') ? 'eager' : 'lazy');

/** Inner markup of an SVG file (no XML comment, no ids, no outer <svg>). */
const inner = (raw: string) => raw.replace(/<!--[\s\S]*?-->/g, '').replace(/\s+id="[^"]*"/g, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
const viewBoxOf = (raw: string) => (raw.match(/viewBox="([^"]+)"/) ?? [])[1] ?? '0 0 100 100';
const ratioOf = (raw: string) => { const [, , w, h] = viewBoxOf(raw).split(/\s+/).map(Number); return w / h; };

const isHorizontal = variant === 'horizontal' || variant === 'horizontal-white';
const height = Astro.props.height ?? 44;
const byHeight = !isHorizontal && Astro.props.height !== undefined && Astro.props.width === undefined;
const HORIZONTAL_RATIO = 2180 / 615; // viewBox of kokreaters-logo-horizontal(-white).svg

const files = {
  full: [fullRaw, fullUrl], 'full-white': [fullWhiteRaw, fullWhiteUrl], wordmark: [wordmarkRaw, wordmarkUrl],
  'wordmark-white': [wordmarkWhiteRaw, wordmarkWhiteUrl], cluster: [nodeRaw, nodeUrl],
} as const;
const single = isHorizontal ? null : files[variant as keyof typeof files];
const defaultWidth = variant === 'full' ? 320 : variant === 'full-white' ? 260 : variant === 'cluster' ? (Astro.props.size ?? 64) : '100%';
const w = Astro.props.width ?? defaultWidth;
const cssW = typeof w === 'number' ? `${w}px` : w;
const pxW = typeof w === 'number' ? w : 600;
const ratio = single ? ratioOf(single[0]) : HORIZONTAL_RATIO;

const name = !href ? (Astro.props.alt ?? (variant === 'full' || variant === 'full-white' ? 'KoKreaters: Connect · Collaborate · Create' : '')) : '';
const svgA11y: Record<string, string> = name ? { role: 'img', 'aria-label': name } : { 'aria-hidden': 'true' };
---
{isHorizontal ? (
  <Tag href={href ?? undefined} id={id} class:list={['logo', 'logo--horizontal', `logo--${variant}`, cls]} aria-label={href ? label : undefined} style={`--logo-h:${height}px`}>
    <img
      class="logo__img" src={variant === 'horizontal' ? horizontalUrl : horizontalWhiteUrl} alt={name}
      width={Math.round(height * HORIZONTAL_RATIO)} height={height} loading={loading} decoding="async"
    />
  </Tag>
) : single && (
  <Tag href={href ?? undefined} id={id} class:list={['logo', `logo--${variant}`, byHeight && 'logo--h', cls]} aria-label={href ? label : undefined} style={byHeight ? `--logo-h:${height}px` : `--logo-w:${cssW}`}>
    {inline ? (
      <svg class="logo__svg" viewBox={viewBoxOf(single[0])} focusable="false" {...svgA11y} set:html={inner(single[0])} />
    ) : (
      <img class="logo__img" src={single[1]} alt={name} width={byHeight ? Math.round(height * ratio) : pxW} height={byHeight ? height : Math.round(pxW / ratio)} loading={loading} decoding="async" />
    )}
  </Tag>
)}
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; color: inherit; line-height: 0; flex: none; }
  .logo__svg, .logo__img { display: block; overflow: visible; isolation: isolate; max-width: none; }
  .logo--horizontal { height: var(--logo-h); }
  .logo--horizontal .logo__img { height: 100%; width: auto; aspect-ratio: 2180 / 615; }
  .logo:not(.logo--horizontal):not(.logo--h) { width: var(--logo-w); max-width: 100%; }
  .logo:not(.logo--horizontal):not(.logo--h) .logo__svg, .logo:not(.logo--horizontal):not(.logo--h) .logo__img { width: 100%; height: auto; }
  .logo--h { height: var(--logo-h); }
  .logo--h .logo__svg, .logo--h .logo__img { height: 100%; width: auto; }
</style>
