---
/**
 * Contact, left column (DESIGN-SPEC 5.10): dateline, the page H1, intro, direct details in an
 * <address>, then the page's one primary pill. Copy from @/data/contact and @/config/site (brief 6.8).
 */
import Dateline from '@/components/ui/Dateline.astro';
import Scribble from '@/components/notes/Scribble.astro';
import Ticket from '@/components/bencho/Ticket.astro';
import Confirm from '@/components/ui/Confirm.astro';
import Icon from '@/components/ui/Icon.astro';
import { contact } from '@/data/contact';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';

const W = 'together';
const hi = contact.headline.indexOf(W);
const head = hi > -1 ? [contact.headline.slice(0, hi), contact.headline.slice(hi + W.length)] : null;
---
<div class="cd">
  <Dateline text={contact.overline} />
  <h1 class="t-display cd__title" id="contact-title">{head ? <>{head[0]}<Scribble kind="highlight" delay={0.4}>{W}</Scribble>{head[1]}</> : contact.headline}</h1>
  <p class="t-lead cd__intro">{contact.intro}<Confirm id={9} /></p>

  <address class="cd__address">
    <dl class="cd__list">
      <div class="cd__item">
        <dt class="t-dateline">{contact.details.email}</dt>
        <dd class="t-lead"><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div class="cd__item">
        <dt class="t-dateline">{contact.details.whatsapp}</dt>
        <dd class="t-lead"><a href={site.whatsapp.href} rel="noopener"><span class="nowrap">{site.whatsapp.display}</span></a></dd>
      </div>
      <div class="cd__item">
        <dt class="t-dateline">{contact.details.linkedin}</dt>
        <dd class="t-lead">
          <a href={site.linkedin.href} rel="noopener me">{site.linkedin.display}<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span><Icon name="external" size={16} class="cd__ext" /></a>
        </dd>
      </div>
    </dl>
    <p class="t-lead cd__base">{site.base}</p>
  </address>

  <div class="cd__cta"><Ticket /></div>
</div>

<style>
  .cd__title { margin: var(--s-5) 0 0; font-size: clamp(3.25rem, 1.6rem + 5.6vw, 7.5rem); line-height: .9; text-wrap: balance; max-width: 9ch; }
  .cd__intro { margin: var(--s-6) 0 0; color: var(--fg); text-wrap: pretty; }
  .cd__address { font-style: normal; margin-top: var(--s-8); }
  .cd__list { margin: 0; display: grid; gap: 0; border-top: 2px solid var(--kk-ink); }
  .cd__item { display: grid; grid-template-columns: 104px minmax(0, 1fr); align-items: center; gap: var(--s-4); padding-block: var(--s-3); border-bottom: 1.5px dashed var(--kk-ink); }
  .cd__item dt { margin: 0; }
  .cd__item dd { margin: 0; overflow-wrap: anywhere; }
  .cd__item a {
    color: var(--kk-sapphire); text-decoration: none; font-weight: 500;
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px;
    background-image: linear-gradient(var(--kk-saffron), var(--kk-saffron)); background-size: 0 40%; background-repeat: no-repeat; background-position: 0 75%;
    transition: background-size 320ms var(--ease-expo);
  }
  .cd__item a:is(:hover, :focus-visible) { background-size: 100% 40%; color: var(--kk-ink); }
  .cd__item :global(.cd__ext) { color: var(--fg-2); }
  .cd__base { margin: var(--s-4) 0 0; color: var(--fg-2); }
  .cd__cta { margin-top: var(--s-8); }
  @media (max-width: 479px) { .cd__item { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: var(--s-4); } }
  @media (prefers-reduced-motion: reduce) { .cd__item a { transition: none; } }
</style>
