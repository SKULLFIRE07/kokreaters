---
/**
 * NodeMark — the logo's node cluster alone, the quiet signature (footer, 404, article end mark). REDESIGN-V3 §3.
 *  color — the logo artwork itself (kokreaters-node-cluster.svg, never recoloured), as a cached <img>.
 *  white / blue — a monochrome redraw from the same geometry in currentColor (white; --label = blue-700 on light,
 *                 blue-300 on navy). Lines and node discs are cut by a mask, so each node keeps its ring knockout on
 *                 any ground; the pastel discs of the colour mark are left out.
 * Decorative unless `label` is given. Mobile: fixed `size` px (default 48).
 */
import nodeUrl from '@/assets/brand/svg/kokreaters-node-cluster.svg?url';
interface Props {
  size?: number;
  tone?: 'color' | 'white' | 'blue';
  label?: string;
  class?: string;
}
const { size = 48, tone = 'color', label, class: cls } = Astro.props;
// geometry from kokreaters-node-cluster.svg (viewBox 20 15 570 570)
const nodes = [
  { x: 144, y: 184, r: 50 }, { x: 416, y: 135, r: 50 }, { x: 291, y: 316, r: 56 }, { x: 480, y: 431, r: 50 }, { x: 211, y: 500, r: 50 },
];
const lines = [
  { d: 'M144 184 L205 498', w: 26 }, { d: 'M144 184 L291 316', w: 26 }, { d: 'M291 316 L196 418', w: 24 },
  { d: 'M291 316 L416 135', w: 22 }, { d: 'M291 316 L480 431', w: 22 },
];
const ring = (r: number) => (r === 56 ? 41 : 37);
const dot = (r: number) => (r === 56 ? 30 : 27);
// unique, build-deterministic mask id per instance
const g = globalThis as { __kkNodeMark?: number };
g.__kkNodeMark = (g.__kkNodeMark ?? 0) + 1;
const mid = `nodemark-${g.__kkNodeMark}`;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
{tone === 'color' ? (
  <img class:list={['nodemark', cls]} src={nodeUrl} width={size} height={size} alt={label ?? ''} loading="lazy" decoding="async" />
) : (
  <svg class:list={['nodemark', `nodemark--${tone}`, cls]} width={size} height={size} viewBox="20 15 570 570" focusable="false" {...a11y}>
    <defs>
      <mask id={mid} maskUnits="userSpaceOnUse" x="20" y="15" width="570" height="570">
        <rect x="20" y="15" width="570" height="570" fill="#fff" />
        {nodes.map((n) => <circle cx={n.x} cy={n.y} r={ring(n.r)} fill="#000" />)}
      </mask>
    </defs>
    <g mask={`url(#${mid})`} fill="currentColor" stroke="currentColor" stroke-linecap="round">
      {lines.map((l) => <path d={l.d} stroke-width={l.w} fill="none" />)}
      {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} stroke="none" />)}
    </g>
    <g fill="currentColor">{nodes.map((n) => <circle cx={n.x} cy={n.y} r={dot(n.r)} />)}</g>
  </svg>
)}
<style>
  .nodemark { display: block; flex: none; }
  .nodemark--white { color: var(--white); }
  .nodemark--blue { color: var(--label); }
</style>
