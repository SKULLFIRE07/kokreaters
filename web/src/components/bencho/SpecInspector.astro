---
/**
 * SpecInspector (DESIGN-SPEC v2 9, 10.3 F2): wraps the honest SpecLabel. A toggle ("Inspect the label") shows a
 * draggable 220×160 frame (Sapphire, corner ticks); under it the label turns into its own blueprint (Sapphire ground,
 * White 1px grid, White lines) with mono measurement captions read off the real layout. Keyboard: the toggle opens /
 * closes it, arrow keys move the frame 16px while the toggle has focus, Esc closes. Touch: tap toggles the blueprint
 * over the whole label. The blueprint is an aria-hidden clone built by the script; no JS = label only (toggle hidden).
 *
 * Ported from the "spec-inspector" block of bencho.dev, MIT License, Copyright (c) 2026 Lorenzo Cabra.
 * See web/THIRD_PARTY_NOTICES.md for the full licence text. Restyled to KoKreaters v2 tokens.
 */
import MarginNote from '../notes/MarginNote.astro';
import { expertiseNotes } from '@/data/notes/expertise';
interface Props { fig?: string; count?: number; class?: string }
const { fig = '', count = 0, class: cls } = Astro.props;
const I = expertiseNotes.inspector;
---
<div class:list={['spi', 'has-notes', cls]} data-spec-inspector data-open-label={I.open} data-close-label={I.close}
  data-items={I.items.replace('{n}', String(count))} data-fig={fig ? I.fig.replace('{n}', fig) : ''}>
  <div class="spi__target" data-spi-target><slot /></div>
  <div class="spi__frame" data-spi-frame aria-hidden="true" hidden>
    <div class="spi__lens" data-spi-lens></div>
    <span class="spi__tick spi__tick--tl"></span><span class="spi__tick spi__tick--tr"></span>
    <span class="spi__tick spi__tick--bl"></span><span class="spi__tick spi__tick--br"></span>
    <span class="spi__cap spi__cap--top t-micro" data-spi-cap-top></span>
    <span class="spi__cap spi__cap--side t-micro" data-spi-cap-side></span>
  </div>
  <div class="spi__bar">
    <button type="button" class="spi__toggle" data-spi-toggle aria-pressed="false" hidden><span class="spi__eye" aria-hidden="true"></span><span class="t-hand" data-spi-label>{I.open}</span></button>
    <MarginNote text={I.hint} anchor="inline" arrow="arrow-loop" arrowAt="start" flip rotate={-4} arrowAngle={-150} show="pointer" />
  </div>
</div>
<style>
  .spi { position: relative; }
  .spi__target { position: relative; }
  .spi__frame {
    position: absolute; left: 0; top: 0; z-index: 3; width: 220px; height: 160px; cursor: grab; touch-action: none;
    border: 2px solid var(--kk-sapphire); border-radius: 4px; box-shadow: 0 0 0 4px rgb(44 80 158 / .18), var(--shadow-lift);
  }
  .spi__frame[hidden] { display: none; }
  .spi__frame.is-drag { cursor: grabbing; }
  .spi--full .spi__frame { cursor: default; }
  .spi__lens { position: absolute; inset: 0; overflow: hidden; border-radius: 2px; }
  .spi__lens :global(.spec) {
    position: absolute; left: 0; top: 0; margin: 0; pointer-events: none;
    --fg: var(--kk-white); --fg-2: var(--kk-ice); --head: var(--kk-white);
    background-color: var(--kk-sapphire) !important; color: var(--kk-white) !important; border-color: var(--kk-white) !important;
    background-image: linear-gradient(rgb(255 255 255 / .22) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / .22) 1px, transparent 1px) !important;
    background-size: 16px 16px !important;
  }
  .spi__lens :global(.spec *) { color: var(--kk-white) !important; border-color: var(--kk-white) !important; }
  .spi__lens :global(.spec__rule) { background: var(--kk-white) !important; }
  .spi__tick { position: absolute; width: 14px; height: 14px; border: 0 solid var(--kk-sapphire); }
  .spi__tick--tl { left: -9px; top: -9px; border-left-width: 3px; border-top-width: 3px; }
  .spi__tick--tr { right: -9px; top: -9px; border-right-width: 3px; border-top-width: 3px; }
  .spi__tick--bl { left: -9px; bottom: -9px; border-left-width: 3px; border-bottom-width: 3px; }
  .spi__tick--br { right: -9px; bottom: -9px; border-right-width: 3px; border-bottom-width: 3px; }
  .spi__cap { position: absolute; white-space: nowrap; padding: 3px 7px; border-radius: 4px; background: var(--kk-sapphire); color: var(--kk-white); }
  .spi__cap--top { left: -2px; bottom: calc(100% + 10px); }
  .spi__cap--side { left: calc(100% + 10px); top: 50%; translate: 0 -50%; writing-mode: vertical-rl; }
  .spi__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: var(--s-5); }
  .spi__toggle {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px 2px 16px; cursor: pointer;
    border: 0; border-radius: var(--r-pill); background: transparent; color: var(--fg); box-shadow: inset 0 0 0 2px var(--fg);
    transition: background-color var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo), rotate var(--d-ui) var(--ease-expo);
  }
  .spi__toggle[hidden], .spi__toggle[hidden] + :global(.note) { display: none !important; }
  .spi__toggle:hover { background: var(--kk-butter); box-shadow: inset 0 0 0 2px var(--fg), var(--shadow-hard); rotate: -1deg; }
  .spi__toggle:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .spi__toggle[aria-pressed="true"] { background: var(--kk-sapphire); color: var(--kk-white); box-shadow: inset 0 0 0 2px var(--kk-sapphire); }
  .spi__eye { position: relative; width: 22px; height: 14px; border: 2px solid currentColor; border-radius: 50% / 60%; }
  .spi__eye::after { content: ""; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; translate: -50% -50%; border-radius: 50%; background: currentColor; }
  @media (prefers-reduced-motion: reduce) { .spi__toggle:hover { rotate: 0deg; } }
</style>
