---
/**
 * /approach §4 — five principles as a numbered grid (REDESIGN-V3 §4 Approach). White band.
 * Six equal cells: the first holds the section heading, the other five the principles, so the grid closes with no
 * orphan cell. Every cell opens on a top rule (2px navy on the heading cell, 1px hairline on the principles);
 * a principle is "01" (serif numeral in --accent, ≥ 24px), serif h3 name, Inter body copy.
 * Desktop (≥ 900): 3 × 2. Tablet (600–899): 2 × 3. Mobile (< 600): one column — heading, then the five principles,
 * 40px apart, body 18px.
 */
import Section from '@/components/ui/Section.astro';
import { principles, principlesHeading } from '@/data/approach';
import { pad2 } from '@/lib/format';
---
<Section ground="white" labelledby="principles-h" class="principles">
  <div class="pr">
    <div class="pr__cell pr__cell--head" data-reveal>
      <h2 id="principles-h" class="t-h2 pr__title">{principlesHeading}</h2>
    </div>
    {principles.map((p, i) => (
      <div class="pr__cell" data-reveal style={`--i:${(i + 1) % 3}`}>
        <span class="pr__n" aria-hidden="true">{pad2(i + 1)}</span>
        <h3 class="t-h3 pr__name">{p.name}</h3>
        <p class="pr__copy">{p.copy}</p>
      </div>
    ))}
  </div>
</Section>
<style>
  .pr { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--grid-gap); row-gap: var(--s-7); }
  .pr__cell { border-top: 1px solid var(--rule); padding-top: var(--s-5); }
  .pr__cell--head { border-top: 2px solid var(--rule-strong); }
  .pr__title { margin: 0; }
  .pr__n {
    display: block; font-family: var(--font-serif); font-optical-sizing: auto; font-size: 1.75rem; line-height: 1;
    font-weight: 400; letter-spacing: -0.01em; color: var(--accent); font-variant-numeric: lining-nums tabular-nums;
  }
  .pr__name { margin-top: var(--s-4); }
  .pr__copy { margin-top: var(--s-3); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg); text-wrap: pretty; max-width: 40ch; }
  @media (min-width: 600px) {
    .pr { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-8); }
  }
  @media (min-width: 900px) {
    .pr { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pr__cell { padding-top: var(--s-6); padding-right: var(--s-5); }
    .pr__n { font-size: 2rem; }
    .pr__name { max-width: 18ch; }
  }
</style>
