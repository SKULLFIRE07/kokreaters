---
/**
 * Contact `/contact` (REDESIGN-V3 §4 Contact, §9 "elegant full screen"). No CtaBand: the page is the call to action.
 *  1 PageHero, grey, md (an airy band, H1 bottom-aligned): crumbs, eyebrow "Start a conversation", H1 contact.headline
 *    (#contact-title), intro. Aside: the founder who answers, his 4:5 studio portrait in its natural orientation
 *    (never cropped) standing on the band's bottom edge, name and role beside it (ContactFounder).
 *  2 White band, wide grid: contact details left (email, WhatsApp, LinkedIn as large serif lines, base + CET, booking
 *    card) · the form right.
 * Mobile (< 900px): one column. Hero text, then the founder as a small row (portrait 104px wide, standing on the band
 * edge, name beside it); then details (a short block) and the form at full width. ≥ 900px: details in columns 1–5,
 * sticky under the header while the longer form scrolls; form in columns 6–12 (two-up fields), from 1200px in 7–12
 * (a gap column between, so the two blocks breathe in the wide grid).
 * Grounds: grey hero → white band → navy footer.
 * The form behaviour lives in scripts/pages/contact.ts, loaded here (§8.6), not through the site bundle.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import ContactDetails from '@/components/contact/ContactDetails.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
import ContactFounder from '@/components/contact/ContactFounder.astro';
import { contact } from '@/data/contact';
import { microcopy } from '@/data/microcopy';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: contact.overline, href: '/contact' }];
---
<BaseLayout page="contact" seo={pageSeo('contact')} breadcrumbs={crumbs}>
  <PageHero
    ground="grey"
    size="md"
    crumbs={crumbs}
    eyebrow={microcopy.primaryCta}
    title={contact.headline}
    lead={contact.intro}
    titleId="contact-title"
  >
    <ContactFounder slot="aside" />
  </PageHero>

  <Section ground="white" labelledby="contact-details-h" class="contact">
    <div class="contact__grid">
      <div class="contact__details"><ContactDetails /></div>
      <div class="contact__form"><ContactForm /></div>
    </div>
  </Section>

  <script>import '@/scripts/pages/contact.ts';</script>
</BaseLayout>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-9); align-items: start; }
  @media (min-width: 900px) {
    .contact__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .contact__details { grid-column: 1 / 6; position: sticky; top: calc(var(--header-h-compact) + var(--s-7)); }
    .contact__form { grid-column: 6 / -1; }
  }
  @media (min-width: 1200px) { .contact__form { grid-column: 7 / -1; } }
</style>
