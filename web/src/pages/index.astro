---
/**
 * Home `/` (REDESIGN-V3 §4 Home, 8 sections). Grounds: navy hero → white credibility strip → grey what we do →
 * white featured insights → full-bleed photo interlude (oils-01, §9.1) → navy results → white industries → grey founder → white closing CTA + newsletter
 * (BaseLayout CtaBand: home gets { newsletter: true, ground: 'white' }) → navy footer.
 * Every string comes from src/data/* or the insights collection; JSON-LD (Organization + ProfessionalService +
 * WebSite) is added by BaseLayout for page="home". No page script: motion is the foundation's data-reveal/data-settle.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeProof from '@/components/home/HomeProof.astro';
import HomeExpertise from '@/components/home/HomeExpertise.astro';
import HomeInsights from '@/components/home/HomeInsights.astro';
import HomeResults from '@/components/home/HomeResults.astro';
import HomeIndustries from '@/components/home/HomeIndustries.astro';
import HomeFounder from '@/components/home/HomeFounder.astro';
import PhotoInterlude from '@/components/ui/PhotoInterlude.astro';
import { method } from '@/data/home';
import { pageSeo } from '@/lib/seo';
---
<BaseLayout page="home" seo={pageSeo('home')}>
  <HomeHero />
  <HomeProof />
  <HomeExpertise />
  <HomeInsights />
  {/* §9.1 photo interlude: golden oil from a steel spout (the core trade), captioned with the brief's own line
      "Connect. Collaborate. Create."; its navy foot runs straight into the navy results band. */}
  <PhotoInterlude slug="oils-01" size="lg" eyebrow={method.overline} caption={method.headline} />
  <HomeResults />
  <HomeIndustries />
  <HomeFounder />
</BaseLayout>
