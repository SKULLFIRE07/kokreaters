---
/** Pause motion (DESIGN-SPEC v2 7.1, WCAG 2.2.2). Rendered only while html.motion is set (.js-motion-only): under
 * reduced motion nothing loops. scripts/motion/pause.ts wires it: html.motion-paused, localStorage, onPause handlers.
 * At < 768 icon-only with the label visually hidden; hit area ≥ 44×44. */
import Icon from '@/components/ui/Icon.astro';
import { chromeNotes } from '@/data/notes/chrome';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<button type="button" class:list={['motion-toggle', 'js-motion-only', cls]} aria-pressed="false" data-motion-toggle
  data-label-pause={chromeNotes.motion.pause} data-label-play={chromeNotes.motion.play}>
  <span class="motion-toggle__icon motion-toggle__icon--pause"><Icon name="pause" size={16} /></span>
  <span class="motion-toggle__icon motion-toggle__icon--play"><Icon name="play" size={16} /></span>
  <span class="motion-toggle__label" data-motion-label>{chromeNotes.motion.pause}</span>
</button>
<style>
  .motion-toggle {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; min-width: 44px; padding: 0 4px; margin-block: -6px;
    background: none; border: 0; color: var(--fg); cursor: pointer; font: 500 13px/1 var(--font-mono); letter-spacing: .02em;
    justify-content: center;
  }
  .motion-toggle:hover { color: var(--link); }
  .motion-toggle__icon { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; }
  .motion-toggle__icon :global(svg) { width: 12px; height: 12px; }
  .motion-toggle__icon--play { display: none; }
  .motion-toggle[aria-pressed="true"] .motion-toggle__icon--play { display: inline-grid; }
  .motion-toggle[aria-pressed="true"] .motion-toggle__icon--pause { display: none; }
  @media (max-width: 767px) {
    .motion-toggle__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
