---
/** Imperial footer, merged with the CtaField above it (DESIGN-SPEC 3.5). */
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import Confirm from '@/components/ui/Confirm.astro';
import Newsletter from '@/components/shared/Newsletter.astro';
import { footer, legal } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';
---
<footer id="site-footer" class="site-footer band--dark on-dark" tabindex="-1">
  <div class="container">
    <div class="site-footer__logo">
      <Logo variant="full-reversed" />
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-labelledby="ft-expertise">
        <h2 id="ft-expertise" class="site-footer__head t-dateline">{footer.expertise.heading}</h2>
        <ul role="list">
          {footer.expertise.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <nav class="site-footer__col" aria-labelledby="ft-company">
        <h2 id="ft-company" class="site-footer__head t-dateline">{footer.company.heading}</h2>
        <ul role="list">
          {footer.company.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="site-footer__col">
        <h2 class="site-footer__head t-dateline">{footer.contact.heading}</h2>
        <ul role="list">
          <li><a href={footer.contact.email.href}>{footer.contact.email.label}</a></li>
          <li><a href={footer.contact.whatsapp.href} rel="noopener">{footer.contact.whatsapp.label}</a></li>
          <li>
            <a class="site-footer__ext" href={footer.contact.linkedin.href} rel="me noopener">
              {footer.contact.linkedin.label}<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span>
              <span class="site-footer__icon" aria-hidden="true"><Icon name="external" /></span>
            </a>
          </li>
          <li class="site-footer__base">{footer.contact.base}</li>
        </ul>
      </div>
      <div class="site-footer__col site-footer__col--news">
        <h2 class="site-footer__head t-dateline">{footer.newsletter.heading}</h2>
        <Newsletter variant="footer" />
      </div>
    </div>

    <div class="site-footer__bottom t-meta">
      <p class="site-footer__legal">
        <span class="nowrap">© 2026 {site.name}{site.trademark}</span>
        {legal.map((l) => (
          <><span class="site-footer__sep" aria-hidden="true">·</span><a href={l.href}>{l.label}</a></>
        ))}
        <span class="site-footer__sep js-only" aria-hidden="true">·</span>
        <button type="button" class="site-footer__settings js-only" data-cookie-settings aria-haspopup="dialog" aria-controls="cookie-settings">{microcopy.cookieSettings}</button>
      </p>
      <p class="site-footer__reg">
        {site.legal.registration ?? <Confirm id={11} note="KvK / VAT / registered address" />}
      </p>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    background: var(--c-dark); color: var(--c-on-dark);
    border-top: 1px solid var(--kk-white-20);
    padding-block: var(--s-9) var(--s-7);
  }
  .site-footer:focus { outline: none; }
  .site-footer__logo { width: 220px; max-width: 100%; }
  .site-footer__cols {
    display: grid; grid-template-columns: 1fr; gap: var(--s-7) var(--gutter);
    margin-top: var(--s-8);
  }
  @media (min-width: 600px) { .site-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .site-footer__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .site-footer__head { margin: 0 0 var(--s-4); color: var(--c-on-dark-muted); }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .site-footer__col li { font-size: var(--fs-nav); line-height: 1.5; }
  .site-footer__col a {
    display: inline-flex; align-items: center; gap: 6px;
    padding-block: 10px; min-height: 44px; box-sizing: border-box;
    color: rgb(255 255 255 / 0.9); text-decoration: none;
    transition: color var(--d-colour) var(--ease-out);
  }
  .site-footer a:hover { color: var(--c-highlight-dark); }
  .site-footer__icon { display: inline-flex; width: 14px; height: 14px; }
  .site-footer__icon svg { width: 14px; height: 14px; }
  .site-footer__base { color: var(--c-on-dark-muted); padding-block: 10px; text-wrap: balance; }
  .site-footer__col--news { color: rgb(255 255 255 / 0.9); }

  .site-footer__bottom {
    margin-top: var(--s-8); padding-top: var(--s-5);
    border-top: 1px solid var(--kk-white-20);
    display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); justify-content: space-between; align-items: center;
    color: var(--c-on-dark-muted);
  }
  .site-footer__legal { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-2); }
  .site-footer__legal a, .site-footer__settings {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--c-on-dark-muted); text-decoration: none;
    font: inherit; background: none; border: 0; padding: 0; cursor: pointer;
  }
  .site-footer__settings:hover { color: var(--c-highlight-dark); }
  .site-footer__sep { color: var(--c-on-dark-muted); opacity: 0.7; }
  /* Below 768px the legal row wraps; a dot would be left hanging at a line end, so the row becomes a spaced list. */
  @media (max-width: 767px) {
    .site-footer__legal { column-gap: var(--s-5); }
    .site-footer__sep { display: none; }
  }
  .site-footer__reg { margin: 0; }
</style>
