---
/**
 * SpecLabel (DESIGN-SPEC v2 6.3): the honest label, our nod to food packaging nutrition panels. Real content (not
 * decorative): a titled box with mono rows separated by rules, heavy 10px rules under the title and above the foot.
 * `headingLevel="none"` renders the title as <p> (when the fold's h2 already says it). `inspect` adds the hook for the
 * spec-inspector toy (P-expertise). Rows: `v` may be a string or a list (rendered with hand tick bullets);
 * `html: true` lets `v` carry trusted markup from src/data (e.g. <abbr>).
 */
import type { GroundKey } from '@/data/types';
import { nextId } from './paths';
interface Row { k: string; v: string | string[]; strong?: boolean; html?: boolean }
interface Props {
  title?: string;   // omit for an untitled label (e.g. inside a PillarCard)
  sub?: string;
  rows: Row[];
  foot?: string;
  ground?: GroundKey;
  headingLevel?: 2 | 3 | 4 | 'none';
  rotate?: number;
  inspect?: boolean;
  compact?: boolean;
  id?: string;
  class?: string;
}
const { title, sub, rows, foot, ground = 'white', headingLevel = 3, inspect = false, compact = false, class: cls } = Astro.props;
const id = Astro.props.id ?? `spec-${nextId()}`;
const rot = Math.max(-2, Math.min(2, Astro.props.rotate ?? 0));
const H = headingLevel === 'none' ? 'p' : (`h${headingLevel}` as 'h2' | 'h3' | 'h4');
const Root = headingLevel === 'none' || !title ? 'div' : 'section';
---
<Root
  class:list={['spec', `g-${ground}`, { 'spec--compact': compact }, cls]}
  id={id}
  aria-labelledby={headingLevel === 'none' || !title ? undefined : `${id}-t`}
  data-spec-inspect={inspect ? '' : undefined}
  style={rot ? `rotate:${rot}deg` : undefined}
>
  {title && <H id={`${id}-t`} class="spec__title">{title}</H>}
  {sub && <p class="spec__sub t-micro">{sub}</p>}
  <div class="spec__rule spec__rule--heavy" aria-hidden="true"></div>
  <dl class="spec__rows">
    {rows.map((r) => (
      <div class:list={['spec__row', { 'spec__row--strong': r.strong }]}>
        <dt class="t-label">{r.k}</dt>
        <dd class="t-mono">
          {Array.isArray(r.v) ? (
            <ul class="spec__list" role="list">{r.v.map((item) => (r.html ? <li set:html={item} /> : <li>{item}</li>))}</ul>
          ) : r.html ? <Fragment set:html={r.v} /> : r.v}
        </dd>
      </div>
    ))}
  </dl>
  {foot && (<>
    <div class="spec__rule spec__rule--heavy" aria-hidden="true"></div>
    <p class="spec__foot t-micro">{foot}</p>
  </>)}
</Root>
