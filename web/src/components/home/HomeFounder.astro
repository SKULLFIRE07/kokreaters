---
/**
 * Home 11 · Founder (v4 developer guide). Porcelain band: the studio portrait (src/assets/photos/ganeaysh-portrait.jpg)
 * left; right, vertically centred: "Founder" label, the quote in italic Bodoni (40/50), a 56 × 3px saffron rule (draws
 * in once), "Ganeaysh Kulkarni" + "Chief Catalyst and Founder, KoKreaters", and "Meet Ganeaysh →" (/about).
 * The attribution sits outside the blockquote (WHATWG). The quote wording is CONFIRM 4 (staging-only tag).
 * Motion: the portrait lifts a touch while it crosses the viewport (data-gsap="lift"); the rule draws in.
 * Mobile: portrait (4:5, up to 400px wide) above the text.
 */
import Photo from '@/components/ui/Photo.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { founderQuote } from '@/data/home';
import { founderName, founderRole, portraitAlt } from '@/data/founder';
import { site } from '@/config/site';
import portrait from '@/assets/photos/ganeaysh-portrait.jpg';
---
<section id="about" class="hf band band--grey" aria-labelledby="founder-heading">
  <div class="container hf__grid">
    <div class="hf__media" data-gsap="lift">
      <Photo src={portrait} alt={portraitAlt.founder} fill position="50% 20%"
        sizes="(min-width: 1000px) 460px, min(100vw - 40px, 400px)" widths={[400, 640, 800, 960, 1280]} />
    </div>
    <div class="hf__body">
      <h2 id="founder-heading" class="t-label hf__label">{founderQuote.folio}</h2>
      <blockquote class="hf__quote"><p>“{founderQuote.quote}”</p></blockquote>
      <span class="hf__rule" data-gsap="rule" aria-hidden="true"></span>
      <p class="hf__who">
        <span class="hf__name">{founderName}</span>
        <span class="hf__role">{founderRole}, {site.name}</span>
        <Confirm id={4} note="founder quote wording" />
      </p>
      <ArrowLink href={founderQuote.link.href} class="hf__link">{founderQuote.link.label}</ArrowLink>
    </div>
  </div>
</section>

<style>
  .hf__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; align-items: center; }
  .hf__media { position: relative; width: min(100%, 400px); aspect-ratio: 4 / 5; overflow: hidden; background: var(--ice); }
  .hf__body { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
  .hf__label { margin: 0; }
  .hf__quote { margin: 0; }
  .hf__quote p {
    margin: 0; max-width: 22ch;
    font-family: var(--font-serif); font-style: italic; font-weight: 400;
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem); line-height: 1.25; color: var(--navy-900); text-wrap: pretty;
    text-indent: -.4em;
  }
  .hf__rule { display: block; width: 56px; height: 3px; background: var(--saffron); }
  .hf__who { margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .hf__name { font-size: 1.125rem; font-weight: 700; color: var(--navy-900); }
  .hf__role { font-size: .9375rem; color: var(--fg-2); }
  .hf :global(.hf__link) { margin-top: -12px; }
  @media (min-width: 900px) {
    .hf__grid { grid-template-columns: minmax(0, 460px) minmax(0, 1fr); column-gap: clamp(56px, 7vw, 96px); }
    .hf__media { width: 100%; aspect-ratio: auto; height: 560px; }
  }
</style>
