/** MagneticDots: an aria-hidden dot field that leans toward the pointer (canvas, lazy via whenNear). Absolutely fills
 * its positioned parent. `color` = dot colour, `opacity` = layer opacity. Static (no JS / reduced): CSS radial dots. */
interface Props { color?: string; opacity?: number; class?: string }
const { color = 'var(--kk-imperial)', opacity = .18, class: cls } = Astro.props;
---
<div class:list={['mdots', cls]} aria-hidden="true" data-magnetic-dots style={`--mdots-c:${color};--mdots-o:${opacity}`}>
  <canvas class="mdots__canvas"></canvas>
</div>
<style>
  .mdots { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: var(--mdots-o); color: var(--mdots-c);
    background-image: radial-gradient(circle at center, currentColor 1.6px, transparent 2px); background-size: 22px 22px; background-position: 0 0; }
  .mdots__canvas { position: absolute; inset: 0; width: 100%; height: 100%; color: inherit; }
  .mdots:has(.mdots__canvas.is-live) { background-image: none; }
</style>
