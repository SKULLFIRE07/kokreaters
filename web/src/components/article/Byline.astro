---
/**
 * Article byline (REDESIGN-V3 §4 article), rendered in the article hero's aside under the standfirst (v3.1).
 * A 56px square crop of the founder portrait (v4: square corners everywhere), the author's name (links to /about), his
 * title "Founder and Principal, KoKreaters" (pack 3: byline with photo and title on every article), then
 * "4 Nov 2026 · 5 min read". No date: Confirm C-14 in staging, nothing elsewhere. Draft label: staging only.
 * The photo is decorative (alt="") because the name sits beside it.
 * Mobile: same row; the meta line wraps under the name. The name link has a 44px-tall hit area (::after).
 */
import type { CollectionEntry } from 'astro:content';
import Photo from '@/components/ui/Photo.astro';
import Confirm from '@/components/ui/Confirm.astro';
import portrait from '@/assets/photos/ganeaysh-portrait-square.jpg';
import { founderName, roleLine } from '@/components/about/founder-lines';
import { microcopy } from '@/data/microcopy';
import { articleCopy } from '@/data/insights';
import { isDraft } from '@/lib/insights';
import { showConfirm, showDraftLabels } from '@/lib/mode';
import { fill, formatDate, isoDate } from '@/lib/format';
interface Props { entry: CollectionEntry<'insights'>; minutes: number; }
const { entry, minutes } = Astro.props;
const d = entry.data;
const minLabel = minutes > 0 ? fill(microcopy.readingTime, { n: minutes }) : '';
const draft = showDraftLabels && isDraft(entry);
---
<div class="byline">
  <div class="byline__photo"><Photo src={portrait} alt="" ratio="1/1" sizes="56px" widths={[56, 112, 168]} /></div>
  <p class="byline__text">
    <a class="byline__name" href={articleCopy.meetAuthor.href}>{founderName}</a>
    <span class="byline__role">{roleLine}</span>
    <span class="byline__meta">
      {d.date
        ? <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time>
        : showConfirm && <Confirm id="C-14" note="publication date" />}
      {d.date && minLabel && <span class="byline__sep" aria-hidden="true">·</span>}
      {minLabel && <span>{minLabel}</span>}
      {draft && <><span class="byline__sep" aria-hidden="true">·</span><span class="byline__draft">{articleCopy.draft}</span></>}
    </span>
  </p>
</div>
<style>
  .byline { display: flex; align-items: center; gap: var(--s-3); }
  .byline__photo { flex: none; width: 56px; height: 56px; overflow: hidden; }
  .byline__role { font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg); }
  .byline__text { margin: 0; display: grid; gap: 2px; font-size: var(--fs-small); line-height: var(--lh-small); }
  /* 23px line: an invisible ::after makes the hit area 44px tall (§7) while the focus ring stays tight to the name */
  .byline__name { position: relative; justify-self: start; font-weight: 700; color: var(--head); text-decoration: none; }
  .byline__name::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: max(100%, 44px); transform: translateY(-50%); }
  .byline__name:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .byline__meta { display: flex; flex-wrap: wrap; column-gap: var(--s-2); font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); font-variant-numeric: lining-nums tabular-nums; }
  .byline__draft { font-weight: 600; }
</style>
