---
/**
 * Section band (REDESIGN-V3 §3): <section class="band band--{ground}"> + container. The ground re-declares the role
 * tokens, so every component inside is coloured correctly without props.
 *  pad: default 72 → 120px top/bottom · tight 48 → 80 · flush-top (no top padding) · none.
 *  width: container width; 'bleed' = no container (full-bleed media).
 *  rule: a 1px hairline at the top, inside the container — use it when two identical grounds touch.
 * Mobile: padding scales down to 72px (tight 48px); container gutters 20px.
 * Any other attribute (data-*, aria-*) is passed to the <section>.
 */
interface Props {
  ground?: 'white' | 'grey' | 'navy';
  pad?: 'default' | 'tight' | 'flush-top' | 'none';
  id?: string;
  labelledby?: string;
  width?: 'default' | 'narrow' | 'wide' | 'bleed';
  rule?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { ground = 'white', pad = 'default', id, labelledby, width = 'default', rule = false, class: cls, ...rest } = Astro.props;
---
<section
  id={id}
  aria-labelledby={labelledby}
  class:list={['band', `band--${ground}`, pad !== 'default' && `band--pad-${pad}`, rule && 'band--ruled', cls]}
  {...rest}
>
  {width === 'bleed' ? (
    <>
      {rule && <div class="container"><div class="band__rule" /></div>}
      <slot />
    </>
  ) : (
    <div class:list={['container', width !== 'default' && `container--${width}`]}>
      {rule && <div class="band__rule" />}
      <slot />
    </div>
  )}
</section>
