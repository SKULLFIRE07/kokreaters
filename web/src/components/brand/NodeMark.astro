---
/**
 * NodeMark: the logo A mark alone (kokreaters-mark-A.svg: the connected nodes over three overlapping circles), as a
 * cached <img>. Used in small spaces: the chat launcher and panel, the 404 page, the article end mark.
 * `tone` is kept for the v3 signature; the artwork is never recoloured (brief logo rules), so every tone shows the same
 * file. Decorative unless `label` is given. Mobile: fixed `size` px (default 48).
 */
import markUrl from '@/assets/brand/svg/kokreaters-mark-A.svg?url';
interface Props {
  size?: number;
  tone?: 'color' | 'white' | 'blue';
  label?: string;
  class?: string;
}
const { size = 48, label, class: cls } = Astro.props;
---
<img class:list={['nodemark', cls]} src={markUrl} width={size} height={size} alt={label ?? ''} loading="lazy" decoding="async" />
<style>
  .nodemark { display: block; flex: none; }
</style>
