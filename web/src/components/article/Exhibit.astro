---
/**
 * Exhibit (REDESIGN-V3 §4 article). MDX: <Exhibit n title subtitle? source>ProcessChain or a markdown table</Exhibit>.
 * McKinsey-style figure: 2px navy top rule, "Exhibit 1" label, serif title (states the finding), subtitle, the body,
 * then "Source: …" over a hairline. The figure is labelled by its title.
 * Markdown tables are prepared on the server: every cell gets data-label (its column heading) and explicit table roles,
 * so prose.css can stack the table into one card per row on phones without losing table semantics.
 * ≥ 900px: the exhibit spans the full content width (it reaches into the empty right column, flush with the hero image).
 * Mobile: full column width; tables become stacked cards below 600px; ProcessChain goes vertical.
 */
import { microcopy } from '@/data/microcopy';
interface Props { n: number | string; title: string; subtitle?: string; source: string; }
const { n, title, subtitle, source } = Astro.props;
const tid = `exhibit-${n}-title`;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const text = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
/** Adds data-label + ARIA table roles to simple GFM tables (thead/tbody, one header row). */
function prepareTables(html: string): string {
  return html.replace(/<table([^>]*)>([\s\S]*?)<\/table>/g, (whole, attrs: string, inner: string) => {
    const head = inner.match(/<thead[^>]*>[\s\S]*?<\/thead>/)?.[0] ?? '';
    const labels = [...head.matchAll(/<th(?:\s[^>]*)?>([\s\S]*?)<\/th>/g)].map((m) => text(m[1]));
    if (!labels.length) return whole;
    let out = inner
      .replace(/<thead([^>]*)>/, '<thead$1 role="rowgroup">')
      .replace(/<tbody([^>]*)>/, '<tbody$1 role="rowgroup">')
      .replace(/<th(\s[^>]*)?>/g, (_m, a = '') => `<th${a} role="columnheader">`);
    out = out.replace(/<tr([^>]*)>([\s\S]*?)<\/tr>/g, (_m, ra: string, row: string) => {
      let i = 0;
      const cells = row.replace(/<td(\s[^>]*)?>/g, (_c, a = '') => `<td${a} role="cell" data-label="${esc(labels[i++] ?? '')}">`);
      return `<tr${ra} role="row">${cells}</tr>`;
    });
    return `<table${attrs} role="table" data-stack>${out}</table>`;
  });
}
const body = prepareTables(await Astro.slots.render('default'));
---
<figure class="exhibit" aria-labelledby={tid} data-reveal>
  <div class="exhibit__head">
    <p class="exhibit__n t-label">{microcopy.exhibit} <span class="tnum">{n}</span></p>
    <p class="exhibit__title" id={tid}>{title}</p>
    {subtitle && <p class="exhibit__subtitle">{subtitle}</p>}
  </div>
  <div class="exhibit__body"><Fragment set:html={body} /></div>
  <figcaption class="exhibit__source">{microcopy.source}: {source}</figcaption>
</figure>
<style>
  .exhibit {
    clear: right;
    margin-block: var(--s-8);
    padding-top: var(--s-5);
    border-top: 2px solid var(--rule-strong);
    font-family: var(--font-sans);
    font-variant-numeric: lining-nums;   /* tabular figures only where columns need them (tables, the "Exhibit 1" numeral) */
  }
  .exhibit p { margin: 0; }
  .exhibit__head { display: grid; gap: var(--s-2); margin-bottom: var(--s-6); max-width: 46rem; }
  .exhibit__n { margin-bottom: var(--s-1); }
  .exhibit__title {
    font-family: var(--font-serif); font-optical-sizing: auto; font-weight: 500;
    font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3);
    color: var(--head); text-wrap: balance;
  }
  .exhibit__subtitle { font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); }
  .exhibit__body { max-width: 100%; }
  .exhibit__source {
    margin-top: var(--s-6); padding-top: var(--s-3); border-top: 1px solid var(--rule);
    font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2);
  }
  /* reach across the empty right column: the article body grid is the size container */
  @media (min-width: 900px) { .exhibit { width: 100cqw; } }
</style>
