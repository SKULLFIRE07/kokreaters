---
/**
 * SEO head (DESIGN-SPEC 3.7). BaseLayout renders charset, viewport and the
 * flags script first; this renders items 3–10 in order.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { isStaging } from '@/lib/mode';
import JsonLd from './JsonLd.astro';
import { abs, canonicalFor, type SeoProps } from './schema';

export type { SeoProps };
interface Props { seo: SeoProps }
const { seo } = Astro.props;

const canonical = canonicalFor(seo.path);
const robots = isStaging || seo.noindex ? 'noindex, nofollow' : 'index, follow';
// og:image wiring (W3-og-seo): cards come from `npm run og` into public/og. If a page names a card
// that has not been rendered yet (e.g. a newly approved insight), fall back to the default card.
const OG_DEFAULT = '/og/default.png';
const ogDir = join(process.cwd(), 'public', 'og');
const ogPath = seo.ogImage && seo.ogImage.startsWith('/og/') && existsSync(ogDir) && !existsSync(join(ogDir, seo.ogImage.slice(4)))
  ? OG_DEFAULT
  : (seo.ogImage ?? OG_DEFAULT);
const ogImage = abs(ogPath);
const ogType = seo.ogType ?? 'website';
const graph = seo.jsonLd ?? [];
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<link rel="preload" href="/fonts/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#FFFFFF" />
<meta property="og:site_name" content="KoKreaters" />
<meta property="og:locale" content="en_GB" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="627" />
<meta property="og:image:alt" content={seo.title} />
{seo.article?.published && <meta property="article:published_time" content={seo.article.published} />}
{seo.article?.modified && <meta property="article:modified_time" content={seo.article.modified} />}
{seo.article?.section && <meta property="article:section" content={seo.article.section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={seo.title} />
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<JsonLd graph={graph} />
