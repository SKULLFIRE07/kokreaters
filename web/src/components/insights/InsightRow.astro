---
/**
 * Insight index row (REDESIGN-V3 §9.3, page-local variant of InsightCard for the hub library and the article's related
 * insights). A magazine archive line on the 12-column grid: one hairline on top, no box. The whole row is one link (the
 * title's <a> is stretched over it); hover turns the title --link, draws an accent line across the hairline and zooms
 * the image 1.04. Why not InsightCard: a three-up card grid holding one or two insights leaves two thirds of the band
 * empty; an index line reads finished with one entry and still scales to many.
 * ≥ 900px: meta in columns 1–3 (format label, expertise, date · read time), serif title + summary in 4–8, the 3:2
 *          photo in 9–12 (natural landscape crop, the photo's focal point from photos.ts).
 * 600–899px: text left (7/12), photo right (5/12).
 * Mobile (< 600px): the 3:2 photo full width on top, then label, title, summary, meta; 48px between rows.
 */
import type { ImageMetadata } from 'astro';
import Photo from '@/components/ui/Photo.astro';
import { formatDate, isoDate, fill } from '@/lib/format';
import { microcopy } from '@/data/microcopy';
interface Props {
  href: string;
  title: string;
  label: string;
  pillarName?: string;
  summary?: string;
  date?: Date;
  readTime?: number;
  image?: ImageMetadata;
  imageAlt?: string;
  level?: 2 | 3 | 4;
}
const { href, title, label, pillarName, summary, date, readTime, image, imageAlt = '', level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
const readLabel = readTime ? fill(microcopy.readingTime, { n: readTime }) : '';
---
<article class:list={['irow', 'u-zoom', image && 'irow--image']}>
  <div class="irow__meta">
    <p class="irow__label t-label">{label}{pillarName && <span class="irow__pillar"> · {pillarName}</span>}<slot name="badge" /></p>
    {(date || readLabel) && (
      <p class="irow__date">
        {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
        {date && readLabel && <span aria-hidden="true"> · </span>}
        {readLabel && <span>{readLabel}</span>}
      </p>
    )}
  </div>
  <div class="irow__main">
    <H class="irow__title"><a href={href} class="irow__link">{title}</a></H>
    {summary && <p class="irow__summary">{summary}</p>}
  </div>
  {image && (
    <div class="irow__media">
      <Photo src={image} alt={imageAlt} ratio="3/2" settle sizes="(min-width: 1200px) 400px, (min-width: 900px) 30vw, (min-width: 600px) 38vw, calc(100vw - 40px)" />
    </div>
  )}
</article>
<style>
  .irow {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4);
    padding-block: var(--s-6) var(--s-7); border-top: 1px solid var(--rule);
  }
  /* hover: an accent line draws across the top hairline */
  .irow::before {
    content: ""; position: absolute; left: 0; top: -1px; width: 100%; height: 1px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--d-3) var(--ease-out);
  }
  .irow:hover::before { transform: scaleX(1); }
  .irow__media { order: -1; border-radius: var(--r-sm); overflow: hidden; margin-bottom: var(--s-2); }
  .irow__meta { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-1) var(--s-4); }
  .irow__label { margin: 0; color: var(--label); }
  .irow__pillar { color: var(--fg-2); }
  .irow__date { margin: 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); font-variant-numeric: lining-nums tabular-nums; }
  .irow__title {
    margin: 0; font-family: var(--font-serif); font-optical-sizing: auto;
    font-size: clamp(1.5rem, 1.3rem + .8vw, 2.125rem); line-height: 1.18; font-weight: 420; letter-spacing: -0.014em;
    color: var(--head); text-wrap: balance; max-width: 24ch;
  }
  .irow__link { color: inherit; text-decoration: none; transition: color var(--d-1) var(--ease-out); }
  .irow__link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .irow__link:focus-visible { outline: none; }
  .irow:has(.irow__link:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .irow:hover .irow__link { color: var(--link); }
  .irow__summary { margin: var(--s-4) 0 0; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2); max-width: 52ch; text-wrap: pretty; }

  @media (min-width: 600px) {
    .irow { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); row-gap: var(--s-4); padding-block: var(--s-7); }
    .irow__meta { grid-column: 1 / 8; grid-row: 1; justify-content: flex-start; }
    .irow__main { grid-column: 1 / 8; grid-row: 2; }
    .irow__media { order: 0; grid-column: 8 / -1; grid-row: 1 / span 2; margin: 0; align-self: start; }
  }
  @media (min-width: 900px) {
    .irow { padding-block: clamp(2.5rem, 1.5rem + 2vw, 4rem); row-gap: 0; }
    .irow__meta { grid-column: 1 / 4; grid-row: 1; flex-direction: column; align-items: flex-start; gap: var(--s-2); padding-top: .55em; }
    .irow__main { grid-column: 4 / 9; grid-row: 1; padding-right: var(--s-5); }
    .irow__media { grid-column: 9 / -1; grid-row: 1; }
  }
</style>
