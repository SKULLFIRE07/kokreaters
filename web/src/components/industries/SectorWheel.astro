---
/**
 * SectorWheel (DESIGN-SPEC v2 00.2 INDUSTRIES): a radial wheel of the nine sectors on Imperial; scrolling (pinned)
 * turns it so each sector in turn faces the panel at 3 o'clock, where it expands with its mapped pillars linking out
 * to an inner ring of the six pillar nodes. The wheel labels are real links (#slug) in an <ol>; focusing or hovering one
 * turns the wheel to it. The panel and the SVG are aria-hidden (the sections below carry the words).
 * Static (reduced motion / JS off): the wheel at sector 01, no pin. Motion: pages/industries.ts.
 */
import MarginNote from '../notes/MarginNote.astro';
import PillarDot from '../ui/PillarDot.astro';
import { industries } from '@/data/industries';
import { pillars } from '@/data/pillars';
import { pillarGround } from '@/lib/pillars';
import { expertiseNotes } from '@/data/notes/expertise';
import { pad2 } from '@/lib/format';

const S = 640, C = S / 2, RP = 118;
const step = 360 / industries.length;
const pnodes = pillars.map((p, i) => {
  const a = (-90 + i * 60) * Math.PI / 180;
  return { p, x: C + RP * Math.cos(a), y: C + RP * Math.sin(a) };
});
const AX = C + 218, AY = C;   // the anchor, just inside the active label at 3 o'clock
const first = industries[0];
---
<div class="wheel" data-wheel data-active="0">
  <div class="wheel__dial" data-wheel-dial style="--wr:0deg">
    <svg class="wheel__svg" viewBox={`0 0 ${S} ${S}`} aria-hidden="true" focusable="false">
      <circle class="wheel__rim" cx={C} cy={C} r={C - 6} />
      <g class="wheel__ticks" data-wheel-ticks>
        {Array.from({ length: 72 }, (_, i) => <line x1={C} y1="10" x2={C} y2={i % 8 === 0 ? 34 : 22} transform={`rotate(${i * 5} ${C} ${C})`} />)}
      </g>
      <circle class="wheel__orbit" cx={C} cy={C} r={RP} />
      <path class="wheel__pointer" d={`M${S - 2} ${C} l -22 -12 v 24 z`} />
      {pnodes.map((n) => (
        <line class="wheel__link" pathLength="1" data-wheel-link={n.p.key} x1={AX} y1={AY} x2={n.x.toFixed(1)} y2={n.y.toFixed(1)}
          style={`--pc:var(--pillar-${n.p.key})`} data-on={first.pillars.includes(n.p.key) ? '' : undefined} />
      ))}
      {pnodes.map((n) => (
        <g class="wheel__pnode" data-wheel-pnode={n.p.key} data-on={first.pillars.includes(n.p.key) ? '' : undefined}>
          <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r="22" class="wheel__pring" />
          <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r="15" style={`fill:var(--pillar-${n.p.key})`} />
        </g>
      ))}
      <circle class="wheel__hubdot" cx={C} cy={C} r="30" />
    </svg>
    <ol class="wheel__list" aria-label={expertiseNotes.industries.wheel}>
      {industries.map((ind, i) => (
        <li class="wheel__item" style={`--a:${(i * step).toFixed(2)}deg`} data-wheel-item={i}>
          <a class:list={['wheel__lbl', { 'is-active': i === 0 }]} href={`#${ind.slug}`} data-wheel-link-i={i}>
            <span class="wheel__n tnum" aria-hidden="true">{pad2(ind.n)}</span><span class="wheel__name">{ind.name}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="wheel__panel" aria-hidden="true">
    <p class="wheel__plabel t-label">{expertiseNotes.industries.sector}</p>
    {industries.map((ind, i) => (
      <div class:list={['wheel__pitem', { 'is-active': i === 0 }]} data-wheel-panel={i} data-pillars={ind.pillars.join(' ')}>
        <p class="wheel__pn tnum">{pad2(ind.n)}<span>/{pad2(industries.length)}</span></p>
        <p class="wheel__pname">{ind.name}</p>
        <ul class="wheel__ptags" role="list">
          {ind.pillars.map((k) => { const p = pillars.find((x) => x.key === k)!; return (
            <li><span class={`wheel__ptag g-${pillarGround(k)}`}><PillarDot pillar={k} size={8} />{p.name}</span></li>
          ); })}
        </ul>
      </div>
    ))}
    <MarginNote text={expertiseNotes.industries.turn} tone="saffron" anchor="block" arrow="arrow-loop" arrowAt="start" flip rotate={-5} arrowAngle={-160} show="md" />
  </div>
</div>
<style>
  .wheel { position: relative; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--s-7); align-items: center; }
  .wheel__dial { position: relative; width: min(100%, 640px, 78vh); aspect-ratio: 1; justify-self: start; }
  .wheel__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .wheel__rim { fill: color-mix(in srgb, var(--kk-violet) 55%, transparent); stroke: var(--kk-lavender); stroke-width: 2; }
  .wheel__ticks { stroke: var(--kk-lavender); stroke-width: 2; opacity: .55; transform-origin: 50% 50%; rotate: var(--wr); }
  .wheel__orbit { fill: none; stroke: var(--kk-white-20); stroke-width: 2; stroke-dasharray: 2 8; }
  .wheel__pointer { fill: var(--kk-saffron); }
  .wheel__link { stroke: var(--pc); stroke-width: 4; stroke-linecap: round; opacity: 0; transition: opacity var(--d-ui) var(--ease-expo); }
  .wheel__link[data-on] { opacity: 1; }
  .wheel__pring { fill: var(--kk-imperial); stroke: var(--kk-white-20); stroke-width: 2; transition: stroke var(--d-ui); }
  .wheel__pnode { transform-box: fill-box; transform-origin: center; transition: scale .5s var(--ease-spring); }
  .wheel__pnode[data-on] { scale: 1.3; }
  .wheel__pnode[data-on] .wheel__pring { stroke: var(--kk-white); }
  .wheel__hubdot { fill: var(--kk-saffron); stroke: var(--kk-white); stroke-width: 5; }

  .wheel__list { list-style: none; margin: 0; padding: 0; }
  .wheel__item {
    position: absolute; left: 50%; top: 50%; width: 0; height: 0;
    transform: rotate(calc(var(--a) + var(--wr))) translateX(calc(var(--dial) * .40)) rotate(calc(-1 * (var(--a) + var(--wr))));
  }
  .wheel__dial { --dial: min(100cqw, 640px); container-type: inline-size; }
  .wheel__lbl {
    position: absolute; left: 0; top: 0; translate: -50% -50%; display: inline-flex; flex-direction: column; align-items: center; gap: 2px;
    min-width: 44px; min-height: 44px; padding: 8px 12px; border-radius: 14px; text-align: center; text-decoration: none;
    width: max-content; max-width: 15ch; color: var(--kk-white);
    font: 500 12px/1.2 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; text-wrap: balance;
    transition: background-color var(--d-ui) var(--ease-expo), color var(--d-ui) var(--ease-expo), scale .45s var(--ease-spring), box-shadow var(--d-ui);
  }
  .wheel__n { font-weight: 600; color: var(--kk-saffron); }
  .wheel__lbl:hover { color: var(--kk-saffron); }
  .wheel__lbl:focus-visible { outline: 3px solid var(--kk-saffron); outline-offset: 2px; }
  .wheel__lbl.is-active { background: var(--kk-saffron); color: var(--kk-ink); scale: 1.18; box-shadow: 0 0 0 4px var(--kk-white), var(--shadow-sticker); }
  .wheel__lbl.is-active .wheel__n { color: var(--kk-ink); }

  .wheel__panel { position: relative; }
  .wheel__plabel { margin: 0 0 var(--s-4); color: var(--fg-2); }
  .wheel__pitem { display: none; }
  .wheel__pitem.is-active { display: block; }
  .wheel__pn { margin: 0; font: 800 var(--fs-stat)/.85 var(--font-display); font-stretch: 75%; letter-spacing: -0.03em; color: var(--kk-saffron); }
  .wheel__pn span { font-size: .3em; color: var(--fg-2); letter-spacing: 0; margin-left: .2em; }
  .wheel__pname { margin: var(--s-4) 0 var(--s-5); font: 780 var(--fs-h2)/.95 var(--font-display); font-stretch: 78%; letter-spacing: -0.02em; color: var(--head); text-wrap: balance; max-width: 14ch; }
  .wheel__ptags { list-style: none; margin: 0 0 var(--s-6); padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .wheel__ptag { display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 14px 0 10px; border-radius: var(--r-pill); font: 500 12px/1.2 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; box-shadow: 0 0 0 3px var(--kk-white); }
  @media (max-width: 1023px) {
    .wheel { grid-template-columns: 1fr; gap: var(--s-5); }
    .wheel__dial { width: min(100%, 520px, 58vh); justify-self: center; }
    .wheel__pname { font-size: var(--fs-h3); margin: var(--s-2) 0 var(--s-4); }
    .wheel__pn { font-size: 4rem; }
    .wheel__ptags { margin-bottom: 0; }
  }
  @media (max-width: 767px) {
    .wheel__dial { width: min(100%, 340px, 50vh); }
    .wheel__name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .wheel__lbl { padding: 0; width: 44px; justify-content: center; border-radius: 50%; font-size: 13px; }
    .wheel__item { transform: rotate(calc(var(--a) + var(--wr))) translateX(calc(var(--dial) * .42)) rotate(calc(-1 * (var(--a) + var(--wr)))); }
  }
</style>
