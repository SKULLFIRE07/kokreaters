---
/**
 * A founder-career case (DESIGN-SPEC 5.6.2): Hairline rule, context dateline, h2 outcome (.t-index),
 * a 3/9 grid of "The challenge" / "What was done" / "The result" (datelines + lead),
 * the figure (Sapphire .t-figure + source in meta; −25 °C carries data-frost), then tags.
 * A null value → <Confirm id="C-9"/> in staging; its row is omitted in production.
 * iTFA gets <abbr> and its sidenote on first use (4.6, C-11).
 */
import Confirm from '@/components/ui/Confirm.astro';
import PillarTag from '@/components/ui/PillarTag.astro';
import type { FounderResult } from '@/data/types';
import { impactPage, secondaryFigures } from '@/data/impact';
import { abbreviations, minus25 } from '@/lib/typography';
import { pillarHref } from '@/lib/pillars';
import { isStaging } from '@/lib/mode';

interface Props { result: FounderResult; abbrItfa?: boolean; }
const { result, abbrItfa = true } = Astro.props;
const { labels } = impactPage;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
let itfaUsed = false;
const withAbbr = (text: string) => {
  let html = esc(text);
  if (abbrItfa && !itfaUsed && html.includes('iTFA')) {
    html = html.replace('iTFA', `<abbr title="${abbreviations.iTFA.title}">iTFA</abbr>`);
    itfaUsed = true;
  }
  return html;
};
const rows = ([
  { key: 'challenge', label: labels.challenge, value: result.challenge },
  { key: 'done', label: labels.done, value: result.done },
  { key: 'result', label: labels.result, value: result.result },
] as const)
  .filter((r) => r.value !== null || isStaging)
  .map((r) => ({ ...r, html: r.value === null ? null : withAbbr(r.value), itfa: false }));
// the sidenote follows the row that carried the first iTFA
if (itfaUsed) {
  const i = rows.findIndex((r) => r.html?.includes('<abbr'));
  if (i >= 0) rows[i].itfa = true;
}
const figures = [
  ...(result.figure ? [{ value: result.figure.value, frost: !!result.figure.frost || result.figure.value === minus25 }] : []),
  ...(secondaryFigures[result.id] ? [{ value: secondaryFigures[result.id] as string, frost: false }] : []),
];
const titleId = `case-${result.id}-title`;
---
<article id={result.id} class="case" aria-labelledby={titleId}>
  <span class="case__rule rule" data-rule aria-hidden="true"></span>
  <div class="case__grid grid">
    <p class="case__context t-dateline c-1-3">{result.context}</p>
    <h2 id={titleId} class="case__outcome t-index c-4-12">{result.outcome}</h2>

    <dl class="case__dl c-1-12" data-reveal>
      {rows.map((r) => (
        <div class="case__row grid">
          <dt class="t-dateline c-1-3">{r.label}</dt>
          <dd class="c-4-12">
            {r.html === null
              ? <Confirm id="C-9" note="case detail" />
              : <p class="t-lead case__value" set:html={r.html} />}
            {r.itfa && <p class="case__note t-meta">{abbreviations.iTFA.note}</p>}
          </dd>
        </div>
      ))}
    </dl>

    {figures.length > 0 && result.figure && (
      <div class="case__figure c-4-12" data-reveal>
        <p class="case__figures">
          {figures.map((f) => (
            <span class="t-figure case__fig" data-frost={f.frost ? '' : undefined}>{f.value}</span>
          ))}
        </p>
        <p class="case__source t-meta">{result.figure.source}</p>
      </div>
    )}

    {(result.pillars.length > 0 || result.sectors.length > 0) && (
      <ul class="case__tags c-4-12" role="list">
        {result.pillars.map((k) => <li><PillarTag pillar={k} href={pillarHref(k)} /></li>)}
        {result.sectors.map((s) => <li class="case__sector t-meta">{s}</li>)}
      </ul>
    )}
  </div>
</article>
<style>
  .case { position: relative; }
  .case__rule { display: block; }
  .case__grid { padding-block: var(--s-6) var(--s-8); row-gap: var(--s-4); align-items: start; }
  .case__context { margin: 0; padding-top: 0.75em; }
  .case__outcome { margin: 0; }
  .case__dl { margin: var(--s-4) 0 0; }
  .case__row { padding-block: var(--s-4); border-top: 1px solid var(--c-rule); align-items: baseline; }
  .case__row dt { margin: 0; }
  .case__row dd { margin: 0; }
  .case__row dd :global(.confirm) { margin-inline: 0; }
  .case__value { margin: 0; color: var(--c-text); }
  .case__value :global(abbr) { text-decoration: underline dotted 1px; text-underline-offset: 0.18em; cursor: help; }
  .case__note { margin: var(--s-2) 0 0; }
  .case__figure { margin-top: var(--s-4); }
  .case__figures { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2) var(--s-7); }
  .case__fig { white-space: nowrap; }
  .case__fig[data-frost]::after { bottom: -6px; }
  .case__source { margin: var(--s-3) 0 0; }
  .case__tags { list-style: none; margin: var(--s-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .case__sector { padding-left: var(--s-1); }
  .case__sector::before { content: "·"; margin-right: var(--s-3); color: var(--kk-field-border); }
  @media (max-width: 767px) {
    .case__context { padding-top: 0; }
    .case__row { row-gap: var(--s-1); }
  }
</style>
