---
/**
 * Expertise disclosure panel (DESIGN-SPEC v2 7.3). Server-rendered `hidden`; chrome.ts toggles it (behaviour as v1:
 * a disclosure, not an ARIA menu). Left: the six pillars as mini colour blocks; right: the newest visible insight.
 * Open: clip-path wipe down 320ms expo, tiles rise 12px with a 40ms stagger; close: 160ms fade. Reduced: instant.
 */
import PillarDot from '@/components/ui/PillarDot.astro';
import TextLink from '@/components/ui/TextLink.astro';
import DraftRibbon from '@/components/ui/DraftRibbon.astro';
import { pillars } from '@/data/pillars';
import { pillarGround, pillarNumber } from '@/lib/pillars';
import { microcopy } from '@/data/microcopy';
import { fill, formatDate, isoDate } from '@/lib/format';
import { visibleInsights, formatLabel, insightReadingTime, insightHref, isDraft } from '@/lib/insights';
import { isStaging } from '@/lib/mode';

const [featured] = await visibleInsights();
const minutes = featured ? insightReadingTime(featured) : 0;
---
<div id="expertise-panel" class="xp-panel g-white" hidden>
  <div class="xp-panel__grid">
    <div class="xp-panel__pillars">
      <ul class="xp-panel__list" role="list">
        {pillars.map((p, i) => (
          <li style={`--i:${i}`}>
            <a class:list={['xp-tile', `g-${pillarGround(p.key)}`]} href={`/expertise/${p.slug}`}>
              <span class="xp-tile__n t-micro"><PillarDot pillar={p.key} size={8} /> {pillarNumber(p)}</span>
              <span class="xp-tile__name">{p.name}</span>
              <span class="xp-tile__promise">{p.promise}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="xp-panel__all">
        <TextLink href="/expertise">{microcopy.allExpertise}</TextLink>
      </div>
    </div>
    <div class="xp-panel__feature">
      <p class="t-dateline">{microcopy.featuredInsight}</p>
      {featured ? (
        <article class:list={['xp-feature', 'g-butter']}>
          <p class="xp-feature__format t-micro">{formatLabel(featured)}</p>
          {isStaging && isDraft(featured) && <DraftRibbon size="sm" />}
          <p class="xp-feature__title">
            <a href={insightHref(featured)}>{featured.data.title}</a>
          </p>
          <p class="xp-feature__meta t-meta">
            {minutes > 0 && <span>{fill(microcopy.readingTime, { n: minutes })}</span>}
            {featured.data.date && <span> · <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time></span>}
          </p>
          <TextLink href={insightHref(featured)}>{microcopy.insightsLink}</TextLink>
        </article>
      ) : (
        <p class="xp-feature__newsletter t-meta">{microcopy.newsletter}</p>
      )}
    </div>
  </div>
</div>

<style is:global>
  .xp-panel {
    position: absolute; top: 100%;
    left: max(var(--side), calc((100% - var(--content-max)) / 2));
    right: max(var(--side), calc((100% - var(--content-max)) / 2));
    z-index: 60;
    border: 2px solid var(--kk-ink); border-top: 0;
    border-radius: 0 0 var(--r-card) var(--r-card);
    box-shadow: var(--shadow-panel);
    padding: 32px;
    opacity: 0;
    transition: opacity var(--d-fast) var(--ease-quart);
  }
  .xp-panel.is-open {
    opacity: 1; clip-path: inset(0 -40px -60px -40px);
    animation: xp-open var(--d-panel) var(--ease-expo) both;
    transition: none;
  }
  @keyframes xp-open { from { clip-path: inset(0 -40px 100% -40px); } to { clip-path: inset(0 -40px -60px -40px); } }
  .xp-panel.is-open .xp-panel__list > li { animation: xp-rise var(--d-panel) var(--ease-expo) both; animation-delay: calc(var(--i) * 40ms); }
  @keyframes xp-rise { from { opacity: 0; translate: 0 12px; } }
  @media (prefers-reduced-motion: reduce) { .xp-panel, .xp-panel.is-open, .xp-panel.is-open .xp-panel__list > li { transition: none; animation: none; } }

  .xp-panel__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .xp-panel__pillars { grid-column: 1 / span 8; }
  .xp-panel__feature { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: var(--s-3); }
  .xp-panel__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .xp-tile {
    display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 18px 18px 20px; border-radius: 16px;
    text-decoration: none; color: var(--fg);
    transition: translate var(--d-ui) var(--ease-expo), rotate var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo);
  }
  .xp-tile:hover, .xp-tile:focus-visible { color: var(--fg); translate: 0 -4px; rotate: -1deg; box-shadow: var(--shadow-hard); }
  .xp-tile__n { display: inline-flex; align-items: center; gap: 8px; color: var(--fg); }
  .xp-tile__name { font: 650 1.25rem/1.2 var(--font-display); font-stretch: 90%; color: var(--head); text-wrap: balance; }
  .xp-tile__promise { font: 400 13px/1.45 var(--font-mono); color: var(--fg); text-wrap: pretty; }
  .xp-panel__all { margin-top: var(--s-3); }

  .xp-feature { display: flex; flex-direction: column; gap: var(--s-2); align-items: flex-start; padding: 20px; border-radius: var(--r-card); border: 2px solid var(--kk-ink); }
  .xp-feature p { margin: 0; }
  .xp-feature__title { font: 750 1.625rem/1.02 var(--font-display); font-stretch: 85%; letter-spacing: -0.01em; }
  .xp-feature__title a { color: var(--head); text-decoration: none; }
  .xp-feature__title a:hover, .xp-feature__title a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; }
  .xp-feature__meta { font-variant-numeric: tabular-nums; }
  .xp-feature__newsletter { max-width: 28ch; }
</style>
