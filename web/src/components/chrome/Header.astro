---
/**
 * Sticky site header (DESIGN-SPEC v2 7.2). White bar, vector logo (horizontal, 44px; 36px below 1024), Bricolage nav
 * with a hand-drawn Orchid underline under the current page (static) and on hover/focus (draws in 300ms), the primary
 * pill (magnetic, sweep). Below 1024: a 44px outline Menu pill. The outer <header> keeps --header-h in flow, so the
 * compact state and the hide-on-scroll (motion/index.ts, .is-hidden) never shift layout: only the inner bar moves.
 * While the mobile menu is open the bar turns Ink and shows the white logo (MobileMenu.astro styles).
 */
import Logo from '@/components/brand/Logo.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import ExpertisePanel from './ExpertisePanel.astro';
import MobileMenu from './MobileMenu.astro';
import { main } from '@/data/nav';
import { microcopy } from '@/data/microcopy';

const LINE = 'M3 13 C 60 8, 140 15, 200 10 S 280 9, 297 12';

interface Props { page?: string }
const { page = '' } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const xpCurrent = page === 'expertise' || page === 'pillar' || isCurrent('/expertise');
const links = main.filter((l) => !l.panel);
const xp = main.find((l) => l.panel);
---
<header class="site-header" data-header>
  <div class="site-header__bar g-white">
    <div class="site-header__inner container">
      <Logo variant="horizontal" href="/" label="KoKreaters home" height={44} class="site-header__logo" />
      <Logo variant="horizontal-white" href="/" label="KoKreaters home" height={44} loading="lazy" class="site-header__logo site-header__logo--white" />

      <nav class="site-nav" aria-label="Main">
        <ul class="site-nav__list" role="list">
          {xp && (
            <li class="site-nav__item site-nav__item--xp" data-xp-scope>
              <button
                type="button"
                class:list={['site-nav__link', 'site-nav__xp', 'js-only', xpCurrent && 'is-current']}
                aria-expanded="false"
                aria-controls="expertise-panel"
                data-xp-toggle
              >
                <span class="site-nav__label">{xp.label}<svg class="site-nav__line" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={LINE} /></svg></span>
                <span class="site-nav__chev"><Icon name="chevron" /></span>
              </button>
              <a
                class:list={['site-nav__link', 'nojs-only', xpCurrent && 'is-current']}
                href={xp.href}
                aria-current={path === xp.href ? 'page' : undefined}
              ><span class="site-nav__label">{xp.label}<svg class="site-nav__line" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={LINE} /></svg></span></a>
              <ExpertisePanel />
            </li>
          )}
          {links.map((l) => (
            <li class="site-nav__item">
              <a
                class:list={['site-nav__link', isCurrent(l.href) && 'is-current']}
                href={l.href}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              ><span class="site-nav__label">{l.label}<svg class="site-nav__line" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={LINE} /></svg></span></a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header__actions">
        <span class="site-header__cta">
          <Button href="/contact" variant="primary" size="sm">{microcopy.primaryCta}</Button>
        </span>
        <button
          type="button"
          class="menu-btn js-only"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
          data-label-open={microcopy.menu}
          data-label-close={microcopy.close}
        >
          <span class="menu-btn__label" data-menu-label>{microcopy.menu}</span>
          <span class="menu-btn__icons"><span class="menu-btn__icon menu-btn__icon--menu"><Icon name="menu" /></span><span class="menu-btn__icon menu-btn__icon--close"><Icon name="close" /></span></span>
        </button>
        <a class="menu-btn menu-btn--link nojs-only" href="#site-footer">
          <span class="menu-btn__label">{microcopy.menu}</span>
          <span class="menu-btn__icons"><span class="menu-btn__icon menu-btn__icon--menu"><Icon name="menu" /></span></span>
        </a>
      </div>
    </div>
    <MobileMenu />
  </div>
</header>

<style is:global>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-h);
    pointer-events: none;                 /* the strip under the compact bar never blocks the page */
  }
  .site-header__bar {
    --bar-h: var(--header-h);
    position: relative;
    height: var(--bar-h);
    pointer-events: auto;
    border-bottom: 1px solid transparent;
    view-transition-name: site-header;
    transition: height var(--d-ui) var(--ease-quart), border-color var(--d-ui) var(--ease-quart), translate var(--d-ui) var(--ease-quart);
  }
  .site-header.is-scrolled .site-header__bar { --bar-h: var(--header-h-compact); border-bottom-color: var(--kk-hairline); }
  .site-header.is-hidden .site-header__bar { translate: 0 -100%; }
  html.menu-open .site-header__bar { translate: none; }
  @media (prefers-reduced-motion: reduce) { .site-header.is-hidden .site-header__bar { translate: none; } }

  .site-header__inner { height: 100%; display: flex; align-items: center; gap: var(--s-5); }
  .site-header__logo { display: inline-flex; align-items: center; flex: none; color: inherit; text-decoration: none; border-radius: 6px; }
  @media (max-width: 1023px) { .site-header__logo { --logo-h: 36px !important; } }

  .site-nav { display: none; margin-left: auto; }
  .site-nav__list { display: flex; align-items: center; gap: 20px; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 1280px) { .site-nav__list { gap: 28px; } }
  @media (min-width: 1024px) { .site-nav { display: block; } }

  .site-nav__link {
    position: relative;
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer;
    font: 600 var(--fs-nav)/1 var(--font-display); font-stretch: 100%;
    color: var(--kk-ink); text-decoration: none;
  }
  .site-nav__link:hover, .site-nav__link[aria-expanded="true"] { color: var(--kk-ink); }
  .site-nav__label { position: relative; display: inline-block; }
  .site-nav__line {
    position: absolute; left: -6%; width: 112%; bottom: -9px; height: 8px; overflow: visible; pointer-events: none;
    fill: none; stroke: var(--kk-orchid); stroke-width: 3px; stroke-linecap: round;
    clip-path: inset(-60% 101% -60% 0); transition: clip-path 300ms var(--ease-quart);
  }
  .site-nav__line path { vector-effect: non-scaling-stroke; }
  .site-nav__link:is(:hover, :focus-visible, [aria-expanded="true"]) .site-nav__line,
  .site-nav__link.is-current .site-nav__line { clip-path: inset(-60% -4% -60% -4%); }
  .site-nav__link.is-current .site-nav__line { transition: none; }
  .site-nav__chev { display: inline-flex; width: 14px; height: 14px; transition: rotate var(--d-ui) var(--ease-expo); }
  .site-nav__chev svg { width: 14px; height: 14px; }
  .site-nav__xp[aria-expanded="true"] .site-nav__chev { rotate: 180deg; }

  .site-header__actions { display: flex; align-items: center; gap: var(--s-3); margin-left: auto; flex: none; }
  @media (min-width: 1024px) { .site-header__actions { margin-left: var(--s-2); } }
  .site-header__cta { display: none; }
  @media (min-width: 480px) { .site-header__cta { display: inline-flex; } }

  .menu-btn {
    display: inline-flex; align-items: center; gap: 8px;
    height: 44px; min-width: 44px; padding: 0 12px 0 16px;
    border: 0; border-radius: var(--r-pill); background: var(--kk-white); cursor: pointer;
    box-shadow: inset 0 0 0 2px var(--kk-ink);
    color: var(--kk-ink); font: 500 13px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none;
    transition: background-color var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo);
  }
  .menu-btn:hover { background: var(--kk-butter); box-shadow: inset 0 0 0 2px var(--kk-ink), 3px 3px 0 var(--kk-ink); }
  .menu-btn[aria-expanded="true"] { background: var(--kk-saffron); }
  .menu-btn__icons { display: inline-grid; }
  .menu-btn__icon { grid-area: 1 / 1; display: inline-flex; width: 20px; height: 20px; }
  .menu-btn__icon svg { width: 20px; height: 20px; }
  .menu-btn__icon--close { visibility: hidden; }
  .menu-btn[aria-expanded="true"] .menu-btn__icon--close { visibility: visible; }
  .menu-btn[aria-expanded="true"] .menu-btn__icon--menu { visibility: hidden; }
  @media (min-width: 1024px) { .menu-btn { display: none !important; } }
</style>
