---
/**
 * F4b · "Plant floor → boardroom" (DESIGN-SPEC v2 00.2, the home centrepiece). Ice ground. A PINNED (~250vh) scrubbed
 * diagram: one continuous Sapphire pipe draws left → right through a stylised oils plant (crude tank → refining column →
 * fractionation → blending → finished product) to a boardroom table with a Go/No-Go sign, then rises into the logo's
 * rising arrow. Each station lights in its pillar colour and its 3-word label pops as the pipe reaches it.
 * Real <title>/<desc> + an equivalent visually hidden <ol>. Ships fully drawn and lit (no JS / reduced motion).
 * Below 768 the stage is a horizontal scroller (keyboard focusable); with motion it pins and pans as the pipe draws.
 */
import Folio from '@/components/ui/Folio.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import { principles, principlesHeading } from '@/data/approach';
import { homeNotes } from '@/data/notes/home';
import type { PillarKey } from '@/data/types';

const P = homeNotes.pipeline;
const lead = principles[0];   // "Plant floor to boardroom" (brief principle)
const stations: { id: string; x: number; label: string; pillar: PillarKey }[] = [
  { id: 'tank', x: 150, label: P.tank, pillar: 'capability' },
  { id: 'refine', x: 410, label: P.refine, pillar: 'process' },
  { id: 'fraction', x: 680, label: P.fraction, pillar: 'quality' },
  { id: 'blend', x: 950, label: P.blend, pillar: 'innovation' },
  { id: 'product', x: 1205, label: P.product, pillar: 'deals' },
  { id: 'board', x: 1440, label: P.board, pillar: 'strategy' },
];
const pill = (s: string) => Math.round(s.length * 11.4 + 58);
// One continuous pipe. Segments inside a station are hidden by the station's opaque body (drawn above the pipe).
const PIPE = [
  'M40 470 H240 Q270 470 270 440 V300 Q270 270 300 270 H340 Q370 270 370 300 V440 Q370 470 400 470',   // tank → over → column foot
  'H410 V140 H470 Q500 140 500 170 V300 Q500 330 530 330 H600',        // up the column, out the top, down to the crystalliser
  'H760 Q790 330 790 360 V420 Q790 450 820 450 H860 Q890 450 890 420 V250 Q890 220 920 220 H950 V300', // to the blend tank top
  'V450 H1040 Q1070 450 1070 420 V200 Q1070 170 1100 170 H1205 V300',  // blend out → over → down to the filling nozzle
].join(' ');
---
<section class="pipeline band fold g-ice has-notes" aria-labelledby="pipeline-heading" data-pipeline>
  <div class="pipeline__pin" data-pipeline-pin>
    <div class="container pipeline__head">
      <Folio label={principlesHeading} />
      <div class="pipeline__titles">
        <h2 id="pipeline-heading" class="t-display pipeline__h">{lead.name}<span class="pipeline__dot" aria-hidden="true">.</span></h2>
        <p class="t-lead pipeline__lead">{lead.copy}</p>
      </div>
    </div>

    <div class="pipeline__viewport" data-pipeline-viewport tabindex="0" role="group" aria-labelledby="pipeline-heading">
      <div class="pipeline__stage" data-pipeline-stage>
        <svg class="pipeline__svg" viewBox="0 0 1600 600" role="img" aria-labelledby="pipeline-title pipeline-desc" focusable="false">
          <title id="pipeline-title">{P.title}</title>
          <desc id="pipeline-desc">{stations.map((s, i) => `${i + 1}. ${s.label}`).join(' → ')}</desc>

          <!-- floor line -->
          <path class="pl-floor" d="M20 482 H1580" />

          <!-- the pipe: casing, fill, then the flow dashes on top (hidden until drawn) -->
          <g class="pl-pipe">
            <path class="pl-pipe__case" d={PIPE} data-pipe />
            <path class="pl-pipe__core" d={PIPE} data-pipe />
            <path class="pl-pipe__flow" d={PIPE} data-pipe-flow />
          </g>

          <!-- 01 tank -->
          <g class="pl-st" data-station="0" style="--pc:var(--pillar-capability)">
            <path class="pl-body" d="M70 230 V470 H230 V230 Z" />
            <ellipse class="pl-body" cx="150" cy="230" rx="80" ry="20" />
            <path class="pl-fill" d="M74 320 Q150 335 226 320 V466 H74 Z" />
            <path class="pl-line" d="M70 320 Q150 335 230 320" />
            <path class="pl-line pl-thin" d="M92 260 V300 M108 268 V300" />
            <path class="pl-line" d="M90 470 V482 M210 470 V482" />
          </g>

          <!-- 02 refining column -->
          <g class="pl-st" data-station="1" style="--pc:var(--pillar-process)">
            <path class="pl-body" d="M378 120 Q378 92 410 92 Q442 92 442 120 V470 H378 Z" />
            <path class="pl-fill" d="M382 300 H438 V466 H382 Z" />
            <path class="pl-line pl-thin" d="M378 150 H442 M378 185 H442 M378 220 H442 M378 255 H442 M378 290 H442" />
            <path class="pl-line" d="M410 92 V66 M398 66 H422" />
          </g>

          <!-- 03 fractionation: two crystallisers -->
          <g class="pl-st" data-station="2" style="--pc:var(--pillar-quality)">
            <path class="pl-body" d="M600 290 H670 V420 L650 450 H620 L600 420 Z" />
            <path class="pl-body" d="M690 290 H760 V420 L740 450 H710 L690 420 Z" />
            <path class="pl-fill" d="M604 350 H666 V418 L648 446 H622 L604 418 Z" />
            <path class="pl-fill pl-fill--tint" d="M694 330 H756 V418 L738 446 H712 L694 418 Z" />
            <path class="pl-line pl-thin" d="M612 310 L622 320 M632 312 L640 322 M652 306 L660 316 M702 312 L712 322 M724 306 L732 316 M742 314 L750 324" />
            <path class="pl-line" d="M620 450 V482 M650 450 V482 M710 450 V482 M740 450 V482" />
          </g>

          <!-- 04 blending tank with agitator -->
          <g class="pl-st" data-station="3" style="--pc:var(--pillar-innovation)">
            <path class="pl-body" d="M890 300 H1010 V440 Q1010 470 980 470 H920 Q890 470 890 440 Z" />
            <path class="pl-fill" d="M894 350 Q950 362 1006 350 V440 Q1006 466 980 466 H920 Q894 466 894 440 Z" />
            <rect class="pl-body" x="932" y="270" width="36" height="30" rx="4" />
            <g class="pl-agitator" data-agitator>
              <path class="pl-line" d="M950 300 V420" />
              <path class="pl-line" d="M922 420 H978 M926 400 L950 420 L974 400" />
            </g>
          </g>

          <!-- 05 finished product: a filled tin on a pallet -->
          <g class="pl-st" data-station="4" style="--pc:var(--pillar-deals)">
            <path class="pl-line" d="M1187 300 H1223 L1215 316 H1195 Z" />
            <path class="pl-body" d="M1150 340 H1260 V462 H1150 Z" />
            <path class="pl-fill" d="M1150 372 H1260 V430 H1150 Z" />
            <circle class="pl-drop" cx="1205" cy="401" r="12" />
            <path class="pl-line" d="M1138 462 H1272 V474 H1138 Z M1150 474 V482 M1205 474 V482 M1260 474 V482" />
            <ellipse class="pl-body" cx="1205" cy="340" rx="55" ry="8" />
          </g>

          <!-- 06 boardroom: table, chairs, the Go/No-Go sign -->
          <g class="pl-st" data-station="5" style="--pc:var(--pillar-strategy)">
            <path class="pl-line" d="M1340 400 H1540 M1356 400 V482 M1524 400 V482" />
            <path class="pl-body" d="M1300 340 H1336 V420 H1300 Z M1544 340 H1580 V420 H1544 Z" />
            <path class="pl-line" d="M1304 420 V482 M1332 420 V482 M1548 420 V482 M1576 420 V482" />
            <rect class="pl-body pl-sign" x="1384" y="250" width="112" height="72" rx="10" />
            <path class="pl-line" d="M1440 322 V400" />
            <rect class="pl-fill" x="1392" y="258" width="96" height="56" rx="6" />
            <text class="pl-sign__t" x="1440" y="300" text-anchor="middle">{P.sign}</text>
          </g>

          <!-- the product goes to the decision -->
          <path class="pl-link" d="M1268 392 C1310 392 1330 300 1378 290" data-link />
          <path class="pl-link pl-link__head" d="M1362 278 L1380 290 L1364 304" data-link />

          <!-- the rising arrow: from the table, up and away -->
          <g class="pl-rise" data-rise-arrow>
            <path class="pl-pipe__case" d="M1440 250 V200 C1440 120 1500 90 1560 60" data-rise-path />
            <path class="pl-pipe__core" d="M1440 250 V200 C1440 120 1500 90 1560 60" data-rise-path />
            <path class="pl-rise__head" d="M1522 50 L1566 57 L1546 96" data-rise-head />
          </g>

          <!-- labels -->
          {stations.map((s, i) => (
            <g class="pl-label" data-station-label={i} transform={`translate(${s.x} 528)`} style={`--pc:var(--pillar-${s.pillar})`}>
              <rect x={-pill(s.label) / 2} y="-23" width={pill(s.label)} height="46" rx="23" />
              <circle cx={-pill(s.label) / 2 + 22} cy="0" r="7" class="pl-label__dot" />
              <text x="12" y="6.5" text-anchor="middle">{s.label.toUpperCase()}</text>
              <text class="pl-label__n" x="0" y="-40" text-anchor="middle">{String(i + 1).padStart(2, '0')}</text>
            </g>
          ))}
        </svg>
        <MarginNote text={P.same} tone="sapphire" rotate={-4} arrow="arrow-curve" arrowAt="below" arrowAngle={10} show="md" class="pipeline__note-same" trigger="[data-pipeline]" />
        <MarginNote text={P.up} tone="berry" rotate={6} arrow="arrow-loop" arrowAt="start" arrowAngle={-40} show="md" class="pipeline__note-up" trigger="[data-pipeline]" order={1} />
      </div>
    </div>
    <ol class="visually-hidden">
      {stations.map((s) => <li>{s.label}</li>)}
    </ol>
    <p class="container pipeline__hint t-note" aria-hidden="true">{P.scroll} <span class="pipeline__hint-arrow">→</span></p>
  </div>
</section>

<style>
  .pipeline { position: relative; overflow: clip; }
  .pipeline__pin { box-sizing: border-box; height: 100svh; min-height: 640px; max-height: 1100px; padding-block: calc(var(--header-h) + 8px) clamp(16px, 3vh, 40px); display: flex; flex-direction: column; }
  .pipeline__head :global(.folio) { margin-bottom: var(--s-5); }
  .pipeline__titles { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--s-4) var(--gutter); align-items: end; }
  .pipeline__h { margin: 0; color: var(--kk-ink); font-size: clamp(48px, min(5.2vw, 10vh), 92px); white-space: nowrap; }
  .pipeline__dot { color: var(--kk-sapphire); }
  .pipeline__lead { margin: 0; color: var(--kk-imperial); max-width: 40ch; }

  .pipeline__viewport { position: relative; flex: 1 1 auto; min-height: 0; margin-top: clamp(12px, 2.5vh, 32px); outline: none; display: flex; }
  .pipeline__viewport:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
  .pipeline__stage { position: relative; width: min(100%, 1600px); height: 100%; margin-inline: auto; padding-inline: var(--side); box-sizing: border-box; }
  .pipeline__svg { display: block; width: 100%; height: 100%; overflow: visible; }

  .pl-floor { fill: none; stroke: var(--kk-ink); stroke-width: 2; stroke-dasharray: 2 8; stroke-linecap: round; opacity: .45; }
  .pl-pipe__case { fill: none; stroke: var(--kk-ink); stroke-width: 18; stroke-linecap: round; stroke-linejoin: round; }
  .pl-pipe__core { fill: none; stroke: var(--kk-sapphire); stroke-width: 12; stroke-linecap: round; stroke-linejoin: round; }
  .pl-pipe__flow { fill: none; stroke: var(--kk-ice); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 22; opacity: 0; }
  .pipeline.is-flowing .pl-pipe__flow { opacity: .9; animation: pl-flow 1.1s linear infinite; }
  @keyframes pl-flow { to { stroke-dashoffset: -24; } }
  :global(html.motion-paused) .pipeline .pl-pipe__flow { animation-play-state: paused; }

  .pl-body { fill: #fff; stroke: var(--kk-ink); stroke-width: 3; stroke-linejoin: round; }
  .pl-line { fill: none; stroke: var(--kk-ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .pl-thin { stroke-width: 2; opacity: .55; }
  .pl-fill { fill: var(--pc); stroke: none; transition: fill .45s var(--ease-expo), opacity .45s var(--ease-expo); }
  .pl-fill--tint { opacity: .55; }
  .pl-drop { fill: #fff; stroke: var(--kk-ink); stroke-width: 3; }
  .pl-sign__t { font: 800 34px/1 var(--font-display); font-stretch: 75%; fill: var(--kk-ink); letter-spacing: .02em; }
  .pl-link { fill: none; stroke: var(--kk-ink); stroke-width: 3; stroke-dasharray: 8 8; stroke-linecap: round; stroke-linejoin: round; }
  .pl-link__head { stroke-dasharray: none; }
  .pl-rise__head { fill: none; stroke: var(--kk-ink); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .pl-rise .pl-pipe__core { stroke: var(--kk-saffron); }

  .pl-label rect { fill: #fff; stroke: var(--kk-ink); stroke-width: 2.5; }
  .pl-label__dot { fill: var(--pc); stroke: var(--kk-ink); stroke-width: 1.5; }
  .pl-label text { font: 500 17px/1 var(--font-mono); letter-spacing: .06em; fill: var(--kk-ink); }
  .pl-label .pl-label__n { font: 500 13px/1 var(--font-mono); fill: var(--kk-imperial); letter-spacing: .1em; }
  .pl-label { transform-box: fill-box; }

  /* JS state: unlit stations wait in white */
  .pipeline.is-armed .pl-st:not(.is-lit) .pl-fill { fill: #fff; }
  .pipeline.is-armed .pl-st:not(.is-lit) .pl-drop { fill: #fff; }
  .pl-st.is-lit .pl-drop { fill: var(--kk-saffron); }
  .pl-agitator { transform-box: fill-box; transform-origin: 50% 0; }
  .pipeline.is-flowing .pl-st.is-lit .pl-agitator { animation: pl-stir 1.4s ease-in-out infinite alternate; }
  @keyframes pl-stir { from { transform: scaleX(1); } to { transform: scaleX(-1); } }
  :global(html.motion-paused) .pipeline .pl-agitator { animation-play-state: paused; }

  .pipeline :global(.pipeline__note-same) { left: 27%; top: -4%; }
  .pipeline :global(.pipeline__note-up) { right: 2%; top: -10%; }
  .pipeline__hint { margin: var(--s-2) auto 0; color: var(--kk-sapphire); font-size: 26px; flex: none; }
  .pipeline__hint-arrow { display: inline-block; font-family: var(--font-display); }

  @media (max-width: 1023px) {
    .pipeline__titles { grid-template-columns: 1fr; }
  }
  @media (max-width: 1023px) { .pipeline__h { white-space: normal; } }
  @media (max-width: 767px) {
    .pipeline__pin { height: auto; min-height: 100svh; max-height: none; padding-top: calc(var(--header-h-compact) + 8px); }
    .pipeline__viewport { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; flex: none; }
    .pipeline__stage { width: 1040px; height: auto; flex: none; padding-inline: var(--side); }
    .pipeline__svg { height: auto; }
    .pipeline.is-panning .pipeline__viewport { overflow: visible; }
    .pipeline__h { font-size: clamp(44px, 13vw, 64px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pipeline .pl-pipe__flow, .pipeline .pl-agitator { animation: none !important; }
  }
</style>
