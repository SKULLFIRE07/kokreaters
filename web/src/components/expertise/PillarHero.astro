---
/**
 * Pillar hero (DESIGN-SPEC v2 10.3 F1): full-bleed on the pillar's colour-block ground with print grain. Dateline
 * "0n of 06 · Expertise", the pillar name as eyebrow, the H1 (never animated or hidden) and the intro's first sentence
 * (the rest folds into IntroMore). Right: the PillarMap constellation. A huge outlined pillar numeral sits behind.
 */
import Breadcrumbs from '../chrome/Breadcrumbs.astro';
import PillarDot from '../ui/PillarDot.astro';
import Sidenote from '../ui/Sidenote.astro';
import PillarMap from './PillarMap.astro';
import IntroMore from './IntroMore.astro';
import { pillarNumber, pillarGround } from '@/lib/pillars';
import type { Pillar } from '@/data/types';
import type { Crumb } from '@/components/seo/schema';

interface Props { pillar: Pillar; crumbs: Crumb[]; introHtml: string; introNotes?: string[] }
const { pillar, crumbs, introHtml, introNotes = [] } = Astro.props;
---
<section class:list={['band', 'fold', `g-${pillarGround(pillar.key)}`, 'grain', 'p-hero']} aria-labelledby="pillar-title">
  <span class="p-hero__num" aria-hidden="true" data-parallax="-0.15">{pillarNumber(pillar)}</span>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class="p-hero__grid">
      <div class="p-hero__text">
        <p class="t-dateline p-hero__dateline">
          <span class="p-hero__dot"><PillarDot pillar={pillar.key} size={10} /></span>
          <span><span class="tnum">{pillarNumber(pillar)}</span> of <span class="tnum">06</span> · Expertise</span>
        </p>
        <p class="t-h4 p-hero__eyebrow">{pillar.name}</p>
        <h1 id="pillar-title" class="t-display p-hero__title">{pillar.headline}</h1>
        <IntroMore class="p-hero__intro" html={introHtml} />
        {introNotes.map((n) => <Sidenote class="p-hero__note">{n}</Sidenote>)}
      </div>
      <div class="p-hero__map">
        <PillarMap current={pillar.key} />
      </div>
    </div>
  </div>
</section>
<style>
  .p-hero { position: relative; padding-top: var(--s-5); padding-bottom: clamp(4rem, 2rem + 6vw, 8rem); overflow: clip; }
  .p-hero__num {
    position: absolute; right: -0.04em; bottom: -0.2em; z-index: 0; pointer-events: none;
    font: 800 clamp(16rem, 8rem + 30vw, 46rem)/0.8 var(--font-display); font-stretch: 75%; letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 2px var(--fg); opacity: .22;
  }
  .p-hero .container { position: relative; z-index: 1; }
  .p-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); align-items: center; margin-top: var(--s-8); }
  .p-hero__dateline { display: flex; align-items: center; gap: var(--s-3); margin: 0 0 var(--s-5); color: var(--fg); }
  .p-hero__dot { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--kk-white); }
  .p-hero__eyebrow { margin: 0 0 var(--s-4); color: var(--fg); max-width: 28ch; }
  .p-hero__title { margin: 0; max-width: 14ch; color: var(--head); font-size: clamp(3rem, 1.3rem + 6.4vw, 7.5rem); }
  .p-hero :global(.p-hero__intro) { margin-top: var(--s-6); max-width: var(--measure-lead); }
  .p-hero__text :global(.p-hero__note) { margin: var(--s-4) 0 0; }
  @media (max-width: 1023px) {
    .p-hero__grid { grid-template-columns: 1fr; }
    .p-hero__map { max-width: 520px; width: 100%; }
  }
  @media (max-width: 767px) { .p-hero__grid { margin-top: var(--s-6); gap: var(--s-6); } .p-hero__num { font-size: 15rem; bottom: -0.1em; } }
</style>
