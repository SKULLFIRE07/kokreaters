---
/**
 * "From our founder’s career" (REDESIGN-V3 §4 Impact): SectionHeader (bare h2 partOne, no eyebrow per the inner-page rule; lead naming
 * Wilmar and Cargill), then the four cases in data order (India, Indonesia, Ukraine, WHO), each a CaseStudy with its
 * photo from research/v3/photos.md. Shown once (v2 showed them twice: stack + chapters).
 * v3.1 (§9): each case is a cinematic spread (CaseStudy), the photo alternating sides: left, right, left, right.
 * Photos keep their natural orientation (portrait 3:4, landscape 3:2).
 * Desktop: cases 160 → 200px apart, no rules (air and the numbered kicker separate them). Mobile: 96px apart.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CaseStudy from './CaseStudy.astro';
import { founderResults, impactPage } from '@/data/impact';
import { photos, type PhotoSlug } from '@/data/photos';
import type { FounderResult } from '@/data/types';

interface Props { ground?: 'white' | 'grey' }
const { ground = 'white' } = Astro.props;

/**
 * Placement plan (photos.md, "Impact"): one photo per case, none repeated on the page, and none that is also a pillar
 * hero (plant-01 = Process design, factory-01 = Capability): someone coming from /expertise must not see the same image
 * twice. India (specialty fats) → the stainless coating pan; Indonesia (growth) → the team reviewing figures.
 */
const casePhoto: Record<FounderResult['id'], PhotoSlug> = {
  india: 'chocolate-02',
  indonesia: 'people-02',
  ukraine: 'cold-01',
  tfa: 'bakery-01',
};
---
<Section ground={ground} labelledby="part-founder">
  <SectionHeader id="part-founder" title={impactPage.partOne} lead={impactPage.partOneLead} />
  <div class="cases">
    {founderResults.map((r, i) => (
      <CaseStudy result={r} photo={photos[casePhoto[r.id]]} index={i + 1} total={founderResults.length} side={i % 2 === 0 ? 'left' : 'right'} />
    ))}
  </div>
</Section>
<style>
  .cases { display: grid; gap: var(--s-9); margin-top: var(--s-8); }
  @media (min-width: 900px) { .cases { gap: clamp(10rem, 4rem + 6.6vw, 12.5rem); margin-top: var(--s-9); } }
</style>
