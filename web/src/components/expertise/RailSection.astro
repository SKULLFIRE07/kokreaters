---
/**
 * Rail section (expertise pages): the label + h2 sit in the left 4 of 12 columns, the content in columns 6–12, both
 * top-aligned. v4 Delft: the head is the PAGES-A Head (label, Bodoni h2); grounds white / grey (Porcelain) / ice.
 * `pad="tight"` where a rail follows another rail of the same ground across a hairline.
 * Mobile (< 900px): one column, heading first, content 32px below.
 */
import Section from '@/components/ui/Section.astro';
import Head from './Head.astro';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  ground?: 'white' | 'grey' | 'ice';
  rule?: boolean;
  pad?: 'default' | 'tight';
  class?: string;
}
const { id, title, eyebrow, ground = 'white', rule = false, pad = 'default', class: cls } = Astro.props;
const g = ground === 'ice' ? 'white' : ground;
---
<Section ground={g} rule={rule} pad={pad} labelledby={id} class:list={[ground === 'ice' && 'band--ice', cls]}>
  <div class="rail">
    <Head id={id} title={title} label={eyebrow} class="rail__head" />
    <div class="rail__body"><slot /></div>
  </div>
</Section>
<style>
  .rail { display: grid; grid-template-columns: minmax(0, 1fr); }
  .rail > :global(.rail__head) { margin-bottom: var(--s-6); }
  .rail > :global(.rail__head .hd__title) { font-size: clamp(2rem, 1.7rem + 1vw, 2.75rem); max-width: 14ch; }
  .rail__body { min-width: 0; }
  @media (min-width: 900px) {
    .rail { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: start; }
    .rail > :global(.rail__head) { grid-column: 1 / 5; margin-bottom: 0; }
    .rail__body { grid-column: 6 / -1; }
  }
</style>
