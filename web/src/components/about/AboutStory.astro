---
/**
 * About · the story (REDESIGN-V3 §4 About, section 2). White band, aria-labelledby="bio-title".
 * ≥ 900px: 12 columns. Columns 1–4: the h2 (the founder's name; bare, no eyebrow: inner-page content sections carry none). Columns 5–12: the short story
 * (longBio[0]) as a serif lede, then "Read the long version", a native <details data-smooth> (height eases open via
 * motion.css; instant where unsupported; paragraphs stay in the DOM for search). Inside, each paragraph of longBio[1..5]
 * keeps columns 5–12 and its dated sidenotes (bioSidenotes) hang in columns 1–4 of the same row.
 * Mobile (< 900px): one column. Name, lede (21px → 32px serif), the disclosure as a full-width 48px button, then the
 * paragraphs at 18px with their date labels set above them.
 */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Section from '@/components/ui/Section.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { founderName, founderRole, longBio, bioSidenotes, aboutPage } from '@/data/founder';
import { footer } from '@/data/nav';
import { site } from '@/config/site';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Keep "21%" / "15%" in one piece on any line (tabular, no-wrap). */
const withFigures = (s: string) => esc(s).replace(/(\d+%)/g, '<span class="nowrap tnum">$1</span>');
const paras = longBio.map((text, i) => ({
  html: withFigures(text),
  notes: bioSidenotes.filter((n) => n.at === i + 1).map((n) => n.text),
}));
const [lede, ...rest] = paras;
---
<Section ground="white" labelledby="bio-title" class="story">
  <div class="story__grid">
    <div class="story__head">
      <SectionHeader id="bio-title" title={founderName} />
      <p class="story__role">{founderRole}, {site.name}</p>
      <p class="story__base"><span class="story__dot" aria-hidden="true"></span>{footer.contact.base}</p>
    </div>
    <div class="story__main">
      <p class="story__lede"><Fragment set:html={lede.html} /> <Confirm id={13} note="founded in 2026 and career dates" /></p>
    </div>
    <details class="story__more" data-smooth>
      <summary class="story__toggle btn btn--secondary">
        <span class="btn__label">{aboutPage.bioMore}</span>
        <svg class="story__icon" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M3 10h14" /><path class="story__icon-v" d="M10 3v14" />
        </svg>
      </summary>
      <div class="story__rest">
        {rest.map((p) => (
          <div class="story__row">
            {p.notes.length > 0 && (
              <div class="story__side">
                {p.notes.map((t) => <p class="story__date tnum">{t}</p>)}
              </div>
            )}
            <p class="story__p" set:html={p.html} />
          </div>
        ))}
      </div>
    </details>
  </div>
</Section>
<style>
  .story__grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .story__head { margin-bottom: var(--s-6); }
  .story__head :global(.sh) { margin-bottom: 0; }
  .story__role { margin: var(--s-4) 0 0; font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 700; color: var(--head); }
  .story__base { display: flex; align-items: center; gap: var(--s-2); margin: var(--s-1) 0 0; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); }
  .story__dot { width: 6px; height: 6px; background: var(--saffron); flex: none; }
  /* v4: the lede is the band's statement in Bodoni 24 → 40, measure ≤ 30ch */
  .story__lede {
    margin: 0; max-width: 30ch;
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); line-height: 1.25; letter-spacing: 0; color: var(--head); text-wrap: pretty;
  }

  /* the disclosure: the foundation's secondary button look on a native <summary> */
  .story__more { margin-top: var(--s-6); }
  .story__toggle { list-style: none; width: 100%; justify-content: space-between; }
  .story__toggle::-webkit-details-marker { display: none; }
  .story__icon { flex: none; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
  .story__icon-v { transform-origin: 10px 10px; transition: transform var(--d-2) var(--ease-out); }
  .story__more[open] .story__icon-v { transform: rotate(90deg); }

  .story__rest { display: grid; gap: var(--s-6); padding-top: var(--s-7); }
  .story__row { display: grid; gap: var(--s-2); }
  .story__side { display: grid; gap: var(--s-1); }
  .story__date { margin: 0; font-size: var(--fs-meta); line-height: var(--lh-meta); font-weight: 700; color: var(--label); }
  .story__p { margin: 0; max-width: var(--measure); font-size: 1.0625rem; line-height: 1.75; color: var(--fg-2); text-wrap: pretty; }

  @media (min-width: 600px) {
    .story__toggle { width: auto; gap: var(--s-4); }
  }

  @media (min-width: 900px) {
    .story__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: start; }
    .story__head { grid-column: 1 / 5; margin-bottom: 0; }
    .story__main { grid-column: 5 / -1; }
    .story__more { grid-column: 1 / -1; margin-top: var(--s-7); }
    /* the button lines up with the lede in column 5 */
    .story__toggle { margin-left: calc((100% - 11 * var(--grid-gap)) / 12 * 4 + 4 * var(--grid-gap)); }
    .story__rest { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); row-gap: var(--s-6); }
    /* subgrid: `column-gap: normal` keeps the parent's gap, so the paragraphs line up with the lede in column 5 */
    .story__row { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; column-gap: normal; }
    .story__side { grid-column: 1 / 4; align-content: start; padding-top: 4px; }
    .story__p { grid-column: 5 / -1; }
  }
</style>
