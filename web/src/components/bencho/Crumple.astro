/**
 * Crumple (DESIGN-SPEC v2 9, 10.5 F3): a paper "report" card. The button (or a press on the paper) crumples it into a
 * ball that drops and rolls away (canvas mesh fold, scripts/bencho/crumple.ts); the button then reads "Smooth it out".
 * The paper is decorative (aria-hidden); the caption h2 next to it carries the meaning. Static state (JS off): the
 * paper with a hand strike across it and the "much better" note. The button stays hidden until the script runs.
 */
interface Props { file: string; button: string; reset: string; after: string; class?: string }
const { file, button, reset, after, class: cls } = Astro.props;
const widths = [92, 78, 86, 64, 0, 90, 82, 70, 88, 56];
---
<div class:list={['crumple', cls]} data-crumple data-label-crumple={button} data-label-reset={reset}>
  <div class="crumple__stage" data-toy data-cursor="press">
    <div class="crumple__paper" data-crumple-paper aria-hidden="true">
      <p class="crumple__file">{file}</p>
      <span class="crumple__title"></span>
      {widths.map((w) => (w ? <span class="crumple__line" style={`width:${w}%`}></span> : <span class="crumple__gap"></span>))}
      <svg class="crumple__strike" viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M30 40 C 140 170, 250 300, 372 462" /><path d="M368 52 C 260 160, 150 310, 34 452" />
      </svg>
    </div>
    <canvas class="crumple__canvas" aria-hidden="true"></canvas>
    <span class="crumple__after t-note t-note--lg" aria-hidden="true">{after}</span>
  </div>
  <button type="button" class="btn btn--primary btn--sweep btn--md crumple__btn" data-crumple-btn hidden aria-pressed="false">
    <span class="btn__label" data-crumple-label>{button}</span>
  </button>
</div>
<style>
  .crumple { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-5); }
  .crumple__stage { position: relative; width: 100%; height: clamp(400px, 36vw, 500px); overflow: clip; }
  .crumple__paper {
    position: absolute; left: 50%; top: 48%; translate: -50% -50%; width: min(78%, 360px); aspect-ratio: 4 / 5;
    background: var(--kk-white); border: 2px solid var(--kk-ink); border-radius: 6px; padding: 26px 26px 0;
    display: flex; flex-direction: column; gap: 12px; rotate: -3deg; box-shadow: 10px 10px 0 var(--kk-ink); cursor: pointer;
  }
  .crumple__file { margin: 0 0 6px; font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: .02em; color: var(--kk-ink);
    padding-bottom: 10px; border-bottom: 2px solid var(--kk-ink); }
  .crumple__title { display: block; height: 22px; width: 70%; border-radius: 3px; background: var(--kk-ink); opacity: .85; margin-bottom: 6px; }
  .crumple__line { display: block; height: 9px; border-radius: 3px; background: #C9CCD8; }
  .crumple__gap { display: block; height: 4px; }
  .crumple__strike { position: absolute; inset: 6% 4%; width: 92%; height: 88%; overflow: visible; fill: none; stroke: var(--kk-berry); stroke-width: 6; stroke-linecap: round; }
  .crumple__canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; display: none; }
  .crumple__after { position: absolute; right: 8%; top: 14%; color: var(--note); rotate: -6deg; pointer-events: none; }
  /* live (script running): no strike, no note until it is crumpled */
  .crumple.is-live .crumple__strike { display: none; }
  .crumple.is-live .crumple__after { opacity: 0; scale: .8; transition: opacity .4s var(--ease-expo), scale .5s var(--ease-spring); }
  .crumple.is-live.is-done .crumple__after { opacity: 1; scale: 1; }
  .crumple.is-live.is-done .crumple__paper, .crumple.is-busy .crumple__paper { visibility: hidden; }
  .crumple.is-busy .crumple__canvas, .crumple.is-done .crumple__canvas { display: block; }
  .crumple.is-done:not(.is-live) .crumple__paper { visibility: hidden; }
  .crumple__paper:focus-visible { outline: 3px solid var(--focus); }
</style>
