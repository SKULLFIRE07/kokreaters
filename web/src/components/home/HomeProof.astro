---
/**
 * Home 3 · Track record (pack 3 point 3 + bug 2). Porcelain band: label "Our track record", then six tiles from
 * career.ts `homeTrackRecord` — 25 years · 8 sites (in 5 countries) · 3 regions · 2 national firsts · 3,000 t/day ·
 * 100 people. Number in Bodoni lining figures at the one stat size (72–80px desktop), unit in Manrope beside it, label
 * in Manrope under it. No counting animation: every label is in its final form at first paint. Draft figures render in
 * staging and preview only (production: confirmed only), with a CONFIRM marker in staging.
 * The footnote is NOT here: one footnote per page, at the end of the Impact section.
 * Layout: 3 × 2 from 900px (2 columns from 600px, 1 below), each tile on a hairline that draws in once.
 */
import Confirm from '@/components/ui/Confirm.astro';
import { trackRecord } from '@/data/home';
import { homeTrackRecord, visible } from '@/data/career';

const tiles = visible(homeTrackRecord);
---
<section id="track-record" class="hp band band--grey" aria-labelledby="hp-heading">
  <div class="container">
    <h2 id="hp-heading" class="t-label hp__label">{trackRecord.label}</h2>
    <ul class:list={['hp__grid', tiles.length % 3 !== 0 && 'hp__grid--4']} role="list">
      {tiles.map((t) => (
        <li class="hp__item">
          <span class="hp__rule" data-gsap="rule" aria-hidden="true"></span>
          <p class="hp__fig"><span class="hp__n">{t.value}</span>{t.unit && <span class="hp__u">{t.unit}</span>}</p>
          <p class="hp__l">{t.label}</p>
          {t.status === 'draft' && <Confirm id="P-2" note="draft figure, Ganeaysh to confirm" />}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hp { --_pad: clamp(3.5rem, 2.6rem + 3.4vw, 6rem); }
  .hp__label { margin: 0 0 clamp(28px, 2vw + 16px, 44px); }
  .hp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; margin: 0; padding: 0; list-style: none; }
  .hp__item { position: relative; display: flex; flex-direction: column; gap: 10px; padding-top: 22px; }
  .hp__rule { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--navy-900); opacity: .22; }
  .hp__fig { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 10px; margin: 0; color: var(--navy-900); }
  .hp__n {
    font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-stat); line-height: 1; letter-spacing: -0.01em;
    font-variant-numeric: lining-nums; white-space: nowrap;
  }
  .hp__u { font-family: var(--font-sans); font-weight: 700; font-size: 1.125rem; line-height: 1.2; color: var(--blue-700); white-space: nowrap; }
  .hp__l { margin: 0; max-width: 32ch; font-size: .9375rem; line-height: 1.45; color: var(--fg-2); }
  @media (max-width: 599px) { .hp__u { font-size: 1rem; } .hp__fig { column-gap: 6px; } }
  @media (min-width: 600px) { .hp__grid { column-gap: var(--grid-gap); } .hp__l { font-size: 1rem; line-height: 1.5; } }
  @media (min-width: 900px) {
    .hp__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 48px; }
    .hp__u { font-size: 1.25rem; }
    .hp__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
