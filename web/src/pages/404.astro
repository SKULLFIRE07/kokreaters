---
/**
 * 404 (REDESIGN-V3 §4 Legal and 404). One navy band: eyebrow "404", H1 "This page could not be found.", the brief's
 * line "Let’s connect you back.", then four plain links (Home, Expertise, Insights, Contact) and the NodeMark as the
 * quiet signature. noindex and no CtaBand (BaseLayout, page="notfound"); no breadcrumbs, no JSON-LD.
 * The band runs straight into the navy footer, so a container-width hairline separates the two.
 * Mobile (< 900px): one column; the links stack as full-width 56px rows with hairlines; the NodeMark leaves the flow
 * and sits small (48px) at the top right, level with the "404" eyebrow, as a folio mark (not an orphan under the list).
 * 900–1199px: links in a 2 × 2 grid (four columns would crowd label and arrow); ≥ 1200px: one row of four. The label
 * and arrow are centred on one line in every layout. NodeMark large in the right-hand column from 900px.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import NodeMark from '@/components/brand/NodeMark.astro';
import { notFoundPage } from '@/data/notfound';
import { pageSeo } from '@/lib/seo';
---
<BaseLayout page="notfound" seo={pageSeo('notfound')}>
  <PageHero ground="navy" eyebrow={notFoundPage.code} title={notFoundPage.headline} lead={notFoundPage.line} titleId="nf-title" class="nf-hero" asideMobile="corner">
    <ul class="nf-links" role="list">
      {notFoundPage.links.map((l) => (
        <li>
          <a class="nf-link u-hover" href={l.href}>
            <span class="nf-link__label u-draw">{l.label}</span>
            <Icon name="arrow-right" size={20} stroke={2} class="nf-link__arrow u-nudge" />
          </a>
        </li>
      ))}
    </ul>
    <div slot="aside" class="nf-mark"><NodeMark size={200} tone="blue" /></div>
  </PageHero>
  <div class="band band--navy band--pad-none" aria-hidden="true"><div class="container"><div class="hairline"></div></div></div>
</BaseLayout>

<style>
  .nf-links {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--rule);
  }
  .nf-link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    min-height: 56px; padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
    font: 450 var(--fs-h4)/var(--lh-h4) var(--font-serif); font-optical-sizing: auto;
    color: var(--head); text-decoration: none;
  }
  .nf-link :global(.nf-link__arrow) { flex: none; color: var(--accent); }

  .nf-mark { display: flex; }
  .nf-mark :global(.nodemark) { width: 200px; height: 200px; }

  /* Mobile: PageHero asideMobile="corner" puts the mark top right, level with the eyebrow; here it only shrinks */
  @media (max-width: 899px) {
    .nf-mark :global(.nodemark) { width: 48px; height: 48px; }
  }

  @media (min-width: 900px) {
    .nf-links { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--grid-gap); border-top: 0; }
    .nf-link { border-bottom: 0; border-top: 1px solid var(--rule); min-height: 64px; padding-block: var(--s-4); }
    .nf-mark { justify-content: flex-end; }
  }
  @media (min-width: 1200px) {
    .nf-links { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
