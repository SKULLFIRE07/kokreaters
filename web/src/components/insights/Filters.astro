---
/**
 * Insight filters (REDESIGN-V3 §4 Insights hub; behaviour contract research/v3/inventory-insights.md A6).
 * Two rows of small toggle buttons (aria-pressed), "All" first, then the expertise areas / the formats that have at
 * least one visible insight (a button that can only lead to an empty list is not offered). A row that would offer a
 * single option changes nothing, so it is left out; with no row left the whole filter bar is omitted.
 * Server-rendered `hidden`: scripts/pages/insights.ts un-hides it, reads ?pillar= & ?format= (a value without a button
 * falls back to "All"), filters the .insight-row items in [data-insight-list] and writes the count into
 * [data-filter-status] (singular-aware).
 * One navy highlight per row glides to the pressed button (Motion Primitives "AnimatedBackground", vanilla);
 * without it the pressed button fills itself.
 * Mobile: label above its row; buttons wrap onto as many lines as needed (never a horizontal scroll); 44px tap height
 * on touch, 40px visual + 2px invisible hit margin on fine pointers; 24px between the two groups.
 */
import type { CollectionEntry } from 'astro:content';
import { pillars } from '@/data/pillars';
import { microcopy, formatLabels } from '@/data/microcopy';
import { insightsHub, articleCopy } from '@/data/insights';
import { fill } from '@/lib/format';
interface Props { entries: CollectionEntry<'insights'>[]; }
const { entries } = Astro.props;
const total = entries.length;
const usedPillars = new Set<string>(entries.map((e) => e.data.pillar));
const usedFormats = new Set<string>(entries.map((e) => e.data.format));
const formats = Object.entries(formatLabels) as [keyof typeof formatLabels, string][];
const rows = [
  { key: 'pillar', id: 'filter-pillar-label', label: articleCopy.expertise, opts: pillars.filter((p) => usedPillars.has(p.key)).map((p) => ({ value: p.key as string, label: p.shortLabel })) },
  { key: 'format', id: 'filter-format-label', label: microcopy.filterFormat, opts: formats.filter(([k]) => usedFormats.has(k)).map(([k, label]) => ({ value: k as string, label })) },
].filter((r) => r.opts.length > 1);
const many = microcopy.insightsCount;
const one = insightsHub.countOne;
---
{rows.length > 0 && (
<div class="filters" role="group" aria-label={microcopy.filterGroup} hidden data-filters>
  {rows.map((r) => (
    <div class="filters__row">
      <span class="filters__label t-label" id={r.id}>{r.label}</span>
      <div class="filters__track" data-filter-track>
        <span class="filters__glide" aria-hidden="true" data-filter-glide></span>
        <ul class="filters__opts" role="list" aria-labelledby={r.id}>
          <li><button type="button" class="filters__btn" aria-pressed="true" data-filter={r.key} data-value="">{microcopy.filterAll}</button></li>
          {r.opts.map((o) => (
            <li><button type="button" class="filters__btn" aria-pressed="false" data-filter={r.key} data-value={o.value}>{o.label}</button></li>
          ))}
        </ul>
      </div>
    </div>
  ))}
  <p class="filters__status tnum" aria-live="polite" data-filter-status data-template={many} data-template-one={one}>{fill(total === 1 ? one : many, { n: total })}</p>
</div>
)}
<style>
  .filters { display: grid; gap: var(--s-5); margin-bottom: var(--s-7); }
  .filters__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  .filters__label { color: var(--fg-2); }
  .filters__track { position: relative; isolation: isolate; }
  .filters__opts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .filters__btn {
    position: relative; z-index: 1;
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-4);
    border: 1px solid var(--rule); border-radius: var(--r-sm); background: var(--surface); color: var(--fg);
    font: 500 var(--fs-small)/1.2 var(--font-sans); letter-spacing: 0; cursor: pointer;
    transition: border-color var(--d-1) var(--ease-out), color var(--d-2) var(--ease-out), background-color var(--d-1) var(--ease-out);
  }
  .filters__btn:hover { border-color: var(--fg-2); }
  .filters__btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .filters__btn[aria-pressed="true"] { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-fg); }
  /* glide on: the moving highlight carries the fill, the pressed button only switches its text colour */
  .filters__track.has-glide .filters__btn[aria-pressed="true"] { background: transparent; }
  .filters__glide {
    position: absolute; left: 0; top: 0; z-index: 0; width: 0; height: 0;
    border-radius: var(--r-sm); background: var(--btn-bg); opacity: 0; pointer-events: none;
    transition: transform var(--d-2) var(--ease-out), width var(--d-2) var(--ease-out), height var(--d-2) var(--ease-out);
  }
  .filters__glide.is-still { transition: none; }
  .filters__status {
    margin: var(--s-2) 0 0; padding-top: var(--s-4); border-top: 1px solid var(--rule);
    font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2);
  }
  .filters__status:empty { padding-top: 0; }   /* no filter chosen: the hairline alone closes the filter bar */

  @media (pointer: fine) {
    .filters__btn { min-height: 40px; }
    .filters__btn::after { content: ""; position: absolute; inset: -2px 0; }
  }
  @media (min-width: 900px) {
    .filters { gap: var(--s-4); }
    .filters__row { grid-template-columns: 7.5rem minmax(0, 1fr); align-items: start; column-gap: var(--s-5); }
    .filters__label { padding-top: 12px; }
  }
</style>
