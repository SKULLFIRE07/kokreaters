---
/**
 * Ticket (DESIGN-SPEC v2 9 + 10.10): "Book a 30-minute call" as a Saffron boarding pass with a perforated stub.
 * Port of the Bencho "ticket" block to vanilla TS + GSAP + CSS, restyled to the v2 tokens.
 *
 * MIT License · Copyright (c) 2026 Lorenzo Cabra (bencho.dev). Permission is hereby granted, free of charge, to any
 * person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the
 * Software without restriction, subject to the following condition: the above copyright notice and this permission
 * notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS",
 * WITHOUT WARRANTY OF ANY KIND. Full text: web/THIRD_PARTY_NOTICES.md.
 *
 * HTML underneath: the real <a class="btn"> lives in the stub; the pass fields are an aria-hidden prop (Passenger is
 * the visitor's typed Name, fallback "You"). scripts/bencho/ticket.ts: drag the stub away along the perforation, or
 * press the link (Enter/click), and the stub rips off (0.6 s) before navigating; when the booking target is the form
 * on this page, the stub springs back after the form is focused. No JS / reduced motion: a plain link.
 */
import Button from '@/components/ui/Button.astro';
import Confirm from '@/components/ui/Confirm.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import Logo from '@/components/brand/Logo.astro';
import { contact } from '@/data/contact';
import { founderName } from '@/data/founder';
import { journalNotes } from '@/data/notes/journal';
import { site } from '@/config/site';

const t = journalNotes.ticket;
const bookingIsForm = site.bookingUrl === '/contact#form';
const bookingHref = bookingIsForm ? '#form' : site.bookingUrl;
const bookingExternal = !bookingIsForm && /^https?:/i.test(site.bookingUrl);
---
<div class="ticket-wrap has-notes">
<div class="ticket" data-ticket data-booking-mode={bookingIsForm ? 'form' : 'external'}>
  <div class="ticket__pass g-saffron grain" aria-hidden="true">
    <div class="ticket__top">
      <span class="ticket__title t-label">{t.title}</span>
      <Logo variant="cluster" height={34} width={34} alt="" />
    </div>
    <div class="ticket__route">
      <span class="ticket__city" data-ticket-passenger data-fallback={contact.visitorFallback}>{contact.visitorFallback}</span>
      <span class="ticket__path"><svg viewBox="0 0 120 24" fill="none" focusable="false"><path d="M2 12 H 118" stroke-dasharray="4 6" /><circle cx="60" cy="12" r="7" /><path d="M56 12 h8 M61 9 l3 3 -3 3" /></svg></span>
      <span class="ticket__city">GK</span>
    </div>
    <dl class="ticket__fields">
      <div><dt class="t-micro">{t.passenger}</dt><dd data-ticket-passenger data-fallback={contact.visitorFallback}>{contact.visitorFallback}</dd></div>
      <div><dt class="t-micro">{t.with}</dt><dd>{founderName}</dd></div>
      <div><dt class="t-micro">{t.length}</dt><dd>{t.minutes}</dd></div>
    </dl>
    <span class="ticket__barcode" aria-hidden="true"></span>
  </div>
  <div class="ticket__stub g-saffron grain" data-ticket-stub data-cursor="pull">
    <span class="ticket__perf" aria-hidden="true"></span>
    <Button href={bookingHref} variant="primary" size="sm" arrow magnetic={false} class="ticket__btn" data-booking={bookingIsForm ? 'form' : 'external'} data-ticket-link {...(bookingExternal ? { rel: 'noopener' } : {})}>{contact.booking}</Button>
  </div>
</div>
  <MarginNote text={t.tear} tone="berry" rotate={-5} arrow={null} place="right:calc(var(--stub-w) - 40px);top:-34px;max-width:none;" show="pointer" delay={0.6} class="ticket__tear" />
</div>
<p class="ticket__confirm"><Confirm id={9} /></p>
<style>
  .ticket-wrap { --stub-w: 196px; position: relative; max-width: 560px; }
  .ticket { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) var(--stub-w); max-width: 560px; filter: drop-shadow(5px 5px 0 var(--kk-ink)); rotate: -1.5deg; }
  .ticket__pass, .ticket__stub { position: relative; border: 2px solid var(--kk-ink); }
  .ticket__pass { display: flex; flex-direction: column; gap: 14px; padding: 18px 20px 16px; border-right: 0; border-radius: 20px 0 0 20px;
    -webkit-mask: radial-gradient(circle 12px at 100% 0, #0000 11px, #000 12px) top / 100% 51% no-repeat, radial-gradient(circle 12px at 100% 100%, #0000 11px, #000 12px) bottom / 100% 51% no-repeat;
            mask: radial-gradient(circle 12px at 100% 0, #0000 11px, #000 12px) top / 100% 51% no-repeat, radial-gradient(circle 12px at 100% 100%, #0000 11px, #000 12px) bottom / 100% 51% no-repeat; }
  .ticket__stub { display: grid; place-items: center; padding: 16px 12px; border-left: 0; border-radius: 0 20px 20px 0; touch-action: none; cursor: grab;
    -webkit-mask: radial-gradient(circle 12px at 0 0, #0000 11px, #000 12px) top / 100% 51% no-repeat, radial-gradient(circle 12px at 0 100%, #0000 11px, #000 12px) bottom / 100% 51% no-repeat;
            mask: radial-gradient(circle 12px at 0 0, #0000 11px, #000 12px) top / 100% 51% no-repeat, radial-gradient(circle 12px at 0 100%, #0000 11px, #000 12px) bottom / 100% 51% no-repeat; }
  .ticket__stub:active { cursor: grabbing; }
  .ticket__perf { position: absolute; left: -1px; top: 14px; bottom: 14px; border-left: 3px dotted var(--kk-ink); }
  .ticket__top { display: flex; align-items: center; justify-content: space-between; }
  .ticket__title { letter-spacing: .2em; }
  .ticket__route { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; }
  .ticket__city { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: 2.6rem; line-height: .9; letter-spacing: -0.02em; text-transform: uppercase; max-width: 6ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ticket__path svg { display: block; width: 100%; height: 24px; overflow: visible; }
  .ticket__path path, .ticket__path circle { stroke: var(--kk-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ticket__path circle { fill: var(--kk-white); }
  .ticket__fields { display: grid; grid-template-columns: 1.1fr 1.4fr .7fr; gap: 10px; margin: 0; padding-top: 12px; border-top: 1.5px dashed var(--kk-ink); }
  .ticket__fields div { min-width: 0; }
  .ticket__fields dt { margin: 0 0 3px; opacity: .8; }
  .ticket__fields dd { margin: 0; font-family: var(--font-mono); font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ticket__barcode { height: 22px; background: repeating-linear-gradient(90deg, var(--kk-ink) 0 2px, transparent 2px 4px, var(--kk-ink) 4px 7px, transparent 7px 9px, var(--kk-ink) 9px 10px, transparent 10px 13px); opacity: .85; }
  .ticket :global(.ticket__btn) { white-space: normal; text-align: center; height: auto; min-height: 44px; padding: 10px 16px; line-height: 1.1; font-size: 16px; }
  .ticket-wrap :global(.ticket__tear) { pointer-events: none; }
  .ticket__confirm { margin: var(--s-4) 0 0; }
  @media (max-width: 479px) {
    .ticket { grid-template-columns: minmax(0, 1fr); }
    .ticket__pass { border-right: 2px solid var(--kk-ink); border-bottom: 0; border-radius: 20px 20px 0 0;
      -webkit-mask: radial-gradient(circle 12px at 0 100%, #0000 11px, #000 12px) left / 51% 100% no-repeat, radial-gradient(circle 12px at 100% 100%, #0000 11px, #000 12px) right / 51% 100% no-repeat;
              mask: radial-gradient(circle 12px at 0 100%, #0000 11px, #000 12px) left / 51% 100% no-repeat, radial-gradient(circle 12px at 100% 100%, #0000 11px, #000 12px) right / 51% 100% no-repeat; }
    .ticket__stub { border-left: 2px solid var(--kk-ink); border-top: 0; border-radius: 0 0 20px 20px; padding: 18px 16px;
      -webkit-mask: radial-gradient(circle 12px at 0 0, #0000 11px, #000 12px) left / 51% 100% no-repeat, radial-gradient(circle 12px at 100% 0, #0000 11px, #000 12px) right / 51% 100% no-repeat;
              mask: radial-gradient(circle 12px at 0 0, #0000 11px, #000 12px) left / 51% 100% no-repeat, radial-gradient(circle 12px at 100% 0, #0000 11px, #000 12px) right / 51% 100% no-repeat; }
    .ticket__perf { left: 14px; right: 14px; top: -1px; bottom: auto; border-left: 0; border-top: 3px dotted var(--kk-ink); }
    .ticket__city { font-size: 2.2rem; }
    .ticket__fields { grid-template-columns: 1fr 1fr; }
    .ticket__fields div:nth-child(2) { grid-column: 1 / -1; order: 3; }
    .ticket :global(.ticket__btn) { width: 100%; }
    .ticket-wrap :global(.ticket__tear) { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) { .ticket { rotate: none; } }
</style>
