---
/**
 * "What we help with" as the honest label (DESIGN-SPEC v2 10.3 F2): h2 left (sticky ≥ 1024) with a giant hand-circled
 * item count; right the SpecLabel "What’s inside / Nothing hidden" (rows 01…05 = helpWith verbatim, first-use <abbr>
 * kept), rotated −1°, wrapped by the SpecInspector toy.
 */
import SpecLabel from '../notes/SpecLabel.astro';
import SpecInspector from '../bencho/SpecInspector.astro';
import Scribble from '../notes/Scribble.astro';
import { pillarPage } from '@/data/pillars';
import { expertiseNotes } from '@/data/notes/expertise';
import { pad2 } from '@/lib/format';
import type { PillarKey } from '@/data/types';
import type { Expanded } from './abbr';

interface Props { pillar: PillarKey; items: Expanded[]; fig: string }
const { pillar, items, fig } = Astro.props;
const rows = items.map((it, i) => ({ k: pad2(i + 1), v: it.html + it.notes.map((n) => ` <span class="help__note">(${n})</span>`).join(''), html: true }));
---
<div class="help" style={`--pc:var(--pillar-${pillar})`}>
  <div class="help__head">
    <h2 id="help-title" class="t-display help__title" data-rise>{pillarPage.helpWith}</h2>
    <p class="help__count" aria-hidden="true"><Scribble kind="circle" tone="orchid" thickness={4} pad="0.12em 0.32em"><span class="tnum">{pad2(items.length)}</span></Scribble></p>
  </div>
  <div class="help__body">
    <SpecInspector fig={fig} count={items.length}>
      <SpecLabel id="help-label" headingLevel="none" inspect rotate={-1}
        title={expertiseNotes.label.title} sub={expertiseNotes.label.sub} foot={expertiseNotes.label.foot} rows={rows} class="help__spec" />
    </SpecInspector>
  </div>
</div>
<style>
  .help { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-7); align-items: start; }
  .help__head { position: relative; }
  .help__title { margin: 0; max-width: 8ch; color: var(--head); }
  .help__count { margin: var(--s-6) 0 0 .1em; font: 800 var(--fs-stat)/.85 var(--font-display); font-stretch: 75%; letter-spacing: -0.03em; color: var(--pc); }
  .help__body :global(.help__spec) { max-width: 620px; padding: 22px 26px 22px; box-shadow: 10px 10px 0 var(--pc); }
  .help__body :global(.help__spec .spec__title) { font-size: clamp(2.5rem, 1.8rem + 2.4vw, 4rem); }
  .help__body :global(.help__spec dd) { font-size: var(--fs-lead); line-height: 1.5; }
  .help__body :global(.help__note) { color: var(--fg-2); }
  .help__body :global(abbr) { text-decoration: underline dotted 1px; text-underline-offset: .18em; cursor: help; }
  @media (min-width: 1024px) { .help__head { position: sticky; top: calc(var(--header-h) + 32px); } }
  @media (max-width: 1023px) {
    .help { grid-template-columns: 1fr; gap: var(--s-5); }
    .help__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-5); }
    .help__count { margin: 0 .42em 0 0; font-size: 5rem; } /* keep the hand circle (pad .32em + stroke) inside the gutter */
    .help__body :global(.help__spec) { box-shadow: 6px 6px 0 var(--pc); }
  }
</style>
<style>
  @media (max-width: 767px) { .help__body :global(.help__spec) { rotate: 0deg !important; box-shadow: 5px 5px 0 var(--pc); } }
</style>
