---
/**
 * Sticker (DESIGN-SPEC v2 6.2/6.3): a die-cut sticker (circle / pill / rect / burst) on a ground, with a 6px white
 * die-cut edge, a sticker shadow and a rotation. `drop` → data-sticker (R4 drop-in); `peel` → folded corner on hover.
 * Decorative by default (aria-hidden); `decorative={false}` when it holds real content (e.g. heading words);
 * `as="a"` makes the whole sticker a link (never aria-hidden; give it `label` if its content is not text).
 */
import type { GroundKey } from '@/data/types';
interface Props {
  shape?: 'circle' | 'pill' | 'rect' | 'burst';
  ground?: GroundKey;
  rotate?: number;
  size?: string;              // CSS length: circle/burst diameter, rect/pill min-width
  drop?: boolean;
  dropFrom?: 'top' | 'left' | 'right';
  peel?: boolean;
  edge?: boolean;
  decorative?: boolean;
  as?: 'div' | 'span' | 'a';
  href?: string;
  label?: string;
  magnetic?: number | boolean;
  class?: string;
  style?: string;
}
const { shape = 'rect', ground = 'white', rotate = 0, size, drop = false, dropFrom, peel = false, edge = true,
  decorative = true, as = 'div', href, label, magnetic = false, class: cls, style = '' } = Astro.props;
const Tag = as === 'a' && href ? 'a' : as === 'a' ? 'span' : as;
const isLink = Tag === 'a';
const rot = Math.max(-14, Math.min(14, rotate));
---
<Tag
  class:list={['sticker', `sticker--${shape}`, { 'sticker--edge': edge, 'sticker--peel': peel, 'sticker--link': isLink }, cls]}
  href={isLink ? href : undefined}
  aria-label={isLink ? label : undefined}
  aria-hidden={decorative && !isLink ? 'true' : undefined}
  data-sticker={drop ? '' : undefined}
  data-sticker-from={drop ? dropFrom : undefined}
  data-sticker-peel={peel ? '' : undefined}
  data-magnetic={magnetic ? String(magnetic === true ? 0.35 : magnetic) : undefined}
  style={`--rot:${rot}deg;${size ? `--sticker-size:${size};` : ''}${style}`}
><span class:list={['sticker__face', `g-${ground}`]}><slot /></span></Tag>
