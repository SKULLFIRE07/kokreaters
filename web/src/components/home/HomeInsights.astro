---
/**
 * Home 9 · Insights (v4 developer guide). White band: label + H2 "Ideas from the plant floor and the boardroom.",
 * "All insights →" on the right; three cards in a row: the two newest visible insights (read from the insights
 * collection; staging and preview include drafts, production only approved ones) and, third (pack 2 items 32 and 34),
 * the playbook download tile (<PlaybookCard variant="tile" />, owned by PEOPLE-CONTENT; it opens the modal form).
 * The v4 "coming soon" bleaching-earth tile is gone.
 * Card: 3:2 photo (zooms 1.04 on hover) · a red "New" tag on the newest · "FORMAT · PILLAR" label · Bodoni title ·
 * standfirst · date and reading time. Photos follow the client's design (3-MCPD → scale-tanks, trans fats →
 * bakery-dough) and fall back to the entry's own photo.
 * The section always renders (the playbook tile is always there). Mobile: one column; two from 600px; three ≥ 1000.
 * Pack 3: Porcelain ground; bug 3 — the playbook tile's button is the full width of its card and wraps, so it never
 * sticks out past the card's right edge (override here; PlaybookCard itself is PEOPLE-CONTENT's).
 */
import Photo from '@/components/ui/Photo.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Tag from '@/components/ui/Tag.astro';
import PlaybookCard from '@/components/ui/PlaybookCard.astro';
import { insights as fold, homeLabels } from '@/data/home';
import { footer } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { pillars } from '@/data/pillars';
import { photos, type PhotoSlug } from '@/data/photos';
import { showDraftLabels } from '@/lib/mode';
import { formatDate, isoDate, fill, dotJoin } from '@/lib/format';
import { visibleInsights, isDraft, formatLabel, insightReadingTime, insightHref, type Insight } from '@/lib/insights';
import { insightPhoto } from './insight-photo';

/** The client's homepage design pairs these two articles with v4 photos. */
const V4_PHOTO: Record<string, PhotoSlug> = {
  '3-mcpd-glycidyl-esters-playbook': 'scale-tanks',
  'trans-fat-elimination-inside-a-plant': 'bakery-dough',
};
const photoFor = (e: Insight) => {
  const slug = V4_PHOTO[e.id];
  if (slug) return { src: photos[slug].src, alt: photos[slug].alt, position: photos[slug].position };
  return insightPhoto(e);
};

const latest = (await visibleInsights()).slice(0, 2);
const pillarLabel = (e: Insight) => pillars.find((p) => p.key === e.data.pillar)?.shortLabel;
---
{(
  <section id="insights" class="hn band band--grey" aria-labelledby="hn-heading">
    <div class="container">
      <header class="hn__head">
        <div>
          <p class="t-label hn__label">{fold.overline}</p>
          <h2 id="hn-heading" class="hn__title">{fold.headline}</h2>
        </div>
        <ArrowLink href={footer.insights.all.href} class="hn__link">{footer.insights.all.label}</ArrowLink>
      </header>
      <ul class="hn__grid" role="list">
        {latest.map((e, i) => {
          const ph = photoFor(e);
          return (
            <li>
              <a class="hn__card u-zoom" href={insightHref(e)}>
                {ph && <Photo src={ph.src} alt={ph.alt} position={ph.position} ratio="3/2" class="hn__photo"
                  sizes="(min-width: 1320px) 390px, (min-width: 1000px) 30vw, (min-width: 600px) 46vw, calc(100vw - 40px)" widths={[400, 640, 800, 1000]} />}
                <span class="hn__meta">
                  {i === 0 && <span class="hn__new">New</span>}
                  {showDraftLabels && isDraft(e) && <Tag>{homeLabels.draft}</Tag>}
                  <span>{dotJoin([formatLabel(e), pillarLabel(e)])}</span>
                </span>
                <h3 class="hn__name">{e.data.title}</h3>
                {e.data.standfirst && <span class="hn__stand">{e.data.standfirst}</span>}
                <span class="hn__date">
                  {e.data.date && <time datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>}
                  {e.data.date && ' · '}{fill(microcopy.readingTime, { n: insightReadingTime(e) })}
                </span>
              </a>
            </li>
          );
        })}
        <li class="hn__playbook">
          <PlaybookCard variant="tile" id="playbook-home" />
        </li>
      </ul>
    </div>
  </section>
)}

<style>
  .hn__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; margin-bottom: 40px; }
  .hn__label { margin: 0 0 18px; }
  .hn__title { margin: 0; max-width: 24ch; font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 500; }
  .hn :global(.hn__link) { margin-bottom: -10px; }
  .hn__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px 40px; margin: 0; padding: 0; list-style: none; }
  .hn__grid > li { display: flex; }
  .hn__card { flex: 1; display: flex; flex-direction: column; gap: 14px; color: var(--navy-900); text-decoration: none; }
  .hn__card :global(.hn__photo) { margin-bottom: 6px; background: var(--ice); }
  .hn__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--blue-700); }
  .hn__new { padding: 3px 7px; background: var(--red); color: var(--white); letter-spacing: .08em; }
  .hn__name {
    margin: 0; font-family: var(--font-serif); font-weight: 500; font-size: 1.75rem; line-height: 1.2; color: var(--navy-900);
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: .18em;
    transition: text-decoration-color var(--d-2) var(--ease-out), color var(--d-1) var(--ease-out);
  }
  .hn__card:is(:hover, :focus-visible) .hn__name { color: var(--blue-700); text-decoration-color: currentColor; }
  .hn__stand { font-size: 1rem; line-height: 1.55; color: var(--fg-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .hn__date { font-size: .875rem; color: #5E6B88; }
  .hn__playbook > :global(*) { flex: 1; min-width: 0; }
  /* bug 3: full width of the card, label may wrap */
  .hn__playbook :global(.pbc__action) { width: 100%; }
  .hn__playbook :global(.pbc__btn) { width: 100% !important; white-space: normal !important; }
  @media (min-width: 600px) { .hn__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .hn__head { margin-bottom: 52px; }
    .hn__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
