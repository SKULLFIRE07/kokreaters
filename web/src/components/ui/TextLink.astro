---
/** Sapphire label + Arrow; the rising-arrow swoosh underlines it on hover/focus (5.0.2). */
import Arrow from './Arrow.astro';
import type { HTMLAttributes } from 'astro/types';
interface Props { href: string; arrow?: boolean; class?: string; [key: string]: unknown; }
const { href, arrow = true, class: cls, ...rest } = Astro.props;
---
<a href={href} class:list={['text-link', cls]} {...rest as HTMLAttributes<'a'>}>
  <span class="text-link__label"><slot /><svg class="text-link__swoosh" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M2 18 C 120 21, 260 16, 384 6" /></svg></span>
  {arrow && <Arrow size={16} class="text-link__arrow" />}
</a>
<style>
  .text-link {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding-block: 12px; min-height: 44px;
    color: var(--c-link); font-family: var(--font-sans); font-weight: 600; font-size: var(--fs-body);
    text-decoration: none;
  }
  .text-link:hover { color: var(--c-link); }
  .text-link__label { position: relative; display: inline-block; }
  .text-link__swoosh {
    position: absolute; left: 0; right: 0; bottom: -0.42em; width: 100%; height: 0.5em; overflow: visible;
    fill: none; stroke: currentColor; stroke-width: 1.5px; stroke-linecap: round;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 300ms var(--ease-out);
  }
  .text-link__swoosh path { vector-effect: non-scaling-stroke; }
  .text-link:is(:hover, :focus-visible) .text-link__swoosh { clip-path: inset(0 0 0 0); }
  .text-link :global(.text-link__arrow) { transition: transform 300ms var(--ease-out); }
  .text-link:is(:hover, :focus-visible) :global(.text-link__arrow) { transform: translateX(4px); }
  :global(.on-dark) .text-link { color: var(--c-on-dark); }
  :global(.on-dark) .text-link__swoosh { stroke: var(--kk-sky); }
  @media (prefers-reduced-motion: reduce) {
    .text-link__swoosh, .text-link :global(.text-link__arrow) { transition: none; }
  }
</style>
