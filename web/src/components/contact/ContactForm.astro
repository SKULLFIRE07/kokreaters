---
/**
 * Contact form (DESIGN-SPEC 5.10, fields 4.10). Works with no JS: a native POST to
 * PUBLIC_FORM_ENDPOINT, or a text/plain mailto to office@ when no endpoint is set.
 * scripts/pages/contact.ts layers validation, the traps, fetch/mailto and the status message.
 * There is no motion on the form, ever (only the connection line above it).
 * `novalidate` is set by contact.ts (form.noValidate = true), so with JS off the browser's own
 * required/email checks still guard the native submit.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { fields, consentLink, contact } from '@/data/contact';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';
import MarginNote from '@/components/notes/MarginNote.astro';
import { journalNotes } from '@/data/notes/journal';

const action = site.formEndpoint || `mailto:${site.email}`;
const enctype = site.formEndpoint ? 'multipart/form-data' : 'text/plain';
const [consentBefore, consentAfter] = (() => {
  const c = fields.find((f) => f.name === 'consent')!.label;
  const i = c.indexOf(consentLink.text);
  return i < 0 ? [c, ''] : [c.slice(0, i), c.slice(i + consentLink.text.length)];
})();
const inputs = fields.filter((f) => f.type !== 'checkbox');
const consent = fields.find((f) => f.type === 'checkbox')!;
const id = (n: string) => `f-${n}`;
---
<form
  id="form"
  class="cf"
  method="post"
  action={action}
  enctype={enctype}
  data-form
  data-endpoint={site.formEndpoint || undefined}
  data-mailto={site.email}
  data-msg-required={microcopy.required}
  data-msg-email={microcopy.invalidEmail}
  data-msg-success={microcopy.formSuccess}
  data-msg-error={microcopy.formError}
  data-msg-mailto={microcopy.mailtoSent}
  data-turnstile={site.turnstileSiteKey || undefined}
  aria-labelledby="contact-title"
>
  <div class="cf__grid">
    {inputs.map((f) => (
      <div class:list={['cf__field', `cf__field--${f.name}`, { 'cf__field--wide': f.type === 'textarea' || f.type === 'select' || f.name === 'source', 'has-notes': f.name === 'message' }]} data-field={f.name}>
        {f.name === 'message' && <MarginNote text={journalNotes.form.detail} tone="orchid" rotate={-3} arrow="arrow-curve" arrowAt="start" arrowAngle={190} flip place="left:96px;top:-38px;max-width:none;" show="md" />}
        <label class="cf__label" for={id(f.name)}>
          {f.label}
          {f.required && <><span class="cf__req" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></>}
        </label>
        {f.type === 'textarea' ? (
          <textarea id={id(f.name)} name={f.name} rows={f.rows ?? 6} required={f.required} autocomplete={f.autocomplete} class="cf__input cf__input--area"></textarea>
        ) : f.type === 'select' ? (
          <span class="cf__select">
            <select id={id(f.name)} name={f.name} required={f.required} autocomplete={f.autocomplete} class="cf__input">
              <option value="" selected disabled></option>
              {f.options?.map((o) => <option value={o}>{o}</option>)}
            </select>
            <Icon name="chevron" size={20} class="cf__chev" />
          </span>
        ) : (
          <input
            id={id(f.name)} name={f.name} type={f.type} required={f.required} autocomplete={f.autocomplete} class="cf__input"
            {...(f.type === 'email' ? { inputmode: 'email', spellcheck: 'false' } : {})}
            {...(f.type === 'tel' ? { inputmode: 'tel' } : {})}
          />
        )}
        <p id={`${f.name}-error`} class="field-error" hidden><Icon name="error" size={18} /><span data-error-text></span></p>
      </div>
    ))}

    <div class="cf__field cf__field--wide cf__consent" data-field="consent">
      <div class="cf__check">
        <span class="cf__box">
          <input id={id('consent')} name="consent" type="checkbox" value="yes" required={consent.required} class="cf__checkbox" />
        </span>
        <label for={id('consent')} class="cf__checklabel">
          {consentBefore}<a href={consentLink.href}>{consentLink.text}</a>{consentAfter}
          <span class="cf__req" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span>
        </label>
      </div>
      <p id="consent-error" class="field-error" hidden><Icon name="error" size={18} /><span data-error-text></span></p>
    </div>
  </div>

  <div class="hp" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="started_at" value="" data-started-at />
  {site.turnstileSiteKey && <div class="cf-turnstile cf__turnstile" data-sitekey={site.turnstileSiteKey}></div>}

  <div class="cf__actions">
    <Button type="submit" variant="primary" arrow data-submit>{contact.submit}</Button>
  </div>
  <div class="cf__done has-notes">
    <div class="cf__status" role="status" aria-live="polite" data-form-status></div>
    <div class="cf__soon" hidden data-soon><MarginNote text={journalNotes.form.soon} tone="orchid" size="lg" rotate={-6} arrow="arrow-curve" arrowAt="start" arrowAngle={200} flip anchor="inline" show="all" /></div>
  </div>
  <template data-icon="success"><Icon name="success" size={20} /></template>
  <template data-icon="error"><Icon name="error" size={20} /></template>
</form>

<style>
  .cf { margin: 0; }
  .cf__grid { display: grid; grid-template-columns: 1fr; gap: var(--s-5) var(--s-5); }
  @media (min-width: 768px) {
    .cf__grid { grid-template-columns: 1fr 1fr; }
    .cf__field--wide { grid-column: 1 / -1; }
  }
  .cf__field { display: grid; gap: var(--s-2); align-content: start; min-width: 0; }
  .cf__label, .cf__checklabel { font-family: var(--font-display); font-size: 1rem; line-height: 1.3; font-weight: 600; font-stretch: 90%; color: var(--kk-ink); }
  .cf__checklabel { font-family: var(--font-sans); font-stretch: 100%; font-size: .9375rem; }
  .cf__field { position: relative; }
  .cf__req { color: var(--c-text); margin-left: 2px; }
  .cf__input {
    width: 100%; min-width: 0; height: 56px; padding: 0 var(--s-4);
    border: 2px solid var(--kk-ink); border-radius: 14px; background: var(--kk-white);
    font: inherit; font-family: var(--font-mono); font-size: 1rem; color: var(--kk-ink);
    transition: box-shadow 220ms var(--ease-expo), translate 220ms var(--ease-expo);
  }
  .cf__input:hover { box-shadow: 3px 3px 0 var(--kk-ink); }
  .cf__input:focus { box-shadow: 4px 4px 0 var(--kk-saffron), 4px 4px 0 2px var(--kk-ink); }
  @media (prefers-reduced-motion: reduce) { .cf__input { transition: none; } }
  .cf__input--area { height: auto; min-height: 180px; padding: var(--s-3) var(--s-4); line-height: var(--lh-body); resize: vertical; }
  .cf__input:focus-visible, .cf__checkbox:focus-visible { outline: 3px solid var(--kk-cobalt); outline-offset: 3px; }
  .cf__input:focus:not(:focus-visible) { outline: 3px solid var(--kk-cobalt); outline-offset: 3px; }
  .cf__input[aria-invalid="true"], .cf__checkbox[aria-invalid="true"] { border-color: var(--kk-coral); }
  .cf__input[aria-invalid="true"] { box-shadow: inset 0 0 0 1px var(--kk-coral), 3px 3px 0 var(--kk-coral); }

  .cf__select { position: relative; display: block; }
  .cf__select select { appearance: none; -webkit-appearance: none; padding-right: 48px; cursor: pointer; }
  .cf__select :global(.cf__chev) { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--c-text); }

  .cf__check { display: grid; grid-template-columns: 44px 1fr; align-items: start; column-gap: var(--s-2); }
  .cf__box { width: 44px; height: 44px; display: grid; place-items: center; margin: -10px 0 0 -10px; }
  .cf__checkbox { width: 24px; height: 24px; margin: 0; accent-color: var(--c-action); cursor: pointer; border-radius: 4px; }
  .cf__checklabel { font-weight: 500; cursor: pointer; padding-top: 1px; }
  .cf__checklabel a { color: var(--c-link); text-underline-offset: 3px; }

  .field-error { display: flex; align-items: flex-start; gap: var(--s-2); margin: 0; font-family: var(--font-sans); font-size: var(--fs-meta); line-height: var(--lh-meta); font-weight: 500; color: var(--c-text); }
  .field-error :global(.icon) { color: var(--c-error); margin-top: 2px; }
  .field-error[hidden] { display: none; }
  .cf__consent .field-error { padding-left: calc(44px + var(--s-2) - 10px); }

  .hp { position: absolute !important; left: -10000px !important; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .cf__turnstile { margin-top: var(--s-5); }
  .cf__actions { margin-top: var(--s-7); }
  .cf__done { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); }
  .cf__soon[hidden] { display: none; }
  .cf__soon :global(.note) { position: relative; }
  .cf__status:not(:empty) { padding: var(--s-4) var(--s-5); border: 2px solid var(--kk-ink); border-radius: 14px; background: var(--kk-butter); }
  .cf__status { margin-top: var(--s-4); font-family: var(--font-sans); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--c-text); max-width: 40em; }
  .cf__status:empty { display: none; }
  .cf__status :global(.icon) { margin-right: var(--s-2); vertical-align: -4px; }
  .cf__status[data-tone="success"] :global(.icon) { color: var(--c-success); }
  .cf__status[data-tone="error"] :global(.icon) { color: var(--c-error); }
</style>
