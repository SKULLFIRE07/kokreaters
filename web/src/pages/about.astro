---
/**
 * About /about, v4 "Delft". Grounds: navy hero → Porcelain track record → white story → Porcelain career → Dutch polder
 * interlude → white map → navy name panel → white credentials → (CtaBand) → footer.
 *  1 PageHero, navy split: the 4:5 portrait right (photo under the text at 4:3 on mobile), crumbs, eyebrow, the H1
 *    "Built on 25 years…" (no-break space in the data), the intro, then the one-page profile PDF (primary button) and
 *    LinkedIn (tertiary link-button, rel="noopener me"). Below 600px the PDF button goes full width, LinkedIn under it;
 *    below 390px it reads "Download profile (PDF)" so it stays on one line. Portrait at 50% 4%: headroom above the hair
 *    in every crop (desktop half-bleed, 4:3 on tablet and phone).
 *  1b AboutRecord (Porcelain) — the homepage's four figures: 25 years in industry, 14 years in oils, fats and food
 *                              ingredients, 5 countries, WHO (no "regions of teams led" count: open question).
 *  2 AboutStory (white)      — name, "Chief Catalyst and Founder, KoKreaters", based in the Netherlands, the short
 *                              story, "Read the long version" (native details).
 *  3 CareerTimeline (grey)   — v3.1: sticky header left (≥ 1200), the four stops on a vertical spine with large serif
 *                              years scrolling past on the right; worked-with line as the lead.
 *  · PhotoInterlude: the Dutch polder (nl-polder, v4 photo set), eyebrow "Based in the Netherlands", caption = the
 *    bio's own last sentence (longBio[5]); parallax via PhotoInterlude.
 *  4 PlacesMap (white)       — #the-map: "Eight places in five countries", static Equal Earth map, eight ringed nodes,
 *                              the places <ol>.
 *  5 NamePanel (navy)        — "Ko + Kreaters" as one formula with its two definitions, the founder's words, the lockup.
 *  6 Credentials (white)     — education · languages · recognition (WHO).
 *  CtaBand (grey) and the footer come from BaseLayout. JSON-LD: Person (with the portrait) + BreadcrumbList.
 * Mobile: every section states its own layout; hero buttons go full width below 600px.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import AboutStory from '@/components/about/AboutStory.astro';
import CareerTimeline from '@/components/about/CareerTimeline.astro';
import PlacesMap from '@/components/about/PlacesMap.astro';
import NamePanel from '@/components/about/NamePanel.astro';
import Credentials from '@/components/about/Credentials.astro';
import PhotoInterlude from '@/components/ui/PhotoInterlude.astro';
import portrait from '@/assets/photos/ganeaysh-portrait.jpg';
import { person } from '@/components/seo/schema';
import { pageSeo } from '@/lib/seo';
import { site } from '@/config/site';
import AboutRecord from '@/components/about/AboutRecord.astro';
import { about, aboutPage, portraitAlt, longBio } from '@/data/founder';
import { footer } from '@/data/nav';
import { photos } from '@/data/photos';
import { microcopy } from '@/data/microcopy';

const portraitWebp = await getImage({ src: portrait, format: 'webp', width: 960 });
const crumbs = [{ label: about.overline, href: '/about' }];
const seo = { ...pageSeo('about'), jsonLd: [person(portraitWebp.src)] };
// The PDF is a static file written by scripts/make-profile-pdf.mjs; never link to it if it is missing.
const hasPdf = existsSync(join(process.cwd(), 'public', aboutPage.profilePdfHref));
const polder = photos['nl-polder'];
---
<BaseLayout page="about" seo={seo} breadcrumbs={crumbs}>
  <PageHero
    ground="navy"
    imageMode="portrait"
    image={portrait}
    imageAlt={portraitAlt.about}
    imagePosition="50% 0%"
    crumbs={crumbs}
    eyebrow={about.overline}
    title={about.headline}
    lead={about.intro}
    titleId="about-title"
  >
    <div class="about-actions">
      {hasPdf && (
        <Button href={aboutPage.profilePdfHref} icon="download" download="ganeaysh-kulkarni-profile.pdf">
          <span class="about-pdf--full">{aboutPage.profilePdf}</span><span class="about-pdf--short">{aboutPage.profilePdfShort}</span>
        </Button>
      )}
      <Button href={site.linkedin.href} variant="tertiary" icon="external" rel="noopener me" class="about-actions__link">
        {aboutPage.linkedin}<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span>
      </Button>
    </div>
  </PageHero>
  <AboutRecord />
  <AboutStory />
  <CareerTimeline />
  <PhotoInterlude src={polder.src} alt={polder.alt} position={polder.position} size="lg" eyebrow={footer.contact.base} caption={longBio[longBio.length - 1]} />
  <PlacesMap />
  <NamePanel />
  <Credentials />
</BaseLayout>
<style>
  /* PageHero puts its default slot 48px under the lead; buttons belong 32px under it, like hero actions. */
  .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-top: calc(var(--s-6) - var(--s-7)); }
  @media (max-width: 599px) {
    .about-actions :global(.btn--primary) { flex: 1 1 100%; }
  }
  /* Below 390px the full label wraps "(PDF)" onto a second line: the shorter label keeps the button one line, 48px.
     Only one label is ever rendered, so the accessible name follows what is shown. */
  .about-pdf--short { display: none; }
  @media (max-width: 389px) {
    .about-pdf--full { display: none; }
    .about-pdf--short { display: inline; }
  }
</style>
