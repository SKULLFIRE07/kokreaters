---
/**
 * About · career (REDESIGN-V3 §4 About, section 3). Grey band, aria-labelledby="journey-title".
 * SectionHeader (bare h2, no eyebrow: inner-page rule; "From CFTRI Mysore to KoKreaters", derived from the timeline; lead = the worked-with
 * sentence, sectors only), then an <ol> of the four
 * stops with the ringed-node signature: a 20px node (brand-blue disc, white ring, brand-blue dot; the ProcessFlow node)
 * on a 1px brand-blue hairline. Under each node: the years (label colour, tabular), the organisation (serif h3) and one
 * role line (timelineRoles, small, secondary). The KoKreaters node takes the accent: the one highlight in the band.
 * Static: no drawing, no counters.
 * ≥ 900px: four equal columns; the hairline runs from the first node to the last through every node centre.
 * Mobile (< 900px): vertical. Nodes on a left spine, the hairline joins them, text to the right, 32px between stops.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { timeline, timelineRoles, workedWith, aboutPage } from '@/data/founder';
import { showConfirm } from '@/lib/mode';
---
<Section ground="grey" labelledby="journey-title" class="career">
  <SectionHeader id="journey-title" title={aboutPage.careerHeading}>
    <p slot="lead">{workedWith}<Confirm id={5} note="sectors only, no company names" /></p>
  </SectionHeader>
  <ol class="tl" role="list">
    {timeline.map((t, i) => (
      <li class:list={['tl__stop', i === timeline.length - 1 && 'tl__stop--now']} data-reveal style={`--i:${i}`}>
        <span class="tl__node" aria-hidden="true"></span>
        <div class="tl__text">
          <p class="tl__years tnum">{t.years}</p>
          <h3 class="tl__org">{t.label}</h3>
          {timelineRoles[t.label] && <p class="tl__role">{timelineRoles[t.label]}</p>}
        </div>
      </li>
    ))}
  </ol>
  {showConfirm && <p class="career__confirm"><Confirm id={13} note="career dates" /></p>}
</Section>
<style>
  .tl { --node: 20px; --line: var(--label); list-style: none; margin: 0; padding: 0; display: grid; }
  .tl__stop { position: relative; display: grid; grid-template-columns: var(--node) minmax(0, 1fr); column-gap: var(--s-5); padding-bottom: var(--s-6); }
  .tl__stop:last-child { padding-bottom: 0; }

  /* ringed node: disc · white ring · dot (14px box + 3px outer ring = 20px), as ProcessFlow */
  .tl__node {
    position: relative; z-index: 1; width: 14px; height: 14px; margin: 3px; border-radius: 50%;
    background: var(--line); border: 2px solid var(--white); box-shadow: 0 0 0 3px var(--line);
  }
  .tl__stop--now .tl__node { background: var(--accent); box-shadow: 0 0 0 3px var(--accent); }

  /* connector, mobile: node centre → next node centre, down the spine */
  .tl__stop:not(:last-child)::before {
    content: ""; position: absolute; left: calc(var(--node) / 2 - .5px); top: calc(var(--node) / 2); bottom: calc(var(--node) / -2);
    width: 1px; background: var(--line);
  }

  .tl__text { min-width: 0; }
  .tl__years { margin: 0; font-size: var(--fs-meta); line-height: var(--node); font-weight: 600; letter-spacing: .01em; color: var(--label); }
  .tl__org { margin: var(--s-2) 0 0; font-size: var(--fs-h3); line-height: var(--lh-h3); }
  .tl__role { margin: var(--s-2) 0 0; max-width: 34ch; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); text-wrap: pretty; }

  .career__confirm { margin: var(--s-6) 0 0; }

  @media (min-width: 900px) {
    .tl { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .tl__stop { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-5); padding-bottom: 0; align-content: start; }
    /* connector, desktop: across this column and the gap to the next node's centre */
    .tl__stop:not(:last-child)::before {
      left: calc(var(--node) / 2); right: calc((var(--grid-gap) + var(--node) / 2) * -1);
      top: calc(var(--node) / 2 - .5px); bottom: auto; width: auto; height: 1px;
    }
    .tl__years { line-height: 1.3; }
    .tl__role { padding-right: var(--s-4); }
  }
</style>
