---
/**
 * Author box (REDESIGN-V3 §4 article): a round crop of the square founder portrait, "About the author", the name as
 * the h2, role, the short bio and "Meet Ganeaysh" (→ /about). Sits in the article column under the share row.
 * ≥ 600px: photo (112px) left, text right. Mobile: 72px photo above the text, left-aligned.
 */
import Photo from '@/components/ui/Photo.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import portrait from '@/assets/photos/ganeaysh-portrait-square.jpg';
import { shortBio, founderName, founderRole } from '@/data/founder';
import { founderQuote } from '@/data/home';
import { articleCopy } from '@/data/insights';
import { site } from '@/config/site';
---
<section class="author" aria-labelledby="author-h" data-reveal>
  <div class="author__photo"><Photo src={portrait} alt="" ratio="1/1" sizes="(min-width: 600px) 112px, 72px" widths={[72, 112, 144, 224, 336]} /></div>
  <div class="author__text">
    <Eyebrow class="author__eyebrow">{articleCopy.aboutAuthor}</Eyebrow>
    <h2 id="author-h" class="author__name">{founderName}</h2>
    <p class="author__role">{founderRole}, {site.name}</p>
    <p class="author__bio">{shortBio}</p>
    <ArrowLink href={founderQuote.link.href} class="author__link">{founderQuote.link.label}</ArrowLink>
  </div>
</section>
<style>
  .author { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
  .author__photo { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; }
  .author__eyebrow { color: var(--fg-2); }
  .author__name {
    margin: var(--s-3) 0 0; font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-h3);
    line-height: var(--lh-h3); font-weight: 500; letter-spacing: var(--tr-h3); color: var(--head);
  }
  .author__role { margin: var(--s-1) 0 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .author__bio { margin: var(--s-4) 0 0; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg); max-width: 60ch; text-wrap: pretty; }
  .author :global(.author__link) { margin-top: var(--s-2); }
  @media (min-width: 600px) {
    .author { grid-template-columns: 112px minmax(0, 1fr); column-gap: var(--s-6); align-items: start; }
    .author__photo { width: 112px; height: 112px; }
  }
</style>
