---
/**
 * Home 8b · Trust line (pack 2 item 18). A slim porcelain band above Insights: one line, centred, small caps, the three
 * phrases divided by thin rules: "Confidential by default · We work under NDA · Client names are shared only with their
 * consent". Mobile: the three phrases stack, centred, with short horizontal rules between them.
 */
import { trustLine } from '@/data/home';
---
<aside class="ht band--grey" aria-label="Confidentiality">
  <div class="container">
    <p class="ht__line">
      {trustLine.map((t, i) => <>{i > 0 && <span class="ht__sep" aria-hidden="true"></span>}<span class="ht__part">{t}</span>{i < trustLine.length - 1 && <span class="visually-hidden"> · </span>}</>)}
    </p>
  </div>
</aside>

<style>
  .ht { background: var(--bg); padding-block: 22px; border-block: 1px solid var(--rule); }
  .ht__line {
    margin: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center;
    font-size: 1.0625rem; font-weight: 600; line-height: 1.4; letter-spacing: .06em; font-variant-caps: all-small-caps;
    color: var(--navy-900);
  }
  .ht__sep { display: block; width: 20px; height: 1px; background: var(--fg-2); opacity: .5; }
  @media (min-width: 900px) {
    .ht { padding-block: 26px; }
    .ht__line { flex-direction: row; justify-content: center; flex-wrap: wrap; gap: 8px 22px; }
    .ht__sep { width: 1px; height: 14px; }
  }
</style>
