---
/**
 * PillarDiagram (DESIGN-SPEC v2 00.2, pillar pages): one signature scroll-scrubbed diagram per pillar, on Ink.
 *  innovation = funnel (unmet need → brief → prototype → scale-up → launch) · process = refining line with flow
 *  quality = layered barrier, risk dots stopped at each layer · strategy = Go/No-Go tree · deals = iceberg + sonar
 *  capability = a team tree that multiplies.
 * The SVG and its positioned labels are aria-hidden; the equivalent <ol> is the accessible version (visually hidden at
 * ≥ 768, shown as the legend below the drawing on phones, where the SVG shows number badges instead of labels).
 * Markup = the finished drawing (reduced motion / JS off). pages/expertise.ts scrubs it: [data-pd-draw] strokes draw,
 * [data-pd-pop] pops, [data-pd-from] arrives, [data-pd-to] travels, at data-pd-at (0..1 of the scrub).
 * Words come from data/notes/expertise.ts (restatements of the pillar's own brief copy).
 */
import MarginNote from '../notes/MarginNote.astro';
import { expertiseNotes } from '@/data/notes/expertise';
import { pillarNumber } from '@/lib/pillars';
import { fill } from '@/lib/format';
import type { Pillar } from '@/data/types';

interface Props { pillar: Pillar }
const { pillar } = Astro.props;
const k = pillar.key;
const N = expertiseNotes.diagram;
const W = 1200;
const VB: Record<string, [number, number]> = { innovation: [40, 530], process: [50, 480], quality: [20, 480], strategy: [90, 480], deals: [70, 540], capability: [20, 570] };
const [Y0, H] = VB[k];
type Place = 't' | 'b' | 'l' | 'r' | 'c';
interface Label { t: string; x: number; y: number; at: number; place?: Place; big?: boolean; keep?: boolean; n?: number }
const PC = ['var(--kk-sapphire)', 'var(--kk-violet)', 'var(--kk-orchid)', 'var(--kk-saffron)', 'var(--kk-mauve)', 'var(--kk-sky)'];
// deterministic scatter
let seed = 7; const rnd = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };

let title = '';
let labels: Label[] = [];
let steps: string[] = [];
if (k === 'innovation') { title = N.innovationTitle; steps = [...N.innovation]; labels = [
  { t: N.innovation[0], x: 170, y: 300, at: .05, place: 'c', n: 1 }, { t: N.innovation[1], x: 430, y: 300, at: .25, place: 'c', n: 2 },
  { t: N.innovation[2], x: 680, y: 300, at: .45, place: 'c', n: 3 }, { t: N.innovation[3], x: 882, y: 300, at: .62, place: 'c', n: 4 },
  { t: N.innovation[4], x: 1150, y: 112, at: .86, place: 't', big: true, n: 5 }] }
if (k === 'process') { title = N.processTitle; steps = [N.processEnds[0], ...N.process, N.processEnds[1]]; labels = [
  { t: N.processEnds[0], x: 95, y: 470, at: .02, place: 'b', keep: true },
  { t: N.process[0], x: 250, y: 240, at: .18, place: 't', n: 1 }, { t: N.process[1], x: 430, y: 200, at: .32, place: 't', n: 2 },
  { t: N.process[2], x: 610, y: 100, at: .46, place: 't', n: 3 }, { t: N.process[3], x: 790, y: 180, at: .6, place: 't', n: 4 },
  { t: N.process[4], x: 970, y: 220, at: .74, place: 't', n: 5 },
  { t: N.processEnds[1], x: 1125, y: 490, at: .9, place: 'b', keep: true }] }
if (k === 'quality') { title = N.qualityTitle; steps = [N.qualityEnds[0], ...N.quality, N.qualityEnds[1]]; labels = [
  { t: N.qualityEnds[0], x: 100, y: 360, at: .02, place: 'b', keep: true },
  { t: N.quality[0], x: 400, y: 62, at: .2, place: 't', n: 1 }, { t: N.quality[1], x: 620, y: 62, at: .4, place: 't', n: 2 },
  { t: N.quality[2], x: 840, y: 62, at: .6, place: 't', n: 3 },
  { t: N.qualityEnds[1], x: 1080, y: 440, at: .85, place: 'b', keep: true }] }
if (k === 'strategy') { title = N.strategyTitle; steps = [N.strategyEnds[0], ...N.strategy, N.strategyEnds[1], N.strategyEnds[2]]; labels = [
  { t: N.strategyEnds[0], x: 90, y: 280, at: .02, place: 'b', keep: true },
  { t: N.strategy[0], x: 360, y: 160, at: .2, place: 't', n: 1 }, { t: N.strategy[1], x: 630, y: 160, at: .42, place: 't', n: 2 },
  { t: N.strategy[2], x: 900, y: 160, at: .64, place: 't', n: 3 },
  { t: N.strategyEnds[1], x: 1115, y: 220, at: .88, place: 'c', big: true, keep: true },
  { t: N.strategyEnds[2], x: 630, y: 522, at: .8, place: 'c', keep: true }] }
if (k === 'deals') { title = N.dealsTitle; steps = [N.dealsTop, ...N.deals]; labels = [
  { t: N.dealsTop, x: 760, y: 120, at: .05, place: 'r', n: 1 },
  { t: N.deals[0], x: 950, y: 330, at: .35, place: 'r', n: 2 }, { t: N.deals[1], x: 250, y: 430, at: .58, place: 'l', n: 3 },
  { t: N.deals[2], x: 950, y: 525, at: .82, place: 'r', n: 4 }] }
if (k === 'capability') { title = N.capabilityTitle; steps = [...N.capability, N.capabilityEnd]; labels = [
  { t: N.capability[0], x: 150, y: 400, at: .2, place: 'l', n: 1 }, { t: N.capability[1], x: 150, y: 270, at: .5, place: 'l', n: 2 },
  { t: N.capability[2], x: 150, y: 150, at: .75, place: 'l', n: 3 }, { t: N.capabilityEnd, x: 600, y: 58, at: .92, place: 't', big: true, keep: true }] }

/* geometry helpers */
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
// innovation: idea dots
const ideas = k === 'innovation' ? Array.from({ length: 26 }, (_, i) => {
  const x = 70 + rnd() * 190, y = 130 + rnd() * 340; return { x, y, r: 6 + rnd() * 6, c: PC[i % 6], tx: 985 - x, ty: 300 - y, at: .08 + rnd() * .3 };
}) : [];
// quality: risk dots stopped at their layer (markup = stopped)
const LAYERS = [400, 620, 840];
const risks = k === 'quality' ? Array.from({ length: 15 }, (_, i) => {
  const layer = i % 3, y = 130 + (i * 23.5) % 340 + rnd() * 8; const x = LAYERS[layer] - 46 + rnd() * 6;
  return { x, y, fx: 120 - x, at: .1 + layer * .2 + rnd() * .1 };
}) : [];
// capability: tree
const L1 = [420, 600, 780].map((x) => ({ x, y: 400 }));
const L2 = Array.from({ length: 9 }, (_, i) => ({ x: 240 + i * 90, y: 270, p: L1[Math.floor(i / 3)] }));
const L3 = Array.from({ length: 18 }, (_, i) => ({ x: 218 + i * 45, y: 150, p: L2[Math.floor(i / 2)] }));
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => `M${a.x} ${a.y} C ${a.x} ${(a.y + b.y) / 2}, ${b.x} ${(a.y + b.y) / 2}, ${b.x} ${b.y}`;
const badge = (l: Label) => {
  if (l.keep) return '';
  const n = steps.indexOf(l.t) + 1; const cy = l.place === 't' ? l.y + 4 : l.y;
  return `<g class="pd__badge"><circle cx="${l.x}" cy="${cy}" r="30"/><text x="${l.x}" y="${cy + 12}">${n}</text></g>`;
};
---
<figure class="pd" data-pdiag={k} style={`--pc:var(--pillar-${k})`}>
  <figcaption class="pd__cap">
    <span class="pd__fig t-dateline">{fill(N.fig, { n: pillarNumber(pillar) })}</span>
    <span class="pd__title">{title}</span>
  </figcaption>
  <div class="pd__stage has-notes">
    <svg class="pd__svg" viewBox={`0 ${Y0} ${W} ${H}`} aria-hidden="true" focusable="false">
      {k === 'innovation' && (<>
        <path class="pd-fill" d="M40 70 C 380 80, 700 170, 960 255 L 960 345 C 700 430, 380 520, 40 530 Z" data-pd-pop data-pd-at="0" />
        <path class="pd-edge" pathLength="1" data-pd-draw data-pd-at="0" data-pd-dur=".5" d="M40 70 C 380 80, 700 170, 960 255" />
        <path class="pd-edge" pathLength="1" data-pd-draw data-pd-at="0" data-pd-dur=".5" d="M40 530 C 380 520, 700 430, 960 345" />
        {[[300, 92, 508], [560, 138, 462], [800, 196, 404]].map(([x, a, b], i) => (
          <path class="pd-dash" pathLength="1" data-pd-draw data-pd-at={String(.18 + i * .2)} data-pd-dur=".12" d={`M${x} ${a + 8} V ${b - 8}`} />
        ))}
        {ideas.map((d) => <circle class="pd-idea" cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.r.toFixed(1)} style={`fill:${d.c}`} data-pd-to={`${d.tx.toFixed(0)},${d.ty.toFixed(0)}`} data-pd-at={d.at.toFixed(2)} data-pd-dur=".45" />)}
        <path class="pd-arrow" pathLength="1" data-pd-draw data-pd-at=".7" data-pd-dur=".18" d="M960 300 C 1030 302, 1090 262, 1148 150" />
        <path class="pd-arrow" pathLength="1" data-pd-draw data-pd-at=".86" data-pd-dur=".06" d="M1118 158 L 1150 146 L 1156 180" />
      </>)}
      {k === 'process' && (<>
        <rect class="pd-vessel pd-vessel--crude" x="40" y="250" width="110" height="200" rx="22" data-pd-pop data-pd-at="0" />
        <path class="pd-pipe" pathLength="1" data-pd-draw data-pd-at=".02" data-pd-dur=".85" d="M150 420 H 1070" />
        <path class="pd-flow" d="M150 420 H 1070" />
        {[[250, 260], [430, 220], [610, 120], [790, 200], [970, 240]].map(([x, top], i) => (<>
          <path class="pd-riser" d={`M${x} 420 V 410`} />
          <rect class="pd-vessel" x={x - 46} y={top} width="92" height={410 - top} rx={i === 4 ? 46 : 16} data-pd-pop data-pd-at={String(.12 + i * .14)} />
          {[0, 1, 2].map((j) => <circle class="pd-bubble" cx={x - 18 + j * 18} cy={400 - j * 22 - (i * 7) % 20} r={5 + j} data-pd-pop data-pd-at={String(.16 + i * .14)} />)}
        </>))}
        <circle class="pd-vessel pd-vessel--spec" cx="1125" cy="420" r="54" data-pd-pop data-pd-at=".86" />
        <path class="pd-tick" pathLength="1" data-pd-draw data-pd-at=".9" data-pd-dur=".08" d="M1100 420 L 1118 440 L 1152 398" />
      </>)}
      {k === 'quality' && (<>
        <circle class="pd-src" cx="100" cy="300" r="46" data-pd-pop data-pd-at="0" />
        {LAYERS.map((x, i) => (
          <path class={`pd-layer pd-layer--${i}`} pathLength="1" data-pd-draw data-pd-at={String(.12 + i * .2)} data-pd-dur=".14" d={`M${x - 28} 90 Q ${x + 46} 300 ${x - 28} 510`} />
        ))}
        {risks.map((r) => <circle class="pd-risk" cx={r.x.toFixed(1)} cy={r.y.toFixed(1)} r="9" data-pd-from={`${r.fx.toFixed(0)},0`} data-pd-at={r.at.toFixed(2)} data-pd-dur=".16" />)}
        <path class="pd-shield" pathLength="1" data-pd-draw data-pd-at=".76" data-pd-dur=".12" d="M1080 190 L 1166 222 C 1166 330 1134 384 1080 414 C 1026 384 994 330 994 222 Z" />
        <path class="pd-tick" pathLength="1" data-pd-draw data-pd-at=".88" data-pd-dur=".07" d="M1048 300 L 1072 326 L 1114 270" />
      </>)}
      {k === 'strategy' && (<>
        <circle class="pd-root" cx="90" cy="220" r="42" data-pd-pop data-pd-at="0" />
        {[[132, 312], [408, 582], [678, 852], [948, 1052]].map(([a, b], i) => (
          <path class="pd-yes" pathLength="1" data-pd-draw data-pd-at={String(.06 + i * .22)} data-pd-dur=".12" d={`M${a} 220 C ${a + 40} 212, ${b - 40} 228, ${b} 220`} />
        ))}
        {[360, 630, 900].map((x, i) => (<>
          <rect class="pd-q" x={x - 34} y="186" width="68" height="68" rx="10" transform={`rotate(45 ${x} 220)`} data-pd-pop data-pd-at={String(.16 + i * .22)} />
          <path class="pd-no" pathLength="1" data-pd-draw data-pd-at={String(.24 + i * .22)} data-pd-dur=".12" d={i === 1 ? `M630 268 C 626 350, 634 420, 630 494` : `M${x} 268 C ${x} 400, ${(x + 630) / 2} 470, ${x < 630 ? 556 : 704} 512`} />
          <path class="pd-mark" pathLength="1" data-pd-draw data-pd-at={String(.22 + i * .22)} data-pd-dur=".05" d={`M${x + 70} 186 L ${x + 82} 198 L ${x + 104} 172`} />
        </>))}
        <rect class="pd-nogo" x="548" y="494" width="164" height="56" rx="28" data-pd-pop data-pd-at=".78" />
        <rect class="pd-go" x="1052" y="186" width="126" height="68" rx="34" data-pd-pop data-pd-at=".86" />
      </>)}
      {k === 'deals' && (<>
        <rect class="pd-water" x="0" y="230" width="1200" height="370" data-pd-pop data-pd-at="0" />
        <path class="pd-body" d="M470 230 L 360 330 L 300 450 L 380 560 L 640 592 L 860 540 L 904 400 L 800 300 L 700 230 Z" />
        <path class="pd-tip" d="M470 230 L 540 120 L 580 150 L 622 88 L 700 230 Z" data-pd-pop data-pd-at=".02" />
        {[0, 1, 2].map((i) => <path class="pd-grid" d={`M${528 + i * 40} 196 V 228 M 510 ${206 + i * 10} H 660`} data-pd-pop data-pd-at=".06" />)}
        <path class="pd-wave" pathLength="1" data-pd-draw data-pd-at="0" data-pd-dur=".2" d="M0 230 C 100 215, 200 245, 300 230 S 500 215, 600 230 S 800 245, 900 230 S 1100 215, 1200 230" />
        <path class="pd-leader" pathLength="1" data-pd-draw data-pd-at=".05" data-pd-dur=".06" d="M640 140 L 748 120" />
        {[[700, 330, 938, 330, .3], [420, 430, 262, 430, .53], [700, 525, 938, 525, .77]].map(([x1, y1, x2, y2, at]) => (<>
          <circle class="pd-flag" cx={x1} cy={y1} r="12" data-pd-pop data-pd-at={String(at)} />
          <path class="pd-leader" pathLength="1" data-pd-draw data-pd-at={String(at)} data-pd-dur=".06" d={`M${x1} ${y1} L ${x2} ${y2}`} />
        </>))}
        <path class="pd-scan" d="M250 244 H 950" data-pd-to="0,340" data-pd-at=".12" data-pd-dur=".75" />
      </>)}
      {k === 'capability' && (<>
        {L1.map((n, i) => <path class="pd-branch" pathLength="1" data-pd-draw data-pd-at={String(.08 + i * .03)} data-pd-dur=".12" d={curve({ x: 600, y: 540 }, n)} />)}
        {L2.map((n, i) => <path class="pd-branch" pathLength="1" data-pd-draw data-pd-at={String(.35 + i * .015)} data-pd-dur=".1" d={curve(n.p, n)} />)}
        {L3.map((n, i) => <path class="pd-branch pd-branch--fine" pathLength="1" data-pd-draw data-pd-at={String(.6 + i * .008)} data-pd-dur=".08" d={curve(n.p, n)} />)}
        <circle class="pd-node pd-node--root" cx="600" cy="540" r="28" data-pd-pop data-pd-at="0" />
        {L1.map((n, i) => <circle class="pd-node" cx={n.x} cy={n.y} r="20" style={`fill:${PC[(i * 2 + 5) % 6]}`} data-pd-pop data-pd-at={String(.2 + i * .03)} />)}
        {L2.map((n, i) => <circle class="pd-node" cx={n.x} cy={n.y} r="14" style={`fill:${PC[i % 6]}`} data-pd-pop data-pd-at={String(.45 + i * .015)} />)}
        {L3.map((n, i) => <circle class="pd-node" cx={n.x} cy={n.y} r="9" style={`fill:${PC[(i + 3) % 6]}`} data-pd-pop data-pd-at={String(.68 + i * .008)} />)}
        <path class="pd-crown" pathLength="1" data-pd-draw data-pd-at=".84" data-pd-dur=".1" d="M200 104 C 400 84, 800 84, 1000 104" />
      </>)}
      <Fragment set:html={labels.map(badge).join('')} />
    </svg>
    {labels.map((l) => (
      <span class:list={['pd__lbl', `pd__lbl--${l.place ?? 'c'}`, { 'pd__lbl--big': l.big, 'pd__lbl--keep': l.keep }]} aria-hidden="true" style={`left:${pct(l.x, W)};top:${pct(l.y - Y0, H)}`}><span class="pd__lbl-in" data-pd-pop data-pd-at={String(l.at)}>{l.t}</span></span>
    ))}
    <MarginNote text={N.scroll} tone="saffron" arrow="arrow-curve" rotate={-6} arrowAngle={30} place="left: 0; top: -2.6em;" show="lg" />
  </div>
  <ol class="pd__steps">
    {steps.map((s, i) => <li><span class="pd__step-n tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
  </ol>
</figure>
<style>
  .pd { margin: 0; }
  .pd__cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; margin-bottom: var(--s-7); }
  .pd__fig { display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border-radius: var(--r-pill); background: var(--kk-saffron); color: var(--kk-ink); }
  .pd__title { font: 760 var(--fs-h2)/.95 var(--font-display); font-stretch: 78%; letter-spacing: -0.02em; color: var(--head); max-width: 18ch; text-wrap: balance; }
  .pd__stage { position: relative; }
  .pd__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .pd__svg :global(*) { vector-effect: none; }
  .pd__lbl { position: absolute; z-index: 1; width: max-content; max-width: 16ch; }
  .pd__lbl-in {
    display: block; padding: 6px 10px 7px;
    font: 500 var(--fs-mono)/1.25 var(--font-mono); color: var(--kk-ink); background: var(--kk-white); border-radius: 8px;
    box-shadow: 3px 3px 0 var(--pc); text-wrap: balance; text-align: center;
  }
  .pd__lbl--c { translate: -50% -50%; }
  .pd__lbl--t { translate: -50% -100%; }
  .pd__lbl--b { translate: -50% 0; }
  .pd__lbl--l { translate: -100% -50%; }
  .pd__lbl--r { translate: 0 -50%; }
  .pd__lbl--big .pd__lbl-in { font: 780 clamp(1.25rem, .9rem + 1vw, 2rem)/1 var(--font-display); font-stretch: 80%; padding: 8px 16px 10px; background: var(--kk-saffron); box-shadow: 4px 4px 0 var(--kk-ink); }
  .pd__steps { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; padding: 0; }
  .pd :global(.pd__badge) { display: none; }

  /* drawing styles */
  .pd :global(.pd-fill) { fill: color-mix(in srgb, var(--pc) 34%, transparent); }
  .pd :global(.pd-edge) { fill: none; stroke: var(--kk-white); stroke-width: 6; stroke-linecap: round; }
  .pd :global(.pd-dash) { fill: none; stroke: var(--kk-lavender); stroke-width: 2.5; stroke-dasharray: none; opacity: .7; }
  .pd :global(.pd-arrow) { fill: none; stroke: var(--kk-saffron); stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; }
  .pd :global(.pd-idea) { stroke: var(--kk-ink); stroke-width: 2; }
  .pd :global(.pd-pipe) { fill: none; stroke: var(--kk-lavender); stroke-width: 18; stroke-linecap: round; }
  .pd :global(.pd-flow) { fill: none; stroke: var(--kk-saffron); stroke-width: 8; stroke-linecap: round; stroke-dasharray: 2 34; }
  .pd :global(.pd-riser) { stroke: var(--kk-lavender); stroke-width: 14; }
  .pd :global(.pd-vessel) { fill: var(--pc); stroke: var(--kk-white); stroke-width: 5; }
  .pd :global(.pd-vessel--crude) { fill: var(--kk-saffron); }
  .pd :global(.pd-vessel--spec) { fill: var(--kk-sky); }
  .pd :global(.pd-bubble) { fill: var(--kk-white); opacity: .8; }
  .pd :global(.pd-tick), .pd :global(.pd-mark) { fill: none; stroke: var(--kk-ink); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; }
  .pd :global(.pd-mark) { stroke: var(--kk-saffron); stroke-width: 6; }
  .pd :global(.pd-src) { fill: var(--kk-coral); stroke: var(--kk-white); stroke-width: 5; }
  .pd :global(.pd-layer) { fill: none; stroke-width: 26; stroke-linecap: round; }
  .pd :global(.pd-layer--0) { stroke: var(--kk-orchid); }
  .pd :global(.pd-layer--1) { stroke: var(--kk-blush); }
  .pd :global(.pd-layer--2) { stroke: var(--kk-lavender); }
  .pd :global(.pd-risk) { fill: var(--kk-coral); stroke: var(--kk-ink); stroke-width: 3; }
  .pd :global(.pd-shield) { fill: var(--kk-white); stroke: var(--kk-orchid); stroke-width: 6; stroke-linejoin: round; }
  .pd :global(.pd-root) { fill: var(--kk-saffron); stroke: var(--kk-white); stroke-width: 5; }
  .pd :global(.pd-yes) { fill: none; stroke: var(--kk-white); stroke-width: 6; stroke-linecap: round; }
  .pd :global(.pd-no) { fill: none; stroke: var(--kk-coral); stroke-width: 4; stroke-dasharray: none; stroke-linecap: round; }
  .pd :global(.pd-q) { fill: var(--kk-ink); stroke: var(--kk-saffron); stroke-width: 6; }
  .pd :global(.pd-nogo) { fill: var(--kk-white); stroke: var(--kk-coral); stroke-width: 5; }
  .pd :global(.pd-go) { fill: var(--kk-saffron); }
  .pd :global(.pd-water) { fill: color-mix(in srgb, var(--kk-sapphire) 55%, transparent); }
  .pd :global(.pd-body) { fill: color-mix(in srgb, var(--kk-lavender) 30%, transparent); stroke: var(--kk-lavender); stroke-width: 3; stroke-dasharray: 10 8; }
  .pd :global(.pd-tip) { fill: var(--kk-white); stroke: var(--kk-white); stroke-width: 3; stroke-linejoin: round; }
  .pd :global(.pd-grid) { stroke: var(--kk-mauve); stroke-width: 2; }
  .pd :global(.pd-wave) { fill: none; stroke: var(--kk-sky); stroke-width: 5; stroke-linecap: round; }
  .pd :global(.pd-leader) { fill: none; stroke: var(--kk-white); stroke-width: 2.5; }
  .pd :global(.pd-flag) { fill: var(--kk-coral); stroke: var(--kk-white); stroke-width: 4; }
  .pd :global(.pd-scan) { stroke: var(--kk-saffron); stroke-width: 3; stroke-dasharray: 14 10; }
  .pd :global(.pd-branch) { fill: none; stroke: var(--kk-lavender); stroke-width: 4; stroke-linecap: round; }
  .pd :global(.pd-branch--fine) { stroke-width: 2.5; opacity: .8; }
