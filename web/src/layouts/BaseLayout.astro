---
/**
 * Page shell (REDESIGN-V3 §3 Layout). Order: SkipLink, AnnouncementBar, Header, <main>, CtaBand (every page except
 * contact, legal and 404, or when `cta={false}`), Footer, CookieConsent, then the one module script (src/scripts/site.ts).
 * The inline head script only swaps html.no-js → html.js, records a Menu tap made before site.ts runs
 * (window.__kkMenuPending) and, as a safety net, adds html.motion-failed if site.ts never boots (v4: nothing is hidden
 * waiting for JS any more, so this class has no visible effect). Any change to it needs `node scripts/csp-hash.mjs`.
 * Props keep the v2 signature so every page compiles. `pillar` no longer styles anything. Visible breadcrumbs belong to
 * PageHero (`crumbs`); here `breadcrumbs` feeds the JSON-LD BreadcrumbList, and only `showCrumbs={true}` also prints
 * the trail at the top of <main>. `cta` = boolean, or the CtaBand props for this page (e.g. { ground: 'white' }).
 * `footerNewsletter`: kept for compile only. Pack 2 (item 33): the footer always carries the compact newsletter.
 * Chat: the "Ask KoKreaters" widget mounts on every page except /contact; PUBLIC_CHAT=off (site.chat in src/config/site.ts) switches it off site-wide
 * (brief item 1's feature flag, for a launch without the assistant's back end).
 * Motion: site.ts boots src/scripts/motion.ts (GSAP + ScrollTrigger + Lenis, lazy chunk; data-gsap hooks).
 * Mobile: nothing layout-specific here; every chrome component carries its own mobile behaviour.
 */
import '@/styles/global.css';
import SeoHead from '@/components/seo/SeoHead.astro';
import { breadcrumbs as breadcrumbNode, organization, professionalService, website, type SeoProps, type Crumb } from '@/components/seo/schema';
import SkipLink from '@/components/chrome/SkipLink.astro';
import AnnouncementBar from '@/components/chrome/AnnouncementBar.astro';
import Header from '@/components/chrome/Header.astro';
import Footer from '@/components/chrome/Footer.astro';
import CookieConsent from '@/components/chrome/CookieConsent.astro';
import ChatWidget from '@/components/chrome/ChatWidget.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Container from '@/components/ui/Container.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import type { PillarKey } from '@/data/types';
import { site } from '@/config/site';

type Page = 'home' | 'expertise' | 'pillar' | 'industries' | 'approach' | 'impact' | 'insights' | 'article' | 'about' | 'contact' | 'legal' | 'notfound';
type CtaProps = {
  title?: string; body?: string;
  primary?: { label: string; href: string }; secondary?: { label: string; href: string };
  newsletter?: boolean; ground?: 'grey' | 'navy' | 'white' | 'delft';
};
interface Props {
  page: Page;
  seo: SeoProps;
  /** v2; kept for compile, no styling in v3. */
  pillar?: PillarKey;
  breadcrumbs?: Crumb[];
  ground?: 'white' | 'cloud' | 'grey';
  /** Print the breadcrumb trail at the top of <main> (default false: PageHero renders crumbs in v3). */
  showCrumbs?: boolean;
  /** CtaBand: false hides it, true forces it, an object passes CtaBand props. Default on except contact/legal/404. */
  cta?: boolean | CtaProps;
  /** v4 prop, no effect since pack 2 (the footer newsletter is always on). */
  footerNewsletter?: boolean;
}
const { page, seo, pillar, breadcrumbs = [], ground = 'white', showCrumbs = false, cta } = Astro.props;
const chatOn = site.chat && page !== 'contact';

const showCta = cta === undefined ? !['contact', 'legal', 'notfound'].includes(page) : cta !== false;
// v4: every page closes on the Deep Delft CtaBand (CtaBand's default ground), then the near-black footer.
const ctaProps: CtaProps = { ...(typeof cta === 'object' ? cta : {}) };
const noindex = page === 'notfound' ? true : seo.noindex;

// JSON-LD: home carries org + service + website by default; breadcrumb trail added when given.
const graph = [...(seo.jsonLd ?? [])];
if (page === 'home' && graph.length === 0) graph.push(organization(), professionalService(), website());
if (breadcrumbs.length && !graph.some((n) => n['@type'] === 'BreadcrumbList')) graph.push(breadcrumbNode(breadcrumbs));
const seoFinal: SeoProps = { ...seo, noindex, jsonLd: graph };
const bodyGround = ground === 'cloud' ? 'grey' : ground;
---
<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
(function(d,w){var h=d.documentElement;h.classList.remove('no-js');h.classList.add('js');
w.setTimeout(function(){if(!h.classList.contains('motion-booted'))h.classList.add('motion-failed');},3000);
d.addEventListener('click',function(e){var t=e.target;if(t&&t.closest&&t.closest('[data-menu-toggle]')&&!h.classList.contains('chrome-ready')){w.__kkMenuPending=!w.__kkMenuPending;}},true);
})(document,window);
    </script>
    <link rel="preload" href="/fonts/bodoni-moda-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <SeoHead seo={seoFinal} />
  </head>
  <body data-page={page} data-ground={bodyGround} data-pillar={pillar}>
    <SkipLink />
    <AnnouncementBar />
    <Header page={page} />
    <main id="main" tabindex="-1">
      {showCrumbs && breadcrumbs.length > 0 && (
        <Container class="page-crumbs"><Breadcrumbs items={breadcrumbs} /></Container>
      )}
      <slot />
      {showCta && <CtaBand {...ctaProps} />}
    </main>
    <Footer />
    <CookieConsent />
    {chatOn && <ChatWidget />}
    <script>import '@/scripts/site.ts';</script>
  </body>
</html>

<style is:global>
  body[data-ground="grey"] { --bg: var(--grey-50); }
  main:focus { outline: none; }
  .page-crumbs { padding-top: var(--s-5); }
</style>
