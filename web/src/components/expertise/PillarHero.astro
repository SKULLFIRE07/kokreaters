---
/**
 * v4 Delft inner-page hero (used by /expertise, the six pillar pages, /industries, /approach and /impact), built on the
 * homepage hero of the client's design: a full-bleed photo (object-fit cover) under a navy gradient from the left
 * (rgba(14,31,77,.94) → transparent), the label with its 40 × 2 saffron rule, a white Bodoni Moda H1 (--fs-h1: 44 → 76),
 * the intro in Manrope 19px #E4EAF5, optional square buttons (white fill + white outline). Crumbs sit top-left.
 * The text shows at once (no reveal); the photo frame carries data-gsap="kenburns" (settle on load, gentle parallax).
 * Desktop: min-height clamp(540px, 70svh, 760px), text bottom-left in ≈ 7 of 12 columns.
 * Mobile (< 900px): the photo stays behind the text, the gradient turns vertical and denser (≥ .7 under all text).
 */
import type { ImageMetadata } from 'astro';
import type { Crumb } from '@/components/seo/schema';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Photo from '@/components/ui/Photo.astro';
import Kicker from './Kicker.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs: Crumb[];
  crumbsCurrentShort?: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  titleId?: string;
  actions?: { label: string; href: string }[];
}
const { title, eyebrow, lead, crumbs, crumbsCurrentShort, image, imageAlt, imagePosition, titleId = 'page-title', actions = [] } = Astro.props;
---
<section class="ph band band--navy" aria-labelledby={titleId}>
  <div class="ph__media" data-gsap="kenburns">
    <Photo src={image} alt={imageAlt} fill priority position={imagePosition} sizes="100vw" />
  </div>
  <div class="ph__scrim" aria-hidden="true"></div>
  <div class="container ph__crumbs"><Breadcrumbs items={crumbs} currentShort={crumbsCurrentShort} /></div>
  <div class="container ph__inner">
    <div class="ph__text">
      {eyebrow && <Kicker rule tone="white" class="ph__eyebrow">{eyebrow}</Kicker>}
      <h1 id={titleId} class="ph__title">{title}</h1>
      {lead && <p class="ph__lead">{lead}</p>}
      {actions.length > 0 && (
        <div class="ph__actions">
          {actions.map((a, i) => <a class:list={['ph__btn', i === 0 ? 'ph__btn--fill' : 'ph__btn--line']} href={a.href}>{a.label}</a>)}
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .ph { position: relative; isolation: isolate; overflow: clip; padding-block: 0; display: flex; flex-direction: column; min-height: 520px; background: var(--navy-900); }
  .ph__media { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .ph__scrim {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(180deg, rgba(14, 31, 77, .45) 0%, rgba(14, 31, 77, .55) 30%, rgba(14, 31, 77, .9) 62%, rgba(14, 31, 77, .94) 100%);
  }
  .ph__crumbs { position: relative; z-index: 2; padding-top: var(--s-4); }
  .ph__inner { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-block: 120px 64px; }
  .ph__text { max-width: 780px; }
  .ph__eyebrow { margin-bottom: 28px; }
  .ph__title {
    font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-h1); line-height: 1.05; letter-spacing: -0.01em;
    color: var(--white); max-width: 17ch; text-wrap: balance;
  }
  .ph__lead { margin-top: 28px; max-width: 620px; font-size: 1.0625rem; line-height: 1.6; color: #E4EAF5; text-wrap: pretty; }
  .ph__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .ph__btn {
    display: inline-flex; align-items: center; min-height: 48px; padding: 14px 26px; font-size: var(--fs-button); font-weight: 700;
    text-decoration: none; border-radius: 0; transition: background-color var(--d-1) var(--ease-out), color var(--d-1) var(--ease-out);
  }
  .ph__btn--fill { background: var(--white); color: var(--navy-900); }
  .ph__btn--fill:hover { background: var(--ice); }
  .ph__btn--line { border: 1.5px solid rgba(255, 255, 255, .7); color: var(--white); }
  .ph__btn--line:hover { background: rgba(255, 255, 255, .1); }
  .ph__btn:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }

  @media (min-width: 900px) {
    .ph { min-height: max(600px, calc(100svh - var(--chrome-top))); }
    .ph__scrim {
      background:
        linear-gradient(90deg, rgba(14, 31, 77, .94) 0%, rgba(14, 31, 77, .82) 42%, rgba(14, 31, 77, .25) 75%, rgba(14, 31, 77, .05) 100%),
        linear-gradient(0deg, rgba(14, 31, 77, .35) 0%, rgba(14, 31, 77, 0) 40%);
    }
    .ph__inner { padding-block: 120px 96px; }
    .ph__lead { font-size: 1.1875rem; }
  }
</style>
