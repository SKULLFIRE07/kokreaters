---
/**
 * Section header (REDESIGN-V3 §3, §8.2, §9.3): eyebrow → serif title → lead, then the content 64–96px below.
 * Layout `auto` (default): ≥ 1200px with a lead, an asymmetric editorial split — eyebrow + title in columns 1–7, the lead
 *  (and link) in columns 8–12, bottom-aligned with the title's last line; otherwise the classic stack. `stack` forces the
 *  stack at every width. Optional "View all →" link: right-aligned on the title's last line at ≥ 900px (no lead), under
 *  the lead in the split, below the lead on mobile. `level` 2 (h2, --fs-h2 32 → 56) or 3 (h3, --fs-h3).
 *  Slot "lead" replaces the `lead` string when richer markup is needed.
 * Motion (v4): none. The header is readable at first paint; on dark grounds the eyebrow's saffron rule draws in.
 * Mobile: one column, left (or centred) aligned; link sits under the lead with a 16px gap.
 */
import Eyebrow from './Eyebrow.astro';
import ArrowLink from './ArrowLink.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  level?: 2 | 3;
  id?: string;
  align?: 'left' | 'center';
  layout?: 'auto' | 'stack';
  link?: { label: string; href: string };
  class?: string;
}
const { eyebrow, title, lead, level = 2, id, align = 'left', layout = 'auto', link, class: cls } = Astro.props;
const H = level === 3 ? 'h3' : 'h2';
const hasLead = !!lead || Astro.slots.has('lead');
const split = layout === 'auto' && align === 'left' && hasLead && level === 2;
---
<header class:list={['sh', `sh--${align}`, link && 'sh--linked', split && 'sh--split', cls]}>
  <div class="sh__head">
    {eyebrow && <Eyebrow class="sh__eyebrow" data-part>{eyebrow}</Eyebrow>}
    <H id={id} class:list={['sh__title', level === 3 ? 't-h3' : 't-h2']}>{title}</H>
  </div>
  {(hasLead || link) && (
    <div class="sh__side">
      {hasLead && (
        <div class="sh__lead t-lead" data-part style="--i:1">{Astro.slots.has('lead') ? <slot name="lead" /> : <p>{lead}</p>}</div>
      )}
      {link && <span class="sh__linkwrap" data-part style="--i:2"><ArrowLink href={link.href} class="sh__link">{link.label}</ArrowLink></span>}
    </div>
  )}
</header>
<style>
  .sh { display: grid; margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .sh__eyebrow { margin-bottom: 18px; }
  .sh__title { max-width: 22ch; }
  .sh__title.t-h3 { max-width: 40ch; }
  .sh__side { display: grid; gap: var(--s-4); }
  .sh__lead { margin-top: var(--s-5); color: var(--fg-2); font-size: 1.125rem; line-height: 1.65; }
  .sh__lead :global(p + p) { margin-top: .75em; }
  .sh__linkwrap { justify-self: start; margin-top: var(--s-2); }
  .sh--center { justify-items: center; text-align: center; }
  .sh--center .sh__linkwrap { justify-self: center; }
  .sh--center .sh__title, .sh--center .sh__lead { margin-inline: auto; }
  @media (min-width: 900px) {
    .sh--left.sh--linked:not(.sh--split) { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: var(--s-7); }
    .sh--left.sh--linked:not(.sh--split) .sh__side { display: contents; }
    .sh--left.sh--linked:not(.sh--split) .sh__lead { grid-column: 1; grid-row: 2; }
    .sh--left.sh--linked:not(.sh--split) .sh__linkwrap { grid-column: 2; grid-row: 1; align-self: end; justify-self: end; margin: 0 0 -6px; }
  }
  @media (min-width: 1200px) {
    .sh--split { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: end; }
    .sh--split .sh__head { grid-column: 1 / 8; }
    .sh--split .sh__side { grid-column: 8 / -1; padding-bottom: .35em; }
    .sh--split .sh__lead { margin-top: 0; }
    .sh--split .sh__title { max-width: 18ch; }
  }
</style>
