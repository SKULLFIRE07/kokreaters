---
/**
 * HubDiagram (DESIGN-SPEC v2 9 + 10.2 F2): the node cluster as a die-cut sticker at the centre of a spinning stamp,
 * six pillar discs on hand-bent spokes. The discs are REAL links in a <ul> (positioned on the spokes); the SVG
 * (spokes, orbit, packets) is aria-hidden. Hover / focus a disc: its spoke lights in the pillar colour, Saffron packets
 * run it, the caption panel shows the pillar's full name + promise (aria-hidden: the cards below carry the text).
 * Motion (scripts/bencho/hub-diagram.ts, lazy): the hub assembles as it scrolls in (nodes fly in from the edges,
 * spokes draw), packets run for 6 s, discs drift toward the pointer with the spokes following. Static: fully drawn.
 *
 * Ported from the "hub-diagram" block of bencho.dev, MIT License, Copyright (c) 2026 Lorenzo Cabra.
 * See web/THIRD_PARTY_NOTICES.md for the full licence text. Restyled to KoKreaters v2 tokens.
 */
import Stamp from '../notes/Stamp.astro';
import Logo from '../brand/Logo.astro';
import MarginNote from '../notes/MarginNote.astro';
import { pillars } from '@/data/pillars';
import { pillarGround, pillarNumber } from '@/lib/pillars';
import { expertiseNotes } from '@/data/notes/expertise';

interface Props { headingId?: string }
const { headingId = 'hub-title' } = Astro.props;
const S = 720, C = S / 2, R = 262;
const nodes = pillars.map((p, i) => {
  const a = (-90 + i * 60) * Math.PI / 180;
  const x = C + R * Math.cos(a), y = C + R * Math.sin(a);
  // a hand bend: control point pushed off the straight line, alternating sides
  const mx = (C + x) / 2, my = (C + y) / 2, nx = -(y - C) / R, ny = (x - C) / R, bend = (i % 2 ? -1 : 1) * 22;
  const d = `M${C} ${C} Q ${(mx + nx * bend).toFixed(1)} ${(my + ny * bend).toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
  return { p, x, y, d, bend, pct: { x: (x / S) * 100, y: (y / S) * 100 } };
});
const ring = pillars.map((p) => p.shortLabel).join(' · ');
---
<div class="hub" data-hub>
  <div class="hub__side">
    <p class="hub__count t-stat" aria-hidden="true">06</p>
    <h2 id={headingId} class="t-h2 hub__title">{expertiseNotes.hub.label}</h2>
    <div class="hub__caption" aria-hidden="true" data-hub-caption>
      <div class="hub__cap-idle">
        <MarginNote text={expertiseNotes.hub.hover} anchor="block" show="pointer" arrow="arrow-curve" rotate={-5} arrowAngle={-20} />
        <MarginNote text={expertiseNotes.hub.tap} anchor="block" show="touch" arrow="arrow-curve" rotate={-5} arrowAngle={-20} />
      </div>
      {pillars.map((p) => (
        <div class="hub__cap" data-hub-cap={p.key} style={`--pc:var(--pillar-${p.key})`}>
          <p class="hub__cap-n t-dateline"><span class="tnum">{pillarNumber(p)}</span> / 06</p>
          <p class="hub__cap-name">{p.name}</p>
          <p class="hub__cap-promise t-mono">{p.promise}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="hub__stage" data-hub-stage>
    <svg class="hub__svg" viewBox={`0 0 ${S} ${S}`} aria-hidden="true" focusable="false">
      <circle class="hub__orbit" cx={C} cy={C} r={R} />
      <circle class="hub__orbit hub__orbit--in" cx={C} cy={C} r={R * .62} />
      <g class="hub__spokes">
        {nodes.map((n) => <path class="hub__spoke" data-hub-spoke={n.p.key} data-bend={n.bend} d={n.d} pathLength="1" style={`--pc:var(--pillar-${n.p.key})`} />)}
      </g>
      <g class="hub__packets" data-hub-packets>
        {nodes.map((n) => [0, 1, 2].map((k) => <circle class="hub__packet" data-hub-packet={n.p.key} data-k={k} r="6" cx={C} cy={C} />))}
      </g>
    </svg>
    <div class="hub__centre" data-hub-centre>
      <Stamp text={ring} size={210} ground="white" spin>
        <span class="hub__sticker"><Logo variant="cluster" size={96} /></span>
      </Stamp>
    </div>
    <ul class="hub__list" aria-labelledby={headingId}>
      {nodes.map((n) => (
        <li class="hub__item" data-hub-node={n.p.key} style={`--x:${n.pct.x.toFixed(2)}%;--y:${n.pct.y.toFixed(2)}%`}>
          <a class:list={['hub__node', `g-${pillarGround(n.p.key)}`]} href={`/expertise/${n.p.slug}`} data-hub-link={n.p.key}>
            <span class="hub__n t-micro tnum" aria-hidden="true">{pillarNumber(n.p)}</span>
            <span class="hub__lbl">{n.p.shortLabel}</span><span class="visually-hidden">, {n.p.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  .hub { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-7); align-items: center; }
  .hub__side { position: relative; z-index: 1; }
  .hub__count {
    margin: 0 0 -0.08em; font-size: clamp(7rem, 3rem + 14vw, 17rem); line-height: .8; color: transparent;
    -webkit-text-stroke: 2px var(--kk-saffron); letter-spacing: -0.04em;
  }
  .hub__title { margin: 0; max-width: 9ch; color: var(--head); }
  .hub__caption { position: relative; margin-top: var(--s-7); min-height: 190px; }
  .hub__cap-idle { padding-top: var(--s-2); transition: opacity var(--d-ui) var(--ease-expo); }
  .hub__cap {
    position: absolute; inset: 0 auto auto 0; max-width: 30ch; padding-left: 20px; border-left: 6px solid var(--pc);
    display: none; pointer-events: none;
  }
  @keyframes hub-cap-in { from { opacity: 0; translate: 0 12px; } }
  .hub__cap-n { margin: 0 0 10px; color: var(--fg-2); }
  .hub__cap-name { margin: 0; font: 760 var(--fs-h3)/1 var(--font-display); font-stretch: 78%; letter-spacing: -0.015em; color: var(--head); text-wrap: balance; }
  .hub__cap-promise { margin: 14px 0 0; color: var(--kk-saffron); }
  .hub[data-active] .hub__cap-idle { display: none; }
  .hub[data-active="innovation"] [data-hub-cap="innovation"], .hub[data-active="process"] [data-hub-cap="process"],
  .hub[data-active="quality"] [data-hub-cap="quality"], .hub[data-active="strategy"] [data-hub-cap="strategy"],
  .hub[data-active="deals"] [data-hub-cap="deals"], .hub[data-active="capability"] [data-hub-cap="capability"] { display: block; animation: hub-cap-in var(--d-panel) var(--ease-expo); }

  .hub__stage { position: relative; width: 100%; max-width: 720px; aspect-ratio: 1; justify-self: end; }
  .hub__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hub__orbit { fill: none; stroke: var(--kk-white-20); stroke-width: 1.5; stroke-dasharray: 3 9; }
  .hub__orbit--in { stroke-dasharray: 1 7; }
  .hub__spoke { fill: none; stroke: var(--kk-lavender); stroke-width: 2.5; stroke-linecap: round; opacity: .55; transition: stroke var(--d-ui), stroke-width var(--d-ui), opacity var(--d-ui); }
  .hub__packet { fill: var(--kk-saffron); opacity: 0; }
  .hub[data-active] .hub__spoke { opacity: .2; }
  .hub[data-active="innovation"] [data-hub-spoke="innovation"], .hub[data-active="process"] [data-hub-spoke="process"],
  .hub[data-active="quality"] [data-hub-spoke="quality"], .hub[data-active="strategy"] [data-hub-spoke="strategy"],
  .hub[data-active="deals"] [data-hub-spoke="deals"], .hub[data-active="capability"] [data-hub-spoke="capability"] { stroke: var(--pc); stroke-width: 5; opacity: 1; }

  .hub__centre { position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 1; }
  .hub__centre :global(.stamp) { color: var(--kk-ink); box-shadow: 0 0 0 8px var(--kk-ink), 0 0 0 10px var(--kk-white-20); border-radius: 50%; }
  .hub__sticker { display: grid; place-items: center; width: 124px; height: 124px; border-radius: 50%; background: var(--kk-white); }

  .hub__list { list-style: none; margin: 0; padding: 0; }
  .hub__item { position: absolute; left: var(--x); top: var(--y); z-index: 2; width: 0; height: 0; }
  .hub__node {
    --d: clamp(96px, 11vw, 140px);
    position: absolute; left: calc(var(--d) / -2); top: calc(var(--d) / -2); display: grid; place-content: center; justify-items: center; gap: 4px; width: var(--d); height: var(--d);
    border-radius: 50%; text-decoration: none; color: var(--fg); text-align: center;
    box-shadow: 0 0 0 6px var(--kk-white), var(--shadow-sticker);
    transition: scale .5s var(--ease-spring), box-shadow var(--d-ui) var(--ease-expo);
  }
  .hub__n { color: var(--fg); opacity: .85; }
  .hub__lbl { font: 760 clamp(1rem, .6rem + .9vw, 1.4rem)/1 var(--font-display); font-stretch: 80%; letter-spacing: -0.01em; max-width: 7ch; }
  .hub__node:hover, .hub__node:focus-visible { scale: 1.12; color: var(--fg); box-shadow: 0 0 0 6px var(--kk-saffron), var(--shadow-lift); }
  .hub__node:focus-visible { outline: 3px solid var(--kk-white); outline-offset: 10px; }

  @media (max-width: 1023px) {
    .hub { grid-template-columns: 1fr; gap: var(--s-6); }
    .hub__stage { justify-self: center; max-width: 560px; }
    .hub__caption { min-height: 0; margin-top: var(--s-5); }
    .hub[data-active] .hub__cap-idle { display: block; }
    .hub[data-active] .hub__cap { display: none; }
  }
  @media (max-width: 767px) {
    .hub__stage { max-width: 340px; }
    .hub__node { --d: 78px; box-shadow: 0 0 0 4px var(--kk-white), var(--shadow-sticker); }
    .hub__lbl { font-size: 13px; max-width: 8ch; }
    .hub__n { display: none; }
    .hub__centre :global(.stamp) { scale: .55; }
    .hub__count { font-size: 7rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hub__node:hover, .hub__node:focus-visible { scale: 1; } }
</style>
