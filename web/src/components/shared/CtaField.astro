---
/** CTA + terminal node (graft 3), directly above the Footer on the same Imperial field (5.0.12). */
import { cta } from '@/data/home';
import { site } from '@/config/site';
import RisingArrow from '../brand/RisingArrow.astro';
import Engraving from '../brand/Engraving.astro';
import Button from '../ui/Button.astro';
import Confirm from '../ui/Confirm.astro';
interface Props { class?: string; }
const { class: cls } = Astro.props;
const [before, after] = cta.headline.split(cta.swooshPhrase);
---
<section class:list={['cta-field', 'band', 'band--dark', 'on-dark', cls]} aria-labelledby="cta-heading" data-cta>
  <div class="container grid cta-field__grid">
    <div class="cta-field__text c-1-7">
      <h2 id="cta-heading" class="cta-field__h">{before}<RisingArrow phrase={cta.swooshPhrase} tone="dark" />{after}</h2>
      <p class="t-lead cta-field__body">{cta.body}<Confirm id={9} note="free first call" /></p>
      <div class="cta-field__action">
        <svg class="cta-field__line" width="120" height="14" viewBox="0 0 120 14" aria-hidden="true" focusable="false">
          <path data-cta-line d="M0 7 H106" />
          <g data-cta-node><circle cx="111" cy="7" r="7" fill="var(--kk-saffron)" stroke="var(--kk-imperial)" stroke-width="2" /></g>
        </svg>
        <Button href={site.bookingUrl} variant="on-dark">{cta.button}</Button>
      </div>
    </div>
    <div class="cta-field__art c-8-12">
      <Engraving variant="cluster" tone="dark" opacity={0.3} />
    </div>
  </div>
</section>
<style>
  .cta-field__grid { align-items: center; row-gap: var(--s-6); }
  .cta-field__h { font-size: var(--fs-cta); line-height: 1.17; font-weight: var(--wght-h1); color: var(--kk-white); margin: 0 0 var(--s-5); max-width: 20ch; }
  .cta-field__body { color: var(--c-on-dark-muted); margin: 0 0 var(--s-7); }
  .cta-field__action { display: flex; align-items: center; gap: 0; flex-wrap: wrap; row-gap: var(--s-3); }
  .cta-field__line { flex: none; overflow: visible; margin-right: 6px; }
  .cta-field__line path { fill: none; stroke: var(--kk-sky); stroke-width: 1px; }
  .cta-field__line [data-cta-node] { transform-box: fill-box; transform-origin: center; }
  .cta-field__art { justify-self: end; width: 100%; max-width: 420px; }
  @media (max-width: 767px) { .cta-field__art { display: none; } }
</style>
