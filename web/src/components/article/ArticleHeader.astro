---
/**
 * ArticleHeader (DESIGN-SPEC v2 10.9): a full-bleed band on the pillar's tint ground with grain. Running head (mono),
 * DraftRibbon (staging), PillarTag link, the H1 (display, max 18ch; never hidden or animated), the standfirst and the
 * byline (avatar + mono "name · date · n min read"). N1 "grab a coffee" points at the reading time. On the right, the
 * article's own honest label (format, pillar, reading time, author), taped on with a big pillar doodle behind it.
 */
import type { CollectionEntry } from 'astro:content';
import DraftRibbon from '@/components/ui/DraftRibbon.astro';
import PillarTag from '@/components/ui/PillarTag.astro';
import Confirm from '@/components/ui/Confirm.astro';
import FounderPhoto from '@/components/brand/FounderPhoto.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import SpecLabel from '@/components/notes/SpecLabel.astro';
import Doodle from '@/components/notes/Doodle.astro';
import Tape from '@/components/notes/Tape.astro';
import { pillarHref, pillarTintGround, getPillar } from '@/lib/pillars';
import { isDraft } from '@/lib/insights';
import { microcopy, formatLabels } from '@/data/microcopy';
import { founderName } from '@/data/founder';
import { journalNotes } from '@/data/notes/journal';
import { formatDate, isoDate, fill } from '@/lib/format';
interface Props { entry: CollectionEntry<'insights'>; minutes: number; }
const { entry, minutes } = Astro.props;
const d = entry.data;
const pillar = getPillar(d.pillar);
const minLabel = minutes > 0 ? fill(microcopy.readingTime, { n: minutes }) : '';
const rows = [
  { k: microcopy.filterFormat, v: formatLabels[d.format] },
  { k: microcopy.filterPillar, v: pillar.shortLabel },
  ...(minLabel ? [{ k: journalNotes.article.labelTime, v: minLabel }] : []),
  { k: journalNotes.article.labelBy, v: founderName, strong: true },
];
---
<header class:list={['a-head', `g-${pillarTintGround(d.pillar)}`, 'grain', 'has-notes']}>
  <div class="container">
    <div class="a-head__running t-micro">
      <span>{microcopy.insightsRunningHead} · {formatLabels[d.format]}</span>
      {minLabel && <span class="tnum nowrap" data-running-time data-label-left={microcopy.minutesLeft}>{minLabel}</span>}
    </div>
    <div class="a-head__grid">
      <div class="a-head__main">
        {isDraft(entry) && <DraftRibbon class="a-head__draft" />}
        <p class="a-head__tag"><PillarTag pillar={d.pillar} href={pillarHref(d.pillar)} /></p>
        <h1 class="t-display a-head__title">{d.title}</h1>
        {d.standfirst && <p class="t-standfirst a-head__standfirst">{d.standfirst}</p>}
        <p class="a-head__byline t-meta">
          <FounderPhoto variant="avatar" size={48} alt="" loading="eager" />
          <span>
            <span class="a-head__author">{founderName}</span>
            <span aria-hidden="true"> · </span>
            {d.date ? <time class="tnum" datetime={isoDate(d.date)}>{formatDate(d.date)}</time> : <Confirm id="C-14" note="publication date" />}
            {minLabel && <><span aria-hidden="true"> · </span><span class="tnum nowrap a-head__time">{minLabel}</span></>}
          </span>
          {minLabel && <MarginNote text={journalNotes.article.coffee} rotate={-5} arrow="arrow-curve" arrowAt="start" arrowAngle={200} flip place="left:calc(100% + 20px);top:-26px;max-width:none;" show="md" delay={0.6} />}
        </p>
      </div>
      <div class="a-head__side">
        <span class="a-head__blob" aria-hidden="true"></span>
        <Doodle kind="spark" tone="ink" size={90} stroke={3} class="a-head__spark" />
        <div class="a-head__label" data-sticker data-sticker-from="right">
          <Tape tone="butter" rotate={4} width={100} />
          <SpecLabel title={journalNotes.hub.inside} sub={microcopy.insightsRunningHead} rows={rows} ground="white" headingLevel="none" rotate={-2} compact />
        </div>
      </div>
    </div>
  </div>
</header>
<style>
  .a-head { position: relative; overflow: clip; padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); border-bottom: 2px solid var(--kk-ink); }
  .a-head p { margin: 0; }
  .a-head__running { display: flex; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-4); margin-bottom: clamp(2rem, 1rem + 3vw, 4rem); border-bottom: 1.5px dashed var(--fg); color: var(--fg-2); }
  .a-head__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-8); align-items: end; }
  .a-head__main { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-5); min-width: 0; }
  .a-head :global(.a-head__draft) { align-self: flex-start; }
  .a-head__title { margin: 0; max-width: 18ch; font-size: clamp(2.75rem, 1.3rem + 5.2vw, 6.5rem); line-height: .92; text-wrap: balance; color: var(--head); }
  .a-head__standfirst { max-width: 36em; color: var(--fg); }
  .a-head__byline { position: relative; display: flex; align-items: center; gap: var(--s-3); color: var(--fg-2); margin-top: var(--s-2) !important; }
  .a-head__author { color: var(--fg); font-weight: 500; }
  .a-head__side { position: relative; justify-self: start; width: min(100%, 340px); }
  .a-head__blob { position: absolute; z-index: 0; width: 340px; aspect-ratio: 1; border-radius: 50%; right: -150px; top: -190px; background: var(--pillar, var(--kk-saffron)); }
  .a-head :global(.a-head__spark) { position: absolute; z-index: 2; left: -78px; top: -84px; }
  .a-head__label { position: relative; z-index: 1; }
  .a-head__label :global(.spec) { box-shadow: var(--shadow-hard); }
  @media (min-width: 1024px) {
    .a-head__grid { grid-template-columns: minmax(0, 1fr) 320px; column-gap: 64px; }
    .a-head__side { justify-self: end; margin-bottom: var(--s-3); }
  }
  @media (max-width: 1023px) { .a-head__side { display: none; } }
</style>
