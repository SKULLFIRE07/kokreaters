---
/**
 * Result card (REDESIGN-V3 §3, §9.3 "cards lighter"). Eyebrow (e.g. "India · Wilmar") → big serif figure in --accent
 * (blue-500 on light, blue-300 on navy) → serif title → optional body → optional tags. No box on any ground: a 1px
 * hairline on top and open space; on hover an accent line draws across it. The figure counts up once ([data-count]).
 * With `href` the title link is stretched over the card and an arrow sits bottom-right.
 * Text passes through untouched, so −25 °C (U+2212, U+202F) keeps its house form; figures never break across lines.
 * Mobile: full-width card, 24px padding, figure 44px.
 */
import Tag from '@/components/ui/Tag.astro';
import Icon from '@/components/ui/Icon.astro';
interface Props {
  eyebrow: string;
  figure?: string;
  title: string;
  body?: string;
  href?: string;
  tags?: string[];
  level?: 2 | 3 | 4;
  class?: string;
}
const { eyebrow, figure, title, body, href, tags = [], level = 3, class: cls } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---
<article class:list={['rcard', href && 'rcard--link', 'u-hover', cls]}>
  <p class="rcard__eyebrow t-label">{eyebrow}</p>
  {figure && <p class="rcard__figure" data-gsap="count">{figure}</p>}
  <H class="rcard__title">{href ? <a href={href} class="rcard__a">{title}</a> : title}</H>
  {body && <p class="rcard__body">{body}</p>}
  {(tags.length > 0 || href) && (
    <div class="rcard__foot">
      {tags.length > 0 && <ul class="rcard__tags" role="list">{tags.map((t) => <li><Tag size="sm">{t}</Tag></li>)}</ul>}
      {href && <Icon name="arrow-right" size={20} stroke={1.75} class="rcard__arrow u-nudge" />}
    </div>
  )}
</article>
<style>
  .rcard {
    position: relative; display: flex; flex-direction: column; height: 100%;
    padding: var(--s-6) 0 var(--s-2); border-top: 1px solid var(--rule);
  }
  .rcard::before {
    content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--d-3) var(--ease-out);
  }
  .rcard--link:hover::before, .rcard:has(.rcard__a:focus-visible)::before { transform: scaleX(1); }
  .rcard__eyebrow { color: var(--label); }
  .rcard__figure {
    margin-top: var(--s-6);
    font-family: var(--font-serif); font-size: 4rem;
    line-height: 1; font-weight: 400; letter-spacing: -0.01em; color: var(--figure);
    font-variant-numeric: lining-nums tabular-nums; white-space: nowrap;
  }
  .rcard__title {
    margin-top: var(--s-5);
    font-family: var(--font-sans); font-size: 1.0625rem; line-height: 1.5;
    font-weight: 600; color: var(--head); text-wrap: pretty; max-width: 30ch;
  }
  .rcard__figure + .rcard__title { margin-top: var(--s-5); }
  .rcard__a { color: inherit; text-decoration: none; transition: color var(--d-1) var(--ease-out); }
  .rcard__a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .rcard__a:focus-visible { outline: none; }
  .rcard:has(.rcard__a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .rcard--link:hover .rcard__a { color: var(--link); }
  .rcard__body { margin-top: var(--s-3); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); text-wrap: pretty; }
  .rcard__foot { margin-top: auto; padding-top: var(--s-6); display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-4); }
  .rcard__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .rcard__arrow { color: var(--accent); margin-left: auto; }
  @media (min-width: 900px) { .rcard { padding: var(--s-7) var(--s-4) var(--s-2) 0; } }
</style>
