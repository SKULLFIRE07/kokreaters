---
/**
 * Contact, left column (REDESIGN-V3 §4 Contact, §9.3): "Contact details" h2 over a hairline, then an <address> with
 * email, WhatsApp and LinkedIn as large serif lines (small uppercase label above each, hairline below), the base line
 * with the time zone, then the booking card. (The founder who answers sits in the hero: ContactFounder.)
 * Facts from @/config/site and @/data/nav (base + CET); labels from @/data/contact.
 * Booking card: an external link when PUBLIC_BOOKING_URL is set. Unset (bookingUrl falls back to /contact#form) it is a
 * gap (CONFIRM 9, booking tool): staging shows it pointing at the form (a[data-booking="form"] → contact.ts focuses the
 * first field), preview and production leave it out.
 * Mobile (< 900px): one column; each row stacks its label over the value; values wrap anywhere (the LinkedIn URL is
 * long); every link keeps a 44px tap height; values set at --fs-h4 (19 → 22). ≥ 900px the column sits left of the form
 * and stays in view while the form scrolls (sticky, set by the page); values at --fs-h3 from 1200px.
 */
import Icon from '@/components/ui/Icon.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { contact, contactPage } from '@/data/contact';
import { footer } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';
import { showConfirm } from '@/lib/mode';

const bookingSet = !site.bookingUrl.startsWith('/contact');
const showBooking = bookingSet || showConfirm;
const bookingHref = bookingSet ? site.bookingUrl : '#form';
---
<div class="cd">
  <h2 id="contact-details-h" class="cd__title">{contactPage.detailsHeading}</h2>

  <address class="cd__address">
    <dl class="cd__list">
      <div class="cd__row">
        <dt class="cd__label">{contact.details.email}</dt>
        <dd class="cd__value">
          <a class="cd__link" href={`mailto:${site.email}`}>{site.email}</a>
          <Confirm id={9} note="public email and reply-time promise" />
        </dd>
      </div>
      <div class="cd__row">
        <dt class="cd__label">{contact.details.whatsapp}</dt>
        <dd class="cd__value"><a class="cd__link" href={site.whatsapp.href} rel="noopener"><span class="nowrap">{site.whatsapp.display}</span></a></dd>
      </div>
      <div class="cd__row">
        <dt class="cd__label">{contact.details.linkedin}</dt>
        <dd class="cd__value">
          <a class="cd__link cd__link--ext" href={site.linkedin.href} rel="noopener me"><span class="cd__url">{site.linkedin.display}</span><span class="visually-hidden"> ({microcopy.opensLinkedIn})</span><Icon name="arrow-up-right" size={20} stroke={1.75} class="cd__ext" /></a>
        </dd>
      </div>
    </dl>
    <p class="cd__base"><Icon name="pin" size={20} class="cd__pin" />{footer.contact.base}</p>
  </address>

  {showBooking && (
    <div class="cd__booking">
      <a class="cd-book u-hover" href={bookingHref} {...(bookingSet ? { rel: 'noopener' } : { 'data-booking': 'form' })}>
        <Icon name="calendar" size={24} class="cd-book__icon" />
        <span class="cd-book__title u-draw">{contact.booking}</span>
        <Icon name={bookingSet ? 'arrow-up-right' : 'arrow-right'} size={20} stroke={2} class="cd-book__arrow u-nudge" />
      </a>
      {!bookingSet && <Confirm id={9} note="booking tool: set PUBLIC_BOOKING_URL; hidden outside staging until then" />}
    </div>
  )}
</div>

<style>
  .cd { display: grid; gap: 0; }
  .cd__title {
    margin: 0; padding-bottom: var(--s-5); border-bottom: 1px solid var(--rule-strong);
    font: 450 var(--fs-h3)/var(--lh-h3) var(--font-serif); font-optical-sizing: auto; letter-spacing: var(--tr-h3); color: var(--head);
  }

  .cd__address { font-style: normal; }
  .cd__list { margin: 0; }
  .cd__row { display: grid; gap: var(--s-1); padding-block: var(--s-5) var(--s-4); border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) { .cd__row { gap: var(--s-2); padding-block: var(--s-6) var(--s-5); } }
  .cd__label {
    font: 600 var(--fs-label)/var(--lh-label) var(--font-sans); letter-spacing: var(--tr-label); text-transform: uppercase;
    color: var(--fg-2);
  }
  .cd__value { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .cd__link {
    display: inline-flex; align-items: center; gap: var(--s-3); min-height: 44px; max-width: 100%;
    font: 400 var(--fs-h4)/1.3 var(--font-serif); font-optical-sizing: auto; color: var(--head);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .24em;
    text-decoration-color: color-mix(in srgb, currentColor 25%, transparent);
    transition: text-decoration-color var(--d-1) var(--ease-out), color var(--d-1) var(--ease-out);
  }
  @media (min-width: 1200px) { .cd__link { font-size: var(--fs-h3); } }
  .cd__url { min-width: 0; }
  .cd__link:hover { color: var(--link); text-decoration-color: var(--accent); }
  .cd__link:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .cd__link :global(.cd__ext) { flex: none; color: var(--accent); }

  .cd__base {
    display: flex; align-items: flex-start; gap: var(--s-3); margin: var(--s-6) 0 0;
    font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2);
  }
  .cd__base :global(.cd__pin) { flex: none; margin-top: 3px; color: var(--label); }

  .cd__booking { margin-top: var(--s-7); }
  .cd-book {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--s-4);
    min-height: 72px; padding: var(--s-4) 0;
    border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule);
    color: var(--head); text-decoration: none;
    transition: border-color var(--d-1) var(--ease-out);
  }
  .cd-book:hover { border-top-color: var(--accent); }
  .cd-book :global(.cd-book__icon) { color: var(--label); }
  .cd-book__title { font: 450 var(--fs-h4)/var(--lh-h4) var(--font-serif); font-optical-sizing: auto; }
  .cd-book :global(.cd-book__arrow) { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) { .cd__link, .cd-book { transition: none; } }
</style>
