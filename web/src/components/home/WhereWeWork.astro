---
/** F8 · Where we work (DESIGN-SPEC v2 10.1, signature move 5). Blush. Notebook tab + h2 (R1); the GravityTags box of the
 * nine industry links (drop, pile, toss; a flex-wrap pill list without the toy). Berry note "go on, toss one". */
import Section from '@/components/ui/Section.astro';
import GravityTags from '@/components/bencho/GravityTags.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import { industries as fold } from '@/data/home';
import { industries } from '@/data/industries';
import { homeNotes } from '@/data/notes/home';
const items = industries.map((i) => ({ label: i.name, href: `/industries#${i.slug}` }));
---
<Section ground="blush" notes folio={{ n: '04', label: fold.overline }} labelledby="industries-heading" class="where-fold">
  <div class="where-fold__grid">
    <div class="where-fold__head">
      <h2 id="industries-heading" class="t-display where-fold__h" data-rise>{fold.headline}<span aria-hidden="true" class="where-fold__q">.</span></h2>
      <MarginNote text={homeNotes.industries.toss} tone="berry" size="lg" rotate={-6} arrow="arrow-bounce" arrowAt="below" arrowAngle={-10} show="pointer" anchor="block" class="where-fold__note" />
    </div>
    <GravityTags items={items} label={fold.headline} class="where-fold__box" />
  </div>
</Section>

<style>
  .where-fold { padding-block: clamp(80px, 10vw, 150px); }
  .where-fold__grid { display: grid; grid-template-columns: 4fr 8fr; gap: var(--s-7) var(--gutter); align-items: end; }
  .where-fold__h { margin: 0; color: var(--kk-ink); font-size: clamp(56px, 8vw, 132px); max-width: 6ch; }
  .where-fold__q { color: var(--kk-orchid); }
  .where-fold :global(.where-fold__note) { margin-top: var(--s-5); margin-left: 40%; }
  @media (max-width: 1023px) { .where-fold__grid { grid-template-columns: 1fr; } .where-fold__h { max-width: none; } }
</style>
