---
/** Pillar chip (DESIGN-SPEC v2 7.7): 32px, the pillar's colour-block ground, mono 12 caps + PillarDot; hover rotates
 * −2° and lifts 2px. */
import PillarDot from './PillarDot.astro';
import { pillars } from '@/data/pillars';
import { pillarGround } from '@/lib/pillars';
import type { PillarKey } from '@/data/types';
interface Props { pillar: PillarKey; href?: string; label?: string; class?: string; current?: boolean; }
const { pillar, href, label, class: cls, current = false } = Astro.props;
const p = pillars.find((x) => x.key === pillar);
const text = label ?? p?.name ?? pillar;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['pillar-tag', `g-${pillarGround(pillar)}`, cls]} href={href} aria-current={current ? 'page' : undefined}><PillarDot pillar={pillar} size={8} /><span>{text}</span></Tag>
<style>
  .pillar-tag {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 32px; padding: 0 14px 0 8px; border-radius: var(--r-pill);
    font-family: var(--font-mono); font-size: 12px; font-weight: 500; line-height: 1.2; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; color: var(--fg);
    transition: rotate var(--d-ui) var(--ease-expo), translate var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo);
  }
  .pillar-tag :global(.pillar-dot) { box-shadow: 0 0 0 1.5px var(--kk-white); }
  a.pillar-tag { position: relative; }
  a.pillar-tag::after { content: ""; position: absolute; inset: -6px 0; }
  a.pillar-tag:hover, a.pillar-tag:focus-visible { color: var(--fg); rotate: -2deg; translate: 0 -2px; box-shadow: 3px 3px 0 var(--kk-ink); }
  a.pillar-tag[aria-current] { box-shadow: inset 0 0 0 2px var(--fg); }
</style>
