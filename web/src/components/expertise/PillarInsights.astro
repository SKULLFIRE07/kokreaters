---
/**
 * Related insights for one pillar (REDESIGN-V3 §4 detail 7), as a rail section. Up to three visible insights of the
 * same pillar (lib/insights byPillar: drafts in staging and preview, published + approved in production) as text
 * InsightCards (label, serif title, standfirst, date · read time), then any coming-soon pieces of the pillar as plain,
 * unlinked titles under "In preparation" (titles in --fg-2 with a "Soon" tag at the row end, no arrow, so they never
 * read as links). The page omits the section when both lists are empty.
 * The Draft label is staging-only (showDraftLabels).
 * Mobile (< 900px): heading, then the cards stacked full width, then the "In preparation" list. The section is always
 * followed by a hairline (the industries rail's rule or the pager's top line), so below 900px the list's last row drops
 * its own closing line: two full-width rules 48px apart would read as a double rule.
 */
import RailSection from './RailSection.astro';
import InsightCard from '@/components/cards/InsightCard.astro';
import Tag from '@/components/ui/Tag.astro';
import { insightsHub } from '@/data/insights';
import { microcopy } from '@/data/microcopy';
import { formatLabel, insightHref, insightReadingTime, isDraft, type Insight } from '@/lib/insights';
import { showDraftLabels } from '@/lib/mode';

interface Props {
  visible: Insight[];
  coming: Insight[];
  ground?: 'white' | 'grey';
  rule?: boolean;
}
const { visible, coming, ground = 'white', rule = false } = Astro.props;
const cards = visible.slice(0, 3);
---
<RailSection id="related-title" title={microcopy.relatedInsights} ground={ground} rule={rule}>
  {cards.length > 0 && (
    <ul class="ri__cards" role="list">
      {cards.map((e, i) => (
        <li data-reveal style={`--i:${i}`}>
          <InsightCard
            size="text" href={insightHref(e)} title={e.data.title} label={formatLabel(e)} summary={e.data.standfirst}
            date={e.data.date} readTime={insightReadingTime(e)}
          >
            {showDraftLabels && isDraft(e) && <span slot="badge"> · Draft</span>}
          </InsightCard>
        </li>
      ))}
    </ul>
  )}
  {coming.length > 0 && (
    <div class:list={['ri__soon', cards.length > 0 && 'ri__soon--after']} data-reveal style="--i:1">
      <h3 class="ri__soon-title t-label">{microcopy.inPreparation}</h3>
      <ul class="ri__soon-list" role="list">
        {coming.map((e) => (
          <li><span class="ri__soon-format">{formatLabel(e)}</span><span class="ri__soon-name">{e.data.title}</span><Tag size="sm" class="ri__soon-tag">{insightsHub.soonTag}</Tag></li>
        ))}
      </ul>
    </div>
  )}
</RailSection>
<style>
  .ri__cards { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-7); }
  .ri__soon--after { margin-top: var(--s-7); }
  .ri__soon-title { color: var(--fg-2); margin-bottom: var(--s-3); }
  .ri__soon-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .ri__soon-list li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2px var(--s-4);
    padding-block: var(--s-4); border-bottom: 1px solid var(--rule);
  }
  .ri__soon-list :global(.ri__soon-tag) { grid-area: 1 / 2; justify-self: end; }
  .ri__soon-format { grid-area: 1 / 1; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .ri__soon-name {
    font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-h4); line-height: var(--lh-h4);
    grid-column: 1 / -1; font-weight: 450; color: var(--fg-2); text-wrap: pretty;
  }
  @media (min-width: 600px) {
    .ri__soon-list li { grid-template-columns: 9.5rem minmax(0, 1fr) auto; column-gap: var(--s-5); align-items: baseline; }
    .ri__soon-format { grid-area: 1 / 1; }
    .ri__soon-name { grid-area: 1 / 2; }
    .ri__soon-list :global(.ri__soon-tag) { grid-area: 1 / 3; align-self: center; }
  }
  @media (max-width: 899px) {
    .ri__soon-list li:last-child { border-bottom-color: transparent; }
  }
</style>
