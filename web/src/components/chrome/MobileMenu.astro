---
/**
 * Mobile menu, < 1120px (REDESIGN-V3 §3 chrome). A full-screen white sheet under the header bar; the bar stays visible
 * and its Menu button becomes the close button (label swap + the icon turns into a cross).
 * Order: Expertise (accordion → six areas + "All expertise"), Industries (accordion → nine + "All industries"),
 * Approach, Impact, Insights, About, Contact — 24px serif rows on hairlines — then a full-width "Start a conversation"
 * button, the email address and LinkedIn.
 * Behaviour (site.ts): body scroll lock without layout jump, `inert` on the rest of the page, focus trapped between the
 * Menu button and the sheet, Esc closes and returns focus, any link closes. Motion: the sheet fades in (240ms) and the
 * rows settle up with a 30ms stagger (no blur); accordions ease their height (grid rows 0fr → 1fr). Reduced motion: instant.
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { main, mobile, expertiseLinks, industryLinks, megaMenu, industriesMenu, header as labels, emailDisplay } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const groups = main.filter((l) => l.panel).map((l) => {
  const list = l.panel === 'list';
  return {
    id: list ? 'm-menu-industries' : 'm-menu-expertise',
    label: l.label,
    current: isCurrent(l.href),
    links: list ? industryLinks : expertiseLinks,
    all: list ? industriesMenu.all : megaMenu.all,
  };
});
---
<div id="mobile-menu" class="m-menu" data-lenis-prevent hidden>
  <Container class="m-menu__inner">
    <nav aria-label={labels.menuLabel}>
      <ul class="m-menu__list" role="list">
        {groups.map((g, i) => (
          <li class="m-menu__item m-menu__fx" style={`--i:${i}`}>
            <button type="button" class:list={['m-menu__link', 'm-menu__group', g.current && 'is-current']}
              aria-expanded="false" aria-controls={g.id} data-menu-group>
              <span>{g.label}</span><span class="m-menu__pm" aria-hidden="true"></span>
            </button>
            <div id={g.id} class="m-menu__panel">
              <div class="m-menu__panel-in">
                <ul class="m-menu__sub" role="list">
                  {g.links.map((l) => <li><a class="m-menu__sublink" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
                  <li><a class="m-menu__sublink m-menu__all" href={g.all.href}>{g.all.label}<Icon name="arrow-right" size={18} /></a></li>
                </ul>
              </div>
            </div>
          </li>
        ))}
        {mobile.map((l, i) => (
          <li class="m-menu__item m-menu__fx" style={`--i:${i + groups.length}`}>
            <a class:list={['m-menu__link', isCurrent(l.href) && 'is-current']} href={l.href}
              aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="m-menu__foot m-menu__fx" style={`--i:${groups.length + mobile.length}`}>
      <Button href="/contact" full size="lg">{microcopy.primaryCta}</Button>
      <ul class="m-menu__contact" role="list">
        <li><a href={`mailto:${site.email}`}><Icon name="mail" size={20} />{emailDisplay}</a></li>
        <li><a href={site.linkedin.href} rel="me noopener"><Icon name="linkedin" size={20} />LinkedIn<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span></a></li>
      </ul>
    </div>
  </Container>
</div>

<style>
  .m-menu {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 1;
    top: calc(var(--menu-hdr-top, 0px) + var(--header-h));
    pointer-events: auto;
    overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch;
    background: var(--white); color: var(--fg);
    opacity: 0;
    transition: opacity var(--d-1) var(--ease-in-out);
  }
  .m-menu.is-open { opacity: 1; transition: opacity var(--d-2) var(--ease-out); }
  @media (min-width: 1120px) { .m-menu { display: none !important; } }

  .m-menu :global(.m-menu__inner) { padding-block: var(--s-3) calc(var(--s-8) + env(safe-area-inset-bottom, 0px)); }
  .m-menu__list { margin: 0; padding: 0; list-style: none; }
  .m-menu__item { border-bottom: 1px solid var(--grey-200); }
  .m-menu__link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    width: 100%; min-height: 64px; margin: 0; padding: var(--s-3) 0; border: 0; background: none; cursor: pointer; text-align: left;
    font: 420 1.5rem/1.2 var(--font-serif); font-optical-sizing: auto; letter-spacing: -0.005em;
    color: var(--head); text-decoration: none;
  }
  .m-menu__link.is-current { color: var(--link); }
  .m-menu__link:focus-visible { outline-offset: -2px; }

  /* plus → minus */
  .m-menu__pm { position: relative; width: 16px; height: 16px; flex: none; color: var(--ink-2); }
  .m-menu__pm::before, .m-menu__pm::after {
    content: ""; position: absolute; left: 0; top: calc(50% - .75px); width: 100%; height: 1.5px; background: currentColor;
    transition: transform var(--d-2) var(--ease-out);
  }
  .m-menu__pm::after { transform: rotate(90deg); }
  .m-menu__group[aria-expanded="true"] .m-menu__pm::after { transform: rotate(0deg); }

  /* accordion: grid rows 0fr → 1fr; collapsed content is visibility:hidden (not focusable, not read) */
  .m-menu__panel {
    display: grid; grid-template-rows: 0fr; visibility: hidden;
    transition: grid-template-rows var(--d-3) var(--ease-out), visibility 0s linear var(--d-3);
  }
  .m-menu__group[aria-expanded="true"] + .m-menu__panel {
    grid-template-rows: 1fr; visibility: visible;
    transition: grid-template-rows var(--d-3) var(--ease-out), visibility 0s;
  }
  .m-menu__panel-in { min-height: 0; overflow: hidden; }
  .m-menu__sub { margin: 0; padding: 0 0 var(--s-4); list-style: none; }
  .m-menu__sublink {
    display: flex; align-items: center; gap: var(--s-2); min-height: 44px; padding: var(--s-2) 0;
    font: 400 1.0625rem/1.35 var(--font-sans); color: var(--fg); text-decoration: none;
  }
  .m-menu__sublink[aria-current="page"] { color: var(--link); }
  .m-menu__all { color: var(--link); font-weight: 500; }
  .m-menu__all :global(svg) { transition: transform var(--d-1) var(--ease-out); }
  .m-menu__all:hover :global(svg) { transform: translateX(4px); }

  .m-menu__foot { padding-top: var(--s-7); }
  .m-menu__contact { margin: var(--s-5) 0 0; padding: 0; list-style: none; }
  .m-menu__contact a {
    display: inline-flex; align-items: center; gap: var(--s-3); min-height: 44px;
    font: 400 var(--fs-small)/1.3 var(--font-sans); color: var(--fg); text-decoration: none;
  }
  .m-menu__contact a :global(svg) { color: var(--blue-700); }
  .m-menu__contact a:hover { color: var(--link); }

  /* rows settle up with the sheet, 30ms stagger (no blur: v4) */
  .m-menu__fx { opacity: 0; transform: translateY(8px); }
  .m-menu.is-open .m-menu__fx {
    opacity: 1; transform: none;
    transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out);
    transition-delay: calc(40ms + var(--i, 0) * 30ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .m-menu, .m-menu.is-open, .m-menu__panel, .m-menu__fx, .m-menu.is-open .m-menu__fx { transition: none !important; }
    .m-menu__fx { opacity: 1; transform: none; }
  }
</style>
