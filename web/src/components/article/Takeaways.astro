---
/** Key takeaways (DESIGN-SPEC v2 10.9): a Butter SpecLabel titled "Key takeaways", one numbered row per item with a
 * hand tick, plus N2 "the short version". */
import SpecLabel from '@/components/notes/SpecLabel.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import { microcopy } from '@/data/microcopy';
import { journalNotes } from '@/data/notes/journal';
interface Props { items: string[]; }
const { items } = Astro.props;
const rows = items.map((v, i) => ({ k: String(i + 1).padStart(2, '0'), v: [v] }));
---
<aside class="takeaways has-notes" aria-labelledby="takeaways-t" data-reveal>
  <MarginNote text={journalNotes.article.short} tone="berry" rotate={6} arrow="arrow-curve" arrowAt="below" arrowAngle={150} place="right:-12px;top:-58px;" show="md" />
  <SpecLabel title={microcopy.keyTakeaways} id="takeaways" rows={rows} ground="butter" headingLevel={2} rotate={-1} />
</aside>
<style>
  .takeaways { position: relative; margin-block: var(--s-9) 0; }
  .takeaways :global(.spec) { max-width: none; padding: 24px 28px 22px; box-shadow: var(--shadow-hard); }
  .takeaways :global(.spec__title) { margin: 0 !important; font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem) !important; line-height: .95 !important; }
  .takeaways :global(.spec__title::before) { content: none !important; }
  .takeaways :global(.spec__row) { grid-template-columns: 40px minmax(0, 1fr) !important; padding-block: 12px; }
  .takeaways :global(.spec__row dd) { font-size: 15px; line-height: 1.55; }
  .takeaways :global(.spec__list li) { margin: 0 !important; }
</style>
