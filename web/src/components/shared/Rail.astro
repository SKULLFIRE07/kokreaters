---
/**
 * Rail (DESIGN-SPEC v2 7.8, 8.3 R5): <section aria-label> → <ul class="rail__track" role="list"> of the slotted <li>s.
 * `pin` at ≥ 1024 + motion: a pinned sideways scrub (scripts/motion/rail.ts). Otherwise a native scroll-snap rail with
 * Previous/Next buttons (visually hidden labels + arrows) and a mono "1 / n" counter.
 */
import Icon from '../ui/Icon.astro';
import { chromeNotes } from '@/data/notes/chrome';
interface Props { label: string; pin?: boolean; id: string; controls?: boolean; class?: string }
const { label, pin = false, id, controls = true, class: cls } = Astro.props;
---
<section id={id} class:list={['rail', { 'rail--pin': pin }, cls]} aria-label={label} data-rail data-rail-pin={pin ? '' : undefined}>
  <ul class="rail__track" role="list" data-rail-track>
    <slot />
  </ul>
  {controls && (
    <div class="rail__controls js-only">
      <button type="button" class="rail__btn" data-rail-prev aria-controls={id}><Icon name="prev" size={20} /><span class="visually-hidden">{chromeNotes.rail.prev}</span></button>
      <span class="rail__count t-micro tnum" data-rail-count data-template={chromeNotes.rail.count} aria-hidden="true"></span>
      <button type="button" class="rail__btn" data-rail-next aria-controls={id}><Icon name="next" size={20} /><span class="visually-hidden">{chromeNotes.rail.next}</span></button>
    </div>
  )}
</section>
<style>
  .rail { position: relative; --side: clamp(1rem, -0.3rem + 5.333vw, 4.5rem); }
  .rail__track {
    display: flex; gap: var(--gutter); margin: 0; padding: 8px var(--side) 24px; list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--side); overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .rail__track::-webkit-scrollbar { display: none; }
  .rail__track > :global(li) { flex: none; display: flex; scroll-snap-align: start; }
  .rail__track:focus { outline: none; }
  .rail.is-pinned .rail__track { overflow: visible; scroll-snap-type: none; width: max-content; }
  .rail.is-pinned .rail__controls { display: none; }
  .rail__controls { display: flex; align-items: center; gap: 14px; padding-inline: var(--side); }
  .rail__btn {
    display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--fg); color: var(--fg); background: transparent;
    transition: background-color var(--d-ui) var(--ease-expo), color var(--d-ui) var(--ease-expo);
  }
  .rail__btn:hover:not(:disabled), .rail__btn:focus-visible { background: var(--fg); color: var(--bg); }
  .rail__btn:disabled { opacity: .35; cursor: default; }
  .rail__count { min-width: 4ch; text-align: center; color: var(--fg); }
</style>
