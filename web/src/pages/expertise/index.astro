---
/**
 * /expertise (REDESIGN-V3 §4 "Expertise hub").
 *  1 PageHero grey — crumbs, eyebrow "Expertise", H1 "Expertise that connects science, plants and strategy.",
 *    lead = the overview intro (shown whole: trimming it to two sentences would be a copy change).
 *  2 The six areas (white) — SectionHeader + six ExpertiseCards `hub` (name, promise, typical deliverables, Learn more).
 *    3×2 from 1200px, 2×3 from 600px, one column below.
 *  3 "Not sure where you fit?" — this page's CtaBand (BaseLayout `cta` props): the prompt as the headline and
 *    "Start a conversation" → /contact as the button, so the page closes on one CTA band, not two.
 * Mobile: hero text full width; cards one column, full width, 24px padding; the CtaBand button goes full width.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ExpertiseCard from '@/components/cards/ExpertiseCard.astro';
import { expertiseOverview, pillars } from '@/data/pillars';
import { microcopy } from '@/data/microcopy';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: expertiseOverview.overline, href: '/expertise' }];
const prompt = expertiseOverview.prompt;
---
<BaseLayout
  page="expertise" seo={pageSeo('expertise')} breadcrumbs={crumbs}
  cta={{ title: prompt.text, primary: { label: prompt.link.label, href: prompt.link.href } }}
>
  <PageHero
    ground="grey" crumbs={crumbs} eyebrow={expertiseOverview.overline}
    title={expertiseOverview.headline} lead={expertiseOverview.intro} titleId="expertise-title"
  />

  <Section ground="white" labelledby="areas-title">
    <SectionHeader id="areas-title" title={microcopy.expertiseAreas} />
    <ul class="card-grid card-grid--xl" role="list">
      {pillars.map((p, i) => (
        <li data-reveal style={`--i:${i}`}><ExpertiseCard pillar={p} variant="hub" /></li>
      ))}
    </ul>
  </Section>
</BaseLayout>
