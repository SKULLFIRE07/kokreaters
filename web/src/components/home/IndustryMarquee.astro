---
/** F2 · Industry marquee (DESIGN-SPEC v2 10.1). Ink, full-bleed. The nine industry names in Saffron, ringed-dot
 * separators in the five logo colours. aria-hidden (the real list is F8). R6: 60 px/s, reverses with scroll, skew ≤ 6°. */
import Marquee from '@/components/shared/Marquee.astro';
import { industries } from '@/data/industries';
const items = industries.map((i) => i.name);
---
<div class="industry-marquee g-ink">
  <Marquee items={items} ground="ink" speed={60} />
</div>
<style>
  .industry-marquee { position: relative; min-height: 120px; display: flex; align-items: center; overflow: clip;
    border-block: 2px solid var(--kk-ink); }
  .industry-marquee :global(.marquee) { width: 100%; }
  .industry-marquee :global(.marquee__word) { color: var(--kk-saffron); }
</style>
