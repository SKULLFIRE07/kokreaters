---
/**
 * About · "Who he has worked alongside" (brief item 24). White band, aria-labelledby="alongside-h".
 * SectionHeader (h2 + the brief's sentence as the lead), then the six sectors the sentence names as a list of tiles:
 * a 32px Lucide glyph in Deep Delft over the sector's name, each on a 1px top rule. Sector icons only: never company
 * names or logos (Ganeaysh decides later whether to name companies).
 * ≥ 1200px six across; 600–1199px three; phones two (≥ 48px rows).
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import SectorIcon from './SectorIcon.astro';
import { workedAlongside } from '@/data/about';
---
<Section ground="white" labelledby="alongside-h" class="along">
  <SectionHeader id="alongside-h" title={workedAlongside.heading} lead={workedAlongside.body} />
  <ul class="along__list" role="list">
    {workedAlongside.sectors.map((s) => (
      <li class="along__item">
        <span class="along__icon"><SectorIcon name={s.icon} /></span>
        <span class="along__name">{s.label}</span>
      </li>
    ))}
  </ul>
</Section>
<style>
  .along__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--grid-gap); }
  .along__item { display: grid; align-content: start; gap: var(--s-4); padding-top: var(--s-5); border-top: 1px solid var(--rule); min-width: 0; }
  .along__icon { display: grid; place-items: center; width: 64px; height: 64px; background: var(--ice); color: var(--link); }
  .along__name { font: 700 var(--fs-body)/1.35 var(--font-sans); color: var(--head); text-wrap: balance; }
  @media (min-width: 600px) { .along__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .along__list { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
