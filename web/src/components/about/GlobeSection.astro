---
/**
 * The map (DESIGN-SPEC 5.9.4, 6.8). The page's one Three.js moment; this component ships the static,
 * server-rendered state: the engraved globe SVG (same data and projection as the scene's final frame)
 * and the accessible <ol> of the eight places. W3-globe mounts its canvas into [data-globe] over the SVG.
 * At ≥ 1024px with motion the section is 160vh and its inner grid is sticky (CSS sticky, never a pin);
 * otherwise it is auto height. W3-globe may edit this file's CSS and mount markup only.
 */
import GlobeStatic from '@/assets/globe/globe-static.svg';
import Dateline from '@/components/ui/Dateline.astro';
import { globe } from '@/data/founder';
import { places, placeLabel } from '@/data/places';
import { microcopy } from '@/data/microcopy';
---
<section id="the-map" class="band globe-section" aria-labelledby="globe-title" data-globe-section>
  <div class="globe-section__sticky">
    <div class="container grid globe-section__grid">
      <div class="globe-section__text c-1-5">
        <Dateline text={globe.overline} />
        <h2 id="globe-title" class="t-h2 globe-section__h2" data-reveal="lines">{globe.headline}</h2>
        <p class="t-lead globe-section__lead" data-reveal>{globe.lead}</p>
        <ol class="t-meta globe-section__places" aria-label={microcopy.placesLabel} data-reveal>
          {places.map((p) => <li>{placeLabel(p)}</li>)}
        </ol>
      </div>
      <div class="globe-section__art c-6-12">
        <div class="globe" data-globe>
          <GlobeStatic class="globe__static" aria-hidden="true" focusable="false" />
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .globe-section { position: relative; }
  .globe-section__grid { align-items: center; row-gap: var(--s-7); }
  .globe-section__h2 { margin: var(--s-4) 0 var(--s-5); max-width: 16ch; }
  .globe-section__lead { margin: 0 0 var(--s-6); }
  .globe-section__places {
    list-style: none; margin: 0; padding: var(--s-4) 0 0; border-top: 1px solid var(--c-rule);
    columns: 2; column-gap: var(--gutter); color: var(--c-meta);
  }
  .globe-section__places li { break-inside: avoid; padding-block: 2px; }
  .globe { position: relative; width: 100%; max-width: 640px; margin-inline: auto; aspect-ratio: 1 / 1; }
  .globe :global(.globe__static) { display: block; width: 100%; height: 100%; }
  .globe :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* W3-globe: HTML labels positioned by scene.ts each render (aria-hidden; the <ol> carries the names). */
  .globe :global(.globe__labels) { position: absolute; inset: 0; pointer-events: none; }
  .globe :global(.globe__label) {
    position: absolute; left: 0; top: 0; white-space: nowrap;
    font-family: var(--font-sans); font-size: var(--fs-meta); line-height: 1.2; font-weight: 500;
    color: var(--c-text); text-shadow: 0 0 2px var(--kk-white), 0 0 4px var(--kk-white);
    opacity: 0; transition: opacity var(--d-ui-in) var(--ease-out);
  }
  .globe :global(.globe__label.is-on) { opacity: 1; }

  @media (min-width: 1024px) {
    /* Only with motion allowed (and not failed) does the section become a 160vh scroll stage. */
    :global(html.motion:not(.motion-failed)) .globe-section { height: 160vh; padding-block: 0; }
    :global(html.motion:not(.motion-failed)) .globe-section__sticky {
      position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h));
      display: flex; align-items: center;
    }
    /* Stay square inside the sticky stage, so the static SVG and the canvas share one box. */
    :global(html.motion:not(.motion-failed)) .globe { width: min(100%, 640px, calc(100vh - var(--header-h) - 2 * var(--s-7))); }
  }
</style>
