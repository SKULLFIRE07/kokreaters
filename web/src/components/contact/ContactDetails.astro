---
/**
 * Contact, left column (brief items 36–37; pack 3): "Contact details" h2 over a hairline, then an <address> with email,
 * WhatsApp and LinkedIn as large lines (small uppercase label above each, hairline below): the founder's profile and,
 * once Part K 14 is confirmed, the KoKreaters company page next to it (staging shows the empty slot with its <Confirm>).
 * Pack 3 adds the time zone row ("CET, the Netherlands") and the "Confidential by default" line (brief: keep it on
 * Approach and Contact; the words are the Approach principle's, src/data/approach.ts). The city line shows only once
 * Part K 1 names the city (staging: the slot with its <Confirm>). The booking block moved to ContactBooking (first on
 * the page once PUBLIC_BOOKING_URL exists).
 * Mobile (< 900px): one column; each row stacks its label over the value; values wrap anywhere (the LinkedIn URL is
 * long); every link keeps a 44px tap height. ≥ 900px the column sits left of the form and stays in view while the
 * form scrolls (sticky, set by the page).
 */
import Icon from '@/components/ui/Icon.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { contact, contactPage, location, linkedinCompany } from '@/data/contact';
import { principles } from '@/data/approach';
import { emailDisplay } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';
import { showConfirm } from '@/lib/mode';

const showCompany = Boolean(linkedinCompany) || showConfirm;
const showCity = Boolean(location.city) || showConfirm;
const confidential = principles.find((p) => p.name === 'Confidential by default');
---
<div class="cd">
  <h2 id="contact-details-h" class="cd__title">{contactPage.detailsHeading}</h2>

  <address class="cd__address">
    <dl class="cd__list">
      <div class="cd__row">
        <dt class="cd__label">{contact.details.email}</dt>
        <dd class="cd__value">
          <a class="cd__link" href={`mailto:${site.email}`}>{emailDisplay}</a>
        </dd>
      </div>
      <div class="cd__row">
        <dt class="cd__label">{contact.details.whatsapp}</dt>
        <dd class="cd__value"><a class="cd__link" href={site.whatsapp.href} rel="noopener"><span class="nowrap">{site.whatsapp.display}</span></a></dd>
      </div>
      <div class="cd__row">
        <dt class="cd__label">{showCompany ? contact.details.linkedinFounder : contact.details.linkedin}</dt>
        <dd class="cd__value">
          <a class="cd__link cd__link--ext" href={site.linkedin.href} rel="noopener me"><span class="cd__url">{site.linkedin.display}</span><span class="visually-hidden"> ({microcopy.opensLinkedIn})</span><Icon name="arrow-up-right" size={20} stroke={1.75} class="cd__ext" /></a>
        </dd>
      </div>
      <div class="cd__row">
        <dt class="cd__label">{contactPage.timezoneLabel}</dt>
        <dd class="cd__value cd__tz">{contactPage.timezone}</dd>
      </div>
      {showCompany && (
        <div class="cd__row">
          <dt class="cd__label">{contact.details.linkedinCompany}</dt>
          <dd class="cd__value">
            {linkedinCompany
              ? <a class="cd__link cd__link--ext" href={linkedinCompany.href} rel="noopener"><span class="cd__url">{linkedinCompany.display}</span><span class="visually-hidden"> ({microcopy.opensLinkedIn})</span><Icon name="arrow-up-right" size={20} stroke={1.75} class="cd__ext" /></a>
              : <Confirm id="P-14" note="LinkedIn company page URL; hidden until it exists" />}
          </dd>
        </div>
      )}
    </dl>
    {showCity && <p class="cd__base"><Icon name="pin" size={20} class="cd__pin" /><span>{location.line}{!location.city && <Confirm id="P-1" note="city" />}</span></p>}
  </address>
  {confidential && (
    <p class="cd__nda"><strong>{confidential.name}.</strong> {confidential.copy}</p>
  )}

</div>

<style>
  .cd { display: grid; gap: 0; }
  .cd__title {
    margin: 0; padding-bottom: var(--s-5); border-bottom: 1px solid var(--rule);
    font: 500 1.75rem/1.2 var(--font-serif); letter-spacing: 0; color: var(--head);
  }

  .cd__address { font-style: normal; }
  .cd__list { margin: 0; }
  .cd__row { display: grid; gap: var(--s-1); padding-block: var(--s-5) var(--s-4); border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) { .cd__row { gap: var(--s-2); padding-block: var(--s-6) var(--s-5); } }
  .cd__label {
    font: 700 var(--fs-label)/var(--lh-label) var(--font-sans); letter-spacing: var(--tr-label); text-transform: uppercase;
    color: var(--label);
  }
  .cd__value { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .cd__link {
    display: inline-flex; align-items: center; gap: var(--s-3); min-height: 44px; max-width: 100%;
    font: 700 1.1875rem/1.35 var(--font-sans); color: var(--head);   /* v4: Manrope (Bodoni only at 24px and up) */
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .24em;
    text-decoration-color: color-mix(in srgb, currentColor 25%, transparent);
    transition: text-decoration-color var(--d-1) var(--ease-out), color var(--d-1) var(--ease-out);
  }
  @media (min-width: 1200px) { .cd__link { font-size: 1.3125rem; } }
  .cd__url { min-width: 0; }
  .cd__link:hover { color: var(--link); text-decoration-color: var(--accent); }
  .cd__link:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .cd__link :global(.cd__ext) { flex: none; color: var(--accent); }

  .cd__base {
    display: flex; align-items: flex-start; gap: var(--s-3); margin: var(--s-6) 0 0;
    font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2);
  }
  .cd__base :global(.cd__pin) { flex: none; margin-top: 3px; color: var(--label); }
  .cd__base { color: var(--head); font-weight: 600; }

  .cd__tz { min-height: 44px; display: flex; align-items: center; font: 700 1.1875rem/1.35 var(--font-sans); color: var(--head); }
  @media (min-width: 1200px) { .cd__tz { font-size: 1.3125rem; } }
  .cd__nda { margin: var(--s-6) 0 0; padding: var(--s-4) var(--s-5); border-left: 3px solid var(--link); background: var(--grey-50); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); max-width: 44ch; }
  .cd__nda strong { color: var(--head); }

  @media (prefers-reduced-motion: reduce) { .cd__link { transition: none; } }
</style>
