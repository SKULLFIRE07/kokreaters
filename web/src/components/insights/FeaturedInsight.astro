---
/**
 * Featured insight (REDESIGN-V3 §4 Insights hub, §9.1/9.3): the hub's cover story. Page-local layout (not the
 * InsightCard `feature` size): the photo bleeds off the left edge of the screen across columns 1–7 at its natural 3:2
 * crop (focal point from photos.ts), the story sits in columns 8–12, vertically centred: a "Featured insight" eyebrow
 * (the band's h2) with a short rule, the serif title at h2 size (the h3, one big link stretched over photo and text),
 * the standfirst at lead size, then format · expertise and date · read time over a hairline, and "Read the insight".
 * White band under the white hero, so it opens on a hairline. The photo is the page's LCP image (priority); the hero
 * above has none.
 * Mobile (< 900px): the photo runs edge to edge at 3:2, the text follows inside the gutters.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Photo from '@/components/ui/Photo.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { formatLabel, insightHref, insightImage, insightReadingTime, isDraft } from '@/lib/insights';
import { getPillar } from '@/lib/pillars';
import { showDraftLabels } from '@/lib/mode';
import { microcopy } from '@/data/microcopy';
import { articleCopy } from '@/data/insights';
import { formatDate, isoDate, fill } from '@/lib/format';
interface Props { entry: CollectionEntry<'insights'>; }
const { entry: e } = Astro.props;
const img = insightImage(e);
const minutes = insightReadingTime(e);
const readLabel = minutes ? fill(microcopy.readingTime, { n: minutes }) : '';
const summary = e.data.standfirst || e.data.description;
---
<Section ground="white" width="bleed" pad="tight" rule labelledby="featured-h" class="feat">
  <div class="feat__wrap">
    <div class="container">
      <article class:list={['feat__card', 'u-zoom', img && 'feat__card--image']}>
        {img && (
          <div class="feat__media">
            <Photo src={img.src} alt={img.alt} ratio="3/2" priority sizes="(min-width: 1920px) 1100px, (min-width: 900px) 64vw, 100vw" />
          </div>
        )}
        <div class="feat__body">
          <h2 id="featured-h" class="feat__eyebrow t-label">{microcopy.featuredInsight}</h2>
          <h3 class="feat__title"><a href={insightHref(e)} class="feat__link">{e.data.title}</a></h3>
          {summary && <p class="feat__summary">{summary}</p>}
          <div class="feat__meta">
            <p class="feat__label t-label">{formatLabel(e)}<span class="feat__pillar"> · {getPillar(e.data.pillar).shortLabel}</span>{showDraftLabels && isDraft(e) && <span class="feat__draft"> · {articleCopy.draft}</span>}</p>
            {(e.data.date || readLabel) && (
              <p class="feat__date">
                {e.data.date && <time datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>}
                {e.data.date && readLabel && <span aria-hidden="true"> · </span>}
                {readLabel && <span>{readLabel}</span>}
              </p>
            )}
          </div>
          <ArrowLink class="feat__more">{microcopy.insightsLink}</ArrowLink>
        </div>
      </article>
    </div>
  </div>
</Section>
<style>
  /* the band is the size container: the photo's left bleed is measured from the screen edge */
  .feat__wrap { container-type: inline-size; }
  @media (min-width: 900px) { .feat__wrap { padding-top: var(--s-4); } }
  .feat__card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
  .feat__media { margin-inline: calc(-1 * var(--gutter-x)); overflow: hidden; }
  .feat__body { display: flex; flex-direction: column; align-items: flex-start; }
  .feat__eyebrow { display: flex; align-items: center; gap: var(--s-3); margin: 0 0 var(--s-5); color: var(--label); }
  .feat__eyebrow::before { content: ""; width: 32px; height: 1px; background: currentColor; }
  .feat__title {
    margin: 0; font-family: var(--font-serif); font-optical-sizing: auto;
    font-size: clamp(2rem, 1.55rem + 1.8vw, 3.25rem); line-height: 1.1; font-weight: 400; letter-spacing: -0.02em;
    color: var(--head); text-wrap: balance; max-width: 18ch;
  }
  .feat__link { color: inherit; text-decoration: none; transition: color var(--d-1) var(--ease-out); }
  .feat__link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .feat__link:focus-visible { outline: none; }
  .feat__card:has(.feat__link:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .feat__card:hover .feat__link { color: var(--link); }
  .feat__summary {
    margin: var(--s-5) 0 0; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--fg-2);
    max-width: 40ch; text-wrap: pretty;
  }
  .feat__meta {
    align-self: stretch; display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-5);
    margin-top: var(--s-7); padding-top: var(--s-4); border-top: 1px solid var(--rule);
  }
  .feat__label { margin: 0; color: var(--label); }
  .feat__pillar, .feat__draft { color: var(--fg-2); }
  .feat__date { margin: 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); font-variant-numeric: lining-nums tabular-nums; }
  .feat__body :global(.feat__more) { margin-top: var(--s-6); }

  @media (min-width: 900px) {
    .feat__card--image { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: center; }
    /* columns 1–7 plus everything left of the container, up to the screen edge */
    .feat__media { grid-column: 1 / 8; margin: 0 0 0 calc(-1 * max(var(--gutter-x), (100cqw - var(--container)) / 2)); }
    .feat__card--image .feat__body { grid-column: 8 / -1; padding-left: clamp(0px, -2rem + 3.5vw, 3rem); }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .feat__title { font-size: clamp(1.875rem, 1rem + 1.6vw, 2.25rem); }
    .feat__summary { font-size: var(--fs-body); line-height: var(--lh-body); }
  }
</style>
