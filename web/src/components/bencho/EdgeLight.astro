/** EdgeLight: wraps content in an element carrying [data-edge-light] (R11, pointer-fine only, lazy). Components may
 * also put `data-edge-light` on their own root instead of using this wrapper (PillarCard does). */
interface Props { as?: 'div' | 'span' | 'figure'; radius?: string; class?: string }
const { as: Tag = 'div', radius = 'var(--r-card)', class: cls } = Astro.props;
---
<Tag class:list={['edge-light', cls]} data-edge-light style={`--el-r:${radius}`}><slot /></Tag>
<style>
  .edge-light { position: relative; border-radius: var(--el-r); }
</style>
