---
/**
 * Impact-page track record (pack 2, brief item 27; different from the home and About strips): label "Our track record"
 * with the footnote at the right (small, grey), then the figures in Bodoni Moda 64px navy (data-gsap="count"), each on
 * a top rule: 3px saffron for the lead figure, 1px rule for the others (data-gsap="rule"). The first word of each label
 * is bold, as on the home strip. Data: impact.ts `impactStrip`.
 * Placeholder rule: the fourth figure (⟦≥ 50%⟧, Part K 6) renders only in staging, with its <Confirm>; elsewhere the
 * strip has three figures and the columns follow the count.
 * Mobile: one column below 480px, two from 480px, all in one row from 1000px.
 */
import Section from '@/components/ui/Section.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { impactStrip } from '@/data/impact';
import { showConfirm } from '@/lib/mode';

interface Props { ground?: 'white' | 'grey' }
const { ground = 'grey' } = Astro.props;
const items = impactStrip.items.filter((it) => !it.pending || showConfirm);
const head = (t: string) => t.split(' ')[0];
const tail = (t: string) => t.split(' ').slice(1).join(' ');
---
<Section ground={ground} labelledby="record-h" class="record">
  <div class="record__top">
    <h2 id="record-h" class="t-label record__h">{impactStrip.label}</h2>
    <p class="record__src">{impactStrip.source}</p>
  </div>
  <ul class="record__list" role="list" style={`--n: ${items.length}`}>
    {items.map((it, i) => (
      <li class:list={['stat', i === 0 && 'stat--lead']}>
        <span class="stat__rule" aria-hidden="true" data-gsap="rule"></span>
        <p class="stat__value" data-gsap={it.pending ? undefined : 'count'}>{it.value}</p>
        <p class="stat__label"><strong>{head(it.label)}</strong> {tail(it.label)}</p>
        {it.pending && <p class="stat__confirm"><Confirm id={it.pending.confirm} note={it.pending.note} /></p>}
      </li>
    ))}
  </ul>
</Section>
<style>
  .record { --_pad: clamp(4rem, 3rem + 2.5vw, 5.5rem); }
  .record__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; margin-bottom: 40px; }
  .record__src { font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); max-width: 60ch; text-align: right; text-wrap: pretty; }
  .record__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .stat { position: relative; padding-top: 26px; min-width: 0; }
  .stat__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--rule); transform-origin: left center; }
  .stat--lead .stat__rule { height: 3px; background: var(--saffron); }
  .stat__value { font-family: var(--font-serif); font-size: clamp(3rem, 2.6rem + 1.6vw, 4rem); line-height: 1; font-weight: 400; color: var(--head); font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
  .stat__label { margin-top: 14px; font-size: 1rem; line-height: 1.5; color: var(--fg-2); max-width: 26ch; text-wrap: pretty; }
  .stat__label strong { color: var(--head); font-weight: 700; }
  .stat__confirm { margin-top: 8px; }
  @media (max-width: 599px) { .record__src { text-align: left; } }
  @media (min-width: 480px) { .record__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .record__list { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); } }
</style>
