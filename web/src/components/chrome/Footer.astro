---
/** Footer (DESIGN-SPEC v2 7.6): Ink with print grain. Row 1: the full white lockup + a margin note by "Back to top".
 * Row 2: the four v1 columns. Bottom row: © + legal + cookie settings + Confirm 11. Last: the giant white wordmark
 * sign-off (aria-hidden), cropped ~10% by the band's bottom edge, never distorted (set --signoff-crop: 0 to show it whole). */
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import Confirm from '@/components/ui/Confirm.astro';
import Newsletter from '@/components/shared/Newsletter.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import { footer, legal } from '@/data/nav';
import { microcopy } from '@/data/microcopy';
import { chromeNotes } from '@/data/notes/chrome';
import { site } from '@/config/site';
---
<footer id="site-footer" class="site-footer g-ink grain" tabindex="-1">
  <div class="container">
    <div class="site-footer__top">
      <Logo variant="full-white" href="/" label="KoKreaters home" width={260} class="site-footer__logo" />
      <div class="site-footer__back has-notes">
        <a class="site-footer__top-link t-mono" href="#main"><span class="site-footer__up"><Icon name="arrow-up" size={18} /></span>{chromeNotes.top}</a>
        <MarginNote text={chromeNotes.footer} tone="saffron" arrow="arrow-curve" arrowAt="end" arrowAngle={-6} rotate={-4}
          show="md" place="right:calc(100% + 4px); top:-58px;" trigger=".site-footer" />
      </div>
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-labelledby="ft-expertise">
        <h2 id="ft-expertise" class="site-footer__head t-label">{footer.expertise.heading}</h2>
        <ul role="list">
          {footer.expertise.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <nav class="site-footer__col" aria-labelledby="ft-company">
        <h2 id="ft-company" class="site-footer__head t-label">{footer.company.heading}</h2>
        <ul role="list">
          {footer.company.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="site-footer__col">
        <h2 class="site-footer__head t-label">{footer.contact.heading}</h2>
        <ul role="list">
          <li><a href={footer.contact.email.href}>{footer.contact.email.label}</a></li>
          <li><a href={footer.contact.whatsapp.href} rel="noopener">{footer.contact.whatsapp.label}</a></li>
          <li>
            <a class="site-footer__ext" href={footer.contact.linkedin.href} rel="me noopener">
              {footer.contact.linkedin.label}<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span>
              <span class="site-footer__icon" aria-hidden="true"><Icon name="external" /></span>
            </a>
          </li>
          <li class="site-footer__base t-mono">{footer.contact.base}</li>
        </ul>
      </div>
      <div class="site-footer__col site-footer__col--news">
        <h2 class="site-footer__head t-label">{footer.newsletter.heading}</h2>
        <Newsletter variant="footer" />
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal">
        <span class="nowrap">© 2026 {site.name}{site.trademark}</span>
        {legal.map((l) => (
          <><span class="site-footer__sep" aria-hidden="true">·</span><a href={l.href}>{l.label}</a></>
        ))}
        <span class="site-footer__sep js-only" aria-hidden="true">·</span>
        <button type="button" class="site-footer__settings js-only" data-cookie-settings aria-haspopup="dialog" aria-controls="cookie-settings">{microcopy.cookieSettings}</button>
      </p>
      <p class="site-footer__reg">
        {site.legal.registration ?? <Confirm id={11} note="KvK / VAT / registered address" />}
      </p>
    </div>

    <div class="site-footer__signoff" aria-hidden="true">
      <Logo variant="wordmark-white" width="100%" />
    </div>
  </div>
</footer>

<style is:global>
  .site-footer { padding-block: var(--s-9) 0; overflow: clip; }
  .site-footer:focus { outline: none; }
  .site-footer__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s-6); }
  .site-footer__logo { max-width: 100%; }
  .site-footer__back { position: relative; }
  .site-footer__top-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--kk-white); text-decoration: none; }
  .site-footer__top-link:hover { color: var(--kk-saffron); }
  .site-footer__up { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; box-shadow: inset 0 0 0 2px currentColor; }

  .site-footer__cols { display: grid; grid-template-columns: 1fr; gap: var(--s-7) var(--gutter); margin-top: var(--s-8); padding-top: var(--s-7); border-top: 1.5px dashed var(--kk-white-20); }
  @media (min-width: 600px) { .site-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .site-footer__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .site-footer__head { margin: 0 0 var(--s-4); color: var(--kk-lavender); }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .site-footer__col a {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    padding-block: 9px; min-height: 44px; box-sizing: border-box;
    font: 600 1.0625rem/1.25 var(--font-display); font-stretch: 95%;
    color: var(--kk-white); text-decoration: none;
  }
  .site-footer__col a:hover, .site-footer__col a:focus-visible { color: var(--kk-saffron); text-decoration: underline wavy 1.5px; text-underline-offset: .3em; }
  .site-footer__icon { display: inline-flex; width: 14px; height: 14px; }
  .site-footer__icon svg { width: 14px; height: 14px; }
  .site-footer__base { color: var(--kk-lavender); padding-block: 10px; text-wrap: balance; }
  .site-footer__col--news { color: var(--kk-white); }

  .site-footer__bottom {
    position: relative; z-index: 1;
    margin-top: var(--s-7); padding-top: var(--s-4); border-top: 1px solid var(--kk-white-20);
    display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); justify-content: space-between; align-items: center;
    font: 400 13px/1.4 var(--font-mono); color: var(--kk-lavender);
  }
  .site-footer__legal { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-2); }
  .site-footer__legal a, .site-footer__settings {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--kk-lavender); text-decoration: none;
    font: inherit; background: none; border: 0; padding: 0; cursor: pointer;
  }
  .site-footer__legal a:hover, .site-footer__settings:hover { color: var(--kk-saffron); }
  .site-footer__sep { color: var(--kk-lavender); opacity: 0.7; }
  @media (max-width: 767px) {
    .site-footer__legal { column-gap: var(--s-5); }
    .site-footer__sep { display: none; }
  }
  .site-footer__reg { margin: 0; }

  .site-footer__signoff { --signoff-crop: .1; margin-top: var(--s-7); margin-bottom: calc(var(--signoff-crop) * -21.8%); line-height: 0; pointer-events: none; }
  .site-footer__signoff .logo { width: 100%; }
</style>
