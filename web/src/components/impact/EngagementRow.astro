---
/**
 * An anonymised KoKreaters engagement (DESIGN-SPEC v2 10.6 F4) as a ticket-stub card: dashed perforation, the stub
 * with the mono dateline, the brief text in .t-h3. Pending rows render only in staging, with the hazard "Pending
 * client consent" label. The page filters; this component also refuses to render a pending row in production.
 */
import Confirm from '@/components/ui/Confirm.astro';
import PillarDot from '@/components/ui/PillarDot.astro';
import type { Engagement } from '@/data/types';
import { impactPage } from '@/data/impact';
import { microcopy } from '@/data/microcopy';
import { isStaging } from '@/lib/mode';
interface Props { engagement: Engagement; index: number }
const { engagement, index } = Astro.props;
const pending = engagement.consent !== 'cleared';
const show = !pending || isStaging;
const confirmId = engagement.id === 'eu-minerals' ? 'C-12' : 6;
const grounds = ['butter', 'blush', 'ice'] as const;
---
{show && (
  <li class:list={['stub', `g-${grounds[index % 3]}`]} data-engagement={engagement.id} data-consent={engagement.consent} data-reveal>
    <div class="stub__side">
      <p class="t-dateline stub__dateline">{impactPage.engagementDateline}</p>
      <span class="stub__dots" aria-hidden="true">{engagement.pillars.map((k) => <PillarDot pillar={k} size={12} />)}</span>
    </div>
    <div class="stub__body">
      <p class="stub__text">{engagement.text}</p>
      {pending && <p class="stub__pending"><span class="stub__hazard">{microcopy.pendingConsent}</span><Confirm id={confirmId} /></p>}
    </div>
  </li>
)}
<style>
  .stub { position: relative; list-style: none; display: grid; grid-template-columns: 220px minmax(0, 1fr); border: 2px solid var(--kk-ink); border-radius: 16px;
    box-shadow: 6px 6px 0 var(--kk-ink); overflow: clip; }
  .stub__side { position: relative; padding: 24px; display: flex; flex-direction: column; gap: 14px; border-right: 2px dashed var(--kk-ink); }
  .stub__side::before, .stub__side::after { content: ""; position: absolute; right: -13px; width: 24px; height: 24px; border-radius: 50%; background: var(--kk-white); border: 2px solid var(--kk-ink); }
  .stub__side::before { top: -14px; } .stub__side::after { bottom: -14px; }
  .stub__dateline { margin: 0; }
  .stub__dots { display: flex; gap: 6px; margin-top: auto; }
  .stub__body { padding: 24px 28px; }
  .stub__text { margin: 0; font-family: var(--font-display); font-weight: 720; font-stretch: 85%; letter-spacing: -.01em; line-height: 1.05; font-size: var(--fs-h3); color: var(--head); max-width: 28ch; text-wrap: balance; }
  .stub__pending { margin: var(--s-4) 0 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .stub__hazard { display: inline-flex; padding: 4px 10px; border-radius: var(--r-pill); font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
    background: var(--kk-saffron); color: var(--kk-ink); box-shadow: inset 0 0 0 1.5px var(--kk-ink); position: relative; padding-left: 30px; }
  .stub__hazard::before { content: ""; position: absolute; left: 6px; top: 5px; bottom: 5px; width: 16px; border-radius: 4px; background: repeating-linear-gradient(-45deg, var(--kk-ink) 0 3px, transparent 3px 6px); }
  .stub__pending :global(.confirm) { margin-inline: 0; }
  @media (max-width: 767px) {
    .stub { grid-template-columns: 1fr; }
    .stub__side { flex-direction: row; flex-wrap: wrap; align-items: center; border-right: 0; border-bottom: 2px dashed var(--kk-ink); }
    .stub__side::before, .stub__side::after { display: none; }
    .stub__dots { margin: 0 0 0 auto; }
  }
</style>
