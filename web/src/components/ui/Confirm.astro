---
/** [CONFIRM] marker (v1 0.4, v2 7.7): staging only, a hazard-tape pill (Saffron/Ink 45° stripes) with Ink-on-Butter
 * text "CONFIRM n". Nothing in production. */
import { isStaging } from '@/lib/mode';
interface Props { id: number | string; note?: string; }
const { id, note } = Astro.props;
---
{isStaging && <span class="confirm" data-confirm-id={id}><span class="confirm__txt">CONFIRM {id}{note && `: ${note}`}</span></span>}
<style>
  .confirm {
    display: inline-flex; align-items: center; vertical-align: middle;
    margin-inline: 4px; padding: 3px; border-radius: var(--r-pill);
    background: repeating-linear-gradient(45deg, var(--kk-saffron) 0 6px, var(--kk-ink) 6px 12px);
    font-style: normal; text-transform: none; white-space: normal;
  }
  .confirm__txt {
    display: inline-block; padding: 1px 8px; border-radius: var(--r-pill);
    background: var(--kk-butter); color: var(--kk-ink);
    font-family: var(--font-mono); font-size: 11px; font-weight: 500; line-height: 16px; letter-spacing: .04em;
  }
</style>
