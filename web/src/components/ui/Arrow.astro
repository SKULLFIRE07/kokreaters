---
/** The site's only arrow (v1 0.2.9: the → glyph is not in the font subsets). `hand` → the hand-drawn arrow-straight
 * doodle (v2 7.7). */
interface Props { size?: number; class?: string; hand?: boolean; }
const { size = 16, class: cls, hand = false } = Astro.props;
---
{hand ? (
  <svg class:list={['arrow', 'arrow--hand', cls]} width={Math.round(size * 1.5)} height={size} viewBox="0 0 120 30" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 16 C 40 13, 78 18, 108 14" /><path d="M92 4 L 110 14 L 93 25" /></svg>
) : (
  <svg class:list={['arrow', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
)}
<style>
  .arrow { flex: none; display: inline-block; vertical-align: middle; overflow: visible; }
</style>
