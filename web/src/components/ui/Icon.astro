---
/**
 * UI icon (REDESIGN-V3 §2, §3). Lucide (lucide-static, ISC) inlined at build time: the file's outer <svg> is stripped
 * and its paths are set inside one consistent 24-unit <svg> (stroke currentColor, round caps/joins, stroke 1.75).
 * Zero runtime JS. Lucide has no LinkedIn mark, so `linkedin` is a hand-drawn "in" square in the same stroke style.
 * Decorative (aria-hidden) unless `label` is passed, then role="img" + aria-label.
 * Mobile: none; the box is `size` px everywhere (default 24).
 */
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import chevronDown from 'lucide-static/icons/chevron-down.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
import minus from 'lucide-static/icons/minus.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import messageCircle from 'lucide-static/icons/message-circle.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import download from 'lucide-static/icons/download.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import externalLink from 'lucide-static/icons/external-link.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import search from 'lucide-static/icons/search.svg?raw';
import circleAlert from 'lucide-static/icons/circle-alert.svg?raw';
import circleCheck from 'lucide-static/icons/circle-check.svg?raw';

export type IconName =
  | 'arrow-right' | 'arrow-up-right' | 'arrow-left' | 'chevron-down' | 'chevron-right' | 'menu' | 'close' | 'plus' | 'minus'
  | 'linkedin' | 'mail' | 'whatsapp' | 'phone' | 'download' | 'calendar' | 'check' | 'external' | 'clock' | 'pin'
  | 'search' | 'error' | 'success';

interface Props {
  name: IconName;
  size?: number;
  /** Stroke width in 24-unit space (default 1.75). */
  stroke?: number;
  label?: string;
  class?: string;
  [key: string]: unknown;
}
const { name, size = 24, stroke = 1.75, label, class: cls, ...rest } = Astro.props;

const inner = (raw: string) =>
  raw.replace(/<!--[\s\S]*?-->/g, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/\s+/g, ' ').trim();

const LINKEDIN = '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M8 10.5V16"/><path d="M8 7.5v.01"/><path d="M12 16v-5.5"/><path d="M12 13a2.5 2.5 0 0 1 5 0v3"/>';

const raw: Record<string, string> = {
  'arrow-right': arrowRight, 'arrow-up-right': arrowUpRight, 'arrow-left': arrowLeft,
  'chevron-down': chevronDown, 'chevron-right': chevronRight, menu, close: x, plus, minus, mail, whatsapp: messageCircle,
  phone, download, calendar, check, external: externalLink, clock, pin: mapPin, search, error: circleAlert,
  success: circleCheck,
};
const key = name;
const body = key === 'linkedin' ? LINKEDIN : inner(raw[key] ?? raw['arrow-right']);
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
<svg
  class:list={['icon', `icon--${key}`, cls]}
  width={size} height={size} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"
  focusable="false" {...a11y} {...rest}
  set:html={body}
/>
<style>
  .icon { flex: none; display: inline-block; vertical-align: middle; overflow: visible; }
</style>
