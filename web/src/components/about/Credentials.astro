---
/**
 * About · education, languages and recognition (REDESIGN-V3 §4 About, section 6). White band, aria-labelledby="edu-title".
 * SectionHeader, then three tidy columns, each with a 2px navy top rule and a serif h3:
 *  Education   — the four items split at the last comma into qualification (body) and institution (meta).
 *  Languages   — the five items split at the bracket into language (body) and level (meta).
 *  Recognition — "WHO" in the serif figure style (the band's one accent), the trans-fat sentence assembled from
 *                impact.ts `tfa` (done + result, no new words), its source line, and "See the impact".
 * Lists use hairlines between rows (≥ 48px rows). Every string comes from founder.ts / impact.ts / microcopy.ts.
 * ≥ 900px: 4 / 4 / 4 columns of the 12-column grid. 600–899px: education full width (two inner columns), languages and
 * recognition side by side. Mobile (< 600px): one column, 48px between groups.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { education, languages, educationLabel, languagesLabel, aboutPage } from '@/data/founder';
import { founderResults, figureFallback, impactPage } from '@/data/impact';
import { microcopy } from '@/data/microcopy';

/** "Degree in Chemistry, University of Pune" → ["Degree in Chemistry", "University of Pune"] */
const splitLast = (s: string): [string, string] => {
  const i = s.lastIndexOf(', ');
  return i < 0 ? [s, ''] : [s.slice(0, i), s.slice(i + 2)];
};
/** "Bahasa Indonesia (conversational)" → ["Bahasa Indonesia", "Conversational"] */
const splitLevel = (s: string): [string, string] => {
  const m = s.match(/^(.*?)\s*\((.+)\)$/);
  return m ? [m[1], m[2].charAt(0).toUpperCase() + m[2].slice(1)] : [s, ''];
};
const tfa = founderResults.find((r) => r.id === 'tfa');
const recognition = tfa && tfa.done && tfa.result
  ? `${tfa.done.replace(/\.$/, '')}, ${tfa.result.charAt(0).toLowerCase()}${tfa.result.slice(1)}`
  : null;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Keep hyphenated compounds whole ("Director-General" never breaks at its hyphen in the narrow column). */
const recognitionHtml = recognition ? esc(recognition).replace(/(\S+-\S+)/g, '<span class="nowrap">$1</span>') : '';
---
<Section ground="white" labelledby="edu-title" class="cred">
  <SectionHeader id="edu-title" title={aboutPage.credentialsHeading} />
  <div class="cred__cols">
    <div class="cred__col cred__col--edu">
      <span class="cred__rule" aria-hidden="true" data-gsap="rule"></span>
      <h3 id="edu-h-education" class="cred__h">{educationLabel}</h3>
      <ul class="cred__list" role="list">
        {education.map((e) => { const [what, where] = splitLast(e); return (
          <li class="cred__item"><span class="cred__main">{what}</span>{where && <span class="cred__meta">{where}</span>}</li>
        ); })}
      </ul>
    </div>
    <div class="cred__col">
      <span class="cred__rule" aria-hidden="true" data-gsap="rule"></span>
      <h3 id="edu-h-languages" class="cred__h">{languagesLabel}</h3>
      <ul class="cred__list" role="list">
        {languages.map((l) => { const [lang, level] = splitLevel(l); return (
          <li class="cred__item"><span class="cred__main">{lang}</span>{level && <span class="cred__meta">{level}</span>}</li>
        ); })}
      </ul>
    </div>
    {tfa && recognition && (
      <div class="cred__col cred__col--lead">
        <span class="cred__rule" aria-hidden="true" data-gsap="rule"></span>
        <h3 id="edu-h-recognition" class="cred__h">{aboutPage.recognitionLabel}</h3>
        <div class="cred__award">
          <p class="cred__figure t-stat">{figureFallback.tfa}</p>
          <p class="cred__text" set:html={recognitionHtml} />
          <p class="cred__source">{impactPage.partOne} ({tfa.dateline})</p>
          <ArrowLink href="/impact" class="cred__link">{microcopy.impactLink}</ArrowLink>
        </div>
      </div>
    )}
  </div>
</Section>
<style>
  .cred__cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7) var(--grid-gap); }
  .cred__col { position: relative; padding-top: var(--s-5); }
  .cred__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--rule); transform-origin: left center; }
  .cred__col--lead .cred__rule { height: 3px; background: var(--saffron); }
  .cred__h { margin: 0 0 var(--s-4); font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.25; font-weight: 400; }
  .cred__list { list-style: none; margin: 0; padding: 0; }
  .cred__item {
    display: flex; flex-direction: column; justify-content: flex-start; gap: 2px; min-height: 48px;
    padding-block: var(--s-3); border-bottom: 1px solid var(--rule);
  }
  .cred__item:last-child { border-bottom: 0; }
  .cred__main { font-size: var(--fs-body); line-height: 1.4; font-weight: 600; color: var(--head); }
  .cred__meta { font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }

  .cred__award { padding-top: var(--s-3); }
  .cred__figure { margin: 0; color: var(--head); }
  .cred__text { margin: var(--s-4) 0 0; max-width: 34ch; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2); text-wrap: pretty; }
  .cred__source { margin: var(--s-3) 0 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  :global(.cred__link) { margin-top: var(--s-3); }

  @media (min-width: 600px) and (max-width: 899px) {
    .cred__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cred__col--edu { grid-column: 1 / -1; }
    .cred__col--edu .cred__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .cred__col--edu .cred__item:nth-last-child(2) { border-bottom: 0; }
  }
  @media (min-width: 900px) {
    .cred__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
