---
/** Folio row: full-width 1px rule, left dateline `{n} · {label}`, right running head (hidden on mobile). */
interface Props { n?: string; label: string; right?: string; class?: string; }
const { n, label, right, class: cls } = Astro.props;
---
<div class:list={['folio', cls]}>
  <div class="folio__rule rule" data-rule aria-hidden="true"></div>
  <div class="folio__row">
    <p class="t-dateline folio__label">{n ? <><span class="tnum">{n}</span> · {label}</> : label}</p>
    {right && <p class="t-meta folio__right" aria-hidden="true">{right}</p>}
  </div>
</div>
<style>
  .folio { margin-bottom: var(--s-8); }
  .folio__row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); padding-top: var(--s-3); }
  .folio__label, .folio__right { margin: 0; }
  .folio__right { display: none; }
  @media (min-width: 768px) { .folio__right { display: block; } }
  :global(.on-dark) .folio__right { color: var(--c-on-dark-muted); }
</style>
