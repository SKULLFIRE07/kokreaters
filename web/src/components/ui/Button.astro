---
/**
 * Button / button-link (v4 developer guide). Renders <a> when `href`, else <button>. Square corners, no shadows,
 * Manrope 700 15px, 15–16px vertical padding, sentence case; hover darkens (colour only).
 *  primary        — fill --btn-bg / text --btn-fg: Deep Delft on light grounds, white on navy, saffron on Deep Delft.
 *  secondary      — 1.5px outline in --fg (Deep Delft-on-light reads as --link), transparent; hover: faint fill.
 *  tertiary       — text link in --link + arrow; underline draws on hover, arrow nudges 4px; 44px tap height.
 *  on-dark        — white fill, navy text (over photos / navy). ghost-on-dark — white outline, white text.
 *  saffron        — saffron fill, navy text: the one main CTA per page (CtaBand uses it).
 * `full` = width 100%. The .btn classes are global so forms and scripts can reuse them.
 * Mobile: same metrics (≥ 48px tap target); long labels wrap inside the button instead of overflowing.
 * v2 props still compile: variant ground → primary, hand → secondary, size sm → md, `arrow` → icon="arrow";
 * `magnetic` is ignored.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'tertiary' | 'on-dark' | 'ghost-on-dark' | 'saffron';
type IconKey = 'arrow' | 'external' | 'download' | 'calendar';
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: Variant | 'ground' | 'hand';
  size?: 'md' | 'lg' | 'sm';
  icon?: IconKey | null;
  full?: boolean;
  disabled?: boolean;
  loading?: boolean;
  /** v2 */ arrow?: boolean;
  /** v2, ignored */ magnetic?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  href, type = 'button', variant: v = 'primary', size: s = 'md', icon: iconProp, full = false,
  disabled = false, loading = false, arrow, magnetic: _magnetic, class: cls, ...rest
} = Astro.props;

const variant: Variant = v === 'secondary' || v === 'tertiary' || v === 'on-dark' || v === 'ghost-on-dark' || v === 'saffron' ? v : v === 'hand' ? 'secondary' : 'primary';
const size = s === 'lg' ? 'lg' : 'md';
const icon: IconKey | null = iconProp !== undefined ? iconProp : arrow || variant === 'tertiary' ? 'arrow' : null;
const iconName = icon === 'arrow' ? 'arrow-right' : icon === 'external' ? 'arrow-up-right' : icon;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, full && 'btn--full', cls];
---
{href ? (
  <a
    href={disabled ? undefined : href}
    class:list={classes}
    aria-disabled={disabled ? 'true' : undefined}
    role={disabled ? 'link' : undefined}
    aria-busy={loading ? 'true' : undefined}
    {...(rest as HTMLAttributes<'a'>)}
  >
    <span class="btn__label"><slot /></span>
    {iconName && <Icon name={iconName} size={18} stroke={2} class="btn__icon u-nudge" />}
  </a>
) : (
  <button type={type} class:list={classes} disabled={disabled} aria-busy={loading ? 'true' : undefined} {...(rest as HTMLAttributes<'button'>)}>
    <span class="btn__label"><slot /></span>
    {iconName && <Icon name={iconName} size={18} stroke={2} class="btn__icon u-nudge" />}
    <span class="btn__spinner" aria-hidden="true"></span>
  </button>
)}
<style is:global>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 52px; padding: 14px 28px;
    border: 1.5px solid transparent; border-radius: 0;
    font-family: var(--font-sans); font-size: var(--fs-button); font-weight: 700; line-height: 1.25;
    letter-spacing: var(--tr-button); text-align: center; text-decoration: none;
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: background-color var(--d-1) var(--ease-out), border-color var(--d-1) var(--ease-out), color var(--d-1) var(--ease-out);
  }
  .btn--lg { min-height: 56px; padding-inline: 32px; font-size: 1rem; }
  .btn--full { display: flex; width: 100%; }
  .btn__label { min-width: 0; }
  .btn__icon { margin-right: -2px; }
  .btn:hover { text-decoration: none; }

  .btn--primary { background: var(--btn-bg); color: var(--btn-fg); border-color: var(--btn-bg); }
  .btn--primary:is(:hover, .is-hover) { background: var(--btn-bg-hover); border-color: var(--btn-bg-hover); color: var(--btn-fg); }

  .btn--secondary { background: transparent; color: var(--link); border-color: var(--link); }
  .btn--secondary:is(:hover, .is-hover) { background: color-mix(in srgb, var(--link) 7%, transparent); color: var(--head); border-color: var(--head); }

  .btn--on-dark { background: var(--white); color: var(--navy-900); border-color: var(--white); }
  .btn--on-dark:is(:hover, .is-hover) { background: var(--ice); border-color: var(--ice); color: var(--navy-900); }
  .btn--ghost-on-dark { background: transparent; color: var(--white); border-color: rgba(255, 255, 255, .7); }
  .btn--ghost-on-dark:is(:hover, .is-hover) { background: rgba(255, 255, 255, .1); border-color: var(--white); color: var(--white); }
  .btn--saffron { background: var(--saffron); color: var(--navy-900); border-color: var(--saffron); font-weight: 800; }
  .btn--saffron:is(:hover, .is-hover) { background: #D9962A; border-color: #D9962A; color: var(--navy-900); }

  .btn--tertiary {
    min-height: 44px; padding: 0; gap: 8px; border: 0; border-radius: 0; font-size: var(--fs-button);
    background: none; color: var(--link); justify-content: flex-start;
  }
  .btn--tertiary .btn__icon { color: var(--accent); }
  .btn--tertiary .btn__label { background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1px no-repeat; padding-bottom: 2px; transition: background-size var(--d-2) var(--ease-out); }
  .btn--tertiary:is(:hover, .is-hover) .btn__label { background-size: 100% 1px; }
  .btn--tertiary.btn--lg { min-height: 48px; font-size: var(--fs-lead); }

  .btn.is-focus { outline: 2px solid var(--focus); outline-offset: 3px; }   /* styleguide state preview */
  .btn--tertiary.is-hover .btn__icon { transform: translateX(4px); }
  .btn:disabled, .btn[aria-disabled="true"] { opacity: .42; cursor: not-allowed; pointer-events: none; }
  .btn__spinner { display: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; }
  .btn[aria-busy="true"] .btn__spinner { display: inline-block; animation: btn-spin 800ms linear infinite; }
  .btn[aria-busy="true"] .btn__icon { display: none; }
  @keyframes btn-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .btn[aria-busy="true"] .btn__spinner { animation-duration: 2.4s; } }
</style>
