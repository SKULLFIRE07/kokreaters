---
/**
 * Home 2 · Credibility strip (REDESIGN-V3 §4 Home 2, §9.3; McKinsey India "Our impact" pattern). White band at full
 * section padding so the big figures (StatStrip, 52 → 96px, count-up) get the air of a statement, not a footnote.
 * ≥ 900px: a quiet label row (the section's h2 "Our track record" on the left, the source "From our founder’s career."
 *  on the right, both small and grey), then the full-width StatStrip: four figures, each opening on a hairline.
 * Mobile (< 900px): label → StatStrip in its own 2 × 2 phone grid → source line under it.
 */
import Section from '@/components/ui/Section.astro';
import StatStrip from '@/components/ui/StatStrip.astro';
import { proof, proofSource, homeLabels } from '@/data/home';

const items = proof.map((p) => ({ value: p.value, label: p.label }));
---
<Section ground="white" labelledby="proof-heading" class="hp">
  <div class="hp__grid">
    <h2 id="proof-heading" class="hp__label t-label" data-reveal>{homeLabels.proof}</h2>
    <p class="hp__source" data-reveal style="--i:1">{proofSource}.</p>
    <StatStrip items={items} class="hp__stats" />
  </div>
</Section>

<style>
  .hp__grid { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "label" "stats" "source"; }
  .hp__label { grid-area: label; margin: 0 0 var(--s-6); color: var(--label); }
  .hp__grid :global(.hp__stats) { grid-area: stats; }
  .hp__source { grid-area: source; margin-top: var(--s-5); font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }

  @media (min-width: 900px) {
    .hp__grid {
      grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "label source" "stats stats";
      align-items: baseline; column-gap: var(--s-7);
    }
    .hp__label { margin-bottom: clamp(3rem, 1.5rem + 3vw, 5rem); }
    .hp__source { margin: 0; }
  }
</style>
