---
/**
 * Cookie consent (REDESIGN-V3 §3 chrome; DESIGN-SPEC 3.6, C-6). Renders only when PUBLIC_ANALYTICS=1: a quiet bar
 * (bottom-left card on desktop, full-width sheet edge on phones) asking once, plus the settings <dialog> that the
 * footer's "Cookie settings" button opens. With analytics off the site sets no non-essential cookies, so neither the
 * bar, the dialog nor the footer button exist. Plausible (PUBLIC_PLAUSIBLE_DOMAIN) is cookie-free and needs no banner.
 * Pack 3 (brief "Privacy, Cookies, Terms"): "Reject all" is exactly as prominent as "Accept all": same style, same
 * size, side by side (Reject first, so it is never the weaker option). Behaviour: src/scripts/consent.ts.
 */
import { microcopy } from '@/data/microcopy';
import { site } from '@/config/site';
---
{site.analytics && (
  <>
    <dialog id="cookie-settings" class="cookie-dialog" aria-labelledby="cookie-settings-title">
      <form method="dialog" class="cookie-dialog__body">
        <h2 id="cookie-settings-title" class="cookie-dialog__title">{microcopy.cookieSettings}</h2>
        <div class="cookie-dialog__row">
          <input id="consent-essential" type="checkbox" checked disabled />
          <label for="consent-essential">{microcopy.essentialOn}</label>
        </div>
        <div class="cookie-dialog__row">
          <input id="consent-analytics" type="checkbox" data-consent-analytics />
          <label for="consent-analytics">Analytics</label>
        </div>
        <p class="cookie-dialog__more"><a href="/cookies">Cookies</a></p>
        <div class="cookie-dialog__actions">
          <button type="submit" class="btn btn--primary btn--md" data-dialog-close>{microcopy.close}</button>
        </div>
      </form>
    </dialog>

    <section class="cookie-bar" role="region" aria-label="Cookie consent" data-cookie-bar hidden>
      <p class="cookie-bar__text">{microcopy.cookieBanner}</p>
      <div class="cookie-bar__actions">
        <button type="button" class="btn btn--primary btn--md" data-consent-reject>{microcopy.cookieReject}</button>
        <button type="button" class="btn btn--primary btn--md" data-consent-accept>{microcopy.cookieAccept}</button>
      </div>
      <button type="button" class="btn btn--tertiary btn--md cookie-bar__settings" data-consent-settings aria-haspopup="dialog" aria-controls="cookie-settings">{microcopy.cookieSettingsButton}</button>
    </section>
  </>
)}

<style>
  .cookie-dialog {
    width: min(440px, calc(100vw - 2 * var(--gutter-x)));
    margin: auto; padding: 0;
    border: 1px solid var(--grey-200); border-radius: var(--r-sm);
    background: var(--white); color: var(--ink);
    box-shadow: var(--shadow-panel);
  }
  .cookie-dialog::backdrop { background: rgb(11 27 51 / .32); }
  .cookie-dialog__body { display: grid; padding: var(--s-6); }
  .cookie-dialog__title { margin: 0 0 var(--s-4); font-size: var(--fs-h3); line-height: var(--lh-h3); }
  .cookie-dialog__row { display: flex; align-items: center; gap: var(--s-3); min-height: 52px; border-top: 1px solid var(--grey-200); }
  .cookie-dialog__row input { width: 20px; height: 20px; margin: 0; accent-color: var(--navy-900); flex: none; }
  .cookie-dialog__row label { font-size: var(--fs-small); }
  .cookie-dialog__row input:disabled + label { color: var(--ink-2); }
  .cookie-dialog__more { margin: var(--s-2) 0 var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--grey-200); font-size: var(--fs-meta); }
  .cookie-dialog__actions { display: flex; justify-content: flex-end; }

  .cookie-bar {
    --bg: var(--white); --fg: var(--ink); --fg-2: var(--ink-2); --link: var(--blue-700); --btn-bg: var(--navy-900); --btn-fg: var(--white);
    position: fixed; left: var(--s-4); right: var(--s-4); bottom: var(--s-4); z-index: 70;
    max-width: 440px; max-height: 50vh; overflow-y: auto;
    padding: var(--s-5);
    border: 1px solid var(--grey-200); border-radius: var(--r-sm);
    background: var(--white); color: var(--ink); box-shadow: var(--shadow-panel);
  }
  .cookie-bar__text { margin: 0 0 var(--s-4); font-size: var(--fs-small); line-height: var(--lh-small); }
  .cookie-bar__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .cookie-bar__actions :global(.btn) { padding-inline: var(--s-4); }
  .cookie-bar :global(.cookie-bar__settings) { margin-top: var(--s-2); }
</style>
