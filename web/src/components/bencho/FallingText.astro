---
/**
 * FallingText (DESIGN-SPEC v2 9 + 10.12): the 404 H1's words (plus a ringed node tile) fall into a 520×300 pit as
 * colour tiles on the six pillar grounds, pile up, and can be grabbed and thrown. Port of the Bencho "falling-text"
 * block to vanilla TS on the FOUNDATION physics helper (scripts/bencho/physics.ts).
 *
 * MIT License · Copyright (c) 2026 Lorenzo Cabra (bencho.dev). Permission is hereby granted, free of charge, to any
 * person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the
 * Software without restriction, subject to the following condition: the above copyright notice and this permission
 * notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS",
 * WITHOUT WARRANTY OF ANY KIND. Full text: web/THIRD_PARTY_NOTICES.md.
 *
 * Decorative: the H1 stays real, static text above; the pit is aria-hidden. Static state (no JS / reduced motion):
 * the tiles lie piled at the bottom of the pit (flex, slight tilts).
 */
import type { GroundKey } from '@/data/types';
import { pillars } from '@/data/pillars';
import { pillarGround } from '@/lib/pillars';
interface Props { text: string }
const { text } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
const grounds: GroundKey[] = pillars.map((p) => pillarGround(p.key));
const tilts = [-6, 4, -2, 7, -5, 3, -8, 5];
---
<div class="pit" aria-hidden="true" data-falling-text data-cursor="throw">
  <div class="pit__floor">
    {words.map((w, i) => (
      <span class:list={['pit__tile', `g-${grounds[i % grounds.length]}`]} style={`--tilt:${tilts[i % tilts.length]}deg`} data-tile>{w}</span>
    ))}
    <span class="pit__tile pit__tile--node g-white" style="--tilt:0deg" data-tile><span class="pit__ring"><span class="pit__dot"></span></span></span>
  </div>
</div>
<style>
  .pit { position: relative; width: min(100%, 520px); height: 300px; border: 2px solid var(--kk-ink); border-radius: 28px; background: var(--kk-white); overflow: hidden; touch-action: pan-y; box-shadow: var(--shadow-hard); user-select: none; }
  .pit__floor { position: absolute; inset: 0; display: flex; flex-wrap: wrap-reverse; align-content: flex-start; align-items: flex-end; justify-content: center; gap: 4px 6px; padding: 14px; }
  .pit__tile { display: inline-flex; align-items: center; justify-content: center; height: 58px; padding: 0 22px; border-radius: 999px; border: 2px solid var(--kk-ink);
    font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: 30px; line-height: 1; letter-spacing: -0.01em; white-space: nowrap; rotate: var(--tilt); cursor: grab; }
  .pit__tile--node { width: 58px; padding: 0; }
  .pit__ring { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; box-shadow: inset 0 0 0 3px var(--kk-ink); }
  .pit__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--kk-saffron); box-shadow: 0 0 0 2px var(--kk-ink); }
  .pit.is-live .pit__floor { display: block; padding: 0; }
  .pit.is-live .pit__tile { position: absolute; left: 0; top: 0; rotate: none; will-change: transform; }
  .pit.is-live .pit__tile:active { cursor: grabbing; }
  @media (max-width: 479px) { .pit { height: 260px; } .pit__tile { height: 48px; font-size: 24px; padding: 0 16px; } .pit__tile--node { width: 48px; } }
</style>
