---
/**
 * Result card (REDESIGN-V3 §3). Eyebrow (e.g. "India · Wilmar") → big serif figure in --accent (blue-500 on light,
 * blue-300 on navy) → serif title → optional body → optional tags. On navy: navy-800 surface, white text. On light:
 * white surface with a hairline. With `href` the title link is stretched over the card and an arrow sits bottom-right.
 * Text passes through untouched, so −25 °C (U+2212, U+202F) keeps its house form; figures never break across lines.
 * Mobile: full-width card, 24px padding, figure 44px.
 */
import Tag from '@/components/ui/Tag.astro';
import Icon from '@/components/ui/Icon.astro';
interface Props {
  eyebrow: string;
  figure?: string;
  title: string;
  body?: string;
  href?: string;
  tags?: string[];
  level?: 2 | 3 | 4;
  class?: string;
}
const { eyebrow, figure, title, body, href, tags = [], level = 3, class: cls } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---
<article class:list={['rcard', href && 'rcard--link', 'u-hover', cls]}>
  <p class="rcard__eyebrow t-label">{eyebrow}</p>
  {figure && <p class="rcard__figure">{figure}</p>}
  <H class="rcard__title">{href ? <a href={href} class="rcard__a">{title}</a> : title}</H>
  {body && <p class="rcard__body">{body}</p>}
  {(tags.length > 0 || href) && (
    <div class="rcard__foot">
      {tags.length > 0 && <ul class="rcard__tags" role="list">{tags.map((t) => <li><Tag size="sm">{t}</Tag></li>)}</ul>}
      {href && <Icon name="arrow-right" size={20} stroke={1.75} class="rcard__arrow u-nudge" />}
    </div>
  )}
</article>
<style>
  .rcard {
    position: relative; display: flex; flex-direction: column; height: 100%;
    padding: var(--s-5); background: var(--surface); border: 1px solid var(--rule);
    transition: background-color var(--d-2) var(--ease-out), border-color var(--d-2) var(--ease-out);
  }
  :global(.band--navy) .rcard { border-color: transparent; }
  .rcard__eyebrow { color: var(--label); }
  .rcard__figure {
    margin-top: var(--s-5);
    font-family: var(--font-serif); font-optical-sizing: auto; font-size: clamp(2.75rem, 2.379rem + 1.524vw, 3.75rem);
    line-height: 1; font-weight: 380; letter-spacing: -0.02em; color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums; white-space: nowrap;
  }
  .rcard__title {
    margin-top: var(--s-5);
    font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-h4); line-height: 1.35;
    font-weight: 440; color: var(--head); text-wrap: pretty;
  }
  .rcard__figure + .rcard__title { margin-top: var(--s-4); }
  .rcard__a { color: inherit; text-decoration: none; transition: color var(--d-1) var(--ease-out); }
  .rcard__a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .rcard__a:focus-visible { outline: none; }
  .rcard:has(.rcard__a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 4px; }
  .rcard--link:hover { background: var(--surface-hover); }
  .rcard--link:hover .rcard__a { color: var(--link); }
  .rcard__body { margin-top: var(--s-3); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg-2); text-wrap: pretty; }
  .rcard__foot { margin-top: auto; padding-top: var(--s-5); display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-4); }
  .rcard__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .rcard__arrow { color: var(--accent); margin-left: auto; }
  @media (min-width: 900px) { .rcard { padding: var(--s-6) var(--s-5) var(--s-5); } }
</style>
