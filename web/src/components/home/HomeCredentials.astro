---
/**
 * Home 6 · Credentials strip and one testimonial (pack 3 points 4–5; earlier item 25: Education · Executive education ·
 * Memberships · Recognition). One quiet Delft Ice band, text only, no third-party logos: the confirmed groups from
 * career.ts `credentials` as columns on hairlines. Groups still to be supplied (memberships, talks and publications)
 * render only in staging, as CONFIRM slots. Then one testimonial: the first confirmed quote from about.ts
 * (PEOPLE-CONTENT's testimonials list, permission required) — or, while there is none, a CONFIRM slot in staging and
 * nothing at all in preview and production.
 * Mobile: one column (two from 600px; one row of all confirmed groups from 1000px).
 */
import Confirm from '@/components/ui/Confirm.astro';
import { credentialsBand } from '@/data/home';
import { credentials } from '@/data/career';
import { testimonials } from '@/data/about';
import { showConfirm } from '@/lib/mode';

const groups = credentials.filter((g) => g.status === 'confirmed' ? g.items.length > 0 : showConfirm);
const quote = testimonials.items[0];
---
<section id="credentials" class="hc band band--ice" aria-labelledby="hc-heading">
  <div class="container">
    <h2 id="hc-heading" class="t-label hc__label">{credentialsBand.label}</h2>
    <ul class="hc__grid" role="list" style={`--cols:${Math.min(groups.length, 5)}`}>
      {groups.map((g) => (
        <li class="hc__col">
          <h3 class="hc__head">{g.heading}</h3>
          {g.items.length > 0 ? (
            <ul class="hc__list" role="list">
              {g.items.map((it) => <li><span class="hc__main">{it.main}</span>{it.meta && <span class="hc__meta">{it.meta}</span>}</li>)}
            </ul>
          ) : <Confirm id="P-11" note={g.confirm} />}
        </li>
      ))}
    </ul>
    {quote ? (
      <figure class="hc__quote">
        <blockquote><p>“{quote.quote}”</p></blockquote>
        <figcaption><span class="hc__qname">{quote.name}</span> {[quote.role, quote.company].filter(Boolean).join(', ')}</figcaption>
      </figure>
    ) : showConfirm && (
      <p class="hc__slot"><Confirm id="P-12" note={credentialsBand.testimonialConfirm} /></p>
    )}
  </div>
</section>

<style>
  .hc { --_pad: clamp(2.5rem, 1.8rem + 2vw, 4rem); }
  .hc__label { margin: 0 0 28px; }
  .hc__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .hc__col { padding-top: 18px; border-top: 1px solid rgba(14, 31, 77, .2); }
  .hc__col:first-child { border-top: 3px solid var(--saffron); padding-top: 16px; }
  .hc__head { margin: 0 0 12px; font: 700 1rem/1.3 var(--font-sans); color: var(--navy-900); }
  .hc__list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .hc__list li { display: flex; flex-direction: column; }
  .hc__main { font-size: 1rem; font-weight: 600; line-height: 1.4; color: var(--navy-900); }
  .hc__meta { font-size: .9375rem; line-height: 1.45; color: var(--fg-2); }
  .hc__quote { margin: clamp(36px, 2vw + 24px, 56px) 0 0; max-width: 820px; }
  .hc__quote blockquote { margin: 0; }
  .hc__quote p { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: var(--fs-quote); line-height: 1.3; color: var(--navy-900); text-indent: -.4em; }
  .hc__quote figcaption { margin-top: 14px; font-size: .9375rem; color: var(--fg-2); }
  .hc__qname { font-weight: 700; color: var(--navy-900); }
  .hc__slot { margin: 32px 0 0; }
  @media (min-width: 600px) { .hc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .hc__grid { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); } }
</style>
