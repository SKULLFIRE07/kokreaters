---
/**
 * [CONFIRM] marker for open client questions (REDESIGN-V3 §3, §6). Renders ONLY when `showConfirm` (staging);
 * nothing at all in preview or production. Quiet dashed-outline tag in --fg-2, Inter 11px caps, inline.
 * Mobile: inline, wraps with the text it annotates.
 */
import { showConfirm } from '@/lib/mode';
interface Props { id: number | string; note?: string; }
const { id, note } = Astro.props;
---
{showConfirm && <span class="confirm" data-confirm-id={id}>CONFIRM {id}{note && `: ${note}`}</span>}
<style>
  .confirm {
    display: inline-flex; align-items: center; vertical-align: middle;
    margin-inline: 4px; padding: 1px 6px;
    border: 1px dashed currentColor; border-radius: var(--r-sm);
    font-family: var(--font-sans); font-size: 11px; font-weight: 600; font-style: normal; line-height: 18px;
    letter-spacing: .06em; text-transform: none; white-space: normal;
    color: var(--fg-2);
  }
</style>
