---
/**
 * Key takeaways (REDESIGN-V3 §4 article). MDX: <Takeaways items={[…]} /> placed at the top of the body, so it is the
 * first thing under the hero image. A grey panel (role tokens of .band--grey) with a 2px navy top rule, a serif h2
 * "Key takeaways" and the points as the foundation NumberedList ("01" accent numerals, hairlines).
 * Mobile (< 600px): the panel bleeds to the screen edges, its text aligned with the column (20px gutter), so each point
 * keeps a readable line; NumberedList density="tight" (16px rows, 40px numerals) keeps the panel short.
 */
import NumberedList from '@/components/ui/NumberedList.astro';
import { microcopy } from '@/data/microcopy';
interface Props { items: string[]; }
const { items } = Astro.props;
---
<aside class="takeaways band--grey" aria-labelledby="takeaways-t">
  <h2 id="takeaways-t" class="takeaways__title">{microcopy.keyTakeaways}</h2>
  <NumberedList items={items} density="tight" class="takeaways__list" />
</aside>
<style>
  .takeaways {
    background: var(--bg); color: var(--fg);
    border-top: 2px solid var(--rule-strong);
    padding: var(--s-5) var(--s-5) var(--s-3);
  }
  .takeaways__title {
    margin: 0 0 var(--s-4);
    font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-h4); line-height: var(--lh-h4);
    font-weight: 560; letter-spacing: 0; color: var(--head);
  }
  /* phones: the panel runs to the screen edges (text aligned with the column), so the points get the full measure */
  @media (max-width: 599px) {
    .takeaways { margin-inline: calc(-1 * var(--gutter-x)); padding-inline: var(--gutter-x); }
  }
  @media (min-width: 600px) { .takeaways { padding: var(--s-6) var(--s-6) var(--s-4); } }
</style>
