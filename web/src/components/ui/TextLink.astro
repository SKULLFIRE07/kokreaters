---
/** TextLink (DESIGN-SPEC v2 7.7): Bricolage 650 17px in --link + Arrow; hover/focus draws a hand underline (300ms)
 * and nudges the arrow. */
import Arrow from './Arrow.astro';
import type { HTMLAttributes } from 'astro/types';
interface Props { href: string; arrow?: boolean; class?: string; [key: string]: unknown; }
const { href, arrow = true, class: cls, ...rest } = Astro.props;
---
<a href={href} class:list={['text-link', cls]} {...rest as HTMLAttributes<'a'>}>
  <span class="text-link__label"><slot /><svg class="text-link__line" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 13 C 60 8, 140 15, 200 10 S 280 9, 297 12" /></svg></span>
  {arrow && <Arrow size={18} class="text-link__arrow" />}
</a>
<style>
  .text-link {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding-block: 12px; min-height: 44px;
    color: var(--link); font-family: var(--font-display); font-weight: 650; font-stretch: 95%; font-size: 1.0625rem;
    text-decoration: none;
  }
  .text-link:hover { color: var(--link); }
  .text-link__label { position: relative; display: inline-block; }
  .text-link__line {
    position: absolute; left: -2%; width: 104%; bottom: -.32em; height: .34em; overflow: visible;
    fill: none; stroke: currentColor; stroke-width: 2.5px; stroke-linecap: round;
    clip-path: inset(-50% 101% -50% 0);
    transition: clip-path 300ms var(--ease-quart);
  }
  .text-link__line path { vector-effect: non-scaling-stroke; }
  .text-link:is(:hover, :focus-visible) .text-link__line { clip-path: inset(-50% -4% -50% -4%); }
  .text-link :global(.text-link__arrow) { transition: transform 300ms var(--ease-expo); }
  .text-link:is(:hover, :focus-visible) :global(.text-link__arrow) { transform: translateX(5px); }
  @media (prefers-reduced-motion: reduce) {
    .text-link__line, .text-link :global(.text-link__arrow) { transition: none; }
  }
</style>
