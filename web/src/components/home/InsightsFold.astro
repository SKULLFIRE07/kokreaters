---
/**
 * F9 · Insights (DESIGN-SPEC v2 10.1). White. Notebook tab + h2 (R1). A native rail (not pinned) of CoverStory cards for
 * the newest visible entries (≤ 4), then up to three "In preparation" cards (dashed border, mono label, title, unlinked).
 * Newsletter strip with the "no noise, really" note. Production with nothing approved: h2 + In-preparation + newsletter.
 */
import Section from '@/components/ui/Section.astro';
import Rail from '@/components/shared/Rail.astro';
import CoverStory from '@/components/shared/CoverStory.astro';
import Newsletter from '@/components/shared/Newsletter.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import { insights as fold } from '@/data/home';
import { microcopy } from '@/data/microcopy';
import { homeNotes } from '@/data/notes/home';
import { visibleInsights, comingSoon } from '@/lib/insights';

const visible = (await visibleInsights()).slice(0, 4);
const soon = (await comingSoon()).slice(0, 3);
---
<Section ground="white" notes folio={{ n: '05', label: fold.overline }} labelledby="insights-heading" class="insights-fold" container={false}>
  <div class="container insights-fold__head">
    <h2 id="insights-heading" class="t-display insights-fold__h" data-rise>{fold.headline}</h2>
    {visible.length > 0 && <MarginNote text={homeNotes.insights.fresh} tone="orchid" rotate={-5} arrow="arrow-curve" arrowAt="below" arrowAngle={40} show="md" class="insights-fold__note" />}
  </div>
  <Rail label={fold.headline} id="insights-rail" class="insights-fold__rail">
    {visible.map((e) => <li><CoverStory entry={e} variant="card" headingLevel="h3" /></li>)}
    {soon.map((e) => (
      <li>
        <div class="soon-card">
          <p class="t-label soon-card__label">{microcopy.inPreparation}</p>
          <h3 class="soon-card__t">{e.data.title}</h3>
          <span class="soon-card__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
      </li>
    ))}
  </Rail>
  <div class="container insights-fold__nl">
    <Newsletter variant="fold">
      <MarginNote slot="note" text={homeNotes.newsletter.quiet} tone="orchid" rotate={4} arrow="arrow-curve" arrowAt="start" arrowAngle={-160} show="md" class="insights-fold__nlnote" />
    </Newsletter>
  </div>
</Section>

<style>
  .insights-fold { padding-block: clamp(80px, 10vw, 150px); overflow: clip; }
  .insights-fold__head { position: relative; }
  .insights-fold__h { margin: 0 0 clamp(32px, 4vw, 56px); color: var(--kk-ink); max-width: 15ch; font-size: clamp(52px, 7vw, 116px); }
  .insights-fold :global(.insights-fold__note) { right: var(--side); bottom: 10px; }
  .soon-card {
    display: flex; flex-direction: column; gap: var(--s-4); width: min(340px, 78vw); min-height: 440px; padding: 26px 24px;
    border-radius: var(--r-card); border: 2px dashed var(--kk-ink); box-sizing: border-box; background: #fff;
  }
  .soon-card__label { margin: 0; color: var(--kk-berry); }
  .soon-card__t { margin: 0; font-size: var(--fs-h3); line-height: 1; color: var(--kk-ink); text-wrap: balance; }
  .soon-card__dots { margin-top: auto; display: flex; gap: 6px; }
  .soon-card__dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--kk-hairline); }
  .soon-card__dots i:first-child { background: var(--kk-orchid); }
  .insights-fold__nl { margin-top: clamp(48px, 6vw, 88px); }
  .insights-fold__nl :global(.newsletter) { padding-top: var(--s-6); border-top: 2px solid var(--kk-ink); }
  .insights-fold :global(.insights-fold__nlnote) { right: 0; top: -44px; }
</style>
