/** FoggyWord (DESIGN-SPEC v2 9, 10.6 F3): the figure is real text; a canvas of frosted glass over it carries the same
 * word, blurred. Pointer-fine: wiping cuts the frost away and it slowly steams back. Touch / keyboard: it clears by
 * itself 1.2 s after entering view, or when the case receives focus. Reduced motion / JS off: no fog at all. */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['fog', cls]} data-fog data-cursor="wipe"><span class="fog__word"><slot /></span><canvas class="fog__glass" aria-hidden="true"></canvas></span>
<style>
  .fog { position: relative; display: inline-block; }
  .fog__glass { position: absolute; left: -18px; top: -14px; width: calc(100% + 64px); height: calc(100% + 28px); pointer-events: none; display: none; border-radius: 14px; }
  .fog.is-live .fog__glass { display: block; }
  .fog.is-live { cursor: crosshair; }
</style>
