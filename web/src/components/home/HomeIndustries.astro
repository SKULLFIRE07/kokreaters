---
/**
 * Home 7 · Industries (v4 developer guide). White band: label + H2 "Where we work", "All industries →" on the right;
 * six photo tiles (agri-fields, oils-pour, feed-silos, bakery-dough, cocoa-pods, nutrition-spices) with a navy
 * gradient and the name in white Bodoni (28px). Pack 3: no "Also" line (the Industries page carries the rest; the owner
 * asked for less text). Each tile links to /industries, or to the matching industry anchor when that slug exists.
 * Hover: the photo zooms 1.04 (.u-zoom) and the name underlines. The grid itself stays still (a lifted column read as
 * misalignment in review).
 * Mobile: one column of 240px tiles; two columns from 600px; three from 1000px.
 */
import Photo from '@/components/ui/Photo.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { industries as fold } from '@/data/home';
import { industries, industryHref } from '@/data/industries';

const hrefFor = (anchor: string) => (anchor && industries.some((i) => i.slug === anchor) ? industryHref(anchor) : fold.link.href);
---
<section id="industries" class="hi band band--white" aria-labelledby="hi-heading">
  <div class="container">
    <header class="hi__head">
      <div>
        <p class="t-label hi__label">{fold.overline}</p>
        <h2 id="hi-heading" class="hi__title">{fold.headline}</h2>
      </div>
      <ArrowLink href={fold.link.href} class="hi__link">{fold.link.label}</ArrowLink>
    </header>
    <ul class="hi__grid" role="list">
      {fold.tiles.map((t) => (
        <li>
          <a class="hi__tile u-zoom" href={hrefFor(t.anchor)}>
            <Photo slug={t.photo} fill class="hi__photo" sizes="(min-width: 1320px) 285px, (min-width: 1000px) 22vw, 44vw" widths={[400, 640, 800, 1000, 1280]} />
            <span class="hi__scrim" aria-hidden="true"></span>
            <span class="hi__name">{t.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hi__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; margin-bottom: 40px; }
  .hi__label { margin: 0 0 18px; }
  .hi__title { margin: 0; font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 500; }
  .hi :global(.hi__link) { margin-bottom: -10px; }
  .hi__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
  .hi__tile { position: relative; display: block; height: 230px; overflow: hidden; background: var(--navy-900); isolation: isolate; text-decoration: none; }
  .hi__scrim { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(14, 31, 77, 0) 40%, rgba(14, 31, 77, .9) 100%); transition: opacity var(--d-2) var(--ease-out); }
  .hi__name {
    position: absolute; z-index: 2; left: 16px; right: 16px; bottom: 18px;
    font-family: var(--font-serif); font-weight: 500; font-size: clamp(1.25rem, 1rem + .7vw, 1.75rem); line-height: 1.2; color: var(--white);
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: .2em;
    transition: text-decoration-color var(--d-2) var(--ease-out);
  }
  .hi__tile:is(:hover, :focus-visible) .hi__name { text-decoration-color: rgba(255, 255, 255, .7); }
  .hi__tile:focus-visible { outline-offset: 3px; }
  @media (min-width: 600px) { .hi__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hi__tile { height: 280px; } }
  @media (min-width: 1000px) {
    .hi__head { margin-bottom: 52px; }
    .hi__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hi__tile { height: 310px; }
    .hi__name { left: 20px; right: 20px; bottom: 22px; }
  }
  @media (max-width: 359px) { .hi__name { font-size: 1.125rem; left: 12px; right: 12px; } }
</style>
