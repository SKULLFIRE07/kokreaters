---
/**
 * Sidenote (DESIGN-SPEC 5.8 item 5; v2 10.9: a Butter sticky-note card with tape, rotate −1°, in the left margin at
 * ≥ 1280px; an indented Butter card inline below that. Not Caveat: notes are content). The ref is a superscript link; the note itself is a
 * <span role="note"> rather than an <aside>, because MDX places it inside a <p> and the HTML
 * parser would otherwise split the paragraph. At ≥ 1280px it floats into the left margin
 * (cols 1–3); below that it stays in reading order as an indented meta block.
 */
interface Props { n: number | string; }
const { n } = Astro.props;
---
{"\u2060"}<sup class="note-ref"><a href={`#note-${n}`} id={`ref-${n}`} aria-describedby={`note-${n}`}>{n}</a></sup><span id={`note-${n}`} class="sidenote" role="note"><span class="sidenote__n tnum" aria-hidden="true">{n}</span><span class="sidenote__text"><slot /></span></span>
<style>
  .note-ref { font-family: var(--font-mono); font-weight: 500; font-size: 0.66em; line-height: 0; vertical-align: super; margin-left: 2px; }
  .note-ref a { display: inline-grid; place-items: center; min-width: 1.6em; height: 1.6em; padding: 0 3px; border-radius: 999px; background: var(--kk-butter); box-shadow: inset 0 0 0 1.5px var(--kk-ink); color: var(--kk-ink); text-decoration: none; }
  .note-ref a:hover, .note-ref a:focus-visible { background: var(--kk-saffron); }

  .sidenote {
    position: relative;
    display: flex; gap: var(--s-3);
    margin: var(--s-5) 0 var(--s-4) var(--s-4);
    padding: 22px 18px 16px;
    background: var(--kk-butter); color: var(--kk-ink);
    border-radius: 4px 4px 14px 4px;
    box-shadow: 0 1px 0 rgba(18,24,51,.08), 0 14px 22px -14px rgba(18,24,51,.45);
    rotate: -1deg;
    font-family: var(--font-mono); font-style: normal; font-weight: 400;
    font-size: 13.5px; line-height: 1.55; letter-spacing: 0;
    text-transform: none; overflow-wrap: anywhere; hyphens: auto;
  }
  .sidenote::before { /* tape */
    content: ""; position: absolute; top: -10px; left: 50%; width: 76px; height: 22px; translate: -50% 0; rotate: -4deg;
    background: color-mix(in srgb, var(--kk-ice) 80%, transparent); box-shadow: 0 1px 2px rgba(18,24,51,.12);
  }
  .sidenote__n { flex: none; display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--kk-ink); color: var(--kk-white); font-size: 11px; font-weight: 500; }
  .sidenote:target { box-shadow: 0 0 0 3px var(--kk-cobalt), 0 14px 22px -14px rgba(18,24,51,.45); }

  @media (min-width: 1280px) {
    .sidenote {
      float: left; clear: left;
      width: var(--margin-col, 220px);
      margin: 0.35em 0 var(--s-5) calc(-1 * (var(--margin-col, 220px) + var(--gutter) + 24px));
    }
  }
  @media (prefers-reduced-motion: reduce) { .sidenote { rotate: none; } }
</style>
