---
/**
 * CardFan (DESIGN-SPEC v2 9 + 10.8 F2): the featured insight and up to four more covers, fanned from a bottom pivot
 * like a hand of cards. Port of the Bencho "card-fan" block (vanilla TS + GSAP + CSS, restyled to the v2 tokens).
 *
 * MIT License · Copyright (c) 2026 Lorenzo Cabra (bencho.dev). Permission is hereby granted, free of charge, to any
 * person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the
 * Software without restriction, subject to the following condition: the above copyright notice and this permission
 * notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS",
 * WITHOUT WARRANTY OF ANY KIND. Full text: web/THIRD_PARTY_NOTICES.md.
 *
 * HTML underneath: a <ul> of CoverStory cards (real links). The fan is pure CSS (custom properties per card), so it is
 * fanned with JS off; scripts/bencho/card-fan.ts only adds the scrubbed "deal" and the neighbour push on hover.
 * Hover/focus lifts a card 40px and straightens it (CSS, so Tab lifts the focused card). Below 1024px: a list.
 * `pad` covers (in-preparation titles, already listed as text further down the page) only fill out the hand: they
 * are aria-hidden + inert and never linked.
 */
import type { CollectionEntry } from 'astro:content';
import CoverStory from '@/components/shared/CoverStory.astro';
import PillarDot from '@/components/ui/PillarDot.astro';
import { getPillar, pillarTintGround } from '@/lib/pillars';
import { microcopy, formatLabels } from '@/data/microcopy';

type Entry = CollectionEntry<'insights'>;
interface Props { featured?: Entry; entries: Entry[]; pad?: Entry[]; max?: number; label: string }
const { featured, entries, pad = [], max = 5, label } = Astro.props;

const real = [...(featured ? [featured] : []), ...entries.filter((e) => e.id !== featured?.id)].slice(0, max);
const fillers = pad.slice(0, Math.max(0, Math.min(max, Math.max(5, real.length)) - real.length));
const n = real.length + fillers.length;
const c = (n - 1) / 2;
// slot order: the featured card in the centre, other real covers next to it, fillers on the outside
const slots: number[] = Array.from({ length: n }, (_, i) => i).sort((a, b) => Math.abs(a - c) - Math.abs(b - c) || a - b);
// DOM order = importance (featured first), so Tab and the mobile list read in that order; --x/--r place each card.
type Card = { kind: 'real' | 'pad'; e: Entry; slot: number };
const cards: Card[] = [...real.map((e) => ({ kind: 'real', e }) as Card), ...fillers.map((e) => ({ kind: 'pad', e }) as Card)]
  .map((card, k) => ({ ...card, slot: slots[k] }));
const stepR = n > 1 ? Math.min(7, 24 / (n - 1)) : 0;
const stepX = n > 1 ? Math.min(170, 760 / (n - 1)) : 0;
const pos = (i: number) => {
  const d = i - c;
  return `--x:${(d * stepX).toFixed(1)}px;--r:${(d * stepR).toFixed(2)}deg;--y:${(Math.abs(d) * Math.abs(d) * 6).toFixed(1)}px;--z:${10 - Math.round(Math.abs(d) * 2)};--d:${d}`;
};
---
{n > 0 && (
  <div class="fan" data-card-fan style={`--n:${n}`}>
    <ul class="fan__list" aria-label={label}>
      {cards.map((card) => (card.kind === 'real' ? (
        <li class="fan__item" style={pos(card.slot)} data-cursor="open" data-fan-item data-slot={card.slot}>
          <CoverStory entry={card.e} variant="fan" headingLevel="h3" />
        </li>
      ) : (
        <li class="fan__item fan__item--pad" style={pos(card.slot)} aria-hidden="true" inert data-fan-item>
          <div class:list={['fan__pad', `g-${pillarTintGround(card.e.data.pillar)}`]}>
            <p class="fan__pad-format t-micro"><PillarDot pillar={card.e.data.pillar} size={8} /> {formatLabels[card.e.data.format]} · {getPillar(card.e.data.pillar).shortLabel}</p>
            <p class="fan__pad-title">{card.e.data.title}</p>
            <p class="fan__pad-tag t-micro">{microcopy.inPreparation}</p>
          </div>
        </li>
      )))}
    </ul>
  </div>
)}
<style>
  .fan { --lift: -40px; --deal: 1; position: relative; }
  .fan__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
  .fan__item { margin: 0; }
  .fan__item :global(.cover--fan) { width: 100%; min-height: 380px; }
  .fan__item--pad { display: none; }
  .fan__pad { position: relative; display: flex; flex-direction: column; gap: var(--s-4); height: 100%; min-height: 440px; padding: 26px 24px 22px;
    border-radius: var(--r-card); border: 2px dashed var(--fg); box-shadow: var(--shadow-sticker); overflow: clip; }
  .fan__pad p { margin: 0; }
  .fan__pad-format { display: inline-flex; align-items: center; gap: 8px; }
  .fan__pad-title { font-family: var(--font-display); font-weight: 760; font-stretch: 75%; font-size: 2.1rem; line-height: .95; letter-spacing: -0.02em; color: var(--fg-2); text-wrap: balance; }
  .fan__pad-tag { margin-top: auto !important; align-self: flex-start; padding: 6px 12px; border-radius: 999px; border: 2px solid var(--fg); }

  @media (min-width: 768px) and (max-width: 1023px) { .fan__list { grid-template-columns: 1fr 1fr; } }

  @media (min-width: 1024px) {
    .fan__list { display: block; position: relative; height: 600px; }
    .fan__item, .fan__item--pad {
      display: block; position: absolute; left: 50%; bottom: 0; width: 340px; margin-left: -170px;
      z-index: var(--z); transform-origin: 50% 150%;
      translate: calc((var(--x) + var(--push, 0px)) * var(--deal)) calc(var(--y) * var(--deal) + var(--rise, 0px) + (1 - var(--deal)) * 140px);
      rotate: calc(var(--r) * var(--deal) * var(--straight, 1));
      transition: translate 520ms var(--ease-expo), rotate 520ms var(--ease-expo), scale 520ms var(--ease-expo);
    }
    .fan__item :global(.cover--fan) { width: 340px; min-height: 440px; }
    .fan__item:not(.fan__item--pad):is(:hover, :focus-within) { --rise: var(--lift); --straight: 0; z-index: 30; scale: 1.04; }
    .fan__item:not(.fan__item--pad):is(:hover, :focus-within) :global(.cover) { box-shadow: var(--shadow-lift), var(--shadow-hard); }
    .fan.is-dealing .fan__item { transition: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fan__item { transition: none !important; }
  }
</style>
