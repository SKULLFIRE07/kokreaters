---
/**
 * Closing call to action (v4 developer guide, home section 12). Rendered by BaseLayout on every page except contact,
 * legal and 404. Default: a Deep Delft band, "Let’s create something together.", one line of body, ONE saffron button
 * ("Start a conversation" → /contact; the page's single saffron CTA) and the address office@KoKreaters.com under it.
 * Layout ≥ 900px: title + body left (7 columns), button + email right, vertically centred. Mobile: one column, the
 * button full width.
 * Props stay backward compatible: `ground` grey | navy | white | delft (default delft); on light grounds the button is
 * the primary Deep Delft fill instead of saffron. `newsletter` adds the newsletter form under a hairline.
 */
import Section from './Section.astro';
import Button from './Button.astro';
import NewsletterForm from './NewsletterForm.astro';
import { cta } from '@/data/home';
import { footer } from '@/data/nav';
import { site } from '@/config/site';

interface Link { label: string; href: string }
interface Props {
  title?: string;
  body?: string;
  primary?: Link;
  secondary?: Link;
  newsletter?: boolean;
  ground?: 'grey' | 'navy' | 'white' | 'delft';
}
const {
  title = cta.headline,
  body = cta.body,
  primary = { label: cta.button, href: cta.href },
  secondary = { label: footer.contact.email.label, href: `mailto:${site.email}` },
  newsletter = false,
  ground = 'delft',
} = Astro.props;
const dark = ground === 'delft' || ground === 'navy';
---
<Section ground={ground} labelledby="cta-heading" class="cta-band">
  <div class="cta-band__grid">
    <div class="cta-band__text">
      <h2 id="cta-heading" class="cta-band__title">{title}</h2>
      {body && <p class="cta-band__body">{body}</p>}
    </div>
    <div class="cta-band__actions">
      <Button href={primary.href} size="lg" variant={ground === 'delft' ? 'saffron' : 'primary'} class="cta-band__primary">{primary.label}</Button>
      {secondary && <a class="cta-band__secondary u-hover" href={secondary.href}><span class="u-draw">{secondary.label}</span></a>}
    </div>
    {newsletter && (
      <div class="cta-band__news">
        <NewsletterForm id="nl-cta" tone={dark ? 'dark' : 'light'} heading={footer.newsletter.heading} />
      </div>
    )}
  </div>
</Section>

<style>
  .cta-band { --_pad: clamp(4rem, 3rem + 3vw, 6rem); }
  .cta-band__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6) var(--grid-gap); align-items: center; }
  .cta-band__title { margin: 0; font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 500; max-width: 16ch; }
  .cta-band__body { margin: var(--s-4) 0 0; max-width: 46ch; font-size: 1.125rem; line-height: 1.6; color: var(--fg-2); }
  .cta-band__actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .cta-band__secondary {
    display: inline-flex; align-items: center; min-height: 44px;
    font: 500 var(--fs-small)/1.3 var(--font-sans); color: var(--link); text-decoration: none;
  }
  .cta-band__news { padding-top: var(--s-6); border-top: 1px solid var(--rule); grid-column: 1 / -1; }

  @media (max-width: 599px) {
    .cta-band__actions { align-items: stretch; }
    .cta-band__actions :global(.cta-band__primary) { width: 100%; }
  }
  @media (min-width: 900px) {
    .cta-band__grid { grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--s-8); }
  }
</style>
