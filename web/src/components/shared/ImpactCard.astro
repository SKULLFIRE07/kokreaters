---
/**
 * ImpactCard (DESIGN-SPEC v2 7.8): a founder-career result on a White card with a 3px border in a pillar colour:
 * mono dateline, a big figure (counts up via data-count when numeric; the real value is read from a visually hidden
 * twin), the home line in .t-h4 with its emphasis set as figures, data-frost kept on −25 °C. The caller passes
 * `figure` / `secondary` (india: the DERIVED "1st" from its own notes file; indonesia "21%"; ukraine "−25 °C" + "15%";
 * tfa "WHO"). Always labelled "From our founder's career" by its fold.
 */
import type { FounderResult, PillarKey } from '@/data/types';
import { figHtml, abbreviations } from '@/lib/typography';
interface Props { result: FounderResult; figure?: string; secondary?: string; border?: PillarKey; size?: 'md' | 'lg'; as?: 'div' | 'li' | 'article'; href?: string; class?: string }
const { result, secondary, border = result.pillars[0], size = 'md', as: Tag = 'article', href, class: cls } = Astro.props;
const figure = Astro.props.figure ?? result.figure?.value;
let html = figHtml(result.homeLine, result.emphasis);
const hasItfa = html.includes('iTFA');
if (hasItfa) html = html.replace('iTFA', `<abbr title="${abbreviations.iTFA.title}">iTFA</abbr>`);
const num = (v?: string) => { const m = v && /^([−-]?)(\d+)(?!\w)/.exec(v); return m ? `${m[1] ? '-' : ''}${m[2]}` : null; };
const count = num(figure);
const frost = !!figure && figure.includes('−25');
const unitSplit = (v: string) => { const m = /^([−-]?\d+)(.*)$/.exec(v); return m && m[2].trim() ? { n: m[1], u: m[2] } : null; };
const parts = figure ? unitSplit(figure) : null;
---
<Tag class:list={['icard', `icard--${size}`, 'g-white', cls]} style={`--icard-c:var(--pillar-${border})`} data-result={result.id}>
  <p class="icard__dateline t-dateline">{result.dateline.replaceAll(' · ', ' · ')}</p>
  {figure && (
    <p class="icard__figure t-figure">
      <span aria-hidden="true" data-count={count ?? undefined} data-frost={frost ? '' : undefined}>{parts ? <>{parts.n}<span class="unit">{parts.u}</span></> : figure}</span>
      <span class="visually-hidden">{figure}</span>
      {secondary && <span class="icard__secondary"><span aria-hidden="true" data-count={num(secondary) ?? undefined}>{secondary}</span><span class="visually-hidden">{secondary}</span></span>}
    </p>
  )}
  <p class="icard__line t-h4">{href ? <a href={href} set:html={html} /> : <Fragment set:html={html} />}</p>
  {hasItfa && <p class="icard__note t-micro">{abbreviations.iTFA.note}</p>}
</Tag>
<style>
  .icard { position: relative; list-style: none; display: flex; flex-direction: column; gap: 14px; padding: 28px; border: var(--bw-card) solid var(--icard-c); border-radius: var(--r-card); }
  .icard p { margin: 0; }
  .icard__figure { color: var(--kk-ink); display: flex; align-items: baseline; gap: .25em; flex-wrap: wrap; }
  .icard--lg .icard__figure { font-size: var(--fs-stat); }
  .icard__secondary { font-size: .5em; color: var(--kk-sapphire); }
  .icard__line { color: var(--kk-ink); max-width: 30ch; }
  .icard__line a { color: inherit; text-decoration: none; }
  .icard__line a:hover, .icard__line a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; }
  .icard__line :global(.fig) { font-weight: 800; color: var(--kk-sapphire); white-space: nowrap; font-variant-numeric: lining-nums tabular-nums; }
  .icard__line :global([data-frost]) { display: inline; }
  .icard__line :global(abbr) { text-decoration: underline dotted 1px; text-underline-offset: 0.18em; cursor: help; }
  .icard__note { color: var(--kk-graphite); }
</style>
