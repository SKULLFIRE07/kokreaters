---
/**
 * Home 3 · Hero (v4 developer guide + homepage design). Full-bleed rapeseed field (hero-rapeseed, cropped to keep the
 * sky on the left) under a Delft Navy gradient that is solid behind the text on the left (rgba(14,31,77,.92)) and
 * fades out to the right. White label with the saffron rule, Bodoni H1 (76/80 desktop, 44/48 mobile), intro, two
 * buttons (white fill + white outline), and (pack 2 item 14) the proof line on a hairline: three parts in small caps
 * divided by thin rules (one row ≥ 900px; stacked as three short lines, with short horizontal rules, on phones).
 * Motion: the photo settles 1.08 → 1 on load and drifts as the hero leaves (data-gsap="kenburns"); the H1's lines rise
 * once inside their masks on load (data-gsap="hero-title", CSS from 0 ms). Everything else is there at first paint.
 * Mobile (< 900px): the gradient runs top-to-bottom so the whole column of text sits on deep navy; buttons stack.
 * The photo is the LCP image (priority).
 */
import Photo from '@/components/ui/Photo.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { hero } from '@/data/home';
---
<section class="hh band--navy on-dark" aria-labelledby="hero-title">
  <Photo slug="hero-rapeseed" fill priority kenburns sizes="100vw" position="62% 50%" class="hh__photo" widths={[640, 800, 1024, 1280, 1600, 2000, 2400, 2880, 3600]} />
  <div class="hh__scrim" aria-hidden="true"></div>
  <div class="container hh__inner">
    <Eyebrow tone="white" class="hh__eyebrow">{hero.overline}</Eyebrow>
    <h1 id="hero-title" class="hh__title" data-gsap="hero-title">
      {hero.headlineLines.map((l, i) => <span class="ln"><span style={`--ln:${i}`}>{l}</span></span>)}
    </h1>
    <p class="hh__lead">{hero.sub}</p>
    <div class="hh__actions">
      <Button href={hero.primary.href} variant="on-dark">{hero.primary.label}</Button>
      <Button href={hero.secondary.href} variant="ghost-on-dark">{hero.secondary.label}</Button>
    </div>
    <p class="hh__proof">
      {hero.proofLine.map((part, i) => <>{i > 0 && <span class="hh__sep" aria-hidden="true"></span>}<span class="hh__part">{part}</span>{i < hero.proofLine.length - 1 && <span class="visually-hidden"> · </span>}</>)}
    </p>
  </div>
</section>

<style>
  .hh { position: relative; isolation: isolate; overflow: clip; background: var(--navy-900); color: var(--white);
    min-height: max(600px, calc(100svh - var(--chrome-top))); display: flex; flex-direction: column; }
  .hh :global(.hh__photo) { z-index: -2; }
  .hh__scrim {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(14, 31, 77, .62) 0%, rgba(14, 31, 77, .86) 45%, rgba(14, 31, 77, .94) 100%);
  }
  .hh__inner { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: center; padding-block: 72px 40px; }
  .hh__title {
    margin: 26px 0 0; max-width: 13ch;
    font-family: var(--font-serif); font-weight: 500; font-size: 2.75rem; line-height: 1.09; letter-spacing: -0.01em;
    color: var(--white); text-wrap: initial;
  }
  .hh__lead { margin: 24px 0 0; max-width: 620px; font-size: 1.0625rem; line-height: 1.6; color: #E4EAF5; }
  .hh__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  /* Pack 2 item 14: proof line in small caps, parts divided by thin rules; phones: three short stacked lines */
  .hh__proof {
    display: flex; flex-direction: column; gap: 10px;
    margin: 56px 0 0; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, .22);
    font-size: 1rem; font-weight: 600; line-height: 1.4; color: #DCE4F2;
    font-variant-caps: all-small-caps; letter-spacing: .06em;
  }
  .hh__part { max-width: 34ch; text-wrap: balance; }
  .hh__sep { display: block; width: 24px; height: 1px; background: rgba(255, 255, 255, .35); }

  @media (max-width: 599px) {
    .hh__actions :global(.btn) { flex: 1 1 100%; }
    .hh :global(.hh__eyebrow) { letter-spacing: .1em; font-size: .75rem; gap: 12px; }
    .hh :global(.hh__eyebrow .eyebrow__rule) { width: 28px; }
  }
  @media (min-width: 900px) {
    .hh__scrim {
      background: linear-gradient(90deg, rgba(14, 31, 77, .94) 0%, rgba(14, 31, 77, .82) 42%, rgba(14, 31, 77, .25) 75%, rgba(14, 31, 77, .05) 100%);
    }
    .hh__inner { padding-block: 120px 56px; }
    .hh__title { max-width: 16ch; font-size: clamp(3.5rem, 1.6rem + 3.6vw, 6rem); line-height: 1.04; }
    .hh__lead { font-size: 1.1875rem; }
    .hh__inner { padding-block: 96px 40px; }
    /* room on the right for the "Ask KoKreaters" launcher, which sits over the hero's bottom-right corner */
    .hh__proof {
      position: absolute; left: var(--gutter-x); right: calc(var(--gutter-x) + 168px); bottom: 40px; margin: 0;
      flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px 16px;
      font-size: .9375rem; letter-spacing: .05em;
    }
    .hh__part { max-width: none; }
    .hh__sep { width: 1px; height: 14px; }
  }
</style>
