---
/**
 * /approach#engage — "How we engage", the main section of the page (pack 3, brief: "Bring 'How we engage' here as the
 * main section, with the four models and a typical duration and outcome for each"). White band, straight after the hero.
 * Head (h2 + the intro beside it from 1024px), then four model cards on top rules (3px saffron for the first, 1px for
 * the others; data-gsap="rule" draws the rule, never hides content): icon + "01", Bodoni h3 (28px), the duration in
 * Manrope 700 with a clock, the brief's copy, and the outcome on a hairline at the foot. The cards are a subgrid so
 * durations and outcomes line up across a row. Under them, "Confidential by default" (kept on Approach, brief) on a
 * hairline. No prices.
 * ≥ 1100px: four columns. 600–1099: two. Mobile: one column.
 */
import Section from '@/components/ui/Section.astro';
import Head from '@/components/expertise/Head.astro';
import LineIcon, { type LineIconName } from '@/components/expertise/LineIcon.astro';
import { engage, stepLabels } from '@/data/approach';
import { pad2 } from '@/lib/format';

const bind = (s: string) => s.replace(/(\d)–(\d)/g, '$1–⁠$2');
---
<Section ground="white" id={engage.id} labelledby="engage-h" class="engage">
  <Head id="engage-h" title={engage.title} lead={engage.intro} />
  <ol class="ways" role="list">
    {engage.items.map((w, i) => (
      <li class:list={['way', i === 0 && 'way--lead']}>
        <span class="way__rule" aria-hidden="true" data-gsap="rule"></span>
        <div class="way__top">
          <LineIcon name={w.icon as LineIconName} size={32} />
          <span class="way__n" aria-hidden="true">{pad2(w.n)}</span>
        </div>
        <h3 class="way__title">{w.title}</h3>
        <p class="way__copy">{w.copy}</p>
        <p class="way__out"><span class="t-label">{stepLabels.outcome}</span>{w.outcome}</p>
      </li>
    ))}
  </ol>
  <p class="engage__conf">{engage.confidential}</p>
</Section>
<style>
  .engage { scroll-margin-top: var(--scroll-offset); }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7) var(--grid-gap); }
  .way { position: relative; padding-top: 24px; min-width: 0; display: grid; grid-template-rows: subgrid; grid-row: span 4; row-gap: var(--s-3); align-content: start; }
  @supports not (grid-template-rows: subgrid) { .way { display: block; } .way > * + * { margin-top: var(--s-3); } }
  .way__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--rule); transform-origin: left center; }
  .way--lead .way__rule { height: 3px; background: var(--saffron); }
  .way__top { display: flex; align-items: center; justify-content: space-between; }
  .way__n { font-size: .875rem; line-height: 1; font-weight: 700; color: var(--label); font-variant-numeric: lining-nums tabular-nums; }
  .way__title { margin-top: var(--s-2); font-family: var(--font-serif); font-weight: 400; font-size: var(--fs-h3); line-height: 1.2; color: var(--head); text-wrap: balance; }
  .way__dur { display: flex; align-items: center; gap: 8px; font-size: 1.0625rem; line-height: 1.35; font-weight: 700; color: var(--head); }
  .way__copy { font-size: 1rem; line-height: 1.6; color: var(--fg-2); max-width: 40ch; text-wrap: pretty; }
  .way__out { display: grid; gap: 4px; align-self: end; padding-top: var(--s-4); border-top: 1px solid var(--rule); font-size: 1rem; line-height: 1.45; font-weight: 600; color: var(--head); text-wrap: pretty; }
  .way__out .t-label { color: var(--label); }
  .engage__conf {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem); padding-top: var(--s-5); border-top: 1px solid var(--rule);
    font-size: 1.0625rem; line-height: 1.6; color: var(--head); max-width: 70ch; text-wrap: pretty;
  }
  @media (min-width: 600px) { .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .ways { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
