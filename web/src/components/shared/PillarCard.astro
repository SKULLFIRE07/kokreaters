---
/**
 * PillarCard (DESIGN-SPEC v2 7.8): one <a> (the whole card is the link; no nested links) on the pillar's colour-block
 * ground with print grain: mono "0n / 06" + PillarDot, the promise in Bricolage inside the heading, the pillar name as a
 * mono label, an honest-label SpecLabel (Typical deliverables; From our founder's career when the pillar has a result),
 * and a faux hand pill "Learn more". `grid` adds a first row: the first three help-with items + the caller's `moreLabel`
 * ("+{n} more", from the caller's notes file). Hover: edge-light, lift 6px, rotate ±1° (alternating by pillar number).
 */
import PillarDot from '../ui/PillarDot.astro';
import Arrow from '../ui/Arrow.astro';
import SpecLabel from '../notes/SpecLabel.astro';
import { pillarGround, pillarTintGround, pillarNumber } from '@/lib/pillars';
import { pillarPage } from '@/data/pillars';
import { founderResults } from '@/data/impact';
import { microcopy } from '@/data/microcopy';
import { fill } from '@/lib/format';
import type { Pillar } from '@/data/types';
interface Props { pillar: Pillar; variant?: 'rail' | 'grid'; headingLevel?: 2 | 3; moreLabel?: string; class?: string }
const { pillar: p, variant = 'rail', headingLevel = 3, moreLabel, class: cls } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const result = p.impactId ? founderResults.find((r) => r.id === p.impactId) : undefined;
const rows: { k: string; v: string; strong?: boolean }[] = [];
if (variant === 'grid') {
  const more = p.helpWith.length - 3;
  rows.push({ k: pillarPage.helpWith, v: p.helpWith.slice(0, 3).join(' · ') + (more > 0 && moreLabel ? ` ${fill(moreLabel, { n: more })}` : '') });
}
rows.push({ k: pillarPage.deliverables, v: p.deliverables.join(' · ') });
if (result) rows.push({ k: pillarPage.fromTheRecord, v: result.dateline, strong: true });
---
<a href={`/expertise/${p.slug}`} class:list={['pcard', `pcard--${variant}`, `g-${pillarGround(p.key)}`, 'grain', { 'pcard--odd': p.n % 2 === 1 }, cls]} data-edge-light data-pillar={p.key}>
  <span class="pcard__top t-micro"><PillarDot pillar={p.key} size={10} /><span class="tnum">{pillarNumber(p)} / 06</span></span>
  <H class="pcard__promise">{p.promise}</H>
  <p class="pcard__name t-label">{p.name}</p>
  <SpecLabel headingLevel="none" ground={pillarTintGround(p.key)} rows={rows} compact class="pcard__spec" />
  <span class="pcard__more"><span class="t-hand">{microcopy.pillarLink}</span><Arrow hand size={14} /></span>
</a>
<style>
  .pcard {
    position: relative; display: flex; flex-direction: column; gap: 14px;
    padding: 26px 24px 24px; border-radius: var(--r-card); overflow: clip;
    text-decoration: none; color: var(--fg);
    transition: translate var(--d-ui) var(--ease-expo), rotate var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo);
  }
  .pcard--rail { width: min(440px, 82vw); min-height: min(600px, 132vw); height: 100%; }
  .pcard:hover, .pcard:focus-visible { color: var(--fg); translate: 0 -6px; rotate: 1deg; box-shadow: var(--shadow-lift); }
  .pcard--odd:hover, .pcard--odd:focus-visible { rotate: -1deg; }
  .pcard:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .pcard__top { display: inline-flex; align-items: center; gap: 10px; color: var(--fg); }
  .pcard__promise {
    margin: 0; font-family: var(--font-display); font-weight: 760; font-stretch: 78%; letter-spacing: -0.015em; line-height: .98;
    font-size: var(--fs-h3); color: var(--head); text-wrap: balance;
  }
  .pcard--rail .pcard__promise { font-size: calc(var(--fs-h3) * 1.2); }
  .pcard__name { margin: 0; color: var(--fg); }
  .pcard :global(.pcard__spec) { margin-top: auto; max-width: none; }
  .pcard__more {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px 2px;
    border-radius: var(--r-pill); box-shadow: inset 0 0 0 2px var(--fg); color: var(--fg);
  }
  .pcard:hover .pcard__more, .pcard:focus-visible .pcard__more { background: var(--fg); color: var(--bg); }
  @media (prefers-reduced-motion: reduce) { .pcard:hover, .pcard:focus-visible { rotate: 0deg; } }
</style>
