---
/**
 * About /about, pack 3 (Ganeaysh, 20 Nov: "Open with achievements, not education"; owner: "very sharp, not too much
 * text, good visuals"). Grounds: navy hero → Porcelain figures → white timeline → Porcelain story → white "worked
 * alongside" → Dutch polder interlude → white map → navy name panel → white credentials → (Porcelain testimonials, once
 * two are confirmed) → CtaBand → footer.
 *  1 PageHero, navy, the 4:5 portrait right: crumbs, eyebrow, H1, the intro, then "Download short bio (PDF)" (one
 *    page, confirmed facts only, scripts/make-short-bio.mjs), "High-resolution portrait" and LinkedIn (event organisers).
 *  2 AboutStrip     — the figures band from career.ts (25 years, 8 sites, 5 languages + the six drafts; drafts never in
 *                     production) and the page's one footnote.
 *  3 CareerTimeline — from 2001 (Wilmar), one achievement line per step; education is not in it.
 *  4 AboutStory     — name, the three title lines (flourish italic), the short bio, the long version folded.
 *  5 WorkedAlongside — five organisation types with icons, no names or logos.
 *  · PhotoInterlude (nl-polder): "A Dutch base. A global reach."
 *  6 PlacesMap, 7 NamePanel (Ko + Kreaters = the new logo), 8 Credentials (education as a small separate block, with
 *    executive education, recognition and languages), 9 AboutTestimonials (hidden until two are confirmed).
 * Cargill and Wilmar appear on this page (timeline, long bio, the former-role line) and nowhere else but the founder
 * line. JSON-LD: Person (with the portrait) + BreadcrumbList.
 * Mobile: every section states its own layout; hero buttons go full width below 600px.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import AboutStory from '@/components/about/AboutStory.astro';
import CareerTimeline from '@/components/about/CareerTimeline.astro';
import PlacesMap from '@/components/about/PlacesMap.astro';
import NamePanel from '@/components/about/NamePanel.astro';
import Credentials from '@/components/about/Credentials.astro';
import PhotoInterlude from '@/components/ui/PhotoInterlude.astro';
import portrait from '@/assets/photos/ganeaysh-portrait.jpg';
import { person } from '@/components/seo/schema';
import { pageSeo } from '@/lib/seo';
import { site } from '@/config/site';
import AboutStrip from '@/components/about/AboutStrip.astro';
import WorkedAlongside from '@/components/about/WorkedAlongside.astro';
import AboutTestimonials from '@/components/about/AboutTestimonials.astro';
import { about, aboutPage } from '@/data/about';
import { location } from '@/data/contact';
import { founderName } from '@/components/about/founder-lines';
import { photos } from '@/data/photos';
import { microcopy } from '@/data/microcopy';

const portraitWebp = await getImage({ src: portrait, format: 'webp', width: 960 });
const crumbs = [{ label: about.overline, href: '/about' }];
const seo = { ...pageSeo('about'), jsonLd: [person(portraitWebp.src)] };
// Static files in public/downloads (written by scripts/make-short-bio.mjs); never link to one that is missing.
const has = (href: string) => existsSync(join(process.cwd(), 'public', href));
const hasBio = has(aboutPage.bioPdfHref);
const polder = photos['nl-polder'];
---
<BaseLayout page="about" seo={seo} breadcrumbs={crumbs}>
  <PageHero
    ground="navy"
    imageMode="portrait"
    image={portrait}
    imageAlt={founderName}
    imagePosition="50% 0%"
    crumbs={crumbs}
    eyebrow={about.overline}
    title={about.headline}
    lead={about.intro}
    titleId="about-title"
  >
    <div class="about-actions">
      {hasBio && (
        <Button href={aboutPage.bioPdfHref} icon="download" download={aboutPage.bioPdfName}>
          <span class="about-pdf--full">{aboutPage.bioPdf}</span><span class="about-pdf--short">{aboutPage.bioPdfShort}</span>
        </Button>
      )}
      <Button href={site.linkedin.href} variant="tertiary" icon="external" rel="noopener me" class="about-actions__link">
        {aboutPage.linkedin}<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span>
      </Button>
    </div>
  </PageHero>
  <AboutStrip />
  <CareerTimeline />
  <AboutStory />
  <WorkedAlongside />
  <PhotoInterlude src={polder.src} alt={polder.alt} position={polder.position} size="lg" eyebrow={location.line} caption={aboutPage.interludeCaption} />
  <PlacesMap />
  <NamePanel />
  <Credentials />
  <AboutTestimonials />
</BaseLayout>
<style>
  /* PageHero puts its default slot 48px under the lead; buttons belong 32px under it, like hero actions. */
  .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-top: calc(var(--s-6) - var(--s-7)); }
  @media (max-width: 599px) {
    .about-actions :global(.btn--primary) { flex: 1 1 100%; }
  }
  /* Below 390px the full label would wrap: the shorter label keeps the button one line, 48px. Only one label is ever
     rendered, so the accessible name follows what is shown. */
  .about-pdf--short { display: none; }
  @media (max-width: 389px) {
    .about-pdf--full { display: none; }
    .about-pdf--short { display: inline; }
  }
</style>
<style is:global>
  /* Pack 3 bug (phone): the shared hero-title reveal (motion.css kk-line-block) wipes the H1 open with a clip-path, so
     the four-line About headline on a phone was seen cut off mid-animation. Below 900px the About H1 rises and fades in
     whole instead: nothing is ever clipped, and it is complete at every frame after ~150ms. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
    #about-title[data-gsap="hero-title"] { animation: kk-about-rise 420ms cubic-bezier(.2, .75, .2, 1) backwards; clip-path: none; }
  }
  @keyframes kk-about-rise { from { opacity: .001; transform: translateY(12px); } to { opacity: 1; transform: none; } }
</style>
