---
/** AuthorBox (DESIGN-SPEC v2 10.9): a Saffron block: the 96px avatar, name in Bricolage, role and short bio in mono,
 * and the hand pill "Meet Ganeaysh". */
import FounderPhoto from '@/components/brand/FounderPhoto.astro';
import Button from '@/components/ui/Button.astro';
import { shortBio, founderName, founderRole } from '@/data/founder';
import { founderQuote } from '@/data/home';
---
<section class="author g-saffron grain" aria-labelledby="author-h" data-reveal>
  <FounderPhoto variant="avatar" size={96} ground="white" alt="" class="author__avatar" />
  <div class="author__text">
    <h2 id="author-h" class="author__name">{founderName}</h2>
    <p class="author__role t-label">{founderRole}</p>
    <p class="author__bio t-mono">{shortBio}</p>
    <Button href={founderQuote.link.href} variant="hand">{founderQuote.link.label}</Button>
  </div>
</section>
<style>
  .author {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-6); align-items: start;
    padding: var(--s-7); border-radius: 28px; box-shadow: var(--shadow-hard); border: 2px solid var(--kk-ink);
  }
  .author p { margin: 0; }
  .author :global(.author__avatar) { rotate: -4deg; }
  .author__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .author__name { margin: 0; font-family: var(--font-display); font-weight: 780; font-stretch: 75%; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); line-height: .95; letter-spacing: -0.02em; color: var(--head); }
  .author__role { color: var(--fg-2); }
  .author__bio { max-width: 58ch; color: var(--fg); margin-bottom: var(--s-2) !important; }
  @media (max-width: 559px) { .author { grid-template-columns: minmax(0, 1fr); padding: var(--s-5); } }
</style>
