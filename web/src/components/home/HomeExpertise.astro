---
/**
 * Home 5 · What we do (v4 developer guide + homepage design). White band. Header: label + Bodoni H2 on the left, the
 * intro on the right, bottom-aligned. Then the six services from src/data/pillars.ts (order, names and lines are
 * Ganeaysh's) in a 3 × 2 grid with thin rules: number · Bodoni title · line · "Learn more →" to its expertise page.
 * Each card is one link. Hover: a Deep Delft line draws over the hairline, the title turns Deep Delft, the arrow nudges.
 * Motion: the hairlines draw in once (data-gsap="rule"). Mobile: one column (two from 600px).
 */
import Icon from '@/components/ui/Icon.astro';
import { pillars } from '@/data/pillars';
import { whatWeDo } from '@/data/home';
import { microcopy } from '@/data/microcopy';
import { pad2 } from '@/lib/format';
import { keepCompounds } from './typo';
---
<section id="expertise" class="hx band band--white" aria-labelledby="hx-heading">
  <div class="container">
    <header class="hx__head">
      <div class="hx__title-wrap">
        <p class="t-label hx__label">{whatWeDo.overline}</p>
        <h2 id="hx-heading" class="hx__title">{whatWeDo.headline}</h2>
      </div>
      <p class="hx__intro">{whatWeDo.intro}</p>
    </header>
    <ul class="hx__grid" role="list">
      {pillars.map((p) => (
        <li>
          <a class="hx__card u-hover" href={`/expertise/${p.slug}`}>
            <span class="hx__rule" data-gsap="rule" aria-hidden="true"></span>
            <span class="hx__hover" aria-hidden="true"></span>
            <span class="hx__n">{pad2(p.n)}</span>
            <h3 class="hx__name">{p.name}</h3>
            <span class="hx__line">{keepCompounds(p.promise)}</span>
            <span class="hx__more">{microcopy.pillarLink}<Icon name="arrow-right" size={16} stroke={2} class="u-nudge" /><span class="visually-hidden">: {p.name}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* pack 2: "How we engage" (HomeEngage) follows on the same ground, so this band closes short */
  .hx { padding-bottom: clamp(1.5rem, 1rem + 1.6vw, 2.5rem); }
  .hx__head { display: grid; gap: 24px; margin-bottom: 48px; }
  .hx__label { margin: 0 0 18px; }
  .hx__title { margin: 0; max-width: 16ch; font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 500; }
  .hx__intro { margin: 0; max-width: 46ch; font-size: 1.125rem; line-height: 1.65; color: var(--fg-2); }

  .hx__grid { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 48px; margin: 0; padding: 0; list-style: none; }
  .hx__grid > li { display: flex; }
  .hx__card {
    position: relative; flex: 1; display: flex; flex-direction: column; gap: 12px;
    padding: 32px 0 36px; color: var(--navy-900); text-decoration: none;
  }
  .hx__rule, .hx__hover { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--rule); }
  .hx__hover { background: var(--blue-700); transform: scaleX(0); transform-origin: 0 50%; transition: transform 600ms var(--ease-out); }
  .hx__card:is(:hover, :focus-visible) .hx__hover { transform: scaleX(1); }
  .hx__n { font-size: .875rem; font-weight: 700; color: var(--blue-700); font-variant-numeric: tabular-nums; }
  .hx__name {
    margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 1.625rem; line-height: 1.2; letter-spacing: 0;
    color: var(--navy-900); transition: color var(--d-1) var(--ease-out); text-wrap: balance;
  }
  .hx__card:hover .hx__name { color: var(--blue-700); }
  .hx__line { font-size: 1rem; line-height: 1.6; color: var(--fg-2); max-width: 36ch; }
  .hx__more {
    display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 6px;
    font-size: .9375rem; font-weight: 700; color: var(--blue-700);
  }
  .hx__card:focus-visible { outline-offset: 4px; }

  @media (min-width: 600px) { .hx__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .hx__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hx__name { font-size: 1.75rem; }
  }
  @media (min-width: 900px) {
    .hx__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 80px; align-items: end; margin-bottom: 64px; }
    .hx__intro { padding-bottom: 6px; }
  }
</style>
