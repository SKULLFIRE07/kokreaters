---
/**
 * Long bio (DESIGN-SPEC v2 10.7 F3 + 00.1): White, grid 3/9. Left: the big "25" (count-up) with its label. Right:
 * paragraph 1 in .t-h3 + CONFIRM 13; paragraphs 2–6 (Instrument Sans 19/31, 64ch, verbatim from the brief) sit in a
 * <details> "Read the long version +" (in the DOM, never display:none-cloaked). Inside, the three bioSidenotes are
 * margin notes in the left column at ≥ 1024 (decorative, the same dates are in the text) and visible mono datelines
 * above their paragraph below 1024.
 */
import Confirm from '@/components/ui/Confirm.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import { longBio, bioSidenotes } from '@/data/founder';
import { storyNotes } from '@/data/notes/story';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const withFigures = (s: string) => esc(s).replace(/(\d+%)/g, '<span class="nowrap tnum">$1</span>');
const paras = longBio.map((text, i) => ({ html: withFigures(text), notes: bioSidenotes.filter((n) => n.at === i + 1).map((n) => n.text) }));
const [lede, ...rest] = paras;
---
<section class="bio g-white has-notes" aria-labelledby="bio-title">
  <div class="container bio__grid">
    <div class="bio__fig" aria-hidden="true">
      <span class="bio__num t-stat" data-count={storyNotes.about.years}>{storyNotes.about.years}</span>
      <span class="bio__years t-label">{storyNotes.about.yearsLabel}</span>
    </div>
    <div class="bio__main">
      <h2 id="bio-title" class="visually-hidden">{storyNotes.about.years} {storyNotes.about.yearsLabel}</h2>
      <p class="bio__lede" data-reveal><Fragment set:html={lede.html} /> <Confirm id={13} note="founded in 2026 and career dates" /></p>
    </div>
    <details class="bio__more">
        <summary class="bio__sum t-hand">{storyNotes.about.more}</summary>
        <div class="bio__rest">
          {rest.map((p) => (
            <div class="bio__row">
              <div class="bio__side">
                {p.notes.map((t, k) => (<>
                  <p class="bio__date t-dateline tnum">{t}</p>
                  <MarginNote text={t} tone="berry" rotate={k ? 3 : -3} arrow="arrow-straight" arrowAt="end" anchor="block" show="lg" class="bio__note" />
                </>))}
              </div>
              <p class="bio__p t-body" set:html={p.html} />
            </div>
          ))}
        </div>
    </details>
  </div>
</section>
<style>
  .bio { padding-block: var(--section); }
  .bio__grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--gutter); align-items: start; }
  .bio__fig { display: flex; flex-direction: column; gap: 10px; position: sticky; top: calc(var(--header-h) + 24px); }
  .bio__num { color: var(--kk-sapphire); font-size: clamp(7rem, 3rem + 12vw, 15rem); line-height: .8; }
  .bio__years { max-width: 16ch; color: var(--fg-2); }
  .bio__lede { margin: 0; font-family: var(--font-display); font-weight: 700; font-stretch: 85%; letter-spacing: -.012em; line-height: 1.08;
    font-size: clamp(1.75rem, 1.1rem + 1.9vw, 3rem); color: var(--head); max-width: 26ch; text-wrap: pretty; }
  .bio__lede :global(.confirm) { vertical-align: middle; }
  .bio__more { grid-column: 1 / -1; margin-top: var(--s-5); }
  .bio__sum { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px 2px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 2px var(--pill-line);
    cursor: pointer; list-style: none; font-size: var(--fs-hand-button); line-height: 1; }
  .bio__sum::-webkit-details-marker { display: none; }
  .bio__sum:hover { background: var(--kk-butter); }
  .bio__sum:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .bio__more[open] .bio__sum { background: var(--kk-ink); color: var(--kk-white); }
  .bio__rest { margin-top: var(--s-7); display: grid; gap: var(--s-5); }
  .bio__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
  .bio__side { display: flex; flex-direction: column; gap: 4px; }
  .bio__side :global(.bio__note) { display: none; }
  .bio__date { margin: 0; color: var(--kk-berry); }
  .bio__p { margin: 0; max-width: 64ch; font-size: clamp(1.0625rem, 1.016rem + .19vw, 1.1875rem); line-height: 1.63; text-wrap: pretty; }
  @media (min-width: 1024px) {
    .bio__sum { margin-left: calc(25% + var(--gutter) * .25); }
    .bio__row { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--gutter); }
    .bio__date { display: none; }
    .bio__side :global(.bio__note) { display: flex; justify-self: end; margin-left: auto; }
  }
  @media (max-width: 767px) {
    .bio__grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .bio__fig { position: static; flex-direction: row; align-items: flex-end; }
    .bio__num { font-size: 6.5rem; }
  }
</style>
