---
/**
 * v4 Delft expertise index (/expertise): the six services as editorial rows. Each row: the service photo (3:2, square,
 * object-fit cover, data-gsap="parallax", zooms 1.04 on hover) in 7 of 12 columns and, beside it, the number "01" in
 * Deep Delft, the name in Bodoni Moda (28 → 40px), the home line (`promise`), "Typical deliverables" as a short list on a
 * thin rule and "Learn more →". The name link covers the whole row. Rows alternate photo left / right from 900px.
 * Pack 3 (brief, Expertise overview): the service icon beside the number, then two short rows under the home line:
 * "Who it is for" (one sentence) and "Typical engagement" (e.g. "Diagnostic sprint, 2–3 weeks").
 * Mobile: photo then text, 64px between rows.
 */
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import ExpertiseIcon from '@/components/ui/ExpertiseIcon.astro';
import { microcopy } from '@/data/microcopy';
import { pillarPage, pillarPhoto } from '@/data/pillars';
import { pillarHref, pillarNumber } from '@/lib/pillars';
import type { Pillar } from '@/data/types';

interface Props { items: Pillar[] }
const { items } = Astro.props;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<ol class="pidx" role="list">
  {items.map((p, i) => (
    <li class:list={['pidx__row', i % 2 === 1 && 'pidx__row--flip']}>
      <article class="pidx__item u-hover">
        <div class="pidx__media u-zoom">
          <Photo
            slug={pillarPhoto[p.key].slug} position={pillarPhoto[p.key].position} ratio="3/2" data-gsap="parallax"
            sizes="(min-width: 1320px) 700px, (min-width: 900px) 56vw, calc(100vw - 40px)"
          />
        </div>
        <div class="pidx__text">
          <p class="pidx__n"><ExpertiseIcon pillar={p.key} size={32} /><span>{pillarNumber(p)}</span></p>
          <h3 class="pidx__title"><a class="pidx__link" href={pillarHref(p.key)}>{p.name}</a></h3>
          <p class="pidx__promise">{p.promise}</p>
          {(p.audience || p.engagement) && (
            <dl class="pidx__facts">
              {p.audience && <div><dt class="t-label">{pillarPage.audience}</dt><dd>{p.audience}</dd></div>}
              {p.engagement && <div><dt class="t-label">{pillarPage.engagement}</dt><dd>{p.engagement}</dd></div>}
            </dl>
          )}
          <div class="pidx__deliv">
            <p class="pidx__dlabel t-label">{pillarPage.deliverables}</p>
            <p class="pidx__dline">{p.deliverables.map((d, n) => <>{n > 0 && <span class="pidx__dot" aria-hidden="true"> · </span>}<span class="pidx__d">{cap(d)}</span></>)}</p>
          </div>
          <p class="pidx__more" aria-hidden="true"><span class="u-draw">{microcopy.pillarLink}</span><Icon name="arrow-right" size={16} stroke={2} class="u-nudge" /></p>
        </div>
      </article>
    </li>
  ))}
</ol>
<style>
  .pidx { list-style: none; margin: 0; padding: 0; display: grid; row-gap: clamp(4rem, 2.5rem + 5vw, 7.5rem); }
  .pidx__item { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s-6); }
  .pidx__media { position: relative; overflow: hidden; }
  .pidx__text { position: relative; padding-top: var(--s-6); border-top: 1px solid var(--rule); }
  .pidx__n { display: flex; align-items: center; gap: var(--s-4); font-size: .875rem; font-weight: 700; color: var(--label); font-variant-numeric: lining-nums tabular-nums; }
  .pidx__facts { margin: var(--s-5) 0 0; display: grid; gap: var(--s-3); }
  .pidx__facts div { display: grid; gap: 2px; }
  .pidx__facts dt { color: var(--label); }
  .pidx__facts dd { margin: 0; font-size: 1rem; line-height: 1.5; color: var(--head); font-weight: 600; max-width: 40ch; text-wrap: pretty; }
  .pidx__title {
    margin-top: var(--s-3);
    font-family: var(--font-serif); font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem); line-height: 1.15; font-weight: 400;
    color: var(--head); text-wrap: balance; max-width: 18ch;
  }
  .pidx__link { color: inherit; text-decoration: none; transition: color var(--d-1) var(--ease-out); }
  .pidx__link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .pidx__link:focus-visible { outline: none; }
  .pidx__item:has(.pidx__link:focus-visible) { outline: 2px solid var(--focus); outline-offset: 8px; }
  .pidx__item:hover .pidx__link { color: var(--link); }
  .pidx__promise { margin-top: var(--s-4); font-size: 1.0625rem; line-height: 1.6; color: var(--fg-2); text-wrap: pretty; max-width: 36ch; }
  .pidx__deliv { margin-top: var(--s-6); padding-top: var(--s-4); border-top: 1px solid var(--rule); }
  .pidx__dlabel { margin-bottom: var(--s-3); }
  .pidx__dline { font-size: 1rem; line-height: 1.6; color: var(--fg-2); max-width: 44ch; }
  .pidx__dot { color: var(--label); font-weight: 700; }
  .pidx__dlist { list-style: none; margin: 0; padding: 0; font-size: 1rem; line-height: 1.5; color: var(--fg); }
  .pidx__dlist li { position: relative; padding-left: 18px; }
  .pidx__dlist li + li { margin-top: 6px; }
  .pidx__dlist li::before { content: ""; position: absolute; left: 0; top: .72em; width: 8px; height: 1px; background: var(--label); }
  .pidx__more { margin-top: var(--s-6); display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-nav); font-weight: 700; color: var(--link); }

  @media (min-width: 900px) {
    .pidx__item { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: center; }
    .pidx__media { grid-column: 1 / 8; grid-row: 1; }
    .pidx__text { grid-column: 9 / -1; grid-row: 1; }
    .pidx__row--flip .pidx__media { grid-column: 6 / -1; }
    .pidx__row--flip .pidx__text { grid-column: 1 / 5; }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .pidx__text { grid-column: 8 / -1; }
    .pidx__row--flip .pidx__text { grid-column: 1 / 6; }
  }
</style>
