---
/**
 * Pack 3 (brief, Deals and due diligence: "a short 'What we look at' checklist … and a sample red-flag summary layout").
 *  1 What we look at (white): six icon tiles on thin rules (assets, process, quality system, people, technology,
 *    capex), one line each. 3 × 2 from 900px, 2 × 3 from 600px, one column on phones.
 *  2 A red-flag summary (Delft Ice): a document mock, a white sheet with a navy header bar and an "Example layout" tag,
 *    holding a real <table> (Area · Finding · Rating · Before signing). Ratings use shape + word, never colour alone
 *    (filled / half / open square); no red (brief: red only for "New" tags). Phones: each row becomes a stacked card.
 * Data: pillars.ts `dealChecklist`, `redFlagSample` (COMPOSED, neutral example rows, labelled as such).
 */
import Section from '@/components/ui/Section.astro';
import Head from './Head.astro';
import LineIcon, { type LineIconName } from './LineIcon.astro';
import { dealChecklist, redFlagSample } from '@/data/pillars';

const icons: Record<string, LineIconName> = {
  assets: 'factory', process: 'cog', quality: 'shield-check', people: 'users', technology: 'cpu', capex: 'banknote',
};
const r = redFlagSample;
---
<Section ground="white" labelledby="look-title">
  <Head id="look-title" title={dealChecklist.title} />
  <ul class="look" role="list">
    {dealChecklist.items.map((it) => (
      <li class="look__item">
        <LineIcon name={icons[it.key]} size={32} />
        <h3 class="look__name">{it.name}</h3>
        <p class="look__line">{it.line}</p>
      </li>
    ))}
  </ul>
</Section>

<Section ground="white" class="band--ice" labelledby="redflag-title">
  <Head id="redflag-title" title={r.title} />
  <figure class="sheet" aria-labelledby="redflag-title">
    <div class="sheet__bar">
      <span class="sheet__doc">Red-flag summary</span>
      <span class="sheet__tag">{r.badge}</span>
    </div>
    <table class="rf">
      <caption class="visually-hidden">{r.badge}: {r.title}. {r.note}</caption>
      <thead>
        <tr>
          <th scope="col">{r.columns.area}</th>
          <th scope="col">{r.columns.finding}</th>
          <th scope="col">{r.columns.rating}</th>
          <th scope="col">{r.columns.action}</th>
        </tr>
      </thead>
      <tbody>
        {r.rows.map((row) => (
          <tr>
            <th scope="row" class="rf__area">{row.area}</th>
            <td class="rf__finding" data-label={r.columns.finding}>{row.finding}</td>
            <td class="rf__rating" data-label={r.columns.rating}>
              <span class:list={['rate', `rate--${row.rating}`]}><span class="rate__sq" aria-hidden="true"></span>{r.ratings[row.rating]}</span>
            </td>
            <td class="rf__action" data-label={r.columns.action}>{row.action}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <figcaption class="sheet__note">{r.note}</figcaption>
  </figure>
</Section>
<style>
  .look { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 var(--grid-gap); }
  .look__item { display: grid; grid-template-columns: 32px minmax(0, 1fr); column-gap: var(--s-4); row-gap: 4px; padding-block: var(--s-5); border-top: 1px solid var(--rule); }
  .look__item :global(.licon) { grid-row: span 2; }
  .look__name { font-family: var(--font-sans); font-size: 1.125rem; line-height: 1.35; font-weight: 700; color: var(--head); }
  .look__line { font-size: 1rem; line-height: 1.55; color: var(--fg-2); text-wrap: pretty; }
  @media (min-width: 600px) { .look { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .look { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .look__item { display: flex; flex-direction: column; gap: var(--s-3); padding-block: var(--s-6) var(--s-7); }
    .look__item :global(.licon) { margin-bottom: var(--s-2); }
  }

  /* the document mock */
  .sheet { margin: 0; max-width: 1040px; background: var(--white); border: 1px solid var(--rule); box-shadow: 0 24px 48px -28px rgba(14, 31, 77, .35); }
  .sheet__bar { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); padding: 14px 20px; background: var(--navy-900); color: var(--white); }
  .sheet__doc { font: 700 var(--fs-small)/1.3 var(--font-sans); letter-spacing: .02em; }
  .sheet__tag { padding: 4px 10px; border: 1px solid var(--saffron); color: var(--saffron); font: 700 var(--fs-label)/1.2 var(--font-sans); letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; }
  .sheet__note { padding: 14px 20px 18px; border-top: 1px solid var(--rule); font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }

  .rf { width: 100%; border-collapse: collapse; font-size: 1rem; line-height: 1.45; color: var(--fg); }
  .rf thead th { padding: 14px 20px; text-align: left; font: 700 var(--fs-label)/1.2 var(--font-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--label); border-bottom: 2px solid var(--head); }
  .rf td, .rf tbody th { padding: 16px 20px; vertical-align: top; border-bottom: 1px solid var(--rule); text-align: left; }
  .rf tbody tr:last-child > * { border-bottom: 0; }
  .rf__area { font-weight: 700; color: var(--head); white-space: nowrap; }
  .rf__action { color: var(--fg-2); }
  .rate { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--head); white-space: nowrap; }
  .rate__sq { width: 14px; height: 14px; border: 2px solid var(--head); flex: none; }
  .rate--high .rate__sq { background: var(--head); }
  .rate--medium .rate__sq { background: linear-gradient(90deg, var(--head) 50%, transparent 50%); }

  /* phones: each row as a small card (header row hidden; the cells carry their labels) */
  @media (max-width: 699px) {
    .rf thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .rf, .rf tbody, .rf tr, .rf td, .rf tbody th { display: block; width: 100%; }
    .rf tr { padding: 16px 20px; border-bottom: 1px solid var(--rule); }
    .rf tbody tr:last-child { border-bottom: 0; }
    .rf td, .rf tbody th { padding: 0; border: 0; }
    .rf tbody th { font-size: 1.0625rem; margin-bottom: 6px; }
    .rf td + td { margin-top: 8px; }
    .rf td::before { content: attr(data-label); display: block; margin-bottom: 2px; font: 700 var(--fs-label)/1.3 var(--font-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--label); }
    .sheet__bar, .sheet__note { padding-inline: 16px; }
  }
</style>
