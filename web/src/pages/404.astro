---
/** 404 (DESIGN-SPEC 5.12). White, centred, noindex (BaseLayout forces it for page="notfound"). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reconnect from '@/components/notfound/Reconnect.astro';
import Button from '@/components/ui/Button.astro';
import { microcopy } from '@/data/microcopy';
import { pageSeo } from '@/lib/seo';
---
<BaseLayout page="notfound" seo={pageSeo('notfound')}>
  <section class="nf" aria-labelledby="nf-title">
    <div class="container nf__inner">
      <Reconnect />
      <h1 class="t-h1 nf__title" id="nf-title">{microcopy.notFoundHeadline}</h1>
      <p class="t-lead nf__line">{microcopy.notFoundLine}</p>
      <div class="nf__cta">
        <Button href="/" variant="primary" arrow data-take-home>{microcopy.takeHome}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: calc(100svh - var(--header-h));
    display: grid; align-items: center;
    padding-block: var(--s-8);
    background: var(--c-ground);
  }
  .nf__inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .nf__title { margin: var(--s-6) 0 0; max-width: 18em; text-wrap: balance; }
  .nf__line { margin: var(--s-4) auto 0; color: var(--c-meta); }
  .nf__cta { margin-top: var(--s-7); }
</style>
