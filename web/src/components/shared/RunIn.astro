---
/** Run-in list (v1 5.0.7, v2 7.8): inline items separated by aria-hidden middots in Bricolage; or `variant="stickers"`:
 * each item a rotated pill sticker (tints cycling, R4 drop), still a <ul>. */
interface Props { items: { label: string; href?: string }[]; size?: 'h3' | 'lead'; variant?: 'run-in' | 'stickers'; drop?: boolean; class?: string; label?: string; }
const { items, size = 'h3', variant = 'run-in', drop = true, class: cls, label } = Astro.props;
const TINTS = ['butter', 'ice', 'lavender', 'blush'];
const ROT = [-3, 2, -1.5, 3, -2, 1];
---
{variant === 'stickers' ? (
<ul class:list={['run-in', 'run-in--stickers', cls]} aria-label={label}>
  {items.map((it, i) => (
    <li data-sticker={drop ? '' : undefined}><span class={`run-in__sticker g-${TINTS[i % TINTS.length]}`} style={`--rot:${ROT[i % ROT.length]}deg`}>{it.href ? <a href={it.href}>{it.label}</a> : it.label}</span></li>
  ))}
</ul>
) : (
<ul class:list={['run-in', `run-in--${size}`, cls]} aria-label={label}>
  {items.map((it, i) => (
    <li>{it.href ? <a href={it.href}>{it.label}</a> : it.label}{i < items.length - 1 && <span class="run-in__sep" aria-hidden="true">{"\u00A0· "}</span>}</li>
  ))}
</ul>
)}
<style>
  .run-in { list-style: none; margin: 0; padding: 0; max-width: 26em; color: var(--head); text-wrap: balance; }
  .run-in li { display: inline; }
  .run-in--h3 { font-family: var(--font-display); font-size: var(--fs-h3); line-height: 1.2; font-weight: 700; font-stretch: 85%; letter-spacing: -0.01em; }
  .run-in--lead { font-family: var(--font-mono); font-size: var(--fs-lead); line-height: 1.6; max-width: var(--measure-lead); }
  .run-in__sep { color: var(--fg-2); font-weight: 400; }
  .run-in a { color: inherit; text-decoration: none; text-underline-offset: 6px; text-decoration-thickness: 2px; text-decoration-color: var(--link); }
  .run-in a:is(:hover, :focus-visible) { text-decoration-line: underline; }
  /* v2 stickers variant: every item a rotated pill sticker, tints cycling; still a <ul> */
  .run-in--stickers { display: flex; flex-wrap: wrap; gap: 18px 14px; max-width: none; padding: 6px; }
  .run-in--stickers li { display: block; }
  .run-in__sticker {
    display: inline-block; padding: 10px 18px 12px; border-radius: var(--r-pill);
    font: 700 1.125rem/1.15 var(--font-display); font-stretch: 90%; color: var(--kk-ink);
    box-shadow: 0 0 0 5px var(--kk-white), var(--shadow-sticker); rotate: var(--rot);
  }
  .run-in__sticker a { color: inherit; }
</style>
