---
/**
 * SEO head (DESIGN-SPEC 3.7). BaseLayout renders charset, viewport and the
 * flags script first; this renders items 3–10 in order.
 */
import { indexable } from '@/lib/mode';
import JsonLd from './JsonLd.astro';
import { abs, canonicalFor, type SeoProps } from './schema';
import { OG_IMAGE, OG_ALT } from '@/lib/seo';
import { site } from '@/config/site';

export type { SeoProps };
interface Props { seo: SeoProps }
const { seo } = Astro.props;

const canonical = canonicalFor(seo.path);
// Indexing is decoupled from content mode (§8.5): only an opted-in production build is indexable.
const robots = !indexable || seo.noindex ? 'noindex, nofollow' : 'index, follow';
// Pack 3 lead decision 6: one social share image for every page (seo.ogImage is ignored).
const ogImage = abs(OG_IMAGE);
const ogType = seo.ogType ?? 'website';
const graph = seo.jsonLd ?? [];
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0E1F4D" />
<meta property="og:site_name" content="KoKreaters" />
<meta property="og:locale" content="en_GB" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_ALT} />
{seo.article?.published && <meta property="article:published_time" content={seo.article.published} />}
{seo.article?.modified && <meta property="article:modified_time" content={seo.article.modified} />}
{seo.article?.section && <meta property="article:section" content={seo.article.section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={OG_ALT} />
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
{site.plausibleDomain && <script is:inline defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
<JsonLd graph={graph} />
