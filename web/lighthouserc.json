{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/astro/bin/astro.mjs preview --host 127.0.0.1 --port 4331 --ignore-lock",
      "startServerReadyPattern": "ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:4331/",
        "http://127.0.0.1:4331/about",
        "http://127.0.0.1:4331/expertise/food-safety-quality",
        "http://127.0.0.1:4331/insights"
      ],
      "numberOfRuns": 3,
      "chromePath": "/usr/bin/google-chrome",
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
