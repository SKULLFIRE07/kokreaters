---
/**
 * HeroNetwork (DESIGN-SPEC v2 10.1 F1, signature move 1). Decorative (aria-hidden), a toy (data-toy, data-cursor="pull").
 * viewBox 0 0 640 600. Centre: a white die-cut sticker (r 150) holding the logo node cluster at true colours (the
 * header's own cluster file, so dock.ts can Flip it into [data-dock-slot] with an identical box). Six pillar nodes hang
 * off the cluster's Saffron centre on elastic strings (quadratic curves; hero.ts springs them). Ships fully drawn: no-JS
 * and reduced motion see the finished network. The logo's five nodes never move relative to each other.
 */
import clusterRaw from '@/assets/brand/svg/derived/horizontal-cluster.svg?raw';
import { pillars, heroNodeLabels } from '@/data/pillars';
import type { PillarKey } from '@/data/types';

const C = { x: 320, y: 300 };
const R = 248;
const ANG: Record<PillarKey, number> = { innovation: 200, process: 255, quality: 315, strategy: 15, deals: 75, capability: 135 };
// cluster box: 230 wide, aspect 570 × 615 (viewBox 20 −25 570 615); placed so its Saffron node (291, 316) sits on C
const CW = 230, k = CW / 570, CH = Math.round(615 * k);
const cx = +(C.x - (291 - 20) * k).toFixed(1), cy = +(C.y - (316 + 25) * k).toFixed(1);
const inner = clusterRaw.replace(/<!--[\s\S]*?-->/g, '').replace(/\s+id="[^"]*"/g, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();

const nodes = pillars.map((p) => {
  const a = (ANG[p.key] * Math.PI) / 180;
  const x = +(C.x + R * Math.cos(a)).toFixed(1), y = +(C.y + R * Math.sin(a)).toFixed(1);
  const label = heroNodeLabels[p.key].toUpperCase();
  const w = Math.round(label.length * 7.6 + 22);
  // label pill below the node, or above for nodes in the top half
  const above = y < C.y - 60;
  const ly = above ? y - 36 - 26 : y + 34;
  let lx = x - w / 2;
  lx = Math.max(4, Math.min(640 - 4 - w, lx));
  return { key: p.key, x, y, label, w, lx, ly };
});
const mx = (n: { x: number; y: number }) => ({ qx: +((C.x + n.x) / 2).toFixed(1), qy: +((C.y + n.y) / 2 + 14).toFixed(1) });
---
<svg class="hero-network" viewBox="0 0 640 600" aria-hidden="true" focusable="false" data-hero-network data-toy data-cursor="pull">
  <g data-hero="sticker" class="hn-sticker">
    <circle cx={C.x + 4} cy={C.y + 12} r="152" class="hn-sticker__shadow" />
    <circle cx={C.x} cy={C.y} r="152" class="hn-sticker__edge" />
    <circle cx={C.x} cy={C.y} r="146" class="hn-sticker__face" />
    <circle cx={C.x} cy={C.y} r="132" class="hn-sticker__dash" />
  </g>

  <g data-hero="strings" data-hero-hide class="hn-strings">
    {nodes.map((n) => { const q = mx(n); return <path data-string={n.key} d={`M${C.x} ${C.y} Q${q.qx} ${q.qy} ${n.x} ${n.y}`} />; })}
  </g>

  <g data-hero="cluster">
    <svg class="hn-cluster" x={cx} y={cy} width={CW} height={CH} viewBox="20 -25 570 615" set:html={inner} />
  </g>

  <g data-hero="pillars" data-hero-hide class="hn-pillars">
    {nodes.map((n) => (
      <g class="hn-pillar" data-p={n.key} data-x={n.x} data-y={n.y}>
        <g class="hn-label" transform={`translate(${n.lx} ${n.ly})`}>
          <rect width={n.w} height="26" rx="13" />
          <text x={n.w / 2} y="17.5" text-anchor="middle">{n.label}</text>
        </g>
        <g class="hn-node">
          <circle cx={n.x} cy={n.y} r="26" class="hn-hit" />
          <circle cx={n.x} cy={n.y} r="24.5" fill="none" stroke="var(--kk-ink)" stroke-width="1.5" />
          <circle cx={n.x} cy={n.y} r="23.75" fill="#fff" />
          <circle cx={n.x} cy={n.y} r="18" fill={`var(--pillar-${n.key})`} />
        </g>
      </g>
    ))}
  </g>
</svg>

<style>
  .hero-network { display: block; width: 100%; height: auto; overflow: visible; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .hn-sticker__shadow { fill: rgba(18, 24, 51, .16); }
  .hn-sticker__edge { fill: #fff; stroke: var(--kk-ink); stroke-width: 1.5; }
  .hn-sticker__face { fill: #fff; }
  .hn-sticker__dash { fill: none; stroke: var(--kk-hairline); stroke-width: 1.5; stroke-dasharray: 3 7; }
  .hn-strings path { fill: none; stroke: var(--kk-ink); stroke-width: 3; stroke-linecap: round; }
  .hn-cluster { overflow: visible; }
  .hn-node { cursor: grab; transform-box: fill-box; transform-origin: center; }
  .hn-hit { fill: transparent; }
  .hn-label rect { fill: #fff; stroke: var(--kk-ink); stroke-width: 1.5; }
  .hn-label text { font-family: var(--font-mono); font-weight: 500; font-size: 11.5px; letter-spacing: .06em; fill: var(--kk-ink); }
  .hero-network.is-grabbing, .hero-network.is-grabbing .hn-node { cursor: grabbing; }
  @media (max-width: 767px) {
    .hn-label { display: none; }
  }
</style>
