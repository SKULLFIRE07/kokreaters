---
/**
 * /industries (v4 Delft). Grounds: navy photo hero → white (six featured industries with photos) → Porcelain (the rest)
 * → CtaBand (BaseLayout) → footer.
 *  1 PillarHero: sunflower seeds (the raw material many of these industries start from) under the navy gradient;
 *    crumbs, label "Industries", H1 "Where we work", the intro's first sentence as the lead.
 *  2 IndustriesGrid: the rest of the intro as the section lead, the six photo cards, then "Also where we work".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHero from '@/components/expertise/PillarHero.astro';
import IndustriesGrid from '@/components/industries/IndustriesGrid.astro';
import { industriesPage } from '@/data/industries';
import { photos } from '@/data/photos';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: industriesPage.overline, href: '/industries' }];
const photo = photos['oilseeds-01'];
const [first, ...rest] = industriesPage.lead.split(/(?<=\.)\s+/);
---
<BaseLayout page="industries" seo={pageSeo('industries')} breadcrumbs={crumbs}>
  <PillarHero
    eyebrow={industriesPage.overline} title={industriesPage.headline} lead={first} crumbs={crumbs}
    image={photo.src} imageAlt={photo.alt} imagePosition={photo.position} titleId="industries-title"
  />
  <IndustriesGrid lead={rest.join(' ')} />
</BaseLayout>
