---
/** /industries (DESIGN-SPEC 5.4). No lead: the brief has none (C-15). CtaField comes from BaseLayout. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/chrome/Breadcrumbs.astro';
import Confirm from '@/components/ui/Confirm.astro';
import SectorIndex from '@/components/industries/SectorIndex.astro';
import SectorSection from '@/components/industries/SectorSection.astro';
import { industries, industriesPage } from '@/data/industries';
import { pageSeo } from '@/lib/seo';

const crumbs = [{ label: 'Industries', href: '/industries' }];
---
<BaseLayout page="industries" seo={pageSeo('industries')} breadcrumbs={crumbs} showCrumbs={false}>
  <section class="band ind-head" aria-labelledby="industries-title">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="ind-head__text">
        <p class="t-dateline ind-head__dateline">{industriesPage.overline}</p>
        <h1 id="industries-title" class="t-h1 ind-head__title">{industriesPage.headline}</h1>
        <Confirm id="C-15" note="industries intro" />
      </div>
    </div>
  </section>
  <div class="band ind-body">
    <div class="container grid ind-body__grid">
      <div class="ind-body__index"><SectorIndex /></div>
      <div class="ind-body__sectors">
        {industries.map((i) => <SectorSection industry={i} />)}
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .ind-head { padding-top: var(--s-5); padding-bottom: 0; }
  .ind-head__text { margin-top: var(--s-9); }
  .ind-head__dateline { margin: 0 0 var(--s-5); }
  .ind-head__title { margin: 0 0 var(--s-3); }
  .ind-body { padding-top: var(--s-9); }
  .ind-body__grid { row-gap: var(--s-7); align-items: start; }
  .ind-body__index, .ind-body__sectors { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .ind-body__index { grid-column: 1 / 4; align-self: stretch; }
    .ind-body__sectors { grid-column: 4 / 13; }
  }
  @media (max-width: 767px) { .ind-head__text { margin-top: var(--s-7); } .ind-body { padding-top: var(--s-7); } }
</style>
