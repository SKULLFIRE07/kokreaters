---
/**
 * /impact (pack 2, brief items 7, 8, 27–30). Grounds: navy photo hero (stainless process tanks) → Porcelain (the
 * Impact strip and its footnote) → white (the nine stories: filters, grid, accordions, "Show all stories")
 * → (engagements / testimonials, only when cleared) → ImpactCta (Deep Delft, two buttons) → footer.
 * The brief's intro opens with the page title ("Results that started on the plant floor."): the H1 carries that
 * sentence and the lead carries the rest, so it is said once.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHero from '@/components/expertise/PillarHero.astro';
import TrackRecord from '@/components/impact/TrackRecord.astro';
import StoryGrid from '@/components/impact/StoryGrid.astro';
import Engagements from '@/components/impact/Engagements.astro';
import Testimonials from '@/components/impact/Testimonials.astro';
import ImpactCta from '@/components/impact/ImpactCta.astro';
import { engagements, impactPage } from '@/data/impact';
import { photos } from '@/data/photos';
import { pageSeo } from '@/lib/seo';
import { showPendingConsent } from '@/lib/mode';

const crumbs = [{ label: impactPage.overline, href: '/impact' }];
const hero = photos['scale-tanks'];

// Ground rhythm after the (white) stories: engagements grey, testimonials the other ground.
const hasEngagements = engagements.some((e) => e.consent === 'cleared' || showPendingConsent);
const engGround = 'grey' as const;
const quoteGround = hasEngagements ? ('white' as const) : ('grey' as const);
---
<BaseLayout page="impact" seo={pageSeo('impact')} breadcrumbs={crumbs} cta={false}>
  <PillarHero
    eyebrow={impactPage.overline} title={impactPage.headline} lead={impactPage.lead} crumbs={crumbs}
    image={hero.src} imageAlt={hero.alt} imagePosition={hero.position} titleId="impact-title"
  />
  <TrackRecord ground="grey" />
  <StoryGrid ground="white" />
  <Engagements ground={engGround} />
  <Testimonials ground={quoteGround} />
  <ImpactCta />
</BaseLayout>
