---
/** Folio as a notebook tab (DESIGN-SPEC v2 7.7): `[01]` in a 28px ringed circle + mono label + a dashed 1.5px --fg rule
 * (perforation) + the right running head (≥ 768). */
interface Props { n?: string; label: string; right?: string; class?: string; }
const { n, label, right, class: cls } = Astro.props;
---
<div class:list={['folio', cls]}>
  <div class="folio__row">
    {n && <span class="folio__n tnum" aria-hidden="true">{n}</span>}
    <p class="t-label folio__label">{n && <span class="visually-hidden">{n} · </span>}{label}</p>
    <span class="folio__rule" data-rule aria-hidden="true"></span>
    {right && <p class="t-micro folio__right" aria-hidden="true">{right}</p>}
  </div>
</div>
<style>
  .folio { margin-bottom: var(--s-8); }
  .folio__row { display: flex; align-items: center; gap: 12px; }
  .folio__n {
    flex: none; display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    border: 1.5px solid var(--fg); font: 500 12px/1 var(--font-mono); color: var(--fg);
  }
  .folio__label, .folio__right { margin: 0; color: var(--fg); white-space: nowrap; }
  .folio__rule { flex: 1 1 auto; min-width: 24px; height: 0; border-top: 1.5px dashed var(--fg); opacity: .6; }
  .folio__right { display: none; color: var(--fg-2); }
  @media (min-width: 768px) { .folio__right { display: block; } }
  @media (max-width: 479px) { .folio__label { white-space: normal; } }
</style>
