---
/**
 * Exhibit (DESIGN-SPEC 5.8 item 6): numbered figure. Title states the finding; the source
 * is the figcaption. Qualitative only until the author supplies data (4.13).
 */
import { microcopy } from '@/data/microcopy';
interface Props { n: number | string; title: string; subtitle?: string; source: string; }
const { n, title, subtitle, source } = Astro.props;
const tid = `exhibit-${n}-title`;
---
<figure class="exhibit" aria-labelledby={tid} data-reveal>
  <div class="exhibit__head">
    <p class="exhibit__n t-label">{microcopy.exhibit} <span class="tnum">{String(n).padStart(2, '0')}</span></p>
    <p class="exhibit__title" id={tid}>{title}</p>
    {subtitle && <p class="exhibit__subtitle t-meta">{subtitle}</p>}
  </div>
  <div class="exhibit__body table-wrap" tabindex="0" role="region" aria-labelledby={tid}><slot /></div>
  <figcaption class="exhibit__source">{microcopy.source}: {source}</figcaption>
</figure>
<style>
  /* v2 10.9: a SpecLabel-style frame: 2px Ink border, heavy rule under the title, "Exhibit 0n" mono chip. */
  .exhibit {
    margin-block: var(--s-8);
    padding: var(--s-6);
    border: 2px solid var(--kk-ink); border-radius: 20px;
    background: var(--kk-white);
    box-shadow: var(--shadow-hard);
    font-family: var(--font-sans);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .exhibit p { margin: 0; }
  .exhibit__head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); padding-bottom: var(--s-4); margin-bottom: var(--s-5); border-bottom: 10px solid var(--kk-ink); }
  .exhibit__n { padding: 5px 12px; border-radius: 999px; background: var(--kk-saffron); color: var(--kk-ink); box-shadow: inset 0 0 0 1.5px var(--kk-ink); }
  .exhibit__title {
    font-family: var(--font-display); font-weight: 760; font-stretch: 80%;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); line-height: 1; letter-spacing: -0.015em;
    color: var(--kk-ink); text-wrap: balance;
  }
  .exhibit__subtitle { font-family: var(--font-mono); font-size: 13px; color: var(--kk-graphite); }
  .exhibit__body { overflow-x: auto; max-width: 100%; }
  .exhibit__body :global(table) { min-width: 520px; margin: 0; }
  .exhibit__body :global(thead th) { white-space: nowrap; }
  .exhibit__body :global(td:first-child) { font-weight: 600; color: var(--kk-ink); }
  .exhibit__source { margin-top: var(--s-5); padding-top: var(--s-3); border-top: 3px solid var(--kk-ink); font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--kk-graphite); }
  @media (min-width: 900px) { .exhibit { margin-inline: -48px; padding: var(--s-7); } }
  @media (max-width: 767px) { .exhibit { padding: var(--s-5); } }
</style>
