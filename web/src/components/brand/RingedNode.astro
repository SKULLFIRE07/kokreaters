---
/**
 * The ringed node (brief 3.4): White fill, 1.5px ring, optional inner dot; or, with `image`,
 * a ringed avatar (40px byline, 48px contact, 72px author box) with a 2px White knockout.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  size?: number;
  ring?: string;            // CSS colour, default Sapphire
  ringWidth?: number;       // px, default 1.5 (2 for avatars)
  dot?: boolean;            // inner dot (node mode)
  image?: ImageMetadata;
  alt?: string;
  class?: string;
  [key: string]: unknown;
}
const { size = 24, ring = 'var(--c-line)', ringWidth, dot = true, image, alt = '', class: cls, ...rest } = Astro.props;
const rw = ringWidth ?? (image ? 2 : 1.5);
const inner = Math.max(4, Math.round(size * 0.25));
---
{image ? (
  <span class:list={['ringed', 'ringed--avatar', cls]} style={`--size:${size}px;--ring:${ring};--rw:${rw}px`} {...rest}>
    <Image src={image} alt={alt} width={size} height={size} widths={[size, size * 2]} sizes={`${size}px`} loading="lazy" decoding="async" />
  </span>
) : (
  <svg class:list={['ringed', cls]} width={size} height={size} viewBox={`0 0 ${size} ${size}`} aria-hidden="true" focusable="false" {...rest}>
    <circle cx={size / 2} cy={size / 2} r={size / 2 - rw} fill="#fff" stroke={ring} stroke-width={rw} />
    {dot && <circle data-ring cx={size / 2} cy={size / 2} r={inner / 2 + 1} fill={ring} />}
  </svg>
)}
<style>
  .ringed { display: inline-block; flex: none; vertical-align: middle; overflow: visible; }
  .ringed--avatar {
    width: var(--size); height: var(--size); border-radius: 50%;
    box-shadow: 0 0 0 2px var(--kk-white), 0 0 0 calc(2px + var(--rw)) var(--ring);
    overflow: hidden; margin: calc(2px + var(--rw));
  }
  .ringed--avatar :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
