---
/**
 * /approach §6 — FAQ (REDESIGN-V3 §4 Approach, §8.8). White band. Native <details> Accordion (works without JS).
 * Answers come from data/approach.ts `faq` (drafted for approval 10 Nov 2026; none carries `confirm` today). An answer
 * that carries `confirm` gets a <Confirm id="C-22"> tag under the accordion in staging only (plain-text answers).
 * Desktop (≥ 900): heading in columns 1–4, accordion in columns 6–12 (asymmetric reading layout).
 * Mobile: one column — heading, then the accordion full width (summary rows ≥ 56px).
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { faq, faqHeading } from '@/data/approach';
import { showConfirm } from '@/lib/mode';

/** Keep number ranges whole ("2–5 days" never breaks after the dash), as in the models table. */
const bind = (s: string) => s.replace(/(\d)–(\d)/g, '$1–\u2060$2');
const items = faq.map(({ q, a }) => ({ q, a: bind(a) }));
const pending = faq.map((f, i) => ({ n: i + 1, note: f.confirm })).filter((f) => f.note);
---
<Section ground="white" labelledby="faq-h" class="faq">
  <div class="grid-12">
    <div style="--col: 1 / 5">
      <SectionHeader id="faq-h" title={faqHeading} class="faq__head" />
    </div>
    <div style="--col: 6 / -1" data-reveal>
      <Accordion id="approach-faq" items={items} />
      {showConfirm && pending.length > 0 && (
        <p class="faq__confirm">
          {pending.map((p) => <Confirm id="C-22" note={`FAQ ${p.n}, ${p.note}`} />)}
        </p>
      )}
    </div>
  </div>
</Section>
<style>
  .faq__confirm { margin-top: var(--s-4); display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (min-width: 900px) {
    .faq :global(.faq__head) { margin-bottom: 0; }
  }
</style>
