---
/**
 * Approach F3, the report (DESIGN-SPEC v2 10.5 F3): Butter ground, grid 6/6. Left: the promise's first sentence as the
 * h2 (brief copy, verbatim) and the second as the lead; right: the Crumple toy (bencho port).
 */
import Crumple from '@/components/bencho/Crumple.astro';
import Scribble from '@/components/notes/Scribble.astro';
import { positioning } from '@/data/home';
import { storyNotes } from '@/data/notes/story';
const [first, ...rest] = positioning.promise.split(/(?<=\.)\s+/);
const second = rest.join(' ');
const words = first.replace(/\.$/, '').split(' ');
const tail = words.splice(-2).join(' ');   // "and leave"
---
<section class="report g-butter grain" aria-labelledby="report-title">
  <div class="container report__grid">
    <div class="report__text">
      <h2 id="report-title" class="report__h2" data-reveal>{words.join(' ')} <Scribble kind="underline" tone="berry">{tail}</Scribble>.</h2>
      <p class="t-lead report__lead">{second}</p>
    </div>
    <Crumple file={storyNotes.crumple.file} button={storyNotes.crumple.button} reset={storyNotes.crumple.reset} after={storyNotes.crumple.after} class="report__toy" />
  </div>
</section>
<style>
  .report { padding-block: var(--section); overflow: clip; }
  .report__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-8); align-items: center; }
  .report__h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-stretch: 75%; letter-spacing: -.025em; line-height: .92;
    font-size: clamp(2.75rem, 1rem + 5.2vw, 6.5rem); color: var(--head); text-wrap: balance; }
  .report__lead { margin: var(--s-6) 0 0; max-width: 40ch; }
  .report :global(.report__toy) { align-items: center; }
  @media (max-width: 899px) { .report__grid { grid-template-columns: 1fr; } }
</style>
