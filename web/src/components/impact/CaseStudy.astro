---
/**
 * One founder-career case (REDESIGN-V3 §4 Impact): eyebrow (context) → h3 (outcome) → photo → figure highlight →
 * The challenge / What was done / The result as a definition row → tags (expertise + industry links).
 * `id` = the result id (#india · #indonesia · #ukraine · #tfa), deep-linked from /expertise/<slug>.
 * Null fields: staging shows the row with <Confirm id="C-9">; preview/production omit the row (no "—").
 * A row whose text only repeats the headline (India's result = its outcome; Indonesia's "21% growth.") is not shown:
 * the h3 and the figure already say it, so each fact is said once. No fact is lost.
 * No per-figure source line: the section h2 ("From our founder’s career") and the eyebrow's employer attribute every
 * case, which keeps the four cases identical in structure (only two of them carry figure.source).
 * The eyebrow is the data's `context` with its trailing "From our founder’s career (Wilmar)" shortened to the employer
 * ("Process · Ukraine · Wilmar"): the section h2 already says "From our founder’s career".
 *
 * Desktop (≥ 900): 2px navy rule, then a 12-column grid. Head (eyebrow + h3) in columns 1–6 at the top, the figure(s)
 *   in columns 1–6 a fixed --s-7 (48px) under the h3 in every case (one rhythm for all four); photo 3:2 (FOUNDATION §6 feature ratio) in columns 8–12 spanning
 *   both. Below, full width: the definition row with hairlines (3 rows → 4 + 4 + 4 columns; 2 rows → 1–6 and 8–12,
 *   aligned with head and photo; 1 row → 1–6). The iTFA definition sits under the row that uses the term.
 * Tablet (600–899): head full width; photo (5 of 12) beside the figure block (7, bottom-aligned); rows as columns.
 * Mobile (< 600): one column in reading order: eyebrow, h3, photo (3:2, full width), figure(s) side by side with a
 *   hairline divider, the rows stacked (label over text, hairline above each), tags wrapping.
 */
import Photo from '@/components/ui/Photo.astro';
import Tag from '@/components/ui/Tag.astro';
import Confirm from '@/components/ui/Confirm.astro';
import type { FounderResult } from '@/data/types';
import type { Photo as PhotoRecord } from '@/data/photos';
import { impactPage, secondaryFigures, figureFallback, figureCaptions } from '@/data/impact';
import { industries } from '@/data/industries';
import { getPillar, pillarHref } from '@/lib/pillars';
import { abbreviations } from '@/lib/typography';
import { showConfirm } from '@/lib/mode';

interface Props { result: FounderResult; photo: PhotoRecord }
const { result, photo } = Astro.props;
const { labels } = impactPage;
const titleId = `case-${result.id}-title`;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// "… · From our founder’s career (Wilmar)" → "… · Wilmar"
const eyebrow = result.context
  .split(' · ')
  .map((part) => (part.startsWith(impactPage.partOne) ? (/\(([^)]+)\)\s*$/.exec(part)?.[1] ?? '') : part))
  .filter(Boolean)
  .join('\u00A0· ');   // NBSP before the dot: a wrapped line never starts with "·"

// Keep short hyphenated compounds whole ("world-class", "Director-General") so a line never ends on a hyphen.
// Long ones ("design-to-execution") may still break in narrow columns.
const keepCompounds = (h: string) => h.replace(/(?<![\w-])([\w’]+(?:-[\w’]+)+)(?![\w-])/g, (m) => (m.length <= 18 ? `<span class="nowrap">${m}</span>` : m));
const outcomeHtml = keepCompounds(esc(result.outcome));

// Figure highlight: the data's figure, else the derived fallback ('1st', 'WHO'); Ukraine adds its second figure.
const main = result.figure?.value ?? figureFallback[result.id];
const values = [main, secondaryFigures[result.id]].filter((v): v is string => !!v);
const figures = values.map((value) => ({ value, caption: figureCaptions[result.id]?.[value] }));

// <abbr> on the first iTFA (C-11) + the short definition under the rows.
let itfa = false;
const withAbbr = (t: string) => {
  let h = keepCompounds(esc(t));
  if (!itfa && h.includes('iTFA')) { h = h.replace('iTFA', `<abbr title="${abbreviations.iTFA.title}">iTFA</abbr>`); itfa = true; }
  return h;
};
// A row that only repeats the headline (word for word, ignoring case and punctuation) is left out.
const norm = (t: string) => ` ${t.toLowerCase().replace(/[^\p{L}\p{N}%]+/gu, ' ').trim()} `;
const restatesHeadline = (t: string | null) => t !== null && norm(result.outcome).includes(norm(t));
const rows = [
  { key: 'challenge', label: labels.challenge, value: result.challenge },
  { key: 'done', label: labels.done, value: result.done },
  { key: 'result', label: labels.result, value: result.result },
]
  .filter((r) => (r.value !== null || showConfirm) && !restatesHeadline(r.value))
  .map((r) => {
    const had = itfa;
    const html = r.value === null ? null : withAbbr(r.value);
    return { ...r, html, note: !had && itfa };   // the iTFA definition sits in the row that uses the term
  });

// Tags: expertise (pillar pages, full name) + industry (the sector's /industries anchor; sectors carry industries.ts names)
const industryFor = (s: string) => {
  const k = s.toLowerCase();
  return industries.find((i) => i.name.toLowerCase() === k) ?? industries.find((i) => i.name.toLowerCase().startsWith(k));
};
const tags = [
  ...result.pillars.map((k) => ({ label: getPillar(k).name, href: pillarHref(k) })),
  ...result.sectors.map((s) => { const i = industryFor(s); return { label: s, href: i ? `/industries#${i.slug}` : undefined }; }),
];
---
<article id={result.id} class="case" aria-labelledby={titleId}>
  <header class="case__head" data-reveal>
    <p class="case__eyebrow t-label">{eyebrow}</p>
    <h3 id={titleId} class="case__title" set:html={outcomeHtml} />
  </header>

  <div class="case__media" data-reveal style="--i:1">
    <Photo
      src={photo.src} alt={photo.alt} position={photo.position} ratio="3/2" data-settle
      sizes="(min-width: 1200px) 480px, (min-width: 600px) 40vw, calc(100vw - 40px)"
    />
  </div>

  {figures.length > 0 && (
    <div class="case__fig" data-reveal style="--i:2">
      <ul class:list={['case__figs', figures.length > 1 && 'case__figs--pair']} role="list">
        {figures.map((f) => (
          <li class="case__figure">
            <span class="case__value t-stat">{f.value}</span>
            {f.caption && <span class="case__caption">{f.caption}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}

  {rows.length > 0 && (
    <dl class="case__rows" data-n={rows.length} data-reveal>
      {rows.map((r) => (
        <div class="case__row" data-row={r.key}>
          <dt class="case__dt t-label">{r.label}</dt>
          <dd class="case__dd">{r.html === null ? <Confirm id="C-9" note="case detail" /> : <Fragment set:html={r.html} />}</dd>
          {r.note && <dd class="case__note">{abbreviations.iTFA.note}</dd>}
        </div>
      ))}
    </dl>
  )}

  {tags.length > 0 && (
    <ul class="case__tags" role="list" aria-label={impactPage.tagsLabel}>
      {tags.map((t) => <li><Tag href={t.href}>{t.label}</Tag></li>)}
    </ul>
  )}
</article>

<style>
  .case {
    display: grid; grid-template-columns: minmax(0, 1fr);
    padding-top: var(--s-6); border-top: 2px solid var(--rule-strong);
    scroll-margin-top: calc(var(--scroll-offset) + var(--s-6));   /* /impact#<id> lands with the rule clear of the header */
  }
  .case__eyebrow { max-width: 60ch; }
  .case__title {
    margin-top: var(--s-4); max-width: 36ch;   /* WHO headline sets in 2 lines in the 6-column head */
    font-size: calc(var(--fs-h2) * .8); line-height: 1.18; font-weight: 440; letter-spacing: var(--tr-h2);
  }
  .case__media { margin-top: var(--s-6); }

  /* figure highlight: serif figure in --figure (accent on light), caption under it, hairline between a pair */
  .case__fig { margin-top: var(--s-6); }
  .case__figs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-4) 0; }
  .case__figure { display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .case__figs--pair .case__figure { flex: 1 1 0; }
  .case__figure + .case__figure { margin-left: var(--s-5); padding-left: var(--s-5); border-left: 1px solid var(--rule); }
  .case__value { color: var(--figure); white-space: nowrap; }
  .case__caption { font-size: var(--fs-small); line-height: var(--lh-small); color: var(--fg); max-width: 24ch; text-wrap: pretty; }

  /* The challenge / What was done / The result */
  .case__rows { margin: var(--s-7) 0 0; display: grid; }
  .case__row { padding-block: var(--s-4) var(--s-5); border-top: 1px solid var(--rule); }
  .case__row:last-child { border-bottom: 1px solid var(--rule); }
  .case__dt { color: var(--fg-2); }
  .case__dd { margin: var(--s-2) 0 0; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg); max-width: 52ch; }
  .case__row[data-row='result'] .case__dd { color: var(--head); font-weight: 500; }
  .case__dd :global(abbr) { text-decoration-thickness: 1px; text-underline-offset: .18em; cursor: help; }

  .case__note { margin: var(--s-3) 0 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .case__tags { list-style: none; margin: var(--s-5) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-2); }   /* 32px tags + 12px rows ≈ 44px pitch on touch */

  /* Tablet: head full width; photo (5) beside the figure (7, on the photo's bottom line); rows as columns */
  @media (min-width: 600px) and (max-width: 899px) {
    .case { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--grid-gap); }
    .case__head, .case__rows, .case__tags { grid-column: 1 / -1; }
    .case__media { grid-column: 1; }
    .case__fig { grid-column: 2; align-self: end; }
    .case__rows { grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .case__rows[data-n='2'] { --n: 2; }
    .case__rows[data-n='1'] { --n: 1; }
    .case__row, .case__row:last-child { border-bottom: 0; padding-block: var(--s-4) 0; }
  }

  @media (min-width: 900px) {
    .case {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap);
      grid-template-rows: auto 1fr;   /* row 1 = the head's own height; a taller photo grows row 2, never the head row */
      padding-top: var(--s-7);
    }
    .case__head { grid-column: 1 / 7; grid-row: 1; }
    .case__fig { grid-column: 1 / 7; grid-row: 2; align-self: start; margin-top: var(--s-7); }   /* a fixed 48px under the h3 in every case */
    .case__media { grid-column: 8 / -1; grid-row: 1 / span 2; align-self: start; margin-top: 0; }
    .case__rows, .case__tags { grid-column: 1 / -1; }
    .case__rows { margin-top: var(--s-8); grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .case__row, .case__row:last-child { border-bottom: 0; padding-block: var(--s-4) 0; }
    .case__rows[data-n='3'] .case__row { grid-column: span 4; }
    .case__rows[data-n='2'] .case__row:first-child { grid-column: 1 / 7; }
    .case__rows[data-n='2'] .case__row:last-child { grid-column: 8 / -1; }
    .case__rows[data-n='1'] .case__row { grid-column: 1 / 7; }
    .case__tags { margin-top: var(--s-6); }
  }
</style>
