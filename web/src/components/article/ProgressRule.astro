---
/**
 * ProgressRule (DESIGN-SPEC 5.8 item 1): a 1px Sapphire bar fixed under the (compact) header,
 * scaleX scrubbed to article progress by scripts/pages/article.ts. It starts at scaleX(0), so it
 * is invisible without JS; under reduced motion it is hidden and the running head counts minutes left.
 */
---
<div class="progress-rule" aria-hidden="true"><span class="progress-rule__bar" data-progress></span></div>
<style>
  .progress-rule {
    position: fixed; z-index: 49; left: 0; right: 0;
    top: var(--header-h-compact);
    height: 1px; pointer-events: none;
  }
  .progress-rule__bar {
    display: block; height: 100%; width: 100%;
    background: var(--c-line);
    transform: scaleX(0); transform-origin: 0 50%;
  }
  @media (prefers-reduced-motion: reduce) { .progress-rule { display: none; } }
  :global(html.motion-failed) .progress-rule, :global(html.no-js) .progress-rule { display: none; }
</style>
