---
/** One sector (DESIGN-SPEC v2 10.4 F2): dashed perforation rule, mono 0n, h2 with a hand highlight in the tint of its
 * first mapped pillar (wiped on enter), the brief copy in .t-lead, "Relevant expertise" + PillarTags (sticker drop). */
import { Image } from 'astro:assets';
import PillarTag from '../ui/PillarTag.astro';
import Scribble from '../notes/Scribble.astro';
import { industriesPage, industries } from '@/data/industries';
import { pillarHref } from '@/lib/pillars';
import { pad2 } from '@/lib/format';
import type { Industry } from '@/data/types';

interface Props { industry: Industry }
const { industry: i } = Astro.props;
---
<section id={i.slug} class="sector" aria-labelledby={`${i.slug}-title`} data-sector={i.slug} style={`--pc:var(--pillar-${i.pillars[0]}-text)`}>
  <span class="sector__rule" aria-hidden="true"></span>
  <div class="sector__grid">
    <p class="sector__n tnum" aria-hidden="true">{pad2(i.n)}<span>/{pad2(industries.length)}</span></p>
    <div class="sector__main">
      <h2 id={`${i.slug}-title`} class="t-h2 sector__title"><Scribble kind="highlight" nowrap={false}>{i.name}</Scribble></h2>
      <p class="t-lead sector__copy">{i.copy}</p>
      {i.image && (
        <Image class="sector__img" src={i.image} alt={i.imageAlt ?? ''} widths={[480, 720, 960]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" />
      )}
      <p class="t-dateline sector__label">{industriesPage.relevantExpertise}</p>
      <ul class="sector__tags" role="list">
        {i.pillars.map((k) => <li data-sticker><PillarTag pillar={k} href={pillarHref(k)} /></li>)}
      </ul>
    </div>
  </div>
</section>
<style>
  .sector { padding-block: var(--s-8); scroll-margin-top: var(--scroll-offset); }
  .sector__rule { display: block; height: 2px; background-image: linear-gradient(90deg, var(--kk-ink) 0 10px, transparent 10px 18px); background-size: 18px 2px; opacity: .5; }
  .sector__grid { display: grid; grid-template-columns: 7ch minmax(0, 1fr); gap: var(--s-5); margin-top: var(--s-6); }
  .sector__n { margin: 0; font: 800 clamp(2.5rem, 1.5rem + 2.6vw, 4rem)/.9 var(--font-display); font-stretch: 75%; color: var(--pc); letter-spacing: -0.03em; }
  .sector__n span { display: block; margin-top: 6px; font: 500 var(--fs-micro)/1 var(--font-mono); letter-spacing: .1em; color: var(--fg-2); }
  .sector__title { margin: 0; max-width: 16ch; color: var(--head); }
  .sector__copy { margin: var(--s-5) 0 0; color: var(--fg); }
  .sector__img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--r-card); margin-top: var(--s-6); }
  .sector__label { margin: var(--s-6) 0 var(--s-3); color: var(--fg-2); }
  .sector__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .sector:first-child { padding-top: 0; }
  .sector:last-child { padding-bottom: 0; }
  @media (max-width: 767px) { .sector { padding-block: var(--s-7); } .sector__grid { grid-template-columns: 1fr; gap: var(--s-3); } .sector__n span { display: inline; margin-left: 6px; } }
</style>
