---
/**
 * Home 4 · Featured insights (REDESIGN-V3 §4 Home 4, §9.3, §9.6 full bleed). White band: SectionHeader from home.insights
 * + "All insights". The two side slots hold the next visible insights and, in the slots no real insight fills (two in
 * all), an "In preparation" list of coming-soon titles with their format labels (unlinked: coming-soon pieces have no
 * route; titles in --fg-2 with a "Soon" tag, no arrow, so they never read as links).
 * ≥ 1200px (wide, magazine): the feature card runs the full width as a side-by-side row (its own ≥ 880px container
 *  layout: 3:2 photo 7fr left, serif title + standfirst + meta 5fr right). Under it, on the same 7fr / 5fr columns and
 *  gap, a quiet row of hairline-topped text items: the side insight(s) as text cards and the "In preparation" list,
 *  so the second row lines up exactly under the photo and the text above it. No small images competing with the big one.
 * 900–1199: feature card (stacked) in columns 1–7; columns 9–12 hold the side insights as default cards, then the list.
 * Photos: frontmatter image, else the slug's photo from research/v3/photos.md (./insight-photo.ts).
 * Mobile (< 900px): feature card full width, then the side insights as compact rows (112px thumb; format label only,
 *  so "POINT OF VIEW · PRODUCT" never wraps beside the thumb on a 360px phone), then the list.
 * One render per layout: the side insight is rendered as three twins (text / default / compact); display:none keeps
 *  the two hidden ones out of the accessibility tree.
 * Modes: preview/staging list drafts (includeDrafts); the Draft badge is staging-only. With no visible insight
 * (production today) the section is not rendered at all.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import InsightCard from '@/components/cards/InsightCard.astro';
import Tag from '@/components/ui/Tag.astro';
import { insightsHub } from '@/data/insights';
import { insights as fold, homeLabels } from '@/data/home';
import { footer } from '@/data/nav';
import { microcopy, formatLabels } from '@/data/microcopy';
import { pillars } from '@/data/pillars';
import { showDraftLabels } from '@/lib/mode';
import {
  visibleInsights, featuredInsight, comingSoon, isDraft, formatLabel, insightReadingTime, insightHref, type Insight,
} from '@/lib/insights';
import { insightPhoto } from './insight-photo';
import { keepCompounds } from './typo';

const feature = await featuredInsight();
const visible = await visibleInsights();
const side = feature ? visible.filter((e) => e.id !== feature.id).slice(0, 2) : [];

// The side column has two slots (§4: two cards stacked). Coming-soon titles fill only the slots no real insight takes,
// so the column never outgrows the feature card (one card + two titles ran ~80px past it at 1440 and made the band
// the tallest on Home; the full list lives on /insights). Formats not shown yet come first (so the band shows more
// than one kind of piece), then collection order.
const shown = new Set([feature, ...side].filter(Boolean).map((e) => (e as Insight).data.format));
const soon = (await comingSoon())
  .map((e, i) => ({ e, i }))
  .sort((a, b) => Number(shown.has(a.e.data.format)) - Number(shown.has(b.e.data.format)) || a.i - b.i)
  .map(({ e }) => e)
  .slice(0, Math.max(0, 2 - side.length));

const pillarLabel = (e: Insight) => pillars.find((p) => p.key === e.data.pillar)?.shortLabel;
const card = (e: Insight) => {
  const ph = insightPhoto(e);
  return {
    href: insightHref(e), title: e.data.title, label: formatLabel(e), pillarName: pillarLabel(e),
    date: e.data.date, readTime: insightReadingTime(e),
    image: ph?.src, imageAlt: ph?.alt, imagePosition: ph?.position,
  };
};
---
{feature && (
  <Section ground="white" labelledby="insights-heading" class="hi">
    <SectionHeader id="insights-heading" eyebrow={fold.overline} title={fold.headline} link={footer.insights.all} />
    <div class="hi__grid">
      <div class="hi__feature" data-reveal>
        <InsightCard {...card(feature)} size="feature" summary={feature.data.standfirst || undefined}>
          {showDraftLabels && isDraft(feature) && <span slot="badge"> · {homeLabels.draft}</span>}
        </InsightCard>
      </div>
      <div class:list={['hi__side', `hi__side--n${side.length}`, soon.length > 0 && 'hi__side--soon']}>
        {side.length > 0 && (
          <ul class="hi__cards" role="list">
            {side.map((e, i) => (
              <li data-reveal style={`--i:${i + 1}`}>
                <InsightCard {...card(e)} image={undefined} size="text" class="hi__xl">
                  {showDraftLabels && isDraft(e) && <span slot="badge"> · {homeLabels.draft}</span>}
                </InsightCard>
                <InsightCard {...card(e)} class="hi__wide">
                  {showDraftLabels && isDraft(e) && <span slot="badge"> · {homeLabels.draft}</span>}
                </InsightCard>
                <InsightCard {...card(e)} pillarName={undefined} size="compact" class="hi__narrow">
                  {showDraftLabels && isDraft(e) && <span slot="badge"> · {homeLabels.draft}</span>}
                </InsightCard>
              </li>
            ))}
          </ul>
        )}
        {soon.length > 0 && (
          <div class="hi__soon" data-reveal style={`--i:${side.length + 1}`}>
            <h3 class="hi__soon-title t-label">{microcopy.inPreparation}</h3>
            <ul class="hi__soon-list" role="list">
              {soon.map((e) => (
                <li class="hi__soon-item">
                  <p class="hi__soon-format">{formatLabels[e.data.format]}</p>
                  <p class="hi__soon-name">{keepCompounds(e.data.title)}</p>
                  <Tag size="sm" class="hi__soon-tag">{insightsHub.soonTag}</Tag>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </Section>
)}

<style>
  .hi__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
  .hi__side { display: flex; flex-direction: column; gap: var(--s-7); min-width: 0; }
  .hi__cards { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }

  /* one render per layout: text card ≥ 1200, default card 900–1199, compact row below 900 */
  .hi__cards :global(.hi__xl), .hi__cards :global(.hi__wide) { display: none; }

  .hi__soon { border-top: 1px solid var(--rule); padding-top: var(--s-5); }
  .hi__soon-title { margin: 0; color: var(--fg-2); }
  .hi__soon-list { list-style: none; margin: var(--s-2) 0 0; padding: 0; }
  .hi__soon-item {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--s-4); padding-block: var(--s-4);
  }
  .hi__soon-item :global(.hi__soon-tag) { grid-area: 1 / 2; justify-self: end; }
  .hi__soon-item + .hi__soon-item { border-top: 1px solid var(--rule); }
  .hi__soon-format { grid-area: 1 / 1; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .hi__soon-name {
    grid-column: 1 / -1; margin-top: var(--s-1);
    font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-h4); line-height: var(--lh-h4);
    font-weight: 450; color: var(--fg-2); text-wrap: balance;
  }

  @media (max-width: 899px) {
    .hi__cards { gap: var(--s-5); padding-top: var(--s-6); border-top: 1px solid var(--rule); }
    .hi__side { gap: var(--s-6); }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .hi__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); row-gap: 0; }
    .hi__feature { grid-column: 1 / span 7; }
    .hi__side { grid-column: 9 / -1; }
    .hi__cards :global(.hi__wide) { display: block; }
    .hi__cards :global(.hi__narrow) { display: none; }
  }

  /* wide: full-width feature row, then a text row on the feature's own 7fr / 5fr columns */
  @media (min-width: 1200px) {
    .hi__grid { gap: clamp(4rem, 2rem + 3vw, 6rem); }
    .hi__side {
      display: grid; grid-template-columns: 7fr 5fr; column-gap: clamp(3rem, 2rem + 3vw, 6rem); align-items: start;
    }
    .hi__cards :global(.hi__xl) { display: block; }
    .hi__cards :global(.hi__narrow) { display: none; }
    /* two real insights: both text cards share the row, one per column */
    .hi__side--n2 .hi__cards { grid-column: 1 / -1; grid-template-columns: 7fr 5fr; }
    .hi__side--n2 .hi__cards { column-gap: clamp(3rem, 2rem + 3vw, 6rem); }
    /* only coming-soon titles: the list spans the row, its items side by side */
    .hi__side--n0 .hi__soon { grid-column: 1 / -1; }
    .hi__side--n0 .hi__soon-list { display: grid; grid-template-columns: 7fr 5fr; column-gap: clamp(3rem, 2rem + 3vw, 6rem); }
    .hi__side--n0 .hi__soon-item + .hi__soon-item { border-top: 0; }
    .hi__soon { padding-top: var(--s-5); }
    .hi__soon-name { font-size: var(--fs-h3); line-height: 1.22; max-width: 40ch; }
  }
</style>
