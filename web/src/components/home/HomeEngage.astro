---
/**
 * Home 5b · How we engage (pack 2 item 16; copy from item 31). Sits right under the six services of "What we do", on
 * the same white ground, divided from them by a hairline: Bodoni H2 "How we engage" left, the intro right; then
 * four cards in one row (01 Diagnostic sprint · 02 Defined project · 03 Leadership on demand · 04 Expert review), each
 * a link to /approach#engage: number · Bodoni title · line · "Learn more →".
 * Hover: a Deep Delft line draws over the hairline, the title turns Deep Delft. Motion: hairlines draw in once.
 * Mobile: one column below 600px, two columns to 1000px, four from 1000px. No prices (brief item 31).
 */
import Icon from '@/components/ui/Icon.astro';
import { engage } from '@/data/home';
import { microcopy } from '@/data/microcopy';
---
<section id="engage" class="he band band--white" aria-labelledby="he-heading">
  <div class="container">
    <header class="he__head">
      <h2 id="he-heading" class="he__title">{engage.headline}</h2>
      <p class="he__intro">{engage.intro}</p>
    </header>
    <ul class="he__grid" role="list">
      {engage.cards.map((c) => (
        <li>
          <a class="he__card" href={engage.href}>
            <span class="he__rule" data-gsap="rule" aria-hidden="true"></span>
            <span class="he__hover" aria-hidden="true"></span>
            <span class="he__n">{c.n}</span>
            <h3 class="he__name">{c.title}</h3>
            <span class="he__line">{c.line}</span>
            <span class="he__more" aria-hidden="true">{microcopy.pillarLink}<Icon name="arrow-right" size={16} stroke={2} class="u-nudge" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .he { padding-top: 0; }
  .he__head { display: grid; gap: 20px; margin-bottom: 40px; padding-top: clamp(2.5rem, 2rem + 1.6vw, 3.5rem); border-top: 1px solid var(--rule); }
  .he__title { margin: 0; font-size: clamp(1.875rem, 1.6rem + 1.1vw, 2.5rem); line-height: 1.12; font-weight: 500; }
  .he__intro { margin: 0; max-width: 46ch; font-size: 1.0625rem; line-height: 1.65; color: var(--fg-2); }

  .he__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 32px; margin: 0; padding: 0; list-style: none; }
  .he__grid > li { display: flex; }
  .he__card {
    position: relative; flex: 1; display: flex; flex-direction: column; gap: 10px;
    padding: 26px 0 30px; color: var(--navy-900); text-decoration: none;
  }
  .he__rule, .he__hover { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--rule); }
  .he__hover { background: var(--blue-700); transform: scaleX(0); transform-origin: 0 50%; transition: transform 600ms var(--ease-out); }
  .he__card:is(:hover, :focus-visible) .he__hover { transform: scaleX(1); }
  .he__n { font-size: .875rem; font-weight: 700; color: var(--blue-700); font-variant-numeric: tabular-nums; }
  .he__name { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 1.5rem; line-height: 1.2; color: var(--navy-900); transition: color var(--d-1) var(--ease-out); }
  .he__card:hover .he__name { color: var(--blue-700); }
  .he__line { font-size: 1rem; line-height: 1.6; color: var(--fg-2); }
  .he__more { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 6px; font-size: .9375rem; font-weight: 700; color: var(--blue-700); }
  .he__card:focus-visible { outline-offset: 4px; }

  @media (min-width: 600px) { .he__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .he__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .he__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 80px; align-items: end; margin-bottom: 48px; }
    .he__intro { padding-bottom: 6px; }
  }
</style>
