---
/**
 * About /about, pack 2 (brief items 21–26; v4 "Delft" design kept). Grounds: navy hero → Porcelain strip (when it has
 * two or more figures) → white story → Porcelain career → white "worked alongside" → Dutch polder interlude → white
 * map → navy name panel → white credentials → (Porcelain testimonials, once two are confirmed) → CtaBand → footer.
 *  1 PageHero, navy split: the 4:5 portrait right, crumbs, eyebrow, H1 "Twenty-five years of making ingredients work.",
 *    the intro, then LinkedIn (and the one-page profile PDF, only when `aboutPage.profilePdfCurrent`, or in staging with
 *    a <Confirm>: the PDF still carries the v3 bio).
 *  1b AboutStrip (item 23): staging shows all four figures with the Part K 2 markers. Outside staging only the
 *     confirmed figures count: two or more → the band; just one ("5 working languages") → no band, the figure sits in
 *     the story's head column as a quiet fact with the five languages.
 *  2 AboutStory (item 21)    — name, "Founder and Principal, KoKreaters", the former-role line, base, the short bio,
 *                              "Read the long version" (native details) with the five long-bio paragraphs.
 *  3 CareerTimeline (item 22) — seven rows, "Today · KoKreaters" last, the places line under it.
 *  4 WorkedAlongside (item 24) — the sentence and six sector icons; no names, no logos.
 *  · PhotoInterlude (nl-polder): eyebrow "Based in the Netherlands", caption "A Dutch base. A global reach."
 *  5 PlacesMap, 6 NamePanel (v4, unchanged), 7 Credentials (item 25: four columns, placeholder columns hidden),
 *  8 AboutTestimonials (item 26: hidden until two are confirmed).
 * Item 8: Cargill and Wilmar appear on this page (long bio, timeline, former-role line) and nowhere else but the
 * founder line. JSON-LD: Person (with the portrait) + BreadcrumbList.
 * Mobile: every section states its own layout; hero buttons go full width below 600px.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import AboutStory from '@/components/about/AboutStory.astro';
import CareerTimeline from '@/components/about/CareerTimeline.astro';
import PlacesMap from '@/components/about/PlacesMap.astro';
import NamePanel from '@/components/about/NamePanel.astro';
import Credentials from '@/components/about/Credentials.astro';
import PhotoInterlude from '@/components/ui/PhotoInterlude.astro';
import portrait from '@/assets/photos/ganeaysh-portrait.jpg';
import { person } from '@/components/seo/schema';
import { pageSeo } from '@/lib/seo';
import { site } from '@/config/site';
import AboutStrip from '@/components/about/AboutStrip.astro';
import WorkedAlongside from '@/components/about/WorkedAlongside.astro';
import AboutTestimonials from '@/components/about/AboutTestimonials.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { about, aboutPage, aboutStrip, languages } from '@/data/about';
import { location } from '@/data/contact';
import { founderName } from '@/components/about/founder-lines';
import { photos } from '@/data/photos';
import { microcopy } from '@/data/microcopy';
import { showConfirm } from '@/lib/mode';

const portraitWebp = await getImage({ src: portrait, format: 'webp', width: 960 });
const crumbs = [{ label: about.overline, href: '/about' }];
const seo = { ...pageSeo('about'), jsonLd: [person(portraitWebp.src)] };
// The PDF is a static file written by scripts/make-profile-pdf.mjs; never link to it if it is missing.
const pdfExists = existsSync(join(process.cwd(), 'public', aboutPage.profilePdfHref));
const hasPdf = pdfExists && (aboutPage.profilePdfCurrent || showConfirm);
const polder = photos['nl-polder'];
// Item 23: staging shows every figure (placeholders marked); elsewhere only confirmed ones.
const stripItems = aboutStrip.items.filter((i) => showConfirm || !i.pending);
const single = stripItems.length === 1 ? stripItems[0] : undefined;
const fact = single ? {
  value: single.value,
  label: `${single.value === '5' ? aboutPage.languagesLabel : single.label}`.replace(/^./, (c) => c.toUpperCase()),
  detail: single.value === '5' ? languages : undefined,
} : undefined;
---
<BaseLayout page="about" seo={seo} breadcrumbs={crumbs}>
  <PageHero
    ground="navy"
    imageMode="portrait"
    image={portrait}
    imageAlt={founderName}
    imagePosition="50% 0%"
    crumbs={crumbs}
    eyebrow={about.overline}
    title={about.headline}
    lead={about.intro}
    titleId="about-title"
  >
    <div class="about-actions">
      {hasPdf && (
        <Button href={aboutPage.profilePdfHref} icon="download" download="ganeaysh-kulkarni-profile.pdf">
          <span class="about-pdf--full">{aboutPage.profilePdf}</span><span class="about-pdf--short">{aboutPage.profilePdfShort}</span>
        </Button>
      )}
      {hasPdf && !aboutPage.profilePdfCurrent && <Confirm id="PDF" note="profile PDF still has the v3 bio; regenerate (scripts/make-profile-pdf.mjs), then set aboutPage.profilePdfCurrent" />}
      <Button href={site.linkedin.href} variant="tertiary" icon="external" rel="noopener me" class="about-actions__link">
        {aboutPage.linkedin}<span class="visually-hidden"> ({microcopy.opensLinkedIn})</span>
      </Button>
    </div>
  </PageHero>
  {stripItems.length > 1 && <AboutStrip items={stripItems} />}
  <AboutStory fact={fact} />
  <CareerTimeline />
  <WorkedAlongside />
  <PhotoInterlude src={polder.src} alt={polder.alt} position={polder.position} size="lg" eyebrow={location.line} caption={aboutPage.interludeCaption} />
  <PlacesMap />
  <NamePanel />
  <Credentials />
  <AboutTestimonials />
</BaseLayout>
<style>
  /* PageHero puts its default slot 48px under the lead; buttons belong 32px under it, like hero actions. */
  .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-top: calc(var(--s-6) - var(--s-7)); }
  @media (max-width: 599px) {
    .about-actions :global(.btn--primary) { flex: 1 1 100%; }
  }
  /* Below 390px the full label wraps "(PDF)" onto a second line: the shorter label keeps the button one line, 48px.
     Only one label is ever rendered, so the accessible name follows what is shown. */
  .about-pdf--short { display: none; }
  @media (max-width: 389px) {
    .about-pdf--full { display: none; }
    .about-pdf--short { display: inline; }
  }
</style>
