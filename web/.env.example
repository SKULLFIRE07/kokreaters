PUBLIC_SITE_MODE=staging            # staging (local, default) | preview (the Vercel review link) | production (kokreaters.com)
PUBLIC_INDEXABLE=                   # 1 = indexable. Honoured only with PUBLIC_SITE_MODE=production (launch checklist)
PUBLIC_FORM_ENDPOINT=               # empty = /api/contact (the Vercel Function). 'none' = mailto only. An absolute URL posts there
PUBLIC_NEWSLETTER_ENDPOINT=         # empty = "Subscribe" opens mailto:office@kokreaters.com?subject=Subscribe
PUBLIC_BOOKING_URL=                 # Google appointment schedule or Calendly. Empty = booking card hidden, CTAs go to /contact#form. CONFIRM 9
PUBLIC_TURNSTILE_SITEKEY=           # empty = honeypot + time-trap only
PUBLIC_ANALYTICS=                   # empty/0 = no analytics, no consent banner. 1 = banner shown (nothing wired yet)
PUBLIC_CHAT=                        # empty = "Ask KoKreaters" chat on. off = widget not rendered on any page (no launcher, panel or chat script)

# ── Server-side (Vercel Functions in /api; never PUBLIC_, never in the browser). See ../CHATBOT-AND-EMAIL-SETUP.md ──
RESEND_API_KEY=                     # contact form via Resend; empty = FormSubmit (office@ must have activated it once)
RESEND_FROM=                        # default "KoKreaters website <website@kokreaters.com>" (domain verified in Resend)
CONTACT_TO=                         # default office@kokreaters.com (comma-separated list allowed)
OPENROUTER_API_KEY=                 # Ask KoKreaters chatbot (primary provider)
CHAT_MODEL=                         # OpenRouter model id, default google/gemini-2.5-flash-lite
ANTHROPIC_API_KEY=                  # chatbot fallback provider (used only when OPENROUTER_API_KEY is empty)
ANTHROPIC_MODEL=                    # default claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=             # sent as anthropic-workspace-id (user-scoped keys need it)
CHAT_MOCK=                          # 1 = canned streamed answer, no API call (local tests)
CONTACT_DRY_RUN=                    # 1 = validate and log, send nothing (local tests)
