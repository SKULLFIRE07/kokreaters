---
/**
 * The logo's overlapping discs (5.0.18). `outline`: 1px Hairline circles. `filled`: flat Lavender and
 * Butter at 60%, no blur, ONLY behind the founder portrait (graft 7, C-21). Absolutely fills its
 * positioned parent; decorative.
 */
interface Props { mode?: 'outline' | 'filled'; set?: 'logo' | 'portrait'; size?: number; class?: string; }
const { mode = 'outline', set = 'logo', size = 260, class: cls } = Astro.props;
const filled = mode === 'filled';
---
{set === 'logo' ? (
  <svg class:list={['discs', `discs--${mode}`, cls]} viewBox="20 15 570 570" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <circle cx="262" cy="208" r="185" fill={filled ? '#EADCFF' : 'none'} fill-opacity={filled ? 0.6 : undefined} />
    <circle cx="210" cy="392" r="185" fill={filled ? '#D6E2FA' : 'none'} fill-opacity={filled ? 0.6 : undefined} />
    <circle cx="396" cy="356" r="180" fill={filled ? '#FFEEB0' : 'none'} fill-opacity={filled ? 0.6 : undefined} />
  </svg>
) : (
  <span class:list={['discs', 'discs--portrait', `discs--${mode}`, cls]} style={`--d:${size}px`} aria-hidden="true">
    <span class="disc disc--lavender"></span>
    <span class="disc disc--butter"></span>
  </span>
)}
<style>
  .discs { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: visible; }
  svg.discs--outline circle { stroke: var(--c-rule); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .disc { position: absolute; left: 50%; top: 50%; width: var(--d); height: var(--d); border-radius: 50%; }
  .disc--lavender { transform: translate(calc(-50% - 40px), calc(-50% - 24px)); }
  .disc--butter { transform: translate(calc(-50% + 48px), calc(-50% + 36px)); }
  .discs--filled .disc--lavender { background: rgb(234 220 255 / 0.6); }
  .discs--filled .disc--butter { background: rgb(255 238 176 / 0.6); }
  .discs--outline .disc { border: 1px solid var(--c-rule); }
</style>
