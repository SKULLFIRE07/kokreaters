---
/**
 * Insight card, v4 "Delft" (the homepage design's Insights band): a square-cornered 3:2 photo on top, then a label row
 * (a red "New" tag on the newest insight only, then "Point of view · Food safety" in Deep Delft caps), the Bodoni
 * title (one link, stretched over the whole card), an optional summary in secondary text and "4 Nov 2026 · 5 min read".
 * No box and no shadow: the photo and a thin rule under the meta carry the card. Hover: the photo zooms 1.04 and the
 * title turns Deep Delft. Motion hooks: the card is data-gsap="lift", the photo frame data-gsap="parallax".
 * `soon` renders the "In preparation" variant: a Delft Ice panel with no photo and no link (coming-soon pieces have
 * no page), the label "In preparation · Explainer", the title and "Coming soon".
 * Mobile: the card fills the column; the title steps down to 24px.
 */
import type { ImageMetadata } from 'astro';
import Photo from '@/components/ui/Photo.astro';
import { formatDate, isoDate, fill } from '@/lib/format';
import { microcopy } from '@/data/microcopy';
import { insightsHub } from '@/data/insights';
interface Props {
  title: string;
  label: string;
  pillarName?: string;
  href?: string;
  summary?: string;
  date?: Date;
  readTime?: number;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  isNew?: boolean;
  soon?: boolean;
  level?: 2 | 3 | 4;
  priority?: boolean;
  sizes?: string;
}
const {
  title, label, pillarName, href, summary, date, readTime, image, imageAlt = '', imagePosition, isNew = false,
  soon = false, level = 3, priority = false,
  sizes = '(min-width: 1320px) 400px, (min-width: 900px) 30vw, (min-width: 600px) 45vw, calc(100vw - 40px)',
} = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
const readLabel = readTime ? fill(microcopy.readingTime, { n: readTime }) : '';
---
{soon ? (
  <article class="itile itile--soon" data-gsap="lift">
    <p class="itile__label t-label">{insightsHub.inPreparation}<span aria-hidden="true"> · </span>{label}</p>
    <H class="itile__title">{title}</H>
    <p class="itile__date">{insightsHub.comingSoonShort}</p>
  </article>
) : (
  <article class:list={['itile', 'u-zoom', image && 'itile--image']} data-gsap="lift">
    {image && (
      <Photo src={image} alt={imageAlt} position={imagePosition} ratio="3/2" sizes={sizes} priority={priority} class="itile__media" data-gsap="parallax" />
    )}
    <div class="itile__body">
      <p class="itile__label t-label">
        {isNew && <span class="itile__new">{insightsHub.newTag}</span>}
        <span>{label}{pillarName && <span aria-hidden="true"> · </span>}{pillarName}</span><slot name="badge" />
      </p>
      <H class="itile__title"><a href={href} class="itile__link">{title}</a></H>
      {summary && <p class="itile__summary">{summary}</p>}
      {(date || readLabel) && (
        <p class="itile__date">
          {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
          {date && readLabel && <span aria-hidden="true"> · </span>}
          {readLabel && <span>{readLabel}</span>}
        </p>
      )}
    </div>
  </article>
)}
<style>
  .itile { position: relative; display: flex; flex-direction: column; height: 100%; min-width: 0; }
  .itile :global(.itile__media) { margin-bottom: var(--s-5); }
  .itile__body { display: flex; flex-direction: column; flex: 1 1 auto; }
  .itile__label {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3);
    margin: 0 0 var(--s-3); color: var(--label); font-size: 12px; letter-spacing: .14em;
  }
  .itile__new {
    display: inline-flex; align-items: center; height: 20px; padding: 0 7px;
    background: var(--red); color: var(--white); font-size: 11px; letter-spacing: .1em; line-height: 1;
  }
  .itile__title {
    margin: 0; font-family: var(--font-serif); font-weight: 400;
    font-size: 1.75rem; line-height: 1.2; letter-spacing: 0;
    color: var(--head); text-wrap: balance; max-width: 22ch;
  }
  .itile__link { color: inherit; text-decoration: none; transition: color var(--d-1) var(--ease-out); }
  .itile__link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .itile__link:focus-visible { outline: none; }
  .itile:has(.itile__link:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .itile:hover .itile__link { color: var(--link); }
  .itile__summary {
    margin: var(--s-3) 0 0; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--fg-2);
    max-width: 46ch; text-wrap: pretty;
  }
  .itile__date {
    margin: var(--s-4) 0 0; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2);
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* In preparation: a Delft Ice panel, text set low like the homepage card */
  .itile--soon {
    justify-content: flex-end; min-height: 280px; padding: var(--s-6);
    background: var(--ice);
  }
  .itile--soon .itile__title { font-size: 1.75rem; }
  .itile--soon .itile__date { margin-top: var(--s-4); }
  @media (min-width: 900px) { .itile--soon { min-height: 320px; padding: var(--s-7) var(--s-6) var(--s-6); } }
</style>
