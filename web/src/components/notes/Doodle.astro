---
/** Doodle (DESIGN-SPEC v2 6.2): a standalone hand-drawn mark (arrow, star, spark, tick, asterisk, bracket, node,
 * squiggle, heart-node). Decorative, aria-hidden. Draws on (pathLength=1 strokes) when its trigger enters. */
import { pick, vbSize, toneColor, type DoodleKind, type Tone, type Show } from './paths';
interface Props { kind: DoodleKind; tone?: Tone; size?: number; rotate?: number; place?: string; show?: Show;
  delay?: number; trigger?: string; seed?: number; stroke?: number; class?: string }
const { kind, tone = 'auto', rotate = 0, place = '', show = 'all', delay = 0, trigger, seed = 0, stroke = 3, class: cls } = Astro.props;
const def = pick(kind, seed);
const [vw, vh] = vbSize(def.vb);
const size = Astro.props.size ?? vw;
const h = Math.round((size * vh) / vw);
const sw = ((stroke * vw) / size).toFixed(2);
---
<svg class:list={['doodle', `doodle--${kind}`, `note--show-${show}`, cls]} width={size} height={h} viewBox={def.vb} fill="none"
  stroke-width={sw} aria-hidden="true" focusable="false" data-doodle data-note-delay={delay || undefined} data-note-trigger={trigger}
  style={`--note-c:${toneColor(tone)};rotate:${rotate}deg;${place}`}>
  {def.d?.map((d) => <path data-note-draw pathLength="1" d={d} />)}
  {def.head?.map((d) => <path data-note-draw data-note-head pathLength="1" d={d} />)}
</svg>
