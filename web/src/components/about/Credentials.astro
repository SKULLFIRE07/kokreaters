---
/**
 * About · Credentials (brief item 25). White band, aria-labelledby="cred-title".
 * Four columns, each with a 1px top rule (the first saffron, 3px) and a Bodoni h3: Education · Executive education ·
 * Professional memberships · Speaking and publications. Rows split into the qualification (body, bold) and the
 * institution and year (meta), with hairlines between rows (≥ 48px). A column whose rows are still Part K 11
 * placeholders renders only in staging, as its heading and <Confirm>; elsewhere it is left out and the grid closes up
 * (two columns at launch).
 * ≥ 1200px one row of all visible columns; 600–1199px two columns; phones one column, 48px between groups.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { credentials } from '@/data/about';
import { showConfirm } from '@/lib/mode';

const cols = credentials.columns.filter((c) => c.rows.length > 0 || (showConfirm && c.pending));
---
<Section ground="white" labelledby="cred-title" class="cred">
  <SectionHeader id="cred-title" title={credentials.heading} />
  <div class="cred__cols" style={`--n:${cols.length}`}>
    {cols.map((c, i) => (
      <div class:list={['cred__col', i === 0 && 'cred__col--lead']}>
        <span class="cred__rule" aria-hidden="true" data-gsap="rule"></span>
        <h3 class="cred__h">{c.heading}</h3>
        {c.rows.length > 0 ? (
          <ul class="cred__list" role="list">
            {c.rows.map((r) => (
              <li class="cred__item"><span class="cred__main">{r.main}</span>{r.meta && <span class="cred__meta">{r.meta}</span>}</li>
            ))}
          </ul>
        ) : c.pending && <p class="cred__pending"><Confirm id={c.pending.confirm} note={c.pending.note} /></p>}
      </div>
    ))}
  </div>
</Section>
<style>
  .cred__cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7) var(--grid-gap); }
  .cred__col { position: relative; padding-top: var(--s-5); min-width: 0; }
  .cred__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--rule); transform-origin: left center; }
  .cred__col--lead .cred__rule { height: 3px; background: var(--saffron); }
  .cred__h { margin: 0 0 var(--s-4); font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.25; font-weight: 400; }
  .cred__list { list-style: none; margin: 0; padding: 0; }
  .cred__item {
    display: flex; flex-direction: column; justify-content: flex-start; gap: 2px; min-height: 48px;
    padding-block: var(--s-3); border-bottom: 1px solid var(--rule);
  }
  .cred__item:last-child { border-bottom: 0; }
  .cred__main { font-size: var(--fs-body); line-height: 1.4; font-weight: 600; color: var(--head); }
  .cred__meta { font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--fg-2); }
  .cred__pending { margin: 0; }
  @media (min-width: 600px) { .cred__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .cred__cols { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); } }
</style>
