---
/** /impact (DESIGN-SPEC 5.6). CtaField is rendered by BaseLayout. No count-up on this page. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/chrome/Breadcrumbs.astro';
import CaseEntry from '@/components/impact/CaseEntry.astro';
import EngagementRow from '@/components/impact/EngagementRow.astro';
import Testimonials from '@/components/impact/Testimonials.astro';
import { founderResults, engagements, impactPage } from '@/data/impact';
import { pageSeo } from '@/lib/seo';
import { isStaging } from '@/lib/mode';

const crumbs = [{ label: impactPage.overline, href: '/impact' }];
const visibleEngagements = engagements.filter((e) => e.consent === 'cleared' || isStaging);
---
<BaseLayout page="impact" seo={pageSeo('impact')} breadcrumbs={crumbs} showCrumbs={false}>
  <div class="impact-hero band--dark on-dark">
    <div class="container">
      <Breadcrumbs items={crumbs} tone="dark" />
      <div class="grid impact-hero__grid">
        <div class="c-1-9">
          <p class="t-dateline impact-hero__dateline">{impactPage.overline}</p>
          <h1 class="t-h1 impact-hero__title">{impactPage.headline}</h1>
          <p class="t-lead impact-hero__lead">{impactPage.lead}</p>
        </div>
      </div>
    </div>
  </div>

  <section class="band impact-part" aria-labelledby="part-founder">
    <div class="container">
      <h2 id="part-founder" class="t-h2 impact-part__title" data-reveal="lines">{impactPage.partOne}</h2>
      <div class="impact-part__cases">
        {founderResults.map((r) => <CaseEntry result={r} />)}
      </div>
    </div>
  </section>

  {visibleEngagements.length > 0 && (
    <section class="band band--alt impact-part impact-part--eng" aria-labelledby="part-engagements">
      <div class="container">
        <div class="impact-part__head">
          <h2 id="part-engagements" class="t-h2 impact-part__title" data-reveal="lines">{impactPage.partTwo}</h2>
          <p class="t-meta impact-part__meta">{impactPage.anonymised}</p>
        </div>
        <ul class="impact-part__eng" role="list">
          {visibleEngagements.map((e) => <EngagementRow engagement={e} />)}
        </ul>
        <span class="rule impact-part__end" data-rule aria-hidden="true"></span>
      </div>
    </section>
  )}

  <Testimonials />
</BaseLayout>
<style>
  .impact-hero { padding-block: var(--s-5) var(--section); }
  .impact-hero__grid { padding-top: var(--s-9); }
  .impact-hero__dateline { margin: 0 0 var(--s-5); }
  .impact-hero__title { margin: 0; max-width: 15em; }
  .impact-hero__lead { margin: var(--s-6) 0 0; }
  .impact-part__title { margin: 0; }
  .impact-part__cases { margin-top: var(--s-7); }
  .impact-part__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2) var(--s-5); margin-bottom: var(--s-7); }
  .impact-part__meta { margin: 0; }
  .impact-part__eng { list-style: none; margin: 0; padding: 0; }
  .impact-part__end { display: block; }
  @media (max-width: 767px) { .impact-hero__grid { padding-top: var(--s-8); } }
</style>
