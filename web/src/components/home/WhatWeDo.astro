---
/**
 * F5 · What we do (DESIGN-SPEC v2 10.1 + 00.2). White. A pinned sideways rail (R5, ≥ 1024 + motion; a native snap rail
 * otherwise): item 0 is the intro panel, led by a hub-and-spoke diagram of the six pillars that assembles as the fold
 * arrives (nodes fly in from the edges, spokes draw) and then tracks the rail (the node of the card in view lights).
 * Items 1–6: colour-blocked PillarCards with their honest labels, alternating ±1°. Item 7: an Ink end card.
 */
import Rail from '@/components/shared/Rail.astro';
import PillarCard from '@/components/shared/PillarCard.astro';
import Folio from '@/components/ui/Folio.astro';
import Arrow from '@/components/ui/Arrow.astro';
import MarginNote from '@/components/notes/MarginNote.astro';
import NodeCluster from '@/components/brand/NodeCluster.astro';
import { whatWeDo } from '@/data/home';
import { pillars } from '@/data/pillars';
import { microcopy } from '@/data/microcopy';
import { homeNotes } from '@/data/notes/home';

const HC = { x: 160, y: 160 }, HR = 118;
const hub = pillars.map((p, i) => {
  const a = ((-90 + i * 60) * Math.PI) / 180;
  return { key: p.key, n: p.n, x: +(HC.x + HR * Math.cos(a)).toFixed(1), y: +(HC.y + HR * Math.sin(a)).toFixed(1) };
});
---
<section class="whatwedo band fold g-white has-notes" aria-labelledby="whatwedo-heading" data-whatwedo>
  <Rail label={whatWeDo.headline} id="pillar-rail" pin class="whatwedo__rail">
    <li class="whatwedo__intro">
      <div class="wwd-intro">
        <Folio n="01" label={whatWeDo.overline} />
        <svg class="wwd-hub" viewBox="0 0 320 320" aria-hidden="true" focusable="false" data-hub>
          <circle cx={HC.x} cy={HC.y} r={HR} class="wwd-hub__ring" />
          {hub.map((h) => <line x1={HC.x} y1={HC.y} x2={h.x} y2={h.y} class="wwd-hub__spoke" data-hub-spoke />)}
          <g transform={`translate(${HC.x - 38} ${HC.y - 38})`}><NodeCluster size={76} discs={false} /></g>
          {hub.map((h) => (
            <g class="wwd-hub__node" data-hub-node data-x={h.x} data-y={h.y}>
              <circle cx={h.x} cy={h.y} r="22" fill="#fff" stroke="var(--kk-ink)" stroke-width="2" />
              <circle cx={h.x} cy={h.y} r="15" fill={`var(--pillar-${h.key})`} />
              <text x={h.x} y={h.y + 4.5} text-anchor="middle" class={h.key === 'strategy' || h.key === 'capability' ? 'is-ink' : ''}>{String(h.n).padStart(2, '0')}</text>
            </g>
          ))}
        </svg>
        <h2 id="whatwedo-heading" class="t-display wwd-intro__h" data-rise>{whatWeDo.headline}</h2>
        <p class="t-lead wwd-intro__lead">{whatWeDo.intro}</p>
        <MarginNote text={homeNotes.whatWeDo.sideways} tone="orchid" rotate={-3} arrow="arrow-straight" arrowAt="end" show="lg" anchor="block" class="wwd-intro__note" />
        <MarginNote text={homeNotes.whatWeDo.swipe} tone="orchid" rotate={-3} arrow="arrow-straight" arrowAt="end" show="all" anchor="block" class="wwd-intro__note wwd-intro__note--m" />
      </div>
    </li>
    {pillars.map((p) => (
      <li class="whatwedo__card"><PillarCard pillar={p} variant="rail" /></li>
    ))}
    <li class="whatwedo__end">
      <a href="/expertise" class="wwd-end g-ink" data-cursor="open">
        <span class="t-display wwd-end__t">{microcopy.allExpertise}</span>
        <span class="wwd-end__arrow"><Arrow size={48} /></span>
        <span class="wwd-end__dots" aria-hidden="true">{pillars.map((p) => <i style={`background:var(--pillar-${p.key})`}></i>)}</span>
      </a>
    </li>
  </Rail>
</section>

<style>
  .whatwedo { padding-block: clamp(56px, 7vw, 96px); overflow: clip; }
  .whatwedo :global(.rail__track) { align-items: stretch; }
  .whatwedo__intro { width: min(460px, 86vw); }
  .wwd-intro { display: flex; flex-direction: column; gap: var(--s-4); padding-right: var(--s-5); }
  .wwd-intro :global(.folio) { margin-bottom: var(--s-2); }
  .wwd-hub { width: 220px; height: 220px; overflow: visible; margin: 0 0 var(--s-2) -10px; }
  .wwd-hub__ring { fill: none; stroke: var(--kk-hairline); stroke-width: 2; stroke-dasharray: 3 7; }
  .wwd-hub__spoke { stroke: var(--kk-ink); stroke-width: 2.5; stroke-linecap: round; }
  .wwd-hub__node { transform-box: fill-box; transform-origin: center; transition: scale var(--d-ui) var(--ease-expo); }
  .wwd-hub__node text { font: 500 11px/1 var(--font-mono); fill: #fff; }
  .wwd-hub__node text.is-ink { fill: var(--kk-ink); }
  .wwd-hub__node.is-on { scale: 1.35; }
  .wwd-intro__h { margin: 0; color: var(--kk-ink); font-size: clamp(48px, 5.4vw, 88px); }
  .wwd-intro__lead { margin: 0; color: var(--fg-2); max-width: 34ch; }
  .wwd-intro :global(.wwd-intro__note) { margin-top: var(--s-2); }
  @media (min-width: 1024px) { .wwd-intro :global(.wwd-intro__note--m) { display: none; } }

  .whatwedo__card { padding-top: 12px; }
  .whatwedo__card:nth-child(even) :global(.pcard) { rotate: -1deg; }
  .whatwedo__card:nth-child(odd) :global(.pcard) { rotate: 1deg; }
  .whatwedo__card :global(.pcard:hover), .whatwedo__card :global(.pcard:focus-visible) { rotate: 0deg; }

  .whatwedo__end { width: min(360px, 76vw); padding-top: 12px; }
  .wwd-end {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-6);
    width: 100%; min-height: min(600px, 132vw); padding: 32px 28px; border-radius: var(--r-card); text-decoration: none; color: var(--kk-white);
    transition: translate var(--d-ui) var(--ease-expo), box-shadow var(--d-ui) var(--ease-expo);
  }
  .wwd-end:hover, .wwd-end:focus-visible { translate: 0 -6px; box-shadow: var(--shadow-lift); color: var(--kk-saffron); }
  .wwd-end:focus-visible { outline: 3px solid var(--kk-cobalt); outline-offset: 4px; }
  .wwd-end__t { font-size: clamp(56px, 5vw, 84px); color: inherit; }
  .wwd-end__arrow { display: inline-grid; place-items: center; width: 96px; height: 96px; border-radius: 50%; background: var(--kk-saffron); color: var(--kk-ink); transition: rotate var(--d-ui) var(--ease-expo); }
  .wwd-end:hover .wwd-end__arrow { rotate: -45deg; }
  .wwd-end__dots { display: flex; gap: 8px; }
  .wwd-end__dots i { width: 16px; height: 16px; border-radius: 50%; box-shadow: 0 0 0 2px var(--kk-white); }
  @media (prefers-reduced-motion: reduce) { .whatwedo__card :global(.pcard) { rotate: 0deg !important; } }
</style>
