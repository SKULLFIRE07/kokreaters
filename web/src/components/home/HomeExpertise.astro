---
/**
 * Home 4 · What we do (pack 3: "the six services with icons"; layout "small line icons or a thumbnail each so the grid
 * is not all text"). White band: label + Bodoni H2, "How we engage →" (Approach) on the right. Six cards in a 3 × 2
 * grid, each one link: a 56px Ice tile with the service's line icon, the name (Manrope 700, 19px), the one-line promise,
 * an arrow. Hover: the tile turns Deep Delft with a white icon, the name underlines, the arrow nudges.
 * Then "Where we help now" (pack 3 point 8): the live themes as a quiet row of chips on a hairline (CONFIRM in staging:
 * Ganeaysh picks the themes he wants to be found for).
 * Mobile: one column (two from 600px, three from 1000px).
 */
import Icon from '@/components/ui/Icon.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import ExpertiseIcon from '@/components/ui/ExpertiseIcon.astro';
import Confirm from '@/components/ui/Confirm.astro';
import { pillars } from '@/data/pillars';
import { whatWeDo, helpNow } from '@/data/home';
import { keepCompounds } from './typo';
---
<section id="expertise" class="hx band band--white" aria-labelledby="hx-heading">
  <div class="container">
    <header class="hx__head">
      <div>
        <p class="t-label hx__label">{whatWeDo.overline}</p>
        <h2 id="hx-heading" class="hx__title">{whatWeDo.headline}</h2>
      </div>
      <ArrowLink href={whatWeDo.approachLink.href} class="hx__link">{whatWeDo.approachLink.label}</ArrowLink>
    </header>
    <ul class="hx__grid" role="list">
      {pillars.map((p) => (
        <li>
          <a class="hx__card u-hover" href={`/expertise/${p.slug}`}>
            <span class="hx__icon"><ExpertiseIcon pillar={p.key} size={30} /></span>
            <span class="hx__text">
              <h3 class="hx__name">{p.name}</h3>
              <span class="hx__line">{keepCompounds(p.promise)}</span>
            </span>
            <Icon name="arrow-right" size={20} stroke={2} class="hx__arrow u-nudge" />
          </a>
        </li>
      ))}
    </ul>
    <div class="hx__now">
      <p class="hx__now-label">{helpNow.label}</p>
      <ul class="hx__chips" role="list">
        {helpNow.themes.map((t) => <li class="hx__chip">{t}</li>)}
        <li class="hx__confirm"><Confirm id="P-16" note={helpNow.confirm} /></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hx__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; margin-bottom: clamp(32px, 2vw + 20px, 52px); }
  .hx__label { margin: 0 0 18px; }
  .hx__title { margin: 0; max-width: 20ch; font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 500; }
  .hx :global(.hx__link) { margin-bottom: -10px; }

  .hx__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 var(--grid-gap); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--grey-200); }
  .hx__grid > li { display: flex; border-bottom: 1px solid var(--grey-200); }
  .hx__card {
    position: relative; flex: 1; display: grid; grid-template-columns: 56px minmax(0, 1fr) 20px; align-items: start; gap: 20px;
    padding: 28px 0; color: var(--navy-900); text-decoration: none;
  }
  .hx__icon {
    display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px;
    background: var(--ice); color: var(--blue-700);
    transition: background-color var(--d-2) var(--ease-out), color var(--d-2) var(--ease-out);
  }
  .hx__icon :global(.xicon) { color: inherit; }
  .hx__card:is(:hover, :focus-visible) .hx__icon { background: var(--blue-700); color: var(--white); }
  .hx__text { display: flex; flex-direction: column; gap: 6px; }
  .hx__name {
    margin: 0; font-family: var(--font-sans); font-weight: 700; font-size: 1.1875rem; line-height: 1.3; color: var(--navy-900);
    text-wrap: balance; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .2em; text-decoration-thickness: 1px;
    transition: text-decoration-color var(--d-1) var(--ease-out), color var(--d-1) var(--ease-out);
  }
  .hx__card:is(:hover, :focus-visible) .hx__name { color: var(--blue-700); text-decoration-color: currentColor; }
  .hx__line { font-size: 1rem; line-height: 1.5; color: var(--fg-2); }
  .hx__card :global(.hx__arrow) { margin-top: 18px; color: var(--blue-700); }
  .hx__card:focus-visible { outline-offset: 4px; }

  .hx__now { display: grid; gap: 14px; margin-top: clamp(36px, 2vw + 24px, 56px); }
  .hx__now-label { margin: 0; font: 700 var(--fs-label)/var(--lh-label) var(--font-sans); letter-spacing: var(--tr-label); text-transform: uppercase; color: var(--label); }
  .hx__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .hx__confirm:empty { display: none; }
  .hx__chip {
    display: inline-flex; align-items: center; min-height: 40px; padding: 8px 16px;
    border: 1px solid var(--grey-200); background: var(--grey-50);
    font-size: .9375rem; font-weight: 600; line-height: 1.3; color: var(--navy-900);
  }

  @media (min-width: 600px) { .hx__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .hx__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hx__card { padding: 32px 0 34px; }
    .hx__now { grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 28px; }
  }
</style>
